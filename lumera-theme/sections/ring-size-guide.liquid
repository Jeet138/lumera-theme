{{ 'ring-size-guide.css' | asset_url | stylesheet_tag }}

<section class="ring-guide">
  <div class="ring-guide__hero">
    <!-- Left Ring -->
    <div class="hero-ring hero-ring-left">
      <img
        src="{{ 'ring-hero.png' | asset_url }}"
        alt="Ring"
        class="ring-img"
      >

      <img
        src="{{ 'diamond-top.png' | asset_url }}"
        alt="Diamond"
        class="diamond-img"
      >
    </div>

    <div class="page-width">
      <span class="subtitle"> Ring Size Guide </span>

      <h1>{{ section.settings.heading }}</h1>

      <p>{{ section.settings.description }}</p>

   {% if section.settings.pdf_link != blank %}
  <a
    href="{{ section.settings.pdf_link }}"
    class="button button--primary"
    target="_blank"
    rel="noopener"
  >
    {{ section.settings.button_text }}
  </a>
{% endif %}
    </div>

    <!-- Right Ring -->
    <div class="hero-ring hero-ring-right">
      <img
        src="{{ 'ring-hero.png' | asset_url }}"
        alt="Ring"
        class="ring-img"
      >

      <img
        src="{{ 'diamond-top.png' | asset_url }}"
        alt="Diamond"
        class="diamond-img"
      >
    </div>
  </div>

  <div class="page-width">
    <div class="ring-guide__steps">
      {% for block in section.blocks %}
        <div class="step-card">
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy' }}
          {% endif %}

          <h3>{{ block.settings.title }}</h3>

          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ring Size Guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Ring Size At Home"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Measure your ring size in a few simple steps."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Download Size Guide"
    },
    {
      "type": "url",
      "id": "pdf_link",
      "label": "PDF File URL"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Step description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ring Size Guide"
    }
  ]
}
{% endschema %}
