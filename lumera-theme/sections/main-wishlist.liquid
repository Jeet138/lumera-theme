<div class="wishlist-page page-width">

  <div class="wishlist-header text-center">
    <span class="wishlist-subtitle">YOUR SAVED JEWELLERY</span>
    <h1 class="wishlist-title">My Wishlist</h1>
    <p class="wishlist-desc">
      Keep track of your favourite jewellery pieces.
    </p>
  </div>

  <div class="js-wishlist-content row wishlist-grid">
    <!-- theme.js automatically products load karega -->
  </div>

</div>

<style>
.wishlist-page{
    max-width:1400px;
    margin:70px auto;
}

.wishlist-header{
    margin-bottom:60px;
}

.wishlist-subtitle{
    display:block;
    font-size:13px;
    letter-spacing:3px;
    color:#777;
    text-transform:uppercase;
    margin-bottom:12px;
}

.wishlist-title{
    font-size:56px;
    font-family: "Cormorant Garamond", serif;
    color:#0c3b36;
    margin:0;
    font-weight:500;
}

.wishlist-desc{
    margin-top:12px;
    color:#666;
    font-size:17px;
}

.wishlist-grid{
    row-gap:35px;
}

.js-wishlist-itembox{
    background:#fff;
    border:1px solid #ececec;
    border-radius:14px;
    padding:18px;
    height:100%;
    transition:.3s;
}

.js-wishlist-itembox:hover{
    box-shadow:0 15px 35px rgba(0,0,0,.08);
    transform:translateY(-4px);
}

.js-wishlist-itembox img{
    width:150px;
    height:150px;
    object-fit:cover;
    border-radius:10px;
}

.title-product{
    font-size:19px;
    color:#111;
    font-weight:500;
    line-height:1.5;
    text-decoration:none;
}

.title-product:hover{
    color:#0c3b36;
}

.wl-sale{
    color:#0c3b36;
    font-weight:600;
    font-size:18px;
}

.js-wishlist-itembox s{
    color:#999;
    margin-left:10px;
}

.js-remove-wishlist{
    color:#b71c1c;
    font-weight:600;
    text-decoration:none;
}

.js-remove-wishlist:hover{
    color:#000;
}

@media(max-width:767px){

.wishlist-page{
margin:35px auto;
padding:0 15px;
}

.wishlist-title{
font-size:40px;
}

.js-wishlist-itembox .d-flex{
display:block!important;
text-align:center;
}

.js-wishlist-itembox img{
width:100%;
height:auto;
margin-bottom:15px;
}

}
</style>

{% schema %}
{
  "name": "Main Wishlist",
  "settings": []
}
{% endschema %}