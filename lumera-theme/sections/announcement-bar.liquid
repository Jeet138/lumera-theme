{%- if section.settings.enable -%}
  {%- liquid
    assign enable_marquee = section.settings.enable_marquee
    assign enable_login_topbar = section.settings.enable_login_topbar
    assign enable_money_topbar = section.settings.enable_money_topbar
    assign enable_language_topbar = section.settings.enable_language_topbar
    assign enable_social_topbar = section.settings.enable_social_topbar
    assign enable_name = section.settings.enable_name
    assign enable_image = section.settings.enable_image
    assign gradient_bg = section.settings.gradient_bg
    assign background = section.settings.background
    assign text_color = section.settings.text_color
    assign font_size_topbar = section.settings.font_size_topbar

    assign enable_countdown = section.settings.enable_countdown
    assign text_countdown = section.settings.text_countdown
    assign topbar_store_link = section.settings.topbar_store_link
    assign topbar_page_appointment = section.settings.topbar_page_appointment
    assign enable_block_link = section.settings.enable_block_link

    assign left_icon = section.settings.left_icon
    assign left_text = section.settings.left_text
    assign left_link = section.settings.left_link

    assign right_icon = section.settings.right_icon
    assign right_text = section.settings.right_text
    assign right_link = section.settings.right_link
  -%}
  <style>
        .announcement-bar{
        padding: 0.3rem 0;
        background:{%- if gradient_bg != blank -%} {{ gradient_bg }} {%- else -%} {{ background }} {%- endif -%};
        }
        #announcement-topbar{
            {% if text_color != 'transparent' and text_color != 'rgba(0,0,0,0)' %}
            --color-body-text : {{ text_color }};
            --color-body-text-rgb: {{ text_color.red }}, {{ text_color.green }},  {{ text_color.blue }} ;
          {% endif %}
          --g-font-size : {{ font_size_topbar }}px;
          color:var(--color-body-text);
          font-size:var(--g-font-size);
        }
        #announcement-topbar .row{
          line-height: 1;
          margin: 0;
        }
        #announcement-topbar .row > [class*="col-"]{
          padding-top: 0;
          padding-bottom: 0;
        }
        #announcement-topbar .list-inline-item:not(:last-child){
            margin-right: 1.5rem;
        }
        #announcement-topbar .social-icons li a,
        #announcement-topbar .left-custom-link,
        #announcement-topbar .right-custom-link,
        #announcement-topbar .center-block-content a{
            color:var(--color-body-text);
        }
        #announcement-topbar .site-header__link{
            color:var(--color-body-text);
        }
        #announcement-topbar #HeaderCountryForm .localization-form__select,
        #announcement-topbar #HeaderLanguageForm .localization-form__select{
            color:var(--color-body-text);
            font-size: var(--g-font-size);
            font-weight: var(--g-font-weight-body);
            text-transform:inherit;
            letter-spacing:0;
        }
        #announcement-topbar .col-right .topbar-block{
            padding-right: 2.5rem;
        }
        #announcement-topbar .col-right .topbar-block:last-child{
            padding-right: 0rem;
        }
        #announcement-topbar .disclosure__list-wrapper{
            z-index: 9999;
            --color-body-text-rgb: {{ settings.color_body_text.red }}, {{ settings.color_body_text.green }}, {{ settings.color_body_text.blue }};
        }
        #announcement-topbar .link {
        color: rgba(var(--color-body-text-rgb),1);
        text-decoration-color: rgba(var(--color-body-text-rgb),1);
        }
        .announcement-bar .countdown-timer{
        line-height:1;
      }
      .announcement-bar .countdown-timer ul{
        display:flex;
        column-gap:16px;
      }
      .announcement-bar .countdown-timer li{
        text-align:center;
        position:relative;
        padding:0;
      }
      .announcement-bar .countdown-timer li:not(:last-child):before{
      content:":";
      position:absolute;
      top:0;
      right:-8px;
      }
        .announcement-bar .countdown-timer .countdown-time{
          display:block;
          text-align:center;
          font-weight:500;
          font-size: var(--g-font-size);
          min-width: fit-content;
        }
        .announcement-bar .countdown-text{
        font-size: 65% !important;
        text-transform: none !important;
        letter-spacing: 0 !important;
        }

        /* --- MARQUEE STYLES START --- */
        .marquee-wrapper{
        width:100%;
        overflow:hidden;
        position:relative;
    }

    .marquee-track{
        display:flex;
        width:max-content;
        animation: marquee 10s linear infinite;
    }

    .marquee-group{
        display:flex;
        align-items:center;
        white-space:nowrap;
        flex-shrink:0;
    }

    .center-block-content{
        display:inline-flex;
        align-items:center;
        white-space:nowrap;
       padding: 0 33px;
    }

    .marquee-wrapper:hover .marquee-track{
        animation-play-state:paused;
    }

    @keyframes marquee{
        from{
            transform:translateX(0);
        }
        to{
            transform:translateX(-50%);
        }
    }
        /* --- MARQUEE STYLES END --- */

        .center-content-bar {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 1.5rem; /* Spacing between blocks when not scrolling */
        }
        .center-block-content {
            white-space: nowrap;
        }
  </style>
  <announcement-bar>
    <div class="announcement-bar" data-aos="{{ section.settings.animation }}">
      <div class="{{ section.settings.setwidth }}">
        <div id="announcement-topbar">
          <div class="row align-items-center">
            <div class="col-4 d-none d-lg-flex gap-4"  >
              {%- if enable_social_topbar -%}
                <div class="topbar-block">
                  {%- render 'block-social' -%}
                </div>
              {%- endif -%}
              {%- if enable_block_link -%}
                {% if section.settings.topbar_phone != blank %}
                  <div class="d-flex" style="margin-top: -20px; margin-left: -185px;">
                    <a href="tel:{{ section.settings.topbar_phone | strip }}" class="d-inline-flex align-items-center">
                      {% render 'icon-mobile-phone' %}
                      <span class="pl-2">{{ section.settings.topbar_phone }}</span>
                    </a>
                  </div>
                {% endif %}
                {% if section.settings.topbar_email != blank %}
                  <div class="d-flex" >
                    <a href="mailto:{{ section.settings.topbar_email }}" class="d-inline-flex align-items-center">
                      {% render 'icon-email' %}
                      <span class="pl-2">{{ section.settings.topbar_email }}</span>
                    </a>
                  </div>
                {% endif %}
                {% if section.settings.topbar_store != blank %}
                  <div class="d-flex">
                    <a href="{{ topbar_store_link | default:"/pages/store" }}" class="d-inline-flex align-items-center">
                      {% render 'icon-location' %}
                      <span class="pl-2">{{ section.settings.topbar_store }}</span>
                    </a>
                  </div>
                {% endif %}
                {% if section.settings.topbar_appointment != blank %}
                  <div class="d-flex" style="margin-top: -20px;">
                    <a
                      href="{{ topbar_page_appointment | default:"/pages/appointment" }}"
                      class="d-inline-flex align-items-center"
                    >
                      {% render 'icon-calendar' %}
                      <span class="pl-2">{{ section.settings.topbar_appointment }}</span>
                    </a>
                  </div>
                {% endif %}
              {%- endif -%}

              {%- if left_text != blank -%}
                <div class="d-flex">
                  <a
                    href="{{ left_link | default:'#' }}"
                    class="left-custom-link d-inline-flex align-items-center"
                    style="
                      margin-bottom: -22px;
    margin-left: -282px;
                    "
                  >
                    {%- if left_icon != blank -%}
                      <span class="pr-2">{{ left_icon | raw }}</span>
                    {%- endif -%}
                    {{ left_text }}
                  </a>
                </div>
              {%- endif -%}
            </div>

            <div class="col-lg-4 col-center col-12 text-center">
              {% if enable_marquee %}
                <div class="marquee-wrapper">
                  <div class="marquee-track">
                    <div class="marquee-group">
                      {% for block in section.blocks %}
                        <span class="center-block-content">
                          {{ block.settings.text }}

                          {% if block.settings.link != blank %}
                            <a href="{{ block.settings.link }}" class="link pl-2">
                              {{ block.settings.link_text | default: 'Shop Now' }}
                            </a>
                          {% endif %}

                          <span style="padding:0 30px;">|</span>
                        </span>
                      {% endfor %}
                    </div>

                    <div class="marquee-group">
                      {% for block in section.blocks %}
                        <span class="center-block-content">
                          {{ block.settings.text }}

                          {% if block.settings.link != blank %}
                            <a href="{{ block.settings.link }}" class="link pl-2">
                              {{ block.settings.link_text | default: 'Shop Now' }}
                            </a>
                          {% endif %}

                          <span style="padding:0 30px;">|</span>
                        </span>
                      {% endfor %}
                    </div>
                  </div>
                </div>

              {% else %}
                <div class="center-content-bar text-body">
                  {% for block in section.blocks %}
                    <span class="center-block-content">
                      {{- block.settings.text }}
                      {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}" class="link pl-1">
                          {{ block.settings.link_text | default: 'Shop Now' }}
                        </a>
                      {%- endif -%}
                    </span>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
            <div class="col-4 col-right text-right d-none d-lg-flex justify-content-end">
              {%- if right_text != blank -%}
                <div class="topbar-block d-flex align-items-center">
                  <a href="{{ right_link | default:'#' }}" class="right-custom-link d-inline-flex align-items-center">
                    {%- if right_icon != blank -%}
                      <span class="pr-2">{{ right_icon | raw }}</span>
                    {%- endif -%}
                    {{ right_text }}
                  </a>
                </div>
              {%- endif -%}

              {%- if enable_countdown -%}
                <div class="topbar-block d-flex">
                  {% if text_countdown != blank %}
                    <span class="mr-3"> {{ text_countdown }}</span>
                  {% endif %}
                  <countdown-timer
                    class="countdown-timer countdown-item"
                    data-time="{{ section.settings.data_countdown }}"
                  ></countdown-timer>
                </div>
              {%- endif -%}
              {% if enable_login_topbar %}
                {% if shop.customer_accounts_optional or shop.customer_accounts_enabled %}
                  {% if customer %}
                    <div class="header--acount d-none d-lg-inline-block topbar-block">
                      <a
                        href="/account"
                        title="{{ 'customer.account.title' | t }}"
                        class="site-header__link site-account "
                      >
                        <span class="account-text">{{ 'customer.account.title' | t }}</span>
                      </a>
                      |
                      <a
                        href="/account/logout"
                        title="{{ 'layout.customer.log_out' | t }}"
                        class="site-header__link site-logout "
                      >
                        <span class="logout-text">{{ 'layout.customer.log_out' | t }}</span>
                      </a>
                    </div>
                  {% else %}
                    {% if template != 'customers/login' %}
                      {% comment %} {% endcomment %}
                      <div class="header--acount d-none d-lg-inline-block topbar-block pr-3">
                        <a
                          href="javascript:void(0)"
                          data-toggle="modal"
                          data-target="#jsLogin"
                          class="site-header__link site-account js-open-login pr-2"
                        >
                          <span class="account-text">{{ 'customer.login.sign_in' | t }}</span>
                        </a>
                        /
                        <a href="/account/register" class="site-header__link site-register pl-2">
                          <span class="register-text">{{ 'customer.register.title' | t }}</span>
                        </a>
                      </div>
                    {% endif %}
                  {% endif %}
                {% endif %}
              {% endif %}
              {%- if enable_money_topbar and localization.available_countries.size > 1 -%}
                <div class="d-none d-sm-flex topbar-block text-left align-items-center">
                  {% render 'localization',
                    id: 'HeaderCountryForm',
                    margin: 'topbar',
                    enable_image: enable_image,
                    enable_name: enable_name
                  %}
                </div>
              {%- endif -%}
              {%- if enable_language_topbar and localization.available_languages.size > 1 -%}
                <div class="d-none d-sm-flex topbar-block text-left align-items-center">
                  {% render 'localization-language',
                    id: 'HeaderLanguageForm',
                    margin: 'topbar',
                    enable_name: enable_name
                  %}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </announcement-bar>

  <script>
    class AnnouncementBar extends HTMLElement {
      constructor() {
        super();
      }
      connectedCallback() {
        var rootElement = document.querySelector(':root');
        rootElement.style.setProperty('--height-announcementbar', this.offsetHeight + 'px');
      }
    }
    customElements.define('announcement-bar', AnnouncementBar);
  </script>
{%- endif -%}
