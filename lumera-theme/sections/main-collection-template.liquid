          line-height: 18px;
          font-weight: 400;
          color: #062f57;
          text-align: center;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }

        /* ARROWS */
        .diamond-shape-arrow {
          width: 36px;
          height: 36px;
          min-width: 36px;
          flex: 0 0 36px;
          display: flex;
          align-items: center;
          justify-content: center;
