      <script>
        (function () {
          function initDiamondShapeNavigation() {
            var wrappers = document.querySelectorAll('[data-diamond-shape-navigation]');

            if (!wrappers.length) return;

            wrappers.forEach(function (wrapper) {
              if (wrapper.dataset.initialized === 'true') {
                return;
              }

              wrapper.dataset.initialized = 'true';

              var slider = wrapper.querySelector('.diamond-shape-slider');
              var track = wrapper.querySelector('.diamond-shape-track');
              var prev = wrapper.querySelector('.diamond-shape-prev');
              var next = wrapper.querySelector('.diamond-shape-next');

              if (!slider || !track || !prev || !next) {
                return;
              }

              var position = 0;

              /* ITEM WIDTH */
              function getItemWidth() {
                var item = track.querySelector('.diamond-shape-item');

                if (!item) return 0;

                var style = window.getComputedStyle(track);
                var gap = parseFloat(style.columnGap || style.gap) || 0;

                return item.getBoundingClientRect().width + gap;
              }

              /* UPDATE SLIDER */
              function updateSlider() {
                var max = Math.max(0, track.scrollWidth - slider.clientWidth);

                position = Math.max(0, Math.min(position, max));

                track.style.transform = 'translate3d(-' + position + 'px,0,0)';

                prev.disabled = position <= 0;
                next.disabled = position >= max;

                if (max <= 1) {
                  prev.style.display = 'none';
                  next.style.display = 'none';
                } else {
                  prev.style.display = 'flex';
                  next.style.display = 'flex';
                }
              }

              /* NEXT */
              next.addEventListener(
                'click',
                function () {
                  var width = getItemWidth();

                  if (!width) return;

                  position += width * 4;

                  updateSlider();
                },
                { passive: true }
              );

              /* PREVIOUS */
              prev.addEventListener(
                'click',
                function () {
                  var width = getItemWidth();

                  if (!width) return;

                  position -= width * 4;

                  updateSlider();
                },
                { passive: true }
              );

              /* RESIZE */
              var resizeTimer;

              window.addEventListener('resize', function () {
                clearTimeout(resizeTimer);

                resizeTimer = setTimeout(updateSlider, 100);
              });

              updateSlider();
            });
          }

          /* INITIAL LOAD */
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initDiamondShapeNavigation);
          } else {
            initDiamondShapeNavigation();
          }

          /* SHOPIFY THEME EDITOR */
          document.addEventListener('shopify:section:load', function () {
            initDiamondShapeNavigation();
          });
        })();
      </script>
