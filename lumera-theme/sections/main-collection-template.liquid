    <div
      id="ProductGridContainer"
      {% if filter_type == 'vertical' and section.settings.enable_filtering %}
        {% if filter_check == 'drawer-collapse-left' %}
          class="col-12 px-0"
        {% else %}
          class="col-md-9 pl-lg-5"
        {% endif %}
      {% endif %}
    >
      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper text-center">
              <h2 class="title title--primary h3">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          {% comment %} <div class="collection {% if filter_type == 'vertical' %} pt-4 {% endif %}"> {% endcomment %}
          <div class="loading-overlay gradient"></div>

          <ul
            id="product-grid-{{ section.id }}"
            data-id="{{ section.id }}"
            class="
              grid grid--2-col product-grid row AjaxinateLoop
              {% if collection.products_count < 4 %} grid--{{ collection.products_count }}-col-tablet{% else %}
                {% if collection.products_count == 4 %} grid--4-col-desktop{% else %} grid--3-col-tablet grid--one-third-max grid--4-col-desktop grid--quarter-max{% endif %}
              {% endif %}
            "
          >
            {%- assign visible_product_count = 0 -%}

            {%- for product in collection.products -%}
              {%- assign is_premium_product = false -%}

              {%- for product_collection in product.collections -%}
                {%- if product_collection.handle == 'home-page-all' -%}
                  {%- assign is_premium_product = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              {%- unless is_premium_product and collection.handle != 'home-page-all' and customer == null -%}
                <li class="grid__item {{ gridProduct }}" data-product-id="{{ product.id }}">
                  {%- liquid
                    assign enable_edit_item = section.settings.enable_edit_item
                    assign select_item = section.settings.select_item
                  -%}

                  {%- render 'product-card',
                    product: product,
                    size_image_grid: size_image_grid,
                    cover_contain: cover_contain,
                    enable_edit_item: enable_edit_item,
                    select_item: select_item,
                    collection: collection
                  -%}
                </li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
          {% case type_pagi %}
            {% when 'click' %}
              <div
                id="AjaxinatePagination-{{ section.id }}"
                class="AjaxinatePagination text-center"
                data-pagination="click"
              >
                {%- liquid
                  assign numberitem = section.settings.products_per_page | times: paginate.current_page
                  assign getpage = numberitem | times: 100 | divided_by: paginate.items
                -%}
                {%- if numberitem <= paginate.items -%}
                  <div class="d-flex justify-content-center flex-column mb-4">
                    <p class="txt-body-60">
                      {{ 'general.pagination.viewed' | t: perpage: numberitem, numberitem: paginate.items }}
                    </p>

                    <div class="pagi-click mx-auto ">
                      <span
                        class="pagi-click-percent"
                        data-percent="{{ getpage }}"
                        style="width:{{ getpage }}%;"
                      ></span>
                    </div>
                  </div>
                {%- endif -%}
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="btn btn-outline">
                    {{- 'general.pagination.load_more' | t -}}
                  </a>
                {%- endif -%}
              </div>
            {% when 'scroll' %}
              <div
                id="AjaxinatePagination-{{ section.id }}"
                class="AjaxinatePagination text-center"
                data-pagination="scroll"
              >
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="btn btn-outline">
                    {{- 'general.pagination.load_more' | t -}}
                  </a>
                {%- endif -%}
              </div>
            {% else %}
              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
          {% endcase %}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% javascript %}
  (function () {
    window.removeDuplicateCollectionProducts = function () {
      var grid = document.querySelector('#ProductGridContainer .AjaxinateLoop');

      if (!grid) {
        return;
      }

      var seen = {};

      grid.querySelectorAll('[data-product-id]').forEach(function (item) {
        var productId = item.getAttribute('data-product-id');

        if (!productId) {
          return;
        }

        if (seen[productId]) {
          item.remove();
        } else {
          seen[productId] = true;
        }
      });
    };

    /* AJAXINATE STATE */
    window.collectionAjaxinateInstance = window.collectionAjaxinateInstance || null;

    /* DESTROY OLD AJAXINATE */
    window.destroyCollectionAjaxinate = function () {
      var instance = window.collectionAjaxinateInstance;

      if (!instance) {
        return;
      }

      try {
        if (typeof instance.destroy === 'function') {
          instance.destroy();
        }

        if (typeof instance.remove === 'function') {
          instance.remove();
        }
      } catch (error) {
        console.warn('Ajaxinate destroy warning:', error);
      }

      window.collectionAjaxinateInstance = null;

      document.querySelectorAll('.AjaxinatePagination[data-ajaxinate-initialized]').forEach(function (pagination) {
        pagination.removeAttribute('data-ajaxinate-initialized');
      });
    };

    /* INITIALIZE AJAXINATE */
    window.initCollectionAjaxinate = function () {
      if (typeof Ajaxinate === 'undefined') {
        return;
      }

      window.destroyCollectionAjaxinate();

      var productGridContainer = document.getElementById('ProductGridContainer');

      if (!productGridContainer) {
        return;
      }

      var pagination = productGridContainer.querySelector('.AjaxinatePagination[data-pagination]');

      if (!pagination) {
        return;
      }

      var container = productGridContainer.querySelector('.AjaxinateLoop');

      if (!container || !container.id) {
        return;
      }

      var paginationId = pagination.id;

      if (!paginationId) {
        return;
      }

      var type = pagination.getAttribute('data-pagination');

      try {
        var instance = new Ajaxinate({
          container: '#' + container.id,

          pagination: '#' + paginationId,

          loadingText: '<span class="loader-line"></span>',

          method: type === 'scroll' ? 'scroll' : 'click',

          callback: function () {
            /*
             * Naye AJAX se load hue products (13th product se aage)
             * par premium lock JS re-run karna zaroori hai,
             * warna wo products bina lock ke reh jate hain.
             */
            if (typeof window.initPremiumProductLock === 'function') {
              window.initPremiumProductLock();
            }

            if (typeof window.removeDuplicateCollectionProducts === 'function') {
              window.removeDuplicateCollectionProducts();
            }
          },
        });

        window.collectionAjaxinateInstance = instance;

        pagination.setAttribute('data-ajaxinate-initialized', 'true');
      } catch (error) {
        console.warn('Ajaxinate initialization error:', error);

        window.collectionAjaxinateInstance = null;
      }
    };

    /* INITIAL LOAD */
    function startCollectionAjaxinate() {
      setTimeout(function () {
        window.initCollectionAjaxinate();
      }, 300);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startCollectionAjaxinate);
    } else {
      startCollectionAjaxinate();
    }

    /* SHOPIFY THEME EDITOR */
    document.addEventListener('shopify:section:load', function () {
      setTimeout(function () {
        window.initCollectionAjaxinate();
      }, 300);
    });
  })();
{% endjavascript %}

