<script src="{{ 'ajaxinate.min.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign size_image_grid = settings.size_image_grid
  assign cover_contain = section.settings.cover_contain
  assign type_pagi = section.settings.type_pagination
  assign productPerrow = section.settings.collection_perrow
  assign filter_type = section.settings.filter_type

  if productPerrow == '2'
    assign gridProduct = 'js-col col-sm-6 col-6'
  elsif productPerrow == '3'
    assign gridProduct = 'js-col col-sm-6 col-6 col-lg-4'
  elsif productPerrow == '4'
    assign gridProduct = 'js-col col-sm-6 col-6 col-lg-3'
  elsif productPerrow == '5'
    assign gridProduct = 'js-col col-sm-6 col-6 col-lg-2-4'
  elsif productPerrow == '6'
    assign gridProduct = 'js-col col-sm-6 col-6 col-lg-2'
  endif

  case filter_type
    when 'drawer'
      assign filter_type = 'drawer'
    when 'drawer-slide-left'
      assign filter_type = 'drawer'
    when 'vertical'
      assign filter_type = 'vertical'
    when 'horizontal'
      assign filter_type = 'horizontal'
    when 'drawer-collapse-left'
      assign filter_type = 'vertical'
      assign filter_check = 'drawer-collapse-left'
    when 'drawer-collapse-right'
      assign filter_type = 'vertical'
      assign filter_check = 'drawer-collapse-left'
    else
      assign filter_type = 'vertical'
  endcase
-%}

<div
  class="main-collection section-{{ section.id }}-padding {{ section.settings.collection_width }} collection-{{ section.settings.filter_type }} {% if section.settings.filter_type == 'drawer-collapse-right' %} collection-drawer-collapse-left collection-drawer-collapse-right {% endif %}"
>
  {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
  {%- if section.settings.enable_sorting and filter_type == 'vertical' -%}
    <!--
      =========================================================
      DIAMOND SHAPE NAVIGATION
      LIGHTWEIGHT SHOPIFY FILTER VERSION
      =========================================================
    -->

    {% assign shape_filter = blank %}

    {% for filter in collection.filters %}
      {% assign filter_label = filter.label | downcase | strip %}

      {% if filter_label == 'diamond shape' or filter_label == 'stone shape' %}
        {% assign shape_filter = filter %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if shape_filter != blank and shape_filter.values.size > 0 %}
      <div
        class="diamond-shape-wrapper"
        data-diamond-shape-navigation
      >
        <!-- PREVIOUS -->
        <button
          type="button"
          class="diamond-shape-arrow diamond-shape-prev"
          aria-label="Previous shapes"
        >
          ‹
        </button>

        <!-- SHAPE SLIDER -->
        <div class="diamond-shape-slider">
          <div class="diamond-shape-track">
            {% for matched_value in shape_filter.values %}
              {% assign shape = matched_value.label | strip %}
              {% assign shape_handle = shape | handleize %}

              <a
                href="{% if matched_value.active %}{{ matched_value.url_to_remove }}{% else %}{{ matched_value.url_to_add }}{% endif %}"
                class="
                  diamond-shape-item
                  {% if matched_value.active %}active{% endif %}
                "
                data-shape="{{ shape_handle }}"
                data-active="{% if matched_value.active %}true{% else %}false{% endif %}"
              >
                <div class="diamond-shape-image">
                  <img
                    src="{{ shape_handle | append: '.png' | asset_url }}"
                    alt="{{ shape | escape }}"
                    width="60"
                    height="60"
                    loading="lazy"
                  >
                </div>

                <span>
                  {{ shape }}
                </span>
              </a>
            {% endfor %}
          </div>
        </div>

        <!-- NEXT -->
        <button
          type="button"
          class="diamond-shape-arrow diamond-shape-next"
          aria-label="Next shapes"
        >
          ›
        </button>
      </div>

      <style>
        /* MAIN */
        .diamond-shape-wrapper {
          width: 100%;
          display: flex;
          align-items: center;
          gap: 18px;
          padding: 28px 45px 25px;
          background: #fef8f1;
          box-sizing: border-box;
          overflow: hidden;
        }

        /* SLIDER */
        .diamond-shape-slider {
          flex: 1;
          min-width: 0;
          overflow: hidden;
        }

        .diamond-shape-track {
          display: flex;
          align-items: stretch;
          gap: 30px;
          width: max-content;
          transition: transform .25s ease;
          will-change: transform;
        }

        /* ITEM */
        .diamond-shape-item {
          width: 92px;
          min-width: 92px;
          height: 106px;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          padding: 7px 5px;
          box-sizing: border-box;
          text-decoration: none !important;
          color: #062f57;
          background: transparent;
          transition: background .2s ease, transform .2s ease;
        }

        /* HOVER */
        .diamond-shape-item:hover {
          background: #f1f7fa;
          text-decoration: none !important;
        }

        /* ACTIVE */
        .diamond-shape-item.active {
          background: #e8f2f6;
        }

        .diamond-shape-item.active .diamond-shape-image {
          transform: scale(1.05);
        }

        .diamond-shape-item.active span {
          font-weight: 600;
        }

        /* IMAGE */
        .diamond-shape-image {
          width: 65px;
          height: 65px;
          display: flex;
          align-items: center;
          justify-content: center;
          margin-bottom: 6px;
          transition: transform .2s ease;
        }

        .diamond-shape-image img {
          display: block;
          width: 104px !important;
          height: 90px !important;
          max-width: 111px !important;
          max-height: 137px !important;
          object-fit: contain;
          margin: 0 !important;
          padding: 0 !important;
          border: 0 !important;
          box-shadow: none !important;
        }

        /* TEXT */
        .diamond-shape-item span {
