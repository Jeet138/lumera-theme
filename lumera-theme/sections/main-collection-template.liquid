      <script>
        (function () {
          var raf;

          function placeWhyLumera() {
            var aside = document.getElementById('main-collection-filters');
            var box = document.getElementById('why-lumera-box');
            if (!aside || !box) return;

            /* sabse neeche wala top-level filter group (nested wale ignore) */
            var groups = aside.querySelectorAll('.facets__disclosure-vertical');
            var last = null;
            for (var i = groups.length - 1; i >= 0; i--) {
              var g = groups[i];
              if (box.contains(g)) continue;
              if (g.parentElement && g.parentElement.closest('.facets__disclosure-vertical')) continue;
              last = g;
              break;
            }

            if (last) {
              var anchor = last;
              if (anchor.parentElement && anchor.parentElement.tagName === 'UL') {
                anchor = anchor.parentElement;
              }
              /* box ko last filter ke turant baad, usi flow me rakho */
              if (anchor.nextElementSibling !== box) {
                anchor.insertAdjacentElement('afterend', box);
              }
            }

            box.classList.add('is-ready');
          }

          function schedule() {
            cancelAnimationFrame(raf);
            raf = requestAnimationFrame(placeWhyLumera);
          }

          function init() {
            var aside = document.getElementById('main-collection-filters');
            if (!aside) return;

            placeWhyLumera();

            /* AJAX filter se sidebar re-render ho to box wapas sahi jagah */
            new MutationObserver(schedule).observe(aside, { childList: true });
            var container = aside.querySelector('.facets-container') || aside;
            new MutationObserver(schedule).observe(container, { childList: true, subtree: true });

            /* agar kabhi placement fail ho, box chhupa na rahe */
            setTimeout(function () {
              var box = document.getElementById('why-lumera-box');
              if (box) box.classList.add('is-ready');
            }, 1500);
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
          } else {
            init();
          }

          document.addEventListener('shopify:section:load', init);
        })();
      </script>

      <style>
        /* =========================================================
           DESKTOP FILTER SIDEBAR - STICKY
           ========================================================= */
