  @prompt
    Shop by shape create section, this typ create shop by shape, are muje shop by shape without framing chiaye or smaall size me , muje Round oval radiant emerald cusion pear marquies sirf chiaye withoud white backgroaund
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shape-clean-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-shape-clean-container-{{ ai_gen_id }} {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .ai-shape-clean-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-shape-clean-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    margin: 0 0 8px;
    font-size: {{ block.settings.heading_size }}px;
    text-transform: {{ block.settings.heading_transform }};
    font-weight: {{ block.settings.heading_weight }};
  }

  .ai-shape-clean-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    margin: 0;
    font-size: {{ block.settings.subheading_size }}px;
  }

  .ai-shape-clean-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-shape-clean-item-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-shape-clean-link-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .ai-shape-clean-link-{{ ai_gen_id }}:hover {
    transform: translateY(-3px);
  }

  .ai-shape-clean-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.image_size }}px;
    margin-bottom: {{ block.settings.image_spacing }}px;
  }

  .ai-shape-clean-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-shape-clean-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .ai-shape-clean-link-{{ ai_gen_id }}:hover .ai-shape-clean-image-{{ ai_gen_id }} {
    transform: scale(1.08);
  }

  .ai-shape-clean-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-shape-clean-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.1;
  }

  .ai-shape-clean-content-{{ ai_gen_id }} {
    text-align: center;
    width: 100%;
  }

  .ai-shape-clean-title-{{ ai_gen_id }} {
    color: {{ block.settings.label_color }};
    font-size: {{ block.settings.label_size }}px;
    font-weight: {{ block.settings.label_weight }};
    text-transform: {{ block.settings.label_transform }};
    margin: 0;
    transition: color 0.3s ease;
  }

  .ai-shape-clean-link-{{ ai_gen_id }}:hover .ai-shape-clean-title-{{ ai_gen_id }} {
    color: {{ block.settings.label_hover_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-shape-clean-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-shape-clean-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-shape-clean-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-shape-clean-image-wrapper-{{ ai_gen_id }} {
      max-width: {{ block.settings.image_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<shape-clean-{{ ai_gen_id }} class="ai-shape-clean-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shape-clean-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-shape-clean-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-shape-clean-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-shape-clean-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <ul class="ai-shape-clean-grid-{{ ai_gen_id }}">
      {% for i in (1..7) %}
        {% liquid
          assign shape_name_key = 'shape_' | append: i | append: '_name'
          assign shape_image_key = 'shape_' | append: i | append: '_image'
          assign shape_link_key = 'shape_' | append: i | append: '_link'
          
          assign shape_name = block.settings[shape_name_key]
          assign shape_image = block.settings[shape_image_key]
          assign shape_link = block.settings[shape_link_key]
        %}

        {% if shape_name != blank %}
          <li class="ai-shape-clean-item-{{ ai_gen_id }}">
            <a href="{{ shape_link }}" class="ai-shape-clean-link-{{ ai_gen_id }}" aria-label="Shop {{ shape_name }} shape diamonds">
              <div class="ai-shape-clean-image-wrapper-{{ ai_gen_id }}">
                <div class="ai-shape-clean-image-container-{{ ai_gen_id }}">
                  {% if shape_image %}
                    <img
                      src="{{ shape_image | image_url: width: 300 }}"
                      alt="{{ shape_name | escape }}"
                      class="ai-shape-clean-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="300"
                      height="300"
                    >
                  {% else %}
                    <div class="ai-shape-clean-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
              </div>
              <div class="ai-shape-clean-content-{{ ai_gen_id }}">
                <h3 class="ai-shape-clean-title-{{ ai_gen_id }}">{{ shape_name }}</h3>
              </div>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</shape-clean-{{ ai_gen_id }}>

<script>
  (function() {
    class ShapeClean{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('shape-clean-{{ ai_gen_id }}', ShapeClean{{ ai_gen_id }});
  })();
</script>

