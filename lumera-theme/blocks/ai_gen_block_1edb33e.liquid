{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-collection-grid__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-collection-grid__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-collection-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collection-grid__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-collection-grid__link-{{ ai_gen_id }} {
    display: block;
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .ai-collection-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: hidden;
    {% comment %} background-color: #f4f4f4; {% endcomment %}
  }

  .ai-collection-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 73%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
    transform: scale(1.1);
  }

  .ai-collection-grid__link-{{ ai_gen_id }}:hover .ai-collection-grid__image-{{ ai_gen_id }} {
    transform: scale(1);
  }

  .ai-collection-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-collection-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-grid__title-wrapper-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: {{ block.settings.title_bg_color }};
    padding: {{ block.settings.title_padding }}px;
  }

  .ai-collection-grid__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    margin: 0;
    text-align: {{ block.settings.title_alignment }};
    text-transform: {{ block.settings.title_transform }};
    line-height: 1.3;
  }

@media screen and (max-width: 749px) {

  .ai-collection-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding | times: 0.6 }}px 0;
  }

  .ai-collection-grid__container-{{ ai_gen_id }}{
    padding: 0 12px;
  }

  .ai-collection-grid__grid-{{ ai_gen_id }}{
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    gap: 6px;

    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;

    scrollbar-width: none;
    -ms-overflow-style: none;

    grid-template-columns: unset;
  }

  .ai-collection-grid__grid-{{ ai_gen_id }}::-webkit-scrollbar{
    display: none;
  }

  .ai-collection-grid__item-{{ ai_gen_id }}{
    flex: 0 0 32%;
    min-width: 20%;
    scroll-snap-align: start;
  }

  .ai-collection-grid__image-wrapper-{{ ai_gen_id }}{
    height: {{ block.settings.image_height | times: 0.6 }}px;
  }

  .ai-collection-grid__image-{{ ai_gen_id }}{
    width:100%;
    height:95%;
    object-fit: contain;
    object-position: center;
    transform: none;
  }

  .ai-collection-grid__link-{{ ai_gen_id }}:hover .ai-collection-grid__image-{{ ai_gen_id }}{
    transform:none;
  }

  .ai-collection-grid__heading-{{ ai_gen_id }}{
    font-size: calc({{ block.settings.heading_size }}px * 0.7);
    margin-bottom: {{ block.settings.heading_spacing | times: 0.7 }}px;
  }

  .ai-collection-grid__title-wrapper-{{ ai_gen_id }}{
    position:absolute;
    bottom:0;
    left:0;
    right:0;
    padding:8px;
    background:rgba(255,255,255,.9);
  }

  .ai-collection-grid__title-{{ ai_gen_id }}{
    font-size:13px;
    text-align:center;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }

}
{% endstyle %}

<collection-grid-{{ ai_gen_id }} class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-grid__container-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}
      <h2 class="ai-collection-grid__heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
    {% endif %}

    <div class="ai-collection-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}

        {% if collection != blank %}
          <div class="ai-collection-grid__item-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-collection-grid__link-{{ ai_gen_id }}">
              <div class="ai-collection-grid__image-wrapper-{{ ai_gen_id }}">
                {% if collection.image %}
                  <img
                    src="{{ collection.image | image_url: width: 600 }}"
                    alt="{{ collection.title | escape }}"
                    class="ai-collection-grid__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ block.settings.image_height }}"
                  >
                {% elsif collection.products.first and collection.products.first.featured_image %}
                  <img
                    src="{{ collection.products.first.featured_image | image_url: width: 600 }}"
                    alt="{{ collection.title | escape }}"
                    class="ai-collection-grid__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ block.settings.image_height }}"
                  >
                {% else %}
                  <div class="ai-collection-grid__placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                <div class="ai-collection-grid__title-wrapper-{{ ai_gen_id }}">
                  <h3 class="ai-collection-grid__title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                </div>
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initAccessibility();
      }

      initAccessibility() {
        const links = this.querySelectorAll('.ai-collection-grid__link-{{ ai_gen_id }}');
        links.forEach(link => {
          const title = link.querySelector('.ai-collection-grid__title-{{ ai_gen_id }}');
          if (title) {
            link.setAttribute('aria-label', `Shop ${title.textContent.trim()} collection`);
          }
        });
      }
    }

    customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
  })();
</script>

