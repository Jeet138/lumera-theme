{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-category-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    display: block;
  }

  .ai-shop-category-container-{{ ai_gen_id }} {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .ai-shop-category-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.title_spacing }}px;
  }

  .ai-shop-category-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 400;
    color: #000000;
    margin: 0 0 20px;
    text-transform: capitalize;
    letter-spacing: -0.02em;
  }

  .ai-shop-category-divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_height }}px;
    background-color: {{ block.settings.divider_color }};
    margin: 0 auto;
  }

  .ai-shop-category-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_spacing }}px;
  }

  .ai-shop-category-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  .ai-shop-category-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f6f4f3;
  }

  .ai-shop-category-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ai-shop-category-card-{{ ai_gen_id }}:hover .ai-shop-category-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-shop-category-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f6f4f3;
  }

  .ai-shop-category-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-shop-category-name-{{ ai_gen_id }} {
    margin-top: {{ block.settings.name_spacing }}px;
    font-size: {{ block.settings.name_size }}px;
    font-weight: 400;
    color: #000000;
    text-transform: capitalize;
    letter-spacing: 0.02em;
    transition: color 0.3s ease;
  }

  .ai-shop-category-card-{{ ai_gen_id }}:hover .ai-shop-category-name-{{ ai_gen_id }} {
    color: {{ block.settings.name_hover_color }};
  }

  .ai-shop-category-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-shop-category-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap_mobile }}px;
    }

    .ai-shop-category-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-shop-category-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.name_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-shop-category-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shop-category-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <div class="ai-shop-category-header-{{ ai_gen_id }}">
        <h2 class="ai-shop-category-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% if block.settings.show_divider %}
          <div class="ai-shop-category-divider-{{ ai_gen_id }}"></div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-shop-category-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign category_image_key = 'category_image_' | append: i
          assign category_name_key = 'category_name_' | append: i
          assign category_link_key = 'category_link_' | append: i

          assign category_image = block.settings[category_image_key]
          assign category_name = block.settings[category_name_key]
          assign category_link = block.settings[category_link_key]
        %}

        {% if category_name != blank or category_image != blank %}
          <div class="ai-shop-category-card-{{ ai_gen_id }}">
            {% if category_link != blank %}
              <a href="{{ category_link }}" class="ai-shop-category-link-{{ ai_gen_id }}">
            {% else %}
              <div class="ai-shop-category-link-{{ ai_gen_id }}">
            {% endif %}

              <div class="ai-shop-category-image-wrapper-{{ ai_gen_id }}">
                {% if category_image != blank %}
                  <img
                    src="{{ category_image | image_url: width: 600 }}"
                    alt="{{ category_name | escape }}"
                    class="ai-shop-category-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                  >
                {% else %}
                  <div class="ai-shop-category-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              {% if category_name != blank %}
                <div class="ai-shop-category-name-{{ ai_gen_id }}">{{ category_name }}</div>
              {% endif %}

            {% if category_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

