    {
      "type": "range",
      "id": "mobile_content_padding",
      "label": "Content padding",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "About us"
    }
  ]
}
{% endschema %}
