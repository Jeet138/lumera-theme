{% doc %}
  @prompt
    Create a fully customizable two-column section with an image slider, inspired by a jewelry custom design layout.
    
    Layout:
    
    Left side (on desktop): Text content block.
    
    Right side: Image carousel/slider showing “Reference” and “Reality” images.
    
    On mobile: Stack vertically (slider on top, text below).
    
    Text Content (fully editable):
    
    Editable heading (e.g., “Your Perfect Ring, Made to Order.”).
    
    Editable subheading/paragraph (1–3 lines, describing the customization process).
    
    Editable button (text, color, link).
    
    Image Slider (fully editable):
    
    Upload multiple image pairs (Reference and Reality).
    
    Each slide should display two images side by side (Reference + Reality) with small editable labels on top.
    
    Option to add or remove slides.
    
    Optional navigation arrows or swipe gestures for mobile.
    
    Design & Styling Controls:
    
    Option to change background color (e.g., deep navy, white, or gradient).
    
    Adjustable text color, font size, and alignment.
    
    Adjustable padding and spacing between text and slider.
    
    Option to round image corners or add subtle shadows.
    
    Responsive and adaptive to all screen sizes.
    
    Goal:
    A modern, luxury-themed section suitable for a jewelry brand, where users can showcase before-and-after or reference vs real product photos, with full customization in Shopify editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
    .ai-custom-design-section-{{ ai_gen_id }} {
      background-color: {{ block.settings.background_color }};
      padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    }

    .ai-custom-design-container-{{ ai_gen_id }} {
      max-width: {{ block.settings.container_width }}px;
      margin: 0 auto;
      background: #00254E;
      padding: 20px {{ block.settings.horizontal_padding }}px;
      }

      .ai-custom-design-grid-{{ ai_gen_id }} {
        display: flex;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: {{ block.settings.column_gap }}px;
        align-items: stretch;
        max-width: 1400px;
        margin: 0 auto;
      }

      .ai-custom-design-text-{{ ai_gen_id }} {
        padding: {{ block.settings.text_padding }}px;
        color: {{ block.settings.text_color }};
        max-width: 416px;
        {% case block.settings.text_alignment %}
          {% when 'center' %}
            margin-left: auto;
            margin-right: auto;
          {% when 'right' %}
            margin-left: auto;
            margin-right: 0;
          {% else %}
            margin-left: 0;
            margin-right: auto;
        {% endcase %}
      }

      .ai-custom-design-heading-{{ ai_gen_id }} {
        color: {{ block.settings.heading_color }};
        font-size: {{ block.settings.heading_size }}px;
        line-height: 1.1;
        margin: 0 0 {{ block.settings.heading_spacing }}px;
        text-align: {{ block.settings.text_alignment }};
      }

      .ai-custom-design-subheading-{{ ai_gen_id }} {
        color: {{ block.settings.text_color }};
        font-size: {{ block.settings.text_size }}px;
        line-height: 1.8;
        margin: 0 0 {{ block.settings.text_spacing }}px;
        text-align: {{ block.settings.text_alignment }};
        opacity: 0.85;
      }

      .ai-custom-design-subheading-{{ ai_gen_id }} p {
        margin: 0 10px 20px 0;
        color: #fff;
        line-height: 1.6;
        text-align: left;
      }

      .ai-custom-design-button-wrapper-{{ ai_gen_id }} {
        text-align: {{ block.settings.text_alignment }};
        margin-top: 8px;
      }

      .ai-custom-design-button-{{ ai_gen_id }} {
        display: inline-block;
        padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
        background-color: {{ block.settings.button_bg_color }};
        color: {{ block.settings.button_text_color }};
        text-decoration: none;
        border-radius: {{ block.settings.button_border_radius }}px;
        font-size: {{ block.settings.button_text_size }}px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
      }

      .ai-custom-design-button-{{ ai_gen_id }}:hover {
        background-color: {{ block.settings.button_hover_bg_color }};
        color: {{ block.settings.button_hover_text_color }};
      }

      .ai-custom-design-slider-wrapper-{{ ai_gen_id }} {
        position: relative;
        overflow: hidden;
        border-radius: {{ block.settings.slider_panel_radius }}px;
        padding: {{ block.settings.slider_panel_padding }}px 2px;
        background: {{ block.settings.slider_panel_background }};
        {% if block.settings.enable_shadow %}
          box-shadow: 0 {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(1, 18, 44, {{ block.settings.shadow_opacity }});
        {% endif %}
      }

      .ai-custom-design-slider-{{ ai_gen_id }} {
        position: relative;
        width: 100%;
      }

      .ai-custom-design-slide-{{ ai_gen_id }} {
        display: none;
        width: 100%;
      }

      .ai-custom-design-slide-{{ ai_gen_id }}.active {
        display: block;
      }

     .ai-custom-design-pair-grid-{{ ai_gen_id }} {
    display: grid;
    {% comment %} grid-template-columns: repeat(4, minmax(0, 1fr)); {% endcomment %}
    grid-template-columns: 1fr 1fr 20px 1fr 1fr;
    gap: {{ block.settings.image_gap }}px;
    {% comment %} align-items: stretch; {% endcomment %}
    {% comment %} width: 100%; {% endcomment %}
    {% comment %} height: auto; {% endcomment %}
  }

  .ai-custom-design-pair-grid-{{ ai_gen_id }} .ai-custom-design-image-container-{{ ai_gen_id }}:nth-child(1) { grid-column: 1 }
  .ai-custom-design-pair-grid-{{ ai_gen_id }} .ai-custom-design-image-container-{{ ai_gen_id }}:nth-child(2) { grid-column: 2 }
  .ai-custom-design-pair-grid-{{ ai_gen_id }} .ai-custom-design-image-container-{{ ai_gen_id }}:nth-child(3) { grid-column: 3 }
  .ai-custom-design-pair-grid-{{ ai_gen_id }} .ai-custom-design-image-container-{{ ai_gen_id }}:nth-child(3) { grid-column: 4 }

  .ai-custom-design-slide-{{ ai_gen_id }} + .ai-custom-design-slide-{{ ai_gen_id }} {
     margin-top: {{ block.settings.image_gap | times: 4 }}px;
  }

  .ai-custom-design-image-container-{{ ai_gen_id }} {
       position: relative;
      overflow: hidden;
      border-radius: {{ block.settings.image_border_radius }}px;
      max-height: 280px;
      width: 100%;
      max-width: none;
  }

  .ai-custom-design-image-label-{{ ai_gen_id }} {
        position: absolute;
        top: {{ block.settings.label_position_top }}px;
        left: {{ block.settings.label_position_left }}px;
        background-color: {{ block.settings.label_bg_color }};
        color: {{ block.settings.label_text_color }};
        padding: {{ block.settings.label_padding_vertical }}px {{ block.settings.label_padding_horizontal }}px;
        font-size: {{ block.settings.label_text_size }}px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border-radius: {{ block.settings.label_border_radius }}px;
        z-index: 2;
        line-height: 130%;
        min-width: 78px;
    }

    .ai-custom-design-image-{{ ai_gen_id }} {
        width: 100%;
        aspect-ratio: {{ block.settings.image_aspect_ratio }};
        object-fit: cover;
        display: block;
    }

    .ai-custom-design-image-placeholder-{{ ai_gen_id }} {
        width: 100%;
        aspect-ratio: {{ block.settings.image_aspect_ratio }};
        background-color: #f4f4f4;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: {{ block.settings.image_border_radius }}px;
        position: relative;
    }

    .ai-custom-design-image-placeholder-{{ ai_gen_id }} svg {
        width: 60%;
        height: 60%;
        opacity: 0.3;
    }

    .ai-custom-design-empty-state-{{ ai_gen_id }} {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 14px;
        color: #666;
        text-align: center;
        pointer-events: none;
    }

    .ai-custom-design-nav-{{ ai_gen_id }} {
        position: absolute;
        top: auto;
        bottom: 55px;
        right: {{ block.settings.arrow_position }}px;
        transform: none;
        background-color: {{ block.settings.arrow_bg_color }};
        color: {{ block.settings.arrow_color }};
        border: 1px solid rgba(255, 255, 255, 0.3);
        width: {{ block.settings.arrow_size }}px;
        height: {{ block.settings.arrow_size }}px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 3;
        transition: all 0.3s ease;
        box-shadow: 0 12px 24px rgba(1, 21, 56, 0.25);
    }

    .ai-custom-design-nav-{{ ai_gen_id }}:hover {
        background-color: {{ block.settings.arrow_hover_bg_color }};
        color: {{ block.settings.arrow_hover_color }};
    }

    .ai-custom-design-nav-prev-{{ ai_gen_id }} {
        right: calc({{ block.settings.arrow_position }}px + {{ block.settings.arrow_size }}px + 16px);
    }

    .ai-custom-design-nav-next-{{ ai_gen_id }} {
        right: {{ block.settings.arrow_position }}px;
    }

    .ai-custom-design-dots-{{ ai_gen_id }} {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 20px;
    }

    .ai-custom-design-dot-{{ ai_gen_id }} {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: {{ block.settings.dot_color }};
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .ai-custom-design-dot-{{ ai_gen_id }}.active {
        background-color: {{ block.settings.dot_active_color }};
        transform: scale(1.2);
    }

      @media screen and (max-width: 768px) {

        .ai-custom-design-grid-{{ ai_gen_id }} {
            display: flex;
            flex-direction: column-reverse;
        }

        .ai-custom-design-pair-grid-{{ ai_gen_id }} {
         display: grid;
         grid-template-columns: 1fr;
         gap: {{ block.settings.image_gap }}px;
        }

      .ai-custom-design-heading-{{ ai_gen_id }} p {
          margin: 0 auto 8px;
          line-height: 1.4;
          display: flex;
          justify-content: center;
          text-align: center !important;
      }

      .ai-custom-design-subheading-{{ ai_gen_id }} p {
        font-size: 14px;
        justify-content: center;
        text-align: center !important;
      }

      .ai-custom-design-button-{{ ai_gen_id }} {
        text-align: center;
        font-size: 16px;
      }

      .ai-custom-design-container-{{ ai_gen_id }} {
        padding: 0px 10px;
      }

      .ai-custom-design-heading-{{ ai_gen_id }} p {
        font-size: 20px;
        line-height: 1.3;
        margin-top: -24px;
      }

      .ai-custom-design-slider-wrapper-{{ ai_gen_id }} {
        padding: 14px 0px;
      }
      }

      .ai-custom-design-heading-{{ ai_gen_id }} h4 {
        color: #fff !important;
        line-height: 1;
        font-size: 27px;
      }

{% endstyle %}

<custom-design-slider-{{ ai_gen_id }}
  class="ai-custom-design-section-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.enable_autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-custom-design-container-{{ ai_gen_id }}">
    <div class="ai-custom-design-grid-{{ ai_gen_id }}">
      <div class="ai-custom-design-text-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <div class="ai-custom-design-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</div>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <div class="ai-custom-design-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <div class="ai-custom-design-button-wrapper-{{ ai_gen_id }}">
            <a href="{{ block.settings.button_link }}" class="ai-custom-design-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          </div>
        {% endif %}
      </div>

      <div class="ai-custom-design-slider-wrapper-{{ ai_gen_id }}">
        <div class="ai-custom-design-slider-{{ ai_gen_id }}">
          {% assign pair_count = 0 %}
          {% assign slide_index = 0 %}
          {% assign slide_open = 'false' %}

          {% for i in (1..5) %}
            {% liquid
              assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
              assign reference_image_key = 'slide_' | append: i | append: '_reference_image'
              assign reality_image_key = 'slide_' | append: i | append: '_reality_image'
              assign reference_label_key = 'slide_' | append: i | append: '_reference_label'
              assign reality_label_key = 'slide_' | append: i | append: '_reality_label'

              assign slide_enabled = block.settings[slide_enabled_key]
              assign reference_image = block.settings[reference_image_key]
              assign reality_image = block.settings[reality_image_key]
              assign reference_label = block.settings[reference_label_key]
              assign reality_label = block.settings[reality_label_key]
            %}

            {% if slide_enabled %}
              {% assign pair_count = pair_count | plus: 1 %}
              {% assign pair_mod = pair_count | modulo: 2 %}

              {% if slide_open == 'false' %}
                {% assign slide_index = slide_index | plus: 1 %}
                <div
                  class="ai-custom-design-slide-{{ ai_gen_id }}{% if slide_index == 1 %} active{% endif %}"
                  data-slide="{{ slide_index }}"
                >
                  <div class="ai-custom-design-pair-grid-{{ ai_gen_id }}">
                    {% assign slide_open = 'true' %}
              {% endif %}

              <div class="ai-custom-design-image-container-{{ ai_gen_id }}">
                {% if reference_label != blank %}
                  <div class="ai-custom-design-image-label-{{ ai_gen_id }}">{{ reference_label }}</div>
                {% endif %}
                {% if reference_image %}
                  <img
                    src="{{ reference_image | image_url: width: 900 }}"
                    alt="{{ reference_label | escape }}"
                    class="ai-custom-design-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ reference_image.width }}"
                    height="{{ reference_image.height }}"
                  >
                {% else %}
                  <div class="ai-custom-design-image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                    <div class="ai-custom-design-empty-state-{{ ai_gen_id }}">Add reference image</div>
                  </div>
                {% endif %}
              </div>

              <div class="ai-custom-design-image-container-{{ ai_gen_id }}">
                {% if reality_label != blank %}
                  <div class="ai-custom-design-image-label-{{ ai_gen_id }}">{{ reality_label }}</div>
                {% endif %}
                {% if reality_image %}
                  <img
                    src="{{ reality_image | image_url: width: 900 }}"
                    alt="{{ reality_label | escape }}"
                    class="ai-custom-design-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ reality_image.width }}"
                    height="{{ reality_image.height }}"
                  >
                {% else %}
                  <div class="ai-custom-design-image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                    <div class="ai-custom-design-empty-state-{{ ai_gen_id }}">Add reality image</div>
                  </div>
                {% endif %}
              </div>

              {% if pair_mod == 0 %}
                </div>
                </div>
                {% assign slide_open = 'false' %}
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if slide_open == 'true' %}
            </div>
            </div>
          {% endif %}
        </div>

        {% if block.settings.show_arrows %}
          <button
            class="ai-custom-design-nav-{{ ai_gen_id }} ai-custom-design-nav-prev-{{ ai_gen_id }}"
            aria-label="Previous slide"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            class="ai-custom-design-nav-{{ ai_gen_id }} ai-custom-design-nav-next-{{ ai_gen_id }}"
            aria-label="Next slide"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        {% endif %}

        {% if block.settings.show_dots %}
          <div class="ai-custom-design-dots-{{ ai_gen_id }}"></div>
        {% endif %}
      </div>
    </div>
  </div>
</custom-design-slider-{{ ai_gen_id }}>

<script>
  (function () {
    const sliderSuffix = '{{ ai_gen_id }}';
    const sliderTag = `custom-design-slider-${sliderSuffix}`;
    const selectors = {
      slides: `.ai-custom-design-slide-${sliderSuffix}`,
      prev: `.ai-custom-design-nav-prev-${sliderSuffix}`,
      next: `.ai-custom-design-nav-next-${sliderSuffix}`,
      dots: `.ai-custom-design-dots-${sliderSuffix}`,
    };
    const classNames = {
      dot: `ai-custom-design-dot-${sliderSuffix}`,
    };

    if (customElements.get(sliderTag)) {
      return;
    }

    class CustomDesignSlider extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slides = this.querySelectorAll(selectors.slides);
        this.prevButton = this.querySelector(selectors.prev);
        this.nextButton = this.querySelector(selectors.next);
        this.dotsContainer = this.querySelector(selectors.dots);
        this.autoplayEnabled = this.dataset.autoplay === 'true';
        this.autoplaySpeed = Number(this.dataset.autoplaySpeed || 5);

        if (!this.slides.length) {
          return;
        }

        this.setupDots();
        this.setupEventListeners();
        this.setupSwipe();
        this.updateArrowStates();

        if (this.autoplayEnabled) {
          this.startAutoplay();
        }
      }

      setupDots() {
        if (!this.dotsContainer) {
          return;
        }

        this.dotsContainer.innerHTML = '';

        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add(classNames.dot);
          if (index === 0) {
            dot.classList.add('active');
          }
          dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });

        this.dots = this.dotsContainer.querySelectorAll(`.${classNames.dot}`);
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }
      }

      setupSwipe() {
        let startX = 0;
        let endX = 0;

        this.addEventListener('touchstart', (event) => {
          startX = event.touches[0].clientX;
        });

        this.addEventListener('touchmove', (event) => {
          endX = event.touches[0].clientX;
        });

        this.addEventListener('touchend', () => {
          if (startX - endX > 50) {
            this.nextSlide();
          } else if (endX - startX > 50) {
            this.previousSlide();
          }
        });
      }

      goToSlide(index) {
        if (!this.slides[index]) {
          return;
        }

        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.dots) {
          this.dots[this.currentSlide].classList.add('active');
        }

        this.resetAutoplay();
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.goToSlide(nextIndex);
      }

      previousSlide() {
        const prevIndex = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.goToSlide(prevIndex);
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed * 1000);
      }

      resetAutoplay() {
        if (!this.autoplayEnabled) {
          return;
        }

        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define(sliderTag, CustomDesignSlider);
  })();
</script>

{% schema %}
{
  "name": "Custom design showcase",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 0,
      "max": 3000,
      "step": 50,
      "unit": "px",
      "label": "Container width",
      "default": 1500
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Column gap",
      "default": 60
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#012a5a"
    },
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Your Perfect Ring, <br> Made to Order.</p>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#fff"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading spacing",
      "default": 24
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Description",
      "default": "<p>From stone to setting, we craft every ring by hand, just the way you want it. Choose your design, personalize every detail, and see it come to life with updates at every step.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 18
