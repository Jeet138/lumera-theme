{% doc %}
  @prompt
    create a video section single big size video section 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-video-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-video-container-{{ ai_gen_id }} video,
  .ai-video-container-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-video-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px;
    z-index: 2;
    pointer-events: none;
  }

  .ai-video-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .ai-video-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .ai-video-play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    background-color: {{ block.settings.play_button_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, opacity 0.3s ease;
    pointer-events: auto;
  }

  .ai-video-play-button-{{ ai_gen_id }}:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ai-video-play-button-{{ ai_gen_id }} svg {
    width: 32px;
    height: 32px;
    fill: {{ block.settings.play_button_icon_color }};
    margin-left: 4px;
  }

  .ai-video-play-button-{{ ai_gen_id }}.ai-hidden-{{ ai_gen_id }} {
    opacity: 0;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-video-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-video-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-video-play-button-{{ ai_gen_id }} {
      width: 60px;
      height: 60px;
    }

    .ai-video-play-button-{{ ai_gen_id }} svg {
      width: 24px;
      height: 24px;
    }
  }
{% endstyle %}

<video-section-{{ ai_gen_id }} class="ai-video-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-container-{{ ai_gen_id }}">
    {% if block.settings.video_url != blank %}
      {% if block.settings.video_url contains 'youtube.com' or block.settings.video_url contains 'youtu.be' %}
        {% assign video_id = block.settings.video_url | split: 'v=' | last | split: '/' | last | split: '&' | first %}
        <iframe
          src="https://www.youtube.com/embed/{{ video_id }}?autoplay={{ block.settings.autoplay }}&mute={{ block.settings.mute }}&loop={{ block.settings.loop }}&controls={{ block.settings.show_controls }}&playlist={{ video_id }}"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
          loading="lazy"
        ></iframe>
      {% elsif block.settings.video_url contains 'vimeo.com' %}
        {% assign video_id = block.settings.video_url | split: '/' | last %}
        <iframe
          src="https://player.vimeo.com/video/{{ video_id }}?autoplay={{ block.settings.autoplay }}&muted={{ block.settings.mute }}&loop={{ block.settings.loop }}&controls={{ block.settings.show_controls }}"
          frameborder="0"
          allow="autoplay; fullscreen"
          allowfullscreen
          loading="lazy"
        ></iframe>
      {% else %}
        <video
          {% if block.settings.autoplay %}autoplay{% endif %}
          {% if block.settings.mute %}muted{% endif %}
          {% if block.settings.loop %}loop{% endif %}
          {% if block.settings.show_controls %}controls{% endif %}
          playsinline
        >
          <source src="{{ block.settings.video_url }}" type="video/mp4">
        </video>
      {% endif %}
    {% elsif block.settings.video_file != blank %}
      <video
        {% if block.settings.autoplay %}autoplay{% endif %}
        {% if block.settings.mute %}muted{% endif %}
        {% if block.settings.loop %}loop{% endif %}
        {% if block.settings.show_controls %}controls{% endif %}
        playsinline
      >
        <source src="{{ block.settings.video_file }}" type="video/mp4">
      </video>
    {% else %}
      <div class="ai-video-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.show_overlay %}
      <div class="ai-video-overlay-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-video-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-video-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_play_button and block.settings.autoplay == false %}
      <button
        class="ai-video-play-button-{{ ai_gen_id }}"
        aria-label="Play video"
        data-video-play
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>
    {% endif %}
  </div>
</video-section-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.playButton = this.querySelector('[data-video-play]');
        this.video = this.querySelector('video');
        this.iframe = this.querySelector('iframe');

        if (this.playButton) {
          this.playButton.addEventListener('click', this.handlePlayClick.bind(this));
        }

        if (this.video) {
          this.video.addEventListener('play', this.handleVideoPlay.bind(this));
          this.video.addEventListener('pause', this.handleVideoPause.bind(this));
        }
      }

      handlePlayClick() {
        if (this.video) {
          this.video.play();
        } else if (this.iframe) {
          const src = this.iframe.src;
          if (src.includes('youtube.com')) {
            this.iframe.src = src.replace('autoplay=0', 'autoplay=1');
          } else if (src.includes('vimeo.com')) {
            this.iframe.src = src.replace('autoplay=0', 'autoplay=1');
          }
          this.playButton.classList.add('ai-hidden-{{ ai_gen_id }}');
        }
      }

      handleVideoPlay() {
        if (this.playButton) {
          this.playButton.classList.add('ai-hidden-{{ ai_gen_id }}');
        }
      }

      handleVideoPause() {
        if (this.playButton) {
          this.playButton.classList.remove('ai-hidden-{{ ai_gen_id }}');
        }
      }
    }

    customElements.define('video-section-{{ ai_gen_id }}', VideoSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Video section",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Video source"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL"
    },
    {
      "type": "video",
      "id": "video_file",
      "label": "Video file"
    },
    {
      "type": "paragraph",
      "content": "Add a YouTube, Vimeo, or direct video URL. Or upload a video file."
    },
    {
      "type": "header",
      "content": "Video settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mute",
      "label": "Mute",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show controls",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_play_button",
      "label": "Show play button",
      "default": false
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "56.25",
          "label": "16:9"
        },
        {
          "value": "75",
          "label": "4:3"
        },
        {
          "value": "100",
          "label": "1:1"
        },
        {
          "value": "133.33",
          "label": "3:4"
        },
        {
          "value": "42.85",
          "label": "21:9"
        }
      ],
      "default": "56.25"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Text overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show text overlay",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "play_button_color",
      "label": "Play button color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "play_button_icon_color",
      "label": "Play button icon color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Video section"
    }
  ]
}
{% endschema %}
