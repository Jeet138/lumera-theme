{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-step-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-step-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.gap }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-step-container-{{ ai_gen_id }}.ai-image-right-{{ ai_gen_id }} {
    flex-direction: row-reverse;
  }

  .ai-step-image-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}%;
    max-width: {{ block.settings.image_width }}%;
  }

  .ai-step-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
    object-fit: cover;
  }

  .ai-step-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-step-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-step-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-step-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_number_size }}px;
    font-weight: {{ block.settings.step_number_weight }};
    color: {{ block.settings.step_number_color }};
    margin: 0;
  }

  .ai-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-step-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-step-container-{{ ai_gen_id }}.ai-image-right-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-step-image-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 100%;
    }

    .ai-step-content-{{ ai_gen_id }} {
      flex: 1;
    }
  }
{% endstyle %}

<ai-step-section-{{ ai_gen_id }}
  class="ai-step-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-step-container-{{ ai_gen_id }} {% if block.settings.image_position == 'right' %}ai-image-right-{{ ai_gen_id }}{% endif %}">
    <div class="ai-step-image-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 800 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-step-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-step-content-{{ ai_gen_id }}">
      {% if block.settings.step_number != blank %}
        <div class="ai-step-number-{{ ai_gen_id }}">{{ block.settings.step_number }}</div>
      {% endif %}

      {% if block.settings.title != blank %}
        <h3 class="ai-step-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-step-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>
  </div>
</ai-step-section-{{ ai_gen_id }}>

<script>
  (function() {
    class AiStepSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('ai-step-section-{{ ai_gen_id }}', AiStepSection{{ ai_gen_id }});
  })();
</script>

