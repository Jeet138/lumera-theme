{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-csr-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-csr-container-{{ ai_gen_id }} {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 30px;
  }

  .ai-csr-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-csr-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px;
    font-weight: 500;
  }

  .ai-csr-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 900px;
    margin: 0 auto;
    line-height: 1.8;
  }

  .ai-csr-initiatives-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-bottom: 60px;
  }

  .ai-csr-initiative-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    padding: 30px;
    border-radius: {{ block.settings.card_border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-csr-initiative-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .ai-csr-initiative-icon-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    margin-bottom: 20px;
    color: {{ block.settings.icon_color }};
  }

  .ai-csr-initiative-title-{{ ai_gen_id }} {
    font-size: 20px;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px;
    font-weight: 600;
  }

  .ai-csr-initiative-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-csr-stats-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    margin-bottom: 60px;
    text-align: center;
  }

  .ai-csr-stat-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-csr-stat-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.stat_number_size }}px;
    color: {{ block.settings.stat_color }};
    font-weight: 700;
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .ai-csr-stat-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.stat_label_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-csr-trust-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-csr-trust-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    font-style: italic;
  }

  .ai-csr-instagram-{{ ai_gen_id }} {
    margin-top: 60px;
  }

  .ai-csr-instagram-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-csr-instagram-title-{{ ai_gen_id }} {
    font-size: 32px;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px;
    font-weight: 500;
  }

  .ai-csr-instagram-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.instagram_link_color }};
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .ai-csr-instagram-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.title_color }};
  }

  .ai-csr-instagram-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
  }

  .ai-csr-instagram-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .ai-csr-instagram-post-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.instagram_border_radius }}px;
    background: {{ block.settings.card_background }};
  }

  .ai-csr-instagram-media-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-csr-instagram-post-{{ ai_gen_id }}:hover .ai-csr-instagram-media-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-csr-instagram-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(1, 48, 90, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-csr-instagram-post-{{ ai_gen_id }}:hover .ai-csr-instagram-overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-csr-instagram-caption-{{ ai_gen_id }} {
    color: #ffffff;
    padding: 20px;
    font-size: 14px;
    text-align: center;
    line-height: 1.6;
  }

  .ai-csr-instagram-video-icon-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 30px;
    height: 30px;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 50%;
    padding: 6px;
  }

  .ai-csr-instagram-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f4f4f4;
  }

  .ai-csr-instagram-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-csr-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
  }

  .ai-csr-empty-state-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    margin-bottom: 20px;
  }

  @media screen and (max-width: 768px) {
    .ai-csr-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 0 {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-csr-container-{{ ai_gen_id }} {
      padding: 0 20px;
    }

    .ai-csr-header-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }

    .ai-csr-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-csr-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-csr-initiatives-{{ ai_gen_id }} {
      gap: 20px;
      margin-bottom: 40px;
    }

    .ai-csr-initiative-{{ ai_gen_id }} {
      padding: 25px;
    }

    .ai-csr-stats-{{ ai_gen_id }} {
      gap: 30px;
      margin-bottom: 40px;
    }

    .ai-csr-stat-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.stat_number_size | times: 0.7 }}px;
    }

    .ai-csr-instagram-{{ ai_gen_id }} {
      margin-top: 40px;
    }

    .ai-csr-instagram-title-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-csr-instagram-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 15px;
    }
  }
{% endstyle %}

<div class="ai-csr-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-csr-container-{{ ai_gen_id }}">
    <div class="ai-csr-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-csr-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-csr-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>

    {% if block.settings.show_initiatives %}
      <div class="ai-csr-initiatives-{{ ai_gen_id }}">
        {% if block.settings.initiative_1_title != blank %}
          <div class="ai-csr-initiative-{{ ai_gen_id }}">
            <svg class="ai-csr-initiative-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            <h3 class="ai-csr-initiative-title-{{ ai_gen_id }}">{{ block.settings.initiative_1_title }}</h3>
            <div class="ai-csr-initiative-text-{{ ai_gen_id }}">{{ block.settings.initiative_1_text }}</div>
          </div>
        {% endif %}

        {% if block.settings.initiative_2_title != blank %}
          <div class="ai-csr-initiative-{{ ai_gen_id }}">
            <svg class="ai-csr-initiative-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="ai-csr-initiative-title-{{ ai_gen_id }}">{{ block.settings.initiative_2_title }}</h3>
            <div class="ai-csr-initiative-text-{{ ai_gen_id }}">{{ block.settings.initiative_2_text }}</div>
          </div>
        {% endif %}

        {% if block.settings.initiative_3_title != blank %}
          <div class="ai-csr-initiative-{{ ai_gen_id }}">
            <svg class="ai-csr-initiative-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <h3 class="ai-csr-initiative-title-{{ ai_gen_id }}">{{ block.settings.initiative_3_title }}</h3>
            <div class="ai-csr-initiative-text-{{ ai_gen_id }}">{{ block.settings.initiative_3_text }}</div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.show_stats %}
      <div class="ai-csr-stats-{{ ai_gen_id }}">
        {% if block.settings.stat_1_number != blank %}
          <div class="ai-csr-stat-{{ ai_gen_id }}">
            <div class="ai-csr-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_1_number }}</div>
            <div class="ai-csr-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_1_label }}</div>
          </div>
        {% endif %}

        {% if block.settings.stat_2_number != blank %}
          <div class="ai-csr-stat-{{ ai_gen_id }}">
            <div class="ai-csr-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_2_number }}</div>
            <div class="ai-csr-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_2_label }}</div>
          </div>
        {% endif %}

        {% if block.settings.stat_3_number != blank %}
          <div class="ai-csr-stat-{{ ai_gen_id }}">
            <div class="ai-csr-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_3_number }}</div>
            <div class="ai-csr-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_3_label }}</div>
          </div>
        {% endif %}

        {% if block.settings.stat_4_number != blank %}
          <div class="ai-csr-stat-{{ ai_gen_id }}">
            <div class="ai-csr-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_4_number }}</div>
            <div class="ai-csr-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_4_label }}</div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.trust_text != blank %}
      <div class="ai-csr-trust-{{ ai_gen_id }}">
        <div class="ai-csr-trust-text-{{ ai_gen_id }}">{{ block.settings.trust_text }}</div>
      </div>
    {% endif %}

    {% if block.settings.show_instagram %}
      <div class="ai-csr-instagram-{{ ai_gen_id }}">
        <div class="ai-csr-instagram-header-{{ ai_gen_id }}">
          {% if block.settings.instagram_title != blank %}
            <h3 class="ai-csr-instagram-title-{{ ai_gen_id }}">{{ block.settings.instagram_title }}</h3>
          {% endif %}
          {% if block.settings.instagram_handle != blank or block.settings.instagram_profile_link != blank %}
            {% assign instagram_url = block.settings.instagram_profile_link %}
            {% if instagram_url == blank and block.settings.instagram_handle != blank %}
              {% assign instagram_url = 'https://instagram.com/' | append: block.settings.instagram_handle %}
            {% endif %}
            <a href="{{ instagram_url }}" target="_blank" rel="noopener" class="ai-csr-instagram-link-{{ ai_gen_id }}">
              <svg class="ai-csr-instagram-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              {% if block.settings.instagram_handle != blank %}
                @{{ block.settings.instagram_handle }}
              {% else %}
                Follow us on Instagram
              {% endif %}
            </a>
          {% endif %}
        </div>

        {% assign has_posts = false %}
        {% for i in (1..6) %}
          {% assign post_image_key = 'instagram_post_' | append: i | append: '_image' %}
          {% assign post_video_key = 'instagram_post_' | append: i | append: '_video' %}
          {% if block.settings[post_image_key] != blank or block.settings[post_video_key] != blank %}
            {% assign has_posts = true %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if has_posts %}
          <div class="ai-csr-instagram-grid-{{ ai_gen_id }}">
            {% for i in (1..6) %}
              {% assign post_image_key = 'instagram_post_' | append: i | append: '_image' %}
              {% assign post_video_key = 'instagram_post_' | append: i | append: '_video' %}
              {% assign post_caption_key = 'instagram_post_' | append: i | append: '_caption' %}
              {% assign post_link_key = 'instagram_post_' | append: i | append: '_link' %}

              {% assign post_image = block.settings[post_image_key] %}
              {% assign post_video = block.settings[post_video_key] %}
              {% assign post_caption = block.settings[post_caption_key] %}
              {% assign post_link = block.settings[post_link_key] %}

              {% if post_video != blank or post_image != blank %}
                <div class="ai-csr-instagram-post-{{ ai_gen_id }}">
                  {% if post_link != blank %}
                    <a href="{{ post_link }}" target="_blank" rel="noopener" style="display: block; width: 100%; height: 100%;">
                  {% endif %}

                  {% if post_video != blank %}
                    {% if post_video.sources %}
                      <video class="ai-csr-instagram-media-{{ ai_gen_id }}" playsinline muted loop>
                        {% for source in post_video.sources %}
                          <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {% endfor %}
                      </video>
                    {% else %}
                      <video class="ai-csr-instagram-media-{{ ai_gen_id }}" playsinline muted loop>
                        <source src="{{ post_video }}" type="video/mp4">
                      </video>
                    {% endif %}
                    <svg class="ai-csr-instagram-video-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  {% elsif post_image != blank %}
                    <img
                      src="{{ post_image | image_url: width: 600 }}"
                      alt="{{ post_caption | escape }}"
                      class="ai-csr-instagram-media-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% endif %}

                  {% if post_caption != blank %}
                    <div class="ai-csr-instagram-overlay-{{ ai_gen_id }}">
                      <div class="ai-csr-instagram-caption-{{ ai_gen_id }}">{{ post_caption }}</div>
                    </div>
                  {% endif %}

                  {% if post_link != blank %}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% else %}
          <div class="ai-csr-empty-state-{{ ai_gen_id }}">
            <div class="ai-csr-empty-state-text-{{ ai_gen_id }}">Add your Instagram posts to showcase your CSR activities</div>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    class CSRInstagram{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.videos = this.querySelectorAll('.ai-csr-instagram-media-{{ ai_gen_id }}[playsinline]');
        this.setupVideoPlayback();
      }

      setupVideoPlayback() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.5
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            const video = entry.target;
            if (entry.isIntersecting) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
        }, options);

        this.videos.forEach(video => {
          observer.observe(video);
          
          video.addEventListener('mouseenter', () => {
            video.play().catch(() => {});
          });
          
          video.addEventListener('mouseleave', () => {
            video.pause();
          });
        });
      }
    }

    customElements.define('csr-instagram-{{ ai_gen_id }}', CSRInstagram{{ ai_gen_id }});
    
    const csrSection = document.querySelector('.ai-csr-section-{{ ai_gen_id }}');
    if (csrSection && !customElements.get('csr-instagram-{{ ai_gen_id }}')) {
      const wrapper = document.createElement('csr-instagram-{{ ai_gen_id }}');
      csrSection.parentNode.insertBefore(wrapper, csrSection);
      wrapper.appendChild(csrSection);
    }
  })();
</script>

{% schema %}
{
  "name": "CSR with Instagram feed",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Corporate Social Responsibility"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We believe success shines brightest when it uplifts others. Our CSR is driven by Matru Shree Kashiba Haribhai Charitable Trust and the initiative \"Better Giving\".</p>"
    },
    {
      "type": "header",
      "content": "Initiatives"
    },
    {
      "type": "checkbox",
      "id": "show_initiatives",
      "label": "Show initiatives",
      "default": true
    },
    {
