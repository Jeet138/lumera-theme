{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-by-style-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-shop-by-style-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-shop-by-style-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-shop-by-style-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 12px;
    font-weight: 300;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .ai-shop-by-style-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
    font-style: italic;
  }

  .ai-shop-by-style-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-shop-by-style-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-shop-by-style-item-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    border-color: {{ block.settings.card_border_hover_color }};
  }

  .ai-shop-by-style-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f9f9f9;
  }

  .ai-shop-by-style-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-shop-by-style-item-{{ ai_gen_id }}:hover .ai-shop-by-style-image-{{ ai_gen_id }} {
    transform: scale(1.08);
  }

  .ai-shop-by-style-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  }

  .ai-shop-by-style-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.2;
  }

  .ai-shop-by-style-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 14px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: 2px;
    z-index: 2;
  }

  .ai-shop-by-style-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
  }

  .ai-shop-by-style-product-vendor-{{ ai_gen_id }} {
    color: {{ block.settings.vendor_color }};
    font-size: {{ block.settings.vendor_size }}px;
    margin: 0 0 8px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .ai-shop-by-style-product-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 12px;
    font-weight: 300;
    letter-spacing: 0.5px;
    line-height: 1.4;
    min-height: 48px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-shop-by-style-product-price-{{ ai_gen_id }} {
    color: {{ block.settings.price_color }};
    font-size: {{ block.settings.price_size }}px;
    margin: 0 0 16px;
    font-weight: 400;
  }

  .ai-shop-by-style-product-price-compare-{{ ai_gen_id }} {
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    margin-right: 8px;
    opacity: 0.6;
  }

  .ai-shop-by-style-product-price-sale-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
    font-weight: 600;
  }

  .ai-shop-by-style-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: 2px solid {{ block.settings.button_border_color }};
    padding: 12px 28px;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    width: 100%;
  }

  .ai-shop-by-style-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-shop-by-style-button-arrow-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .ai-shop-by-style-button-{{ ai_gen_id }}:hover .ai-shop-by-style-button-arrow-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  .ai-shop-by-style-empty-state-{{ ai_gen_id }} {
    grid-column: 1 / -1;
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.subheading_color }};
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-shop-by-style-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-shop-by-style-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-shop-by-style-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-shop-by-style-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-shop-by-style-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.5 }}px;
    }

    .ai-shop-by-style-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.7 }}px;
    }

    .ai-shop-by-style-product-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
      min-height: auto;
    }

    .ai-shop-by-style-button-{{ ai_gen_id }} {
      padding: 10px 20px;
      font-size: {{ block.settings.button_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<shop-by-style-{{ ai_gen_id }} class="ai-shop-by-style-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shop-by-style-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-shop-by-style-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-shop-by-style-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-shop-by-style-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-shop-by-style-grid-{{ ai_gen_id }}">
      {% liquid
        assign has_products = false
        for i in (1..6)
          assign product_key = 'product_' | append: i
          assign product = block.settings[product_key]
          if product != blank
            assign has_products = true
            break
          endif
        endfor
      %}

      {% if has_products %}
        {% for i in (1..6) %}
          {% liquid
            assign product_key = 'product_' | append: i
            assign badge_key = 'badge_' | append: i
            assign product = block.settings[product_key]
            assign badge_text = block.settings[badge_key]
          %}

          {% if product != blank %}
            <div class="ai-shop-by-style-item-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-shop-by-style-item-link-{{ ai_gen_id }}">
                <div class="ai-shop-by-style-image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 800 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      loading="lazy"
                      width="800"
                      height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                      class="ai-shop-by-style-image-{{ ai_gen_id }}"
                    >
                  {% else %}
                    <div class="ai-shop-by-style-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}

                  {% if badge_text != blank %}
                    <div class="ai-shop-by-style-badge-{{ ai_gen_id }}">{{ badge_text }}</div>
                  {% endif %}
                </div>

                <div class="ai-shop-by-style-content-{{ ai_gen_id }}">
                  {% if block.settings.show_vendor and product.vendor != blank %}
                    <p class="ai-shop-by-style-product-vendor-{{ ai_gen_id }}">{{ product.vendor }}</p>
                  {% endif %}

                  <h3 class="ai-shop-by-style-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>

                  {% if block.settings.show_price %}
                    <div class="ai-shop-by-style-product-price-{{ ai_gen_id }}">
                      {% if product.compare_at_price > product.price %}
                        <span class="ai-shop-by-style-product-price-compare-{{ ai_gen_id }}">
                          {{ product.compare_at_price | money }}
                        </span>
                        <span class="ai-shop-by-style-product-price-sale-{{ ai_gen_id }}">
                          {{ product.price | money }}
                        </span>
                      {% else %}
                        {{ product.price | money }}
                      {% endif %}
                    </div>
                  {% endif %}

                  <span class="ai-shop-by-style-button-{{ ai_gen_id }}">
                    {{ block.settings.button_text }}
                    <svg class="ai-shop-by-style-button-arrow-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </div>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="ai-shop-by-style-empty-state-{{ ai_gen_id }}">
          Select products to display in your Shop by Style section
        </div>
      {% endif %}
    </div>
  </div>
</shop-by-style-{{ ai_gen_id }}>

<script>
  (function() {
    class ShopByStyle{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const items = this.querySelectorAll('.ai-shop-by-style-item-{{ ai_gen_id }}');
        
        items.forEach((item, index) => {
          item.style.opacity = '0';
          item.style.transform = 'translateY(20px)';
          
          setTimeout(() => {
            item.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            item.style.opacity = '1';
            item.style.transform = 'translateY(0)';
          }, index * 100);
        });
      }
    }

    customElements.define('shop-by-style-{{ ai_gen_id }}', ShopByStyle{{ ai_gen_id }});
  })();
</script>

