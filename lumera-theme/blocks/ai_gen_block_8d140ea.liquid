
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-faq-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-faq-heading-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-faq-tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    margin-bottom: 30px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ai-faq-tab-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.tab_bg_color }};
    color: {{ block.settings.tab_text_color }};
    border: 1px solid {{ block.settings.tab_border_color }};
    border-radius: {{ block.settings.tab_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: {{ block.settings.tab_font_size }}px;
    font-weight: 500;
  }

  .ai-faq-tab-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tab_hover_bg_color }};
    color: {{ block.settings.tab_hover_text_color }};
  }

  .ai-faq-tab-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.tab_active_bg_color }};
    color: {{ block.settings.tab_active_text_color }};
    border-color: {{ block.settings.tab_active_border_color }};
  }

  .ai-faq-content-{{ ai_gen_id }} {
    display: none;
  }

  .ai-faq-content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.item_border_color }};
    margin-bottom: 0;
  }

  .ai-faq-question-{{ ai_gen_id }} {
    width: 100%;
    padding: 20px 0;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: {{ block.settings.question_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.question_color }};
  }

  .ai-faq-question-{{ ai_gen_id }}:hover {
    color: {{ block.settings.question_hover_color }};
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: 15px;
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-faq-answer-content-{{ ai_gen_id }} {
    padding: 0 0 20px 0;
    color: {{ block.settings.answer_color }};
    font-size: {{ block.settings.answer_font_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-faq-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-faq-tab-{{ ai_gen_id }} {
      font-size: {{ block.settings.tab_font_size | times: 0.9 }}px;
      padding: 10px 16px;
    }
  }
{% endstyle %}

<faq-section-{{ ai_gen_id }} class="ai-faq-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-faq-container-{{ ai_gen_id }}">
    <h2 class="ai-faq-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>

    <div class="ai-faq-tabs-{{ ai_gen_id }}">
      <button class="ai-faq-tab-{{ ai_gen_id }} active" data-tab="general">{{ block.settings.tab_general }}</button>
      <button class="ai-faq-tab-{{ ai_gen_id }}" data-tab="shipping">{{ block.settings.tab_shipping }}</button>
      <button class="ai-faq-tab-{{ ai_gen_id }}" data-tab="payment">{{ block.settings.tab_payment }}</button>
      <button class="ai-faq-tab-{{ ai_gen_id }}" data-tab="returns">{{ block.settings.tab_returns }}</button>
    </div>

    <div class="ai-faq-content-{{ ai_gen_id }} active" data-content="general">
      {% for i in (1..10) %}
        {% assign question_key = 'general_q' | append: i %}
        {% assign answer_key = 'general_a' | append: i %}
        {% if block.settings[question_key] != blank %}
          <div class="ai-faq-item-{{ ai_gen_id }}">
            <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
              <span>{{ block.settings[question_key] }}</span>
              <svg class="ai-faq-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="ai-faq-answer-{{ ai_gen_id }}">
              <div class="ai-faq-answer-content-{{ ai_gen_id }}">
                {{ block.settings[answer_key] }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-faq-content-{{ ai_gen_id }}" data-content="shipping">
      {% for i in (1..10) %}
        {% assign question_key = 'shipping_q' | append: i %}
        {% assign answer_key = 'shipping_a' | append: i %}
        {% if block.settings[question_key] != blank %}
          <div class="ai-faq-item-{{ ai_gen_id }}">
            <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
              <span>{{ block.settings[question_key] }}</span>
              <svg class="ai-faq-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="ai-faq-answer-{{ ai_gen_id }}">
              <div class="ai-faq-answer-content-{{ ai_gen_id }}">
                {{ block.settings[answer_key] }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-faq-content-{{ ai_gen_id }}" data-content="payment">
      {% for i in (1..10) %}
        {% assign question_key = 'payment_q' | append: i %}
        {% assign answer_key = 'payment_a' | append: i %}
        {% if block.settings[question_key] != blank %}
          <div class="ai-faq-item-{{ ai_gen_id }}">
            <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
              <span>{{ block.settings[question_key] }}</span>
              <svg class="ai-faq-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="ai-faq-answer-{{ ai_gen_id }}">
              <div class="ai-faq-answer-content-{{ ai_gen_id }}">
                {{ block.settings[answer_key] }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-faq-content-{{ ai_gen_id }}" data-content="returns">
      {% for i in (1..10) %}
        {% assign question_key = 'returns_q' | append: i %}
        {% assign answer_key = 'returns_a' | append: i %}
        {% if block.settings[question_key] != blank %}
          <div class="ai-faq-item-{{ ai_gen_id }}">
            <button class="ai-faq-question-{{ ai_gen_id }}" aria-expanded="false">
              <span>{{ block.settings[question_key] }}</span>
              <svg class="ai-faq-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="ai-faq-answer-{{ ai_gen_id }}">
              <div class="ai-faq-answer-content-{{ ai_gen_id }}">
                {{ block.settings[answer_key] }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</faq-section-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-faq-tab-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-faq-content-{{ ai_gen_id }}');
        this.questions = this.querySelectorAll('.ai-faq-question-{{ ai_gen_id }}');

        this.setupTabs();
        this.setupAccordion();
      }

      setupTabs() {
        this.tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const targetTab = tab.getAttribute('data-tab');

            this.tabs.forEach(t => t.classList.remove('active'));
            this.contents.forEach(c => c.classList.remove('active'));

            tab.classList.add('active');
            const targetContent = this.querySelector(`[data-content="${targetTab}"]`);
            if (targetContent) {
              targetContent.classList.add('active');
            }

            const openItems = this.querySelectorAll('.ai-faq-item-{{ ai_gen_id }}.active');
            openItems.forEach(item => {
              item.classList.remove('active');
              const answer = item.querySelector('.ai-faq-answer-{{ ai_gen_id }}');
              const question = item.querySelector('.ai-faq-question-{{ ai_gen_id }}');
              if (answer) answer.style.maxHeight = null;
              if (question) question.setAttribute('aria-expanded', 'false');
            });
          });
        });
      }

      setupAccordion() {
        this.questions.forEach(question => {
          question.addEventListener('click', () => {
            const item = question.closest('.ai-faq-item-{{ ai_gen_id }}');
            const answer = item.querySelector('.ai-faq-answer-{{ ai_gen_id }}');
            const isActive = item.classList.contains('active');

            if (isActive) {
              item.classList.remove('active');
              answer.style.maxHeight = null;
              question.setAttribute('aria-expanded', 'false');
            } else {
              item.classList.add('active');
              answer.style.maxHeight = answer.scrollHeight + 'px';
              question.setAttribute('aria-expanded', 'true');
            }
          });
        });
      }
    }

    customElements.define('faq-section-{{ ai_gen_id }}', FaqSection{{ ai_gen_id }});
  })();
</script>

