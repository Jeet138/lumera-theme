{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
 .ai-shop-by-shape-{{ ai_gen_id }} {
  display: block !important;
  width: 100%;
  padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  background-color: #FEF8F1 !important;
  overflow: hidden;
  box-sizing: border-box;
}
  .ai-shop-by-shape-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1600px;
    margin: 0 auto;
    position: relative;
  }

  .ai-shop-by-shape-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 38px;
  }

  .ai-shop-by-shape-heading-{{ ai_gen_id }} {
    margin: 0 0 8px;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: {{ block.settings.heading_color }};
  }

  .ai-shop-by-shape-subheading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.5;
    color: {{ block.settings.subheading_color }};
  }

  .ai-shop-by-shape-slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding: 0 58px;
  }

  .ai-shop-by-shape-viewport-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
  }

  .ai-shop-by-shape-grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.grid_gap }}px;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .ai-shop-by-shape-item-{{ ai_gen_id }} {
    flex: 0 0 calc(
      (100% - ({{ block.settings.grid_gap }}px * 7)) / 8
    );
    min-width: 0;
    text-align: center;
    opacity: 0;
    transform: translateY(15px);
    animation: aiShapeFadeIn-{{ ai_gen_id }} 0.65s ease forwards;
  }

  {% for i in (1..17) %}
    .ai-shop-by-shape-item-{{ ai_gen_id }}:nth-child({{ i }}) {
      animation-delay: {{ i | times: 0.045 }}s;
    }
  {% endfor %}

  @keyframes aiShapeFadeIn-{{ ai_gen_id }} {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ai-shop-by-shape-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-shop-by-shape-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 20px;
    overflow: visible;
  }

  .ai-shop-by-shape-image-wrapper-{{ ai_gen_id }}::before {
    content: "";
    position: absolute;
    width: 78%;
    height: 78%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255,255,255,0.95) 0%,
      rgba(245,245,242,0.45) 48%,
      rgba(255,255,255,0) 75%
    );
    opacity: 0;
    transform: scale(0.7);
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
    pointer-events: none;
  }

  .ai-shop-by-shape-image-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}%;
    height: {{ block.settings.image_size }}%;
    object-fit: contain;
    display: block;
    position: relative;
    z-index: 1;
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.4s ease;
  }

  .ai-shop-by-shape-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}%;
    height: {{ block.settings.image_size }}%;
    background: #f6f6f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .ai-shop-by-shape-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.25;
  }

  .ai-shop-by-shape-link-{{ ai_gen_id }}:hover
  .ai-shop-by-shape-image-{{ ai_gen_id }} {
    transform: scale(1.09) translateY(-4px);
    filter: drop-shadow(0 10px 15px rgba(0,0,0,0.08));
  }

  .ai-shop-by-shape-link-{{ ai_gen_id }}:hover
  .ai-shop-by-shape-image-wrapper-{{ ai_gen_id }}::before {
    opacity: 1;
    transform: scale(1);
  }

  .ai-shop-by-shape-name-{{ ai_gen_id }} {
    display: block;
    font-size: {{ block.settings.name_size }}px;
    line-height: 1.35;
    color: {{ block.settings.name_color }};
    font-weight: 400;
    transition:
      color 0.3s ease,
      transform 0.3s ease;
  }

  .ai-shop-by-shape-link-{{ ai_gen_id }}:hover
  .ai-shop-by-shape-name-{{ ai_gen_id }} {
    color: {{ block.settings.name_hover_color }};
    transform: translateY(-2px);
  }

  .ai-shop-by-shape-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.08);
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    padding: 0;
    box-shadow: 0 5px 18px rgba(0,0,0,0.10);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      opacity 0.25s ease;
  }

  .ai-shop-by-shape-arrow-{{ ai_gen_id }}:hover {
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 8px 24px rgba(0,0,0,0.14);
  }

  .ai-shop-by-shape-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  .ai-shop-by-shape-arrow-prev-{{ ai_gen_id }} {
    left: 0;
  }

  .ai-shop-by-shape-arrow-next-{{ ai_gen_id }} {
    right: 0;
  }

  .ai-shop-by-shape-arrow-{{ ai_gen_id }} svg {
    width: 17px;
    height: 17px;
  }

  @media screen and (max-width: 1200px) {
    .ai-shop-by-shape-container-{{ ai_gen_id }} {
      width: 94%;
    }

    .ai-shop-by-shape-item-{{ ai_gen_id }} {
      flex: 0 0 calc(
        (100% - ({{ block.settings.grid_gap }}px * 6)) / 7
      );
    }
  }

  @media screen and (max-width: 989px) {
    .ai-shop-by-shape-slider-{{ ai_gen_id }} {
      padding: 0 50px;
    }

    .ai-shop-by-shape-item-{{ ai_gen_id }} {
      flex: 0 0 calc(
        (100% - ({{ block.settings.grid_gap }}px * 4)) / 5
      );
    }

    .ai-shop-by-shape-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.9);
    }

    .ai-shop-by-shape-image-wrapper-{{ ai_gen_id }} {
      margin-bottom: 15px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-shop-by-shape-{{ ai_gen_id }} {
      padding-top: {{ block.settings.section_padding_top | times: 0.75 }}px;
      padding-bottom: {{ block.settings.section_padding_bottom | times: 0.75 }}px;
    }

    .ai-shop-by-shape-container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-shop-by-shape-header-{{ ai_gen_id }} {
      padding: 0 18px;
      margin-bottom: 25px;
    }

    .ai-shop-by-shape-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.75);
    }

    .ai-shop-by-shape-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }

    .ai-shop-by-shape-slider-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-shop-by-shape-viewport-{{ ai_gen_id }} {
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -ms-overflow-style: none;
      scroll-behavior: smooth;
    }

    .ai-shop-by-shape-viewport-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-shop-by-shape-grid-{{ ai_gen_id }} {
      width: max-content;
      gap: 12px;
      transition: none;
    }

    .ai-shop-by-shape-item-{{ ai_gen_id }} {
      flex: 0 0 calc(
        (100vw - 56px) / 3
      );
      width: calc(
        (100vw - 56px) / 3
      );
      animation: none;
      opacity: 1;
      transform: none;
    }

    .ai-shop-by-shape-image-wrapper-{{ ai_gen_id }} {
      margin-bottom: 11px;
    }

    .ai-shop-by-shape-image-{{ ai_gen_id }},
    .ai-shop-by-shape-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.image_size }}%;
      height: {{ block.settings.image_size }}%;
    }

    .ai-shop-by-shape-name-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.name_size }}px * 0.9);
    }

    .ai-shop-by-shape-arrow-{{ ai_gen_id }} {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-shop-by-shape-item-{{ ai_gen_id }} {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .ai-shop-by-shape-grid-{{ ai_gen_id }},
    .ai-shop-by-shape-image-{{ ai_gen_id }},
    .ai-shop-by-shape-name-{{ ai_gen_id }} {
      transition: none;
    }
  }
{% endstyle %}

<shop-by-shape-{{ ai_gen_id }}
  class="ai-shop-by-shape-{{ ai_gen_id }}"
>
  <div class="ai-shop-by-shape-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-shop-by-shape-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-shop-by-shape-heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <p class="ai-shop-by-shape-subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-shop-by-shape-slider-{{ ai_gen_id }}">
      <button
        type="button"
        class="ai-shop-by-shape-arrow-{{ ai_gen_id }} ai-shop-by-shape-arrow-prev-{{ ai_gen_id }}"
        aria-label="Previous shapes"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-shop-by-shape-viewport-{{ ai_gen_id }}">
        <div class="ai-shop-by-shape-grid-{{ ai_gen_id }}">
          {% for i in (1..17) %}
            {% liquid
              assign shape_enabled_key = 'shape_' | append: i | append: '_enabled'
              assign shape_name_key = 'shape_' | append: i | append: '_name'
              assign shape_image_key = 'shape_' | append: i | append: '_image'
              assign shape_link_key = 'shape_' | append: i | append: '_link'

              assign shape_enabled = block.settings[shape_enabled_key]
              assign shape_name = block.settings[shape_name_key]
              assign shape_image = block.settings[shape_image_key]
              assign shape_link = block.settings[shape_link_key]
            %}

            {% if shape_enabled and shape_name != blank %}
              <div class="ai-shop-by-shape-item-{{ ai_gen_id }}">
                {% if shape_link != blank %}
                  <a
                    href="{{ shape_link }}"
                    class="ai-shop-by-shape-link-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-shop-by-shape-link-{{ ai_gen_id }}">
                {% endif %}

                <div class="ai-shop-by-shape-image-wrapper-{{ ai_gen_id }}">
                  {% if shape_image != blank %}
                    <img
                      src="{{ shape_image | image_url: width: 500 }}"
                      alt="{{ shape_name | escape }}"
                      class="ai-shop-by-shape-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="500"
                      height="500"
                    >
                  {% else %}
                    <div class="ai-shop-by-shape-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>

                <span class="ai-shop-by-shape-name-{{ ai_gen_id }}">
                  {{ shape_name }}
                </span>

                {% if shape_link != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <button
        type="button"
        class="ai-shop-by-shape-arrow-{{ ai_gen_id }} ai-shop-by-shape-arrow-next-{{ ai_gen_id }}"
        aria-label="Next shapes"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</shop-by-shape-{{ ai_gen_id }}>

<script>
  (function() {

    class ShopByShape extends HTMLElement {

      constructor() {
        super();

        this.currentIndex = 0;
        this.itemsToShow = 8;
        this.resizeTimer = null;
      }

      connectedCallback() {

        this.grid = this.querySelector(
          '.ai-shop-by-shape-grid-{{ ai_gen_id }}'
        );

        this.items = this.querySelectorAll(
          '.ai-shop-by-shape-item-{{ ai_gen_id }}'
        );

        this.viewport = this.querySelector(
          '.ai-shop-by-shape-viewport-{{ ai_gen_id }}'
        );

        this.prevButton = this.querySelector(
          '.ai-shop-by-shape-arrow-prev-{{ ai_gen_id }}'
        );

        this.nextButton = this.querySelector(
          '.ai-shop-by-shape-arrow-next-{{ ai_gen_id }}'
        );

        if (!this.grid || !this.items.length) {
          return;
        }

        this.updateItemsToShow();
        this.updatePosition();
        this.updateButtons();

        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.slide('prev');
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.slide('next');
          });
        }

        window.addEventListener('resize', () => {

          clearTimeout(this.resizeTimer);

          this.resizeTimer = setTimeout(() => {
            this.updateItemsToShow();
          }, 150);

        });

        this.initTouchSwipe();
        this.initAccessibility();
      }

      updateItemsToShow() {

        const width = window.innerWidth;

        if (width < 750) {

          this.itemsToShow = 3;

        } else if (width < 990) {

          this.itemsToShow = 5;

        } else {

          /*
           * DESKTOP = 8 ITEMS
           */
          this.itemsToShow = 8;

        }

        const maxIndex = Math.max(
          0,
          this.items.length - this.itemsToShow
        );

        if (this.currentIndex > maxIndex) {
          this.currentIndex = maxIndex;
        }

        this.updatePosition();
        this.updateButtons();
      }

      slide(direction) {

        const width = window.innerWidth;

        if (width < 750) {
          return;
        }

        const maxIndex = Math.max(
          0,
          this.items.length - this.itemsToShow
        );

        if (direction === 'next') {

          this.currentIndex = Math.min(
            this.currentIndex + 1,
            maxIndex
          );

        } else {

          this.currentIndex = Math.max(
            this.currentIndex - 1,
            0
          );

        }

        this.updatePosition();
        this.updateButtons();
      }

      updatePosition() {

        if (!this.grid || !this.items.length) {
          return;
        }

        const width = window.innerWidth;

        /*
         * MOBILE:
         * Native horizontal swipe
         */
        if (width < 750) {

          this.grid.style.transform = 'none';

          return;
        }

        const firstItem = this.items[0];

        if (!firstItem) {
          return;
        }

        const itemWidth =
          firstItem.getBoundingClientRect().width;

        const gap = width < 990
          ? {{ block.settings.grid_gap }}
          : {{ block.settings.grid_gap }};

        const offset =
          this.currentIndex * (itemWidth + gap);

        this.grid.style.transform =
          'translate3d(-' + offset + 'px, 0, 0)';
      }

      updateButtons() {

        if (!this.items.length) {
          return;
        }

        const width = window.innerWidth;

        if (width < 750) {

          if (this.prevButton) {
            this.prevButton.style.display = 'none';
          }

          if (this.nextButton) {
            this.nextButton.style.display = 'none';
          }

          return;
        }

        const maxIndex = Math.max(
          0,
          this.items.length - this.itemsToShow
        );

        if (this.prevButton) {
          this.prevButton.disabled =
            this.currentIndex <= 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled =
            this.currentIndex >= maxIndex;
        }
      }

      initTouchSwipe() {

        if (!this.viewport) {
          return;
        }

        let startX = 0;
        let startY = 0;
        let isDragging = false;

        this.viewport.addEventListener(
          'touchstart',
          (event) => {

            if (window.innerWidth >= 750) {
              return;
            }

            startX = event.touches[0].clientX;
            startY = event.touches[0].clientY;
            isDragging = true;

          },
          { passive: true }
        );

        this.viewport.addEventListener(
          'touchend',
          (event) => {

            if (!isDragging || window.innerWidth >= 750) {
              return;
            }

            const endX =
              event.changedTouches[0].clientX;

            const endY =
              event.changedTouches[0].clientY;

            const diffX = startX - endX;
            const diffY = startY - endY;

            isDragging = false;

            /*
             * Only react to horizontal swipe
             */
            if (
              Math.abs(diffX) > 45 &&
              Math.abs(diffX) > Math.abs(diffY)
            ) {

              if (diffX > 0) {

                this.viewport.scrollBy({
                  left: window.innerWidth / 3,
                  behavior: 'smooth'
                });

              } else {

                this.viewport.scrollBy({
                  left: -(window.innerWidth / 3),
                  behavior: 'smooth'
                });

              }

            }

          },
          { passive: true }
        );
      }

      initAccessibility() {

        const links = this.querySelectorAll(
          '.ai-shop-by-shape-link-{{ ai_gen_id }}'
        );

        links.forEach((link) => {

          if (link.tagName === 'A') {

            const shapeName =
              link.querySelector(
                '.ai-shop-by-shape-name-{{ ai_gen_id }}'
              );

            if (
              shapeName &&
              !link.getAttribute('aria-label')
            ) {

              link.setAttribute(
                'aria-label',
                'Shop ' +
                shapeName.textContent.trim() +
                ' shaped jewellery'
              );

            }
          }

        });
      }

    }

    if (
      !customElements.get(
        'shop-by-shape-{{ ai_gen_id }}'
      )
    ) {

      customElements.define(
        'shop-by-shape-{{ ai_gen_id }}',
        ShopByShape
      );

    }

  })();
</script>

{% schema %}
{
  "name": "Shop by shape",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Shape"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover your perfect diamond shape"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "heading_transform",
      "label": "Heading transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "subheading_spacing",
      "label": "Subheading spacing",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "color",
