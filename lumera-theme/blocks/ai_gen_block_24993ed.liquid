      }


      .ai-best-selling-grid-{{ ai_gen_id }} {
        display: grid !important;

        grid-template-columns:
          repeat(
            2,
            minmax(0, 1fr)
          ) !important;

        gap:
          {{ block.settings.grid_gap | times: 0.7 | round }}px;

        width: 100% !important;
      }


      .ai-best-selling-item-{{ ai_gen_id }} {
        width: 100% !important;

        min-width: 0 !important;

        max-width: 100% !important;
      }


      .ai-best-selling-title-{{ ai_gen_id }} {
        font-size:
          {{ block.settings.heading_size | times: 0.6 }}px;

        line-height: 1.2;
      }


      .ai-best-selling-subtitle-{{ ai_gen_id }} {
        font-size:
          {{ block.settings.subheading_size | times: 0.9 }}px;
