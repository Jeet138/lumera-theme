    /* =========================================================
       SMALL MOBILE
       BELOW 480px
    ========================================================= */

    @media screen and (max-width: 480px) {

      .ai-best-selling-container-{{ ai_gen_id }} {
        width: 100%;

        max-width: 100%;

        padding-left: 8px;
        padding-right: 8px;
  margin-top: -22px;
        box-sizing: border-box;
      }


      .ai-best-selling-grid-{{ ai_gen_id }} {
        grid-template-columns:
          repeat(
            2,
            minmax(0, 1fr)
          ) !important;

        gap: 10px;
      }


      .ai-best-selling-title-{{ ai_gen_id }} {
        font-size: 24px;
      }


      .ai-best-selling-subtitle-{{ ai_gen_id }} {
        font-size: 14px;
      }

    }
{% endstyle %}

<best-selling-section-{{ ai_gen_id }}
  class="ai-best-selling-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-best-selling-container-{{ ai_gen_id }}">
    <!--
      =====================================================
      HEADING
      =====================================================
    -->

    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-best-selling-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-best-selling-title-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <p class="ai-best-selling-subtitle-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <!--
      =====================================================
      BEST SELLING COLLECTION
      =====================================================
    -->

    {% assign best_selling_collection = block.settings.best_selling_collection %}

    {% if best_selling_collection != blank and best_selling_collection.products_count > 0 %}
      <div class="ai-best-selling-grid-{{ ai_gen_id }}">
        {% for product in best_selling_collection.products limit: block.settings.desktop_products_per_row %}
          <div class="ai-best-selling-item-{{ ai_gen_id }}">
            {% render 'product-card', product: product %}
          </div>
        {% endfor %}
      </div>

    {% else %}
      <div class="ai-best-selling-empty-{{ ai_gen_id }}">
        <div class="ai-best-selling-empty-icon-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>

        <p class="ai-best-selling-empty-text-{{ ai_gen_id }}">
          Select a best selling collection to showcase your products
        </p>
      </div>
    {% endif %}
  </div>
</best-selling-section-{{ ai_gen_id }}>

<script>
  (function() {

    class BestSellingSection{{ ai_gen_id }} extends HTMLElement {

      constructor() {
        super();
      }


      connectedCallback() {
        this.style.display = 'block';
      }

    }


    if (
      !customElements.get(
        'best-selling-section-{{ ai_gen_id }}'
      )
    ) {

      customElements.define(
        'best-selling-section-{{ ai_gen_id }}',
        BestSellingSection{{ ai_gen_id }}
      );

    }

  })();
</script>

