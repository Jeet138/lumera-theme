{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
    /* =========================================================
       MAIN SECTION
    ========================================================= */

    .ai-best-selling-{{ ai_gen_id }} {
      width: 100%;
      padding:
        {{ block.settings.section_padding_top }}px
        0
        {{ block.settings.section_padding_bottom }}px;

      background-color: {{ block.settings.background_color }};

      display: block;

      box-sizing: border-box;
    }


    /* =========================================================
       MAIN CONTAINER

       DESKTOP + LAPTOP
       SAME LEFT / RIGHT SPACE
    ========================================================= */

    .ai-best-selling-container-{{ ai_gen_id }} {
      width: 100%;

      max-width: 1548px;

      margin-left: auto;
      margin-right: auto;
  margin-top: -69px;
      padding-left: 24px;
      padding-right: 24px;

      box-sizing: border-box;
    }


    /* =========================================================
       HEADING
    ========================================================= */

    .ai-best-selling-header-{{ ai_gen_id }} {
      width: 100%;

      text-align: {{ block.settings.heading_alignment }};

      margin-bottom:
        {{ block.settings.heading_spacing }}px;

      box-sizing: border-box;
    }


    .ai-best-selling-title-{{ ai_gen_id }} {
      color:
        {{ block.settings.heading_color }};

      margin:
        0 0 10px;

      font-size:
        {{ block.settings.heading_size }}px;

      line-height: 1.2;

      box-sizing: border-box;
    }


    .ai-best-selling-subtitle-{{ ai_gen_id }} {
      color:
        {{ block.settings.subheading_color }};

      margin: 0;

      font-size:
        {{ block.settings.subheading_size }}px;

      line-height: 1.5;

      box-sizing: border-box;
    }


    /* =========================================================
       PRODUCT GRID

       DESKTOP
       EXACTLY 6 PRODUCTS IN ONE ROW
    ========================================================= */

    .ai-best-selling-grid-{{ ai_gen_id }} {
      width: 100%;

      display: grid !important;

      grid-template-columns:
        repeat(
          {{ block.settings.desktop_products_per_row }},
          minmax(0, 1fr)
        ) !important;

      gap:
        {{ block.settings.grid_gap }}px;

      margin-top:
        {{ block.settings.grid_spacing }}px;

      box-sizing: border-box;
    }


    /* =========================================================
       PRODUCT ITEM
    ========================================================= */

    .ai-best-selling-item-{{ ai_gen_id }} {
      width: 100% !important;

      min-width: 0 !important;

      max-width: 100% !important;

      box-sizing: border-box;
    }


    /* =========================================================
       PRODUCT CARD WIDTH FIX
    ========================================================= */

    .ai-best-selling-{{ ai_gen_id }} .card,
    .ai-best-selling-{{ ai_gen_id }} .product-card,
    .ai-best-selling-{{ ai_gen_id }} .card-wrapper {
      width: 100% !important;

      max-width: 100% !important;

      min-width: 0 !important;

      box-sizing: border-box;
    }


    /* =========================================================
       PRODUCT CARD INNER
    ========================================================= */

    .ai-best-selling-{{ ai_gen_id }} .card__inner,
    .ai-best-selling-{{ ai_gen_id }} .card__media,
    .ai-best-selling-{{ ai_gen_id }} .media {
      width: 100% !important;

      max-width: 100% !important;

      box-sizing: border-box;
    }


    /* =========================================================
       PRODUCT IMAGE
    ========================================================= */

    .ai-best-selling-{{ ai_gen_id }} img {
      max-width: 100%;
    }


    /* =========================================================
       PRODUCT TITLE
       MAX 2 LINES
    ========================================================= */

    .ai-best-selling-{{ ai_gen_id }} .product-card__name {
      display: -webkit-box;

      -webkit-box-orient: vertical;

      -webkit-line-clamp: 2;

      overflow: hidden;

      text-overflow: ellipsis;

      line-height: 1.4;

      max-height:
        calc(1.4em * 2);
    }


    /* =========================================================
       EMPTY STATE
    ========================================================= */

    .ai-best-selling-empty-{{ ai_gen_id }} {
      width: 100%;

      text-align: center;

      padding:
        60px 20px;

      color: #999;

      box-sizing: border-box;
    }


    .ai-best-selling-empty-icon-{{ ai_gen_id }} {
      width: 80px;

      height: 80px;

      margin:
        0 auto 20px;

      opacity: 0.3;
    }


    .ai-best-selling-empty-text-{{ ai_gen_id }} {
      font-size: 16px;

      color: #666;

      margin: 0;
    }


    /* =========================================================
       LARGE DESKTOP
       1500px+

       SAME 24px LEFT / RIGHT SPACE
    ========================================================= */

    @media screen and (min-width: 1500px) {

      .ai-best-selling-container-{{ ai_gen_id }} {
        width: 100%;

        max-width: 1548px;

        margin-left: auto;
        margin-right: auto;
  margin-top: -26px;
        padding-left: 24px;
        padding-right: 24px;

        box-sizing: border-box;
      }


      .ai-best-selling-grid-{{ ai_gen_id }} {
        width: 100%;

        grid-template-columns:
          repeat(
            {{ block.settings.desktop_products_per_row }},
            minmax(0, 1fr)
          ) !important;

        gap:
          {{ block.settings.grid_gap }}px;
      }

    }


    /* =========================================================
       15" LAPTOP
       1400px - 1499px

       SAME LEFT / RIGHT SPACE AS DESKTOP
    ========================================================= */

    @media screen and (min-width: 1400px) and (max-width: 1499px) {

      .ai-best-selling-container-{{ ai_gen_id }} {
        width: 100%;

        max-width: 1548px;

        margin-left: auto;
        margin-right: auto;

        padding-left: 24px;
        padding-right: 24px;
  margin-top: -30px;
        box-sizing: border-box;
      }


      .ai-best-selling-grid-{{ ai_gen_id }} {
        width: 100%;

        display: grid !important;

        grid-template-columns:
          repeat(
            {{ block.settings.desktop_products_per_row }},
            minmax(0, 1fr)
          ) !important;

        gap:
          {{ block.settings.grid_gap }}px;

        box-sizing: border-box;
      }


      .ai-best-selling-item-{{ ai_gen_id }} {
        width: 100% !important;

        min-width: 0 !important;

        max-width: 100% !important;
      }


      .ai-best-selling-{{ ai_gen_id }} .card,
      .ai-best-selling-{{ ai_gen_id }} .product-card,
      .ai-best-selling-{{ ai_gen_id }} .card-wrapper {
        width: 100% !important;

        max-width: 100% !important;

        min-width: 0 !important;
      }

    }


    /* =========================================================
       14" LAPTOP
       1200px - 1399px

       SAME LEFT / RIGHT SPACE AS DESKTOP
    ========================================================= */

    @media screen and (min-width: 1200px) and (max-width: 1399px) {

      .ai-best-selling-container-{{ ai_gen_id }} {
        width: 100%;

        max-width: 1548px;

        margin-left: auto;
        margin-right: auto;
  margin-top: -30px;
        padding-left: 24px;
        padding-right: 24px;

        box-sizing: border-box;
      }


      .ai-best-selling-grid-{{ ai_gen_id }} {
        width: 100%;

        display: grid !important;

        grid-template-columns:
          repeat(
            {{ block.settings.desktop_products_per_row }},
            minmax(0, 1fr)
          ) !important;

        gap:
          {{ block.settings.grid_gap }}px;

        box-sizing: border-box;
      }


      .ai-best-selling-item-{{ ai_gen_id }} {
        width: 100% !important;

        min-width: 0 !important;

        max-width: 100% !important;

        box-sizing: border-box;
      }


      .ai-best-selling-{{ ai_gen_id }} .card,
      .ai-best-selling-{{ ai_gen_id }} .product-card,
      .ai-best-selling-{{ ai_gen_id }} .card-wrapper {
