    }


    /* =========================================================
       TABLET
       750px - 989px

       3 PRODUCTS PER ROW
    ========================================================= */

    @media screen and (min-width: 750px) and (max-width: 989px) {

      .ai-best-selling-container-{{ ai_gen_id }} {
        width: 100%;

        max-width: 100%;

        padding-left: 20px;
        padding-right: 20px;
  margin-top: -69px;
        box-sizing: border-box;
      }


      .ai-best-selling-grid-{{ ai_gen_id }} {
        display: grid !important;

        grid-template-columns:
          repeat(
            3,
            minmax(0, 1fr)
          ) !important;

        gap:
          {{ block.settings.grid_gap }}px;
      }


      .ai-best-selling-title-{{ ai_gen_id }} {
        font-size:
          {{ block.settings.heading_size | times: 0.8 }}px;
      }

    }


    /* =========================================================
       MOBILE
       BELOW 750px

       2 PRODUCTS PER ROW
    ========================================================= */

    @media screen and (max-width: 749px) {

      .ai-best-selling-{{ ai_gen_id }} {
        padding-top:
          {{ block.settings.section_padding_top | times: 0.7 | round }}px;

        padding-bottom:
          {{ block.settings.section_padding_bottom | times: 0.7 | round }}px;
      }


      .ai-best-selling-container-{{ ai_gen_id }} {
        width: 100%;

        max-width: 100%;

        padding-left: 10px;
        padding-right: 10px;
  margin-top: -69px;
