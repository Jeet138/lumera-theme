{% doc %}
  @prompt
    Create a custom section that looks exactly like this reference design: Left side has two jewelry/ring images displayed side by side in a 2-column grid layout taking up about 65% of the section width. Right side (35% width) has a small uppercase label text "SHOP DIAMOND", a large bold serif heading "ENGAGEMENT RINGS" in 2 lines, and a bordered rectangular "SHOP NOW →" button below. The overall layout is a horizontal split — images on left, text+CTA on right, vertically centered. Background is white/light. The section should be fully customizable with editable images, heading text, label text, button text, and button link. Make it responsive for mobile (stack vertically on mobile).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-engagement-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }
  
  .ai-engagement-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 30px;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .ai-engagement-images-{{ ai_gen_id }} {
    flex: 0 0 65%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.image_gap }}px;
  }

  .ai-engagement-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-engagement-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-engagement-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-engagement-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-engagement-content-{{ ai_gen_id }} {
    flex: 0 0 35%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-engagement-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: {{ block.settings.label_color }};
    margin: 0;
  }

  .ai-engagement-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    font-weight: 700;
    line-height: 1.1;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-family: serif;
  }

  .ai-engagement-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: 2px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all 0.3s ease;
    width: fit-content;
  }

  .ai-engagement-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-engagement-button-arrow-{{ ai_gen_id }} {
    font-size: 18px;
    transition: transform 0.3s ease;
  }

  .ai-engagement-button-{{ ai_gen_id }}:hover .ai-engagement-button-arrow-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  @media screen and (max-width: 768px) {
    .ai-engagement-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 32px;
      padding: 0 20px;
    }

    .ai-engagement-images-{{ ai_gen_id }} {
      flex: 1 1 100%;
      width: 100%;
    }

    .ai-engagement-content-{{ ai_gen_id }} {
      flex: 1 1 100%;
      width: 100%;
      text-align: center;
      align-items: center;
    }

    .ai-engagement-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size_mobile }}px;
    }

    .ai-engagement-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_font_size_mobile }}px;
    }

    .ai-engagement-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<engagement-rings-section-{{ ai_gen_id }} class="ai-engagement-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-engagement-container-{{ ai_gen_id }}">
    <div class="ai-engagement-images-{{ ai_gen_id }}">
      <div class="ai-engagement-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_1 %}
          <img
            src="{{ block.settings.image_1 | image_url: width: 600 }}"
            alt="{{ block.settings.image_1.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_1.width }}"
            height="{{ block.settings.image_1.height }}"
          >
        {% else %}
          <div class="ai-engagement-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-engagement-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image_2 %}
          <img
            src="{{ block.settings.image_2 | image_url: width: 600 }}"
            alt="{{ block.settings.image_2.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_2.width }}"
            height="{{ block.settings.image_2.height }}"
          >
        {% else %}
          <div class="ai-engagement-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-engagement-content-{{ ai_gen_id }}">
      {% if block.settings.label_text != blank %}
        <p class="ai-engagement-label-{{ ai_gen_id }}">{{ block.settings.label_text }}</p>
      {% endif %}

      {% if block.settings.heading_text != blank %}
        <h2 class="ai-engagement-heading-{{ ai_gen_id }}">{{ block.settings.heading_text }}</h2>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-engagement-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
          <span class="ai-engagement-button-arrow-{{ ai_gen_id }}">→</span>
        </a>
      {% endif %}
    </div>
  </div>
</engagement-rings-section-{{ ai_gen_id }}>

<script>
  (function() {
    class EngagementRingsSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('engagement-rings-section-{{ ai_gen_id }}', EngagementRingsSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
