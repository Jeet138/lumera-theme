{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-csr-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-csr-container-{{ ai_gen_id }} {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 30px;
  }

  .ai-csr-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-csr-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px;
    font-weight: 500;
  }

  .ai-csr-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-csr-stats-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    margin: 60px 0;
  }

  .ai-csr-stat-{{ ai_gen_id }} {
    text-align: center;
    padding: 30px 20px;
    background-color: {{ block.settings.stat_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-csr-stat-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .ai-csr-stat-number-{{ ai_gen_id }} {
    font-size: 48px;
    font-weight: 700;
    color: {{ block.settings.stat_number_color }};
    margin: 0 0 10px;
    line-height: 1;
  }

  .ai-csr-stat-label-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.stat_label_color }};
    font-weight: 500;
  }

  .ai-csr-initiatives-{{ ai_gen_id }} {
    margin: 60px 0;
  }

  .ai-csr-initiatives-title-{{ ai_gen_id }} {
    font-size: 28px;
    color: {{ block.settings.title_color }};
    margin: 0 0 30px;
    text-align: center;
    font-weight: 500;
  }

  .ai-csr-initiatives-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
  }

  .ai-csr-initiative-{{ ai_gen_id }} {
    padding: 30px;
    background-color: {{ block.settings.initiative_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border-left: 4px solid {{ block.settings.accent_color }};
  }

  .ai-csr-initiative-icon-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    background-color: {{ block.settings.accent_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .ai-csr-initiative-icon-{{ ai_gen_id }} svg {
    width: 28px;
    height: 28px;
    fill: {{ block.settings.icon_color }};
  }

  .ai-csr-initiative-title-{{ ai_gen_id }} {
    font-size: 20px;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px;
    font-weight: 600;
  }

  .ai-csr-initiative-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-csr-instagram-{{ ai_gen_id }} {
    margin-top: 80px;
  }

  .ai-csr-instagram-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-csr-instagram-title-{{ ai_gen_id }} {
    font-size: 28px;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px;
    font-weight: 500;
  }

  .ai-csr-instagram-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.accent_color }};
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    transition: opacity 0.3s ease;
  }

  .ai-csr-instagram-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-csr-instagram-link-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    fill: {{ block.settings.accent_color }};
  }

  .ai-csr-instagram-feed-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .ai-csr-instagram-post-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.stat_bg_color }};
    cursor: pointer;
  }

  .ai-csr-instagram-post-{{ ai_gen_id }} img,
  .ai-csr-instagram-post-{{ ai_gen_id }} video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-csr-instagram-post-{{ ai_gen_id }}:hover img,
  .ai-csr-instagram-post-{{ ai_gen_id }}:hover video {
    transform: scale(1.05);
  }

  .ai-csr-instagram-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.7) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: flex-end;
    padding: 20px;
  }

  .ai-csr-instagram-post-{{ ai_gen_id }}:hover .ai-csr-instagram-overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-csr-instagram-caption-{{ ai_gen_id }} {
    color: #ffffff;
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-csr-instagram-play-icon-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: background-color 0.3s ease;
    z-index: 2;
  }

  .ai-csr-instagram-post-{{ ai_gen_id }}:hover .ai-csr-instagram-play-icon-{{ ai_gen_id }} {
    background-color: rgba(255, 255, 255, 1);
  }

  .ai-csr-instagram-play-icon-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    fill: {{ block.settings.accent_color }};
    margin-left: 3px;
  }

  @media screen and (max-width: 768px) {
    .ai-csr-instagram-feed-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }
{% endstyle %}

<div class="ai-csr-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-csr-container-{{ ai_gen_id }}">
    <div class="ai-csr-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-csr-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-csr-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>

    <div class="ai-csr-stats-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% assign num = 'stat_' | append: i | append: '_number' %}
        {% assign lbl = 'stat_' | append: i | append: '_label' %}
        {% if block.settings[num] != blank %}
          <div class="ai-csr-stat-{{ ai_gen_id }}">
            <div class="ai-csr-stat-number-{{ ai_gen_id }}">{{ block.settings[num] }}</div>
            <div class="ai-csr-stat-label-{{ ai_gen_id }}">{{ block.settings[lbl] }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_instagram %}
      <div class="ai-csr-instagram-{{ ai_gen_id }}">
        <div class="ai-csr-instagram-header-{{ ai_gen_id }}">
          <h3 class="ai-csr-instagram-title-{{ ai_gen_id }}">{{ block.settings.instagram_title }}</h3>
          {% if block.settings.instagram_url %}
            <a href="{{ block.settings.instagram_url }}" target="_blank" rel="noopener" class="ai-csr-instagram-link-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5z"/></svg>
              {{ block.settings.instagram_handle }}
            </a>
          {% endif %}
        </div>

        {% if block.settings.instagram_url %}
          <div class="ai-csr-instagram-feed-{{ ai_gen_id }}">
            {% for i in (1..6) %}
              {% assign type = 'instagram_media_type_' | append: i %}
              {% assign img = 'instagram_image_' | append: i %}
              {% assign vid = 'instagram_video_' | append: i %}
              {% assign cap = 'instagram_caption_' | append: i %}
              {% assign media_type = block.settings[type] %}
              {% if media_type == 'image' and block.settings[img] %}
                <div class="ai-csr-instagram-post-{{ ai_gen_id }}">
                  <img src="{{ block.settings[img] | image_url: width: 500 }}" alt="{{ block.settings[cap] | escape }}" loading="lazy">
                  {% if block.settings[cap] %}
                    <div class="ai-csr-instagram-overlay-{{ ai_gen_id }}"><p class="ai-csr-instagram-caption-{{ ai_gen_id }}">{{ block.settings[cap] }}</p></div>
                  {% endif %}
                </div>
              {% elsif media_type == 'video' and block.settings[vid] %}
                <div class="ai-csr-instagram-post-{{ ai_gen_id }}">
                  <video width="500" height="500" loop muted playsinline preload="metadata" poster="{{ block.settings[vid].preview_image | image_url: width: 500 }}">
                    {% for source in block.settings[vid].sources %}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {% endfor %}
                  </video>
                  <div class="ai-csr-instagram-play-icon-{{ ai_gen_id }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                  {% if block.settings[cap] %}
                    <div class="ai-csr-instagram-overlay-{{ ai_gen_id }}"><p class="ai-csr-instagram-caption-{{ ai_gen_id }}">{{ block.settings[cap] }}</p></div>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.ai-csr-instagram-post-{{ ai_gen_id }} video').forEach(video => {
      const post = video.closest('.ai-csr-instagram-post-{{ ai_gen_id }}');
      const playIcon = post.querySelector('.ai-csr-instagram-play-icon-{{ ai_gen_id }}');

      post.addEventListener('click', () => {
        if (video.paused) {
          video.play();
          if (playIcon) playIcon.style.opacity = '0';
        } else {
          video.pause();
          if (playIcon) playIcon.style.opacity = '1';
        }
      });

      video.addEventListener('ended', () => {
        if (playIcon) playIcon.style.opacity = '1';
      });
    });
  });
</script>


<csr-instagram-feed-{{ ai_gen_id }}>
</csr-instagram-feed-{{ ai_gen_id }}>

