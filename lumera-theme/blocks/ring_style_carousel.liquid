{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}

  /* =========================================================
     MAIN SECTION
  ========================================================= */

  .ai-ring-carousel-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 0px 0;
    background: #FEF8F1;
    display: block;
    overflow: hidden;
  }


  /* =========================================================
     HEADER
  ========================================================= */

  .ai-ring-carousel-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 0px;
  }

  .ai-ring-carousel-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    font-weight: 400;
    letter-spacing: 0.5px;
  }

  .ai-ring-carousel-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 auto;
    opacity: 0.8;
    max-width: 600px;
    line-height: 1.6;
  }


  /* =========================================================
     WRAPPER
  ========================================================= */

  .ai-ring-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 40px;
    overflow: visible;
  }


  /* =========================================================
     TRACK
  ========================================================= */

  .ai-ring-carousel-track-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 430px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: visible;

    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }


  /* =========================================================
     IMAGE ITEM
     
     IMPORTANT:
     Fixed width + height prevents 9th/10th image
     from becoming huge.
  ========================================================= */

  .ai-ring-carousel-item-{{ ai_gen_id }} {
    position: absolute;

    width: 560px;
    height: 400px;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    opacity: 0;
    pointer-events: none;

    transition:
      transform 0.55s cubic-bezier(.22,.61,.36,1),
      opacity 0.35s ease;

    will-change: transform, opacity;

    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;

    transform-style: preserve-3d;

    overflow: hidden;
  }


  /* =========================================================
     ACTIVE IMAGE
  ========================================================= */

  .ai-ring-carousel-item-{{ ai_gen_id }}.active {
    opacity: 1;
    pointer-events: auto;
  }


  /* =========================================================
     IMAGE
  ========================================================= */

  .ai-ring-carousel-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: center;

    display: block;

    transform: translateZ(0);

    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }


  /* =========================================================
     CONTROLS
  ========================================================= */

  .ai-ring-carousel-controls-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 0;

    margin-top: -33px;

    position: relative;
    z-index: 20;
  }


  /* =========================================================
     ARROWS
  ========================================================= */

  .ai-ring-carousel-arrow-{{ ai_gen_id }} {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;

    background: {{ block.settings.arrow_bg_color }};

    border: 2px solid {{ block.settings.arrow_border_color }};

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    transition:
      background 0.3s ease,
      transform 0.3s ease;

    color: {{ block.settings.arrow_icon_color }};

    flex-shrink: 0;

    padding: 0;
  }


  .ai-ring-carousel-arrow-{{ ai_gen_id }}:hover {
    background: {{ block.settings.arrow_hover_bg }};
    transform: scale(1.08);
  }


  .ai-ring-carousel-arrow-{{ ai_gen_id }}:active {
    transform: scale(0.96);
  }


  .ai-ring-carousel-arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }


  /* =========================================================
     INFO
  ========================================================= */

  .ai-ring-carousel-info-{{ ai_gen_id }} {
    text-align: center;

    min-width: 200px;
    max-width: 300px;

    padding: 0 15px;
  }


  .ai-ring-carousel-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;

    color: {{ block.settings.text_color }};

    margin: 0 0 8px;

    font-weight: 500;
  }


  .ai-ring-carousel-product-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_subtitle_size }}px;

    color: {{ block.settings.text_color }};

    margin: 0;

    opacity: 0.7;
  }


  /* =========================================================
     LARGE DESKTOP
     1600px+
  ========================================================= */

  @media screen and (min-width: 1600px) {

    .ai-ring-carousel-track-{{ ai_gen_id }} {
      height: 400px;
    }

    .ai-ring-carousel-item-{{ ai_gen_id }} {
      width: 560px;
      height: 400px;
    }

  }


  /* =========================================================
     DESKTOP
     1201px - 1599px
  ========================================================= */

  @media screen and (min-width: 1201px) and (max-width: 1599px) {

    .ai-ring-carousel-track-{{ ai_gen_id }} {
      height: 350px;
    }

    .ai-ring-carousel-item-{{ ai_gen_id }} {
      width: 500px;
      height: 360px;
    }

  }


  /* =========================================================
     TABLET
     769px - 1200px
  ========================================================= */

  @media screen and (min-width: 769px) and (max-width: 1200px) {

    .ai-ring-carousel-wrapper-{{ ai_gen_id }} {
      padding: 0 20px;
    }

    .ai-ring-carousel-track-{{ ai_gen_id }} {
      height: 360px;
    }

    .ai-ring-carousel-item-{{ ai_gen_id }} {
      width: 430px;
      height: 320px;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media screen and (max-width: 768px) {

    .ai-ring-carousel-wrapper-{{ ai_gen_id }} {
      padding: 0 10px;
    }

    .ai-ring-carousel-track-{{ ai_gen_id }} {
      height: 280px;
      margin-bottom: 0px;
    }

    .ai-ring-carousel-item-{{ ai_gen_id }} {
      width: 280px;
      height: 230px;
    }

    .ai-ring-carousel-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-ring-carousel-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-ring-carousel-arrow-{{ ai_gen_id }} {
      width: {{ block.settings.arrow_size | times: 0.8 }}px;
      height: {{ block.settings.arrow_size | times: 0.8 }}px;
    }

    .ai-ring-carousel-controls-{{ ai_gen_id }} {
      gap: 18px;
    }

    .ai-ring-carousel-info-{{ ai_gen_id }} {
      min-width: 150px;
      max-width: 200px;
    }

  }


  /* =========================================================
     SMALL MOBILE
  ========================================================= */

  @media screen and (max-width: 480px) {

    .ai-ring-carousel-track-{{ ai_gen_id }} {
      height: 195px;
    }

    .ai-ring-carousel-item-{{ ai_gen_id }} {
      width: 230px;
      height: 195px;
    }

    .ai-ring-carousel-controls-{{ ai_gen_id }} {
      gap: 12px;
    }

    .ai-ring-carousel-info-{{ ai_gen_id }} {
      min-width: 135px;
      max-width: 170px;
    }

  }

{% endstyle %}


<ring-carousel-{{ ai_gen_id }} class="ai-ring-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ring-carousel-header-{{ ai_gen_id }}">
    {% if block.settings.main_title != blank %}
      <h2 class="ai-ring-carousel-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
    {% endif %}
    {% if block.settings.main_subtitle != blank %}
      <p class="ai-ring-carousel-subtitle-{{ ai_gen_id }}">{{ block.settings.main_subtitle }}</p>
    {% endif %}
  </div>

  <div class="ai-ring-carousel-wrapper-{{ ai_gen_id }}">
    <div class="ai-ring-carousel-track-{{ ai_gen_id }}" data-track>
      {% for i in (1..15) %}
        {% assign image_key = 'ring_image_' | append: i %}
        {% assign title_key = 'ring_title_' | append: i %}
        {% assign subtitle_key = 'ring_subtitle_' | append: i %}
        {% assign link_key = 'ring_link_' | append: i %}

        {% assign ring_image = block.settings[image_key] %}
        {% assign ring_title = block.settings[title_key] %}
        {% assign ring_subtitle = block.settings[subtitle_key] %}
        {% assign ring_link = block.settings[link_key] %}

        {% if ring_image != blank %}
          <div
            class="ai-ring-carousel-item-{{ ai_gen_id }}"
            data-index="{{ forloop.index0 }}"
            data-link="{{ ring_link }}"
            data-title="{{ ring_title }}"
            data-subtitle="{{ ring_subtitle }}"
          >
            <img
              src="{{ ring_image | image_url: width: 800 }}"
              alt="{{ ring_title | escape }}"
              loading="lazy"
              width="800"
              height="800"
            >
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-ring-carousel-controls-{{ ai_gen_id }}">
      <button class="ai-ring-carousel-arrow-{{ ai_gen_id }}" data-prev aria-label="Previous ring">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-ring-carousel-info-{{ ai_gen_id }}" data-info>
        <h3 class="ai-ring-carousel-product-title-{{ ai_gen_id }}" data-product-title></h3>
        <p class="ai-ring-carousel-product-subtitle-{{ ai_gen_id }}" data-product-subtitle></p>
      </div>

      <button class="ai-ring-carousel-arrow-{{ ai_gen_id }}" data-next aria-label="Next ring">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</ring-carousel-{{ ai_gen_id }}>

<script>
(function() {

  class RingCarousel{{ ai_gen_id }} extends HTMLElement {

    constructor() {

      super();

      this.currentIndex = 0;

      this.items = [];

      this.totalItems = 0;

      this.isAnimating = false;

      this.startX = 0;
      this.startY = 0;

      this.endX = 0;
      this.endY = 0;

    }


    /* =========================================================
       INITIALIZE
    ========================================================= */

    connectedCallback() {

      this.track =
        this.querySelector('[data-track]');

      this.prevBtn =
        this.querySelector('[data-prev]');

      this.nextBtn =
        this.querySelector('[data-next]');

      this.infoContainer =
        this.querySelector('[data-info]');

      this.titleEl =
        this.querySelector('[data-product-title]');

      this.subtitleEl =
        this.querySelector('[data-product-subtitle]');


      this.items = Array.from(
        this.querySelectorAll(
          '.ai-ring-carousel-item-{{ ai_gen_id }}'
        )
      );


      this.totalItems =
        this.items.length;


      if (
        !this.track ||
        this.totalItems === 0
      ) {

        return;

      }


      /* Initialize only once */

      this.setupEventListeners();

      this.setupTouch();

      this.updateCarousel();

    }


    /* =========================================================
       BUTTONS + IMAGE CLICK
    ========================================================= */

    setupEventListeners() {

      if (this.prevBtn) {

        this.prevBtn.addEventListener(
          'click',
          () => {

            this.navigate(-1);

          }
        );

      }


      if (this.nextBtn) {

        this.nextBtn.addEventListener(
          'click',
          () => {

            this.navigate(1);

          }
        );

      }


      this.items.forEach(
        (item) => {

          item.addEventListener(
            'click',
            () => {

              const link =
                item.getAttribute(
                  'data-link'
                );


              if (
                link &&
                link !== ''
              ) {

                window.location.href =
                  link;

              }

            }
          );

        }
      );

    }


    /* =========================================================
       TOUCH / SWIPE
    ========================================================= */

    setupTouch() {

      let startX = 0;
      let startY = 0;

      let endX = 0;
      let endY = 0;


      this.track.addEventListener(
        'touchstart',
        (e) => {

          if (
            !e.touches ||
            !e.touches.length
          ) {

            return;

          }


          startX =
            e.touches[0].clientX;

          startY =
            e.touches[0].clientY;

          endX = startX;

          endY = startY;

        },
        {
          passive: true
        }
      );


      this.track.addEventListener(
        'touchmove',
        (e) => {

          if (
            !e.touches ||
            !e.touches.length
          ) {

            return;

          }


          endX =
            e.touches[0].clientX;

          endY =
            e.touches[0].clientY;

        },
        {
          passive: true
        }
      );


      this.track.addEventListener(
        'touchend',
        () => {

          const diffX =
            startX - endX;

          const diffY =
            startY - endY;


          /* Ignore vertical scrolling */

          if (
            Math.abs(diffY) >
            Math.abs(diffX)
          ) {

            return;

          }


          /* Ignore small swipe */

          if (
            Math.abs(diffX) < 40
          ) {

            return;

          }


          if (diffX > 0) {

            /* Swipe left = next */

            this.navigate(1);

          } else {

            /* Swipe right = previous */

            this.navigate(-1);

          }

        }
      );

    }


    /* =========================================================
       NAVIGATION
    ========================================================= */

    navigate(direction) {

      if (
        this.isAnimating ||
        this.totalItems === 0
      ) {

        return;

      }


      this.isAnimating = true;


      this.currentIndex =
        (
          this.currentIndex +
          direction +
          this.totalItems
        ) %
        this.totalItems;


      this.updateCarousel();


      setTimeout(
        () => {

          this.isAnimating = false;

        },
        600
      );

    }


    /* =========================================================
       RESPONSIVE VALUES
       
       Automatically changes image positioning
       according to screen width.
    ========================================================= */

    getResponsiveValues() {

      const width =
        window.innerWidth;


      /* -----------------------------------------
         LARGE DESKTOP
         1600px+
      ----------------------------------------- */

      if (width >= 1600) {

        return {

          sideX: 455,

          secondX: 760,

          sideY: -35,

          secondY: -55,

          sideScale: 0.68,

          secondScale: 0.48

        };

      }


      /* -----------------------------------------
         DESKTOP
         1201 - 1599
      ----------------------------------------- */

      if (width >= 1201) {

        return {

          sideX: 405,

          secondX: 680,

          sideY: -35,

          secondY: -50,

          sideScale: 0.66,

          secondScale: 0.46

        };

      }


      /* -----------------------------------------
         TABLET
         769 - 1200
      ----------------------------------------- */

      if (width >= 769) {

        return {

          sideX: 330,

          secondX: 560,

          sideY: -25,

          secondY: -40,

          sideScale: 0.64,

          secondScale: 0.44

        };

      }


      /* -----------------------------------------
         MOBILE
         481 - 768
      ----------------------------------------- */

      if (width >= 481) {

        return {

          sideX: 225,

          secondX: 380,

          sideY: -15,

          secondY: -25,

          sideScale: 0.62,

          secondScale: 0.42

        };

      }


      /* -----------------------------------------
         SMALL MOBILE
         480px and below
      ----------------------------------------- */

      return {

        sideX: 185,

        secondX: 300,

        sideY: -10,

        secondY: -20,

        sideScale: 0.60,

        secondScale: 0.40

      };

    }


    /* =========================================================
       UPDATE CAROUSEL
    ========================================================= */

    updateCarousel() {

      const positions =
        this.calculatePositions();


      this.items.forEach(
        (item, index) => {

          const pos =
            positions[index];


          if (!pos) {

            return;

          }


          item.classList.toggle(
            'active',
            pos.active
          );


          item.style.transform =
            `translate3d(
              ${pos.x}px,
              ${pos.y}px,
              0
            ) scale(${pos.scale})`;


          item.style.zIndex =
            pos.zIndex;


          item.style.opacity =
            pos.opacity;

        }
      );


      /* -----------------------------------------
         UPDATE CENTER TEXT
      ----------------------------------------- */

      const centerItem =
        this.items[
          this.currentIndex
        ];


      if (!centerItem) {

        return;

      }


      const title =
        centerItem.getAttribute(
          'data-title'
        ) || '';


      const subtitle =
        centerItem.getAttribute(
          'data-subtitle'
        ) || '';


      if (this.titleEl) {

        this.titleEl.textContent =
          title;

      }


      if (this.subtitleEl) {

        this.subtitleEl.textContent =
          subtitle;

      }

    }


    /* =========================================================
       CALCULATE POSITIONS
    ========================================================= */

    calculatePositions() {

      const positions = [];


      const responsive =
        this.getResponsiveValues();


      for (
        let i = 0;
        i < this.totalItems;
        i++
      ) {

        let diff =
          i - this.currentIndex;


        /* -----------------------------------------
           CIRCULAR POSITION
        ----------------------------------------- */

        if (
          diff >
          this.totalItems / 2
        ) {

          diff -=
            this.totalItems;

        }


        if (
          diff <
          -this.totalItems / 2
        ) {

          diff +=
            this.totalItems;

        }


        let pos = {

          x: 0,

          y: 0,

          scale: 0,

          zIndex: 0,

          opacity: 0,

          active: false

        };


        /* =====================================================
           CENTER IMAGE
        ===================================================== */

        switch (diff) {


          case 0:

            pos = {

              x: 0,

              y: 0,

              /*
               * CENTER IMAGE
               * Full size
               */

              scale: 1,

              zIndex: 10,

              opacity: 1,

              active: true

            };

            break;


          /* =====================================================
             RIGHT FIRST IMAGE
          ===================================================== */

          case 1:

            pos = {

              x:
                responsive.sideX,

              y:
                responsive.sideY,

              /*
               * LEFT / RIGHT IMAGE
               * Bigger than previous version
               */

              scale:
                responsive.sideScale,

              zIndex: 8,

              opacity: 1,

              active: true

            };

            break;


          /* =====================================================
             RIGHT SECOND IMAGE
          ===================================================== */

          case 2:

            pos = {

              x:
                responsive.secondX,

              y:
                responsive.secondY,

              scale:
                responsive.secondScale,

              zIndex: 6,

              opacity: 0.82,

              active: true

            };

            break;


          /* =====================================================
             LEFT FIRST IMAGE
          ===================================================== */

          case -1:

            pos = {

              x:
                -responsive.sideX,

              y:
                responsive.sideY,

              scale:
                responsive.sideScale,

              zIndex: 8,

              opacity: 1,

              active: true

            };

            break;


          /* =====================================================
             LEFT SECOND IMAGE
          ===================================================== */

          case -2:

            pos = {

              x:
                -responsive.secondX,

              y:
                responsive.secondY,

              scale:
                responsive.secondScale,

              zIndex: 6,

              opacity: 0.82,

              active: true

            };

            break;


          /* =====================================================
             ALL OTHER IMAGES
             
             9th, 10th, 11th, 12th etc.
             stay hidden until they become active.
          ===================================================== */

          default:

            pos = {

              x:
                diff * 430,

              y: -80,

              scale: 0.25,

              zIndex: 1,

              opacity: 0,

              active: false

            };

            break;

        }


        positions.push(pos);

      }


      return positions;

    }

  }


  /* =========================================================
     DEFINE CUSTOM ELEMENT
  ========================================================= */

  if (
    !customElements.get(
      'ring-carousel-{{ ai_gen_id }}'
    )
  ) {

    customElements.define(
      'ring-carousel-{{ ai_gen_id }}',
      RingCarousel{{ ai_gen_id }}
    );

  }


  /* =========================================================
     HANDLE RESIZE
     
     Recalculate positions when browser width changes.
  ========================================================= */

  window.addEventListener(
    'resize',
    () => {

      const carousel =
        document.querySelector(
          'ring-carousel-{{ ai_gen_id }}'
        );


      if (
        carousel &&
        typeof carousel.updateCarousel ===
        'function'
      ) {

        carousel.updateCarousel();

      }

    }
  );

})();
</script>

{% schema %}
{
  "name": "Ring style carousel",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Title",
      "default": "Discover Styles"
    },
    {
      "type": "textarea",
      "id": "main_subtitle",
      "label": "Subtitle",
      "default": "Discover diverse engagement ring styles, each embodying a distinct symbol of love and devotion"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Ring 1"
    },
    {
      "type": "image_picker",
      "id": "ring_image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "ring_title_1",
      "label": "Title",
      "default": "Classic Solitaire"
    },
    {
      "type": "text",
      "id": "ring_subtitle_1",
      "label": "Subtitle",
      "default": "Timeless elegance"
    },
    {
      "type": "url",
      "id": "ring_link_1",
      "label": "Collection link"
    },
    {
      "type": "header",
      "content": "Ring 2"
    },
    {
      "type": "image_picker",
      "id": "ring_image_2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "ring_title_2",
      "label": "Title",
      "default": "Halo Design"
    },
    {
      "type": "text",
      "id": "ring_subtitle_2",
      "label": "Subtitle",
      "default": "Radiant brilliance"
    },
    {
      "type": "url",
      "id": "ring_link_2",
      "label": "Collection link"
    },
    {
      "type": "header",
      "content": "Ring 3"
    },
    {
