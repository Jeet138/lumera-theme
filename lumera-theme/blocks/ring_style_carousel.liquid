{%- comment -%}
  Ring style U-slider: slides sit on a U-shaped arc (center lowest and largest,
  sides rise, shrink and tilt). Motion is a rAF spring that only runs while moving;
  only transform/opacity are animated. Supports drag/swipe, trackpad, keyboard and autoplay.
{%- endcomment -%}
{%- assign s = block.settings -%}
<u-ring-slider
  class="urs"
  {{ block.shopify_attributes }}
  data-autoplay="{{ s.autoplay }}"
  data-speed="{{ s.autoplay_speed | times: 1000 }}"
  data-depth="{{ s.curve_depth }}"
  style="--urs-w:{{ s.desktop_width_percent }}%;--urs-pad:{{ s.section_padding }}px;--urs-text:{{ s.text_color }};--urs-title:{{ s.title_size }}px;--urs-sub:{{ s.subtitle_size }}px;--urs-ptitle:{{ s.product_title_size }}px;--urs-psub:{{ s.product_subtitle_size }}px;--urs-arrow:{{ s.arrow_size }}px;--urs-arrow-bg:{{ s.arrow_bg_color }};--urs-arrow-bd:{{ s.arrow_border_color }};--urs-arrow-ic:{{ s.arrow_icon_color }};--urs-arrow-hover:{{ s.arrow_hover_bg }};--urs-shadow:{{ s.shadow_color }};--urs-shadow-y:{{ s.shadow_offset }}px;--urs-shadow-blur:{{ s.shadow_blur }}px;"
>
  {%- if s.main_title != blank or s.main_subtitle != blank -%}
    <div class="urs__head">
      {%- if s.main_title != blank -%}<h2 class="urs__title">{{ s.main_title | escape }}</h2>{%- endif -%}
      {%- if s.main_subtitle != blank -%}<p class="urs__sub">{{ s.main_subtitle | escape }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="urs__stage" data-stage role="region" aria-roledescription="carousel" aria-label="{{ s.main_title | default: 'Ring styles' | escape }}">
    {%- assign count = 0 -%}
    {%- for i in (1..15) -%}
      {%- liquid
        assign k_img = 'ring_image_' | append: i
        assign k_title = 'ring_title_' | append: i
        assign k_sub = 'ring_subtitle_' | append: i
        assign k_link = 'ring_link_' | append: i
        assign img = s[k_img]
        assign title = s[k_title]
        assign sub = s[k_sub]
        assign link = s[k_link]
        if img == blank and title == blank
          continue
        endif
        assign count = count | plus: 1
        if count == 1
          assign first_title = title
          assign first_sub = sub
          assign first_link = link
        endif
        if link != blank
          assign tag = 'a'
        else
          assign tag = 'div'
        endif
      -%}
      <{{ tag }}
        class="urs__item{% if count == 1 %} is-active{% endif %}"
        data-item
        {% if link != blank %}href="{{ link }}"{% endif %}
        data-title="{{ title | escape }}"
        data-sub="{{ sub | escape }}"
        aria-label="{{ title | escape }}"
        tabindex="-1"
        draggable="false"
      >
        <span class="urs__media">
          {%- if img != blank -%}
            {{ img | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 1200px) 440px, (min-width: 750px) 34vw, 55vw', loading: 'lazy', class: 'urs__img', alt: title, draggable: 'false' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'urs__img' }}
          {%- endif -%}
        </span>
      </{{ tag }}>
    {%- endfor -%}
    <span class="urs__floor" aria-hidden="true"></span>
  </div>

  {%- if count > 0 -%}
    <div class="urs__nav">
      <button type="button" class="urs__arrow" data-prev aria-label="Previous style"{% if count < 2 %} hidden{% endif %}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="urs__caption" aria-live="polite">
        <h3 class="urs__ptitle"><a data-ctitle {% if first_link != blank %}href="{{ first_link }}"{% endif %}>{{ first_title | escape }}</a></h3>
        <p class="urs__psub" data-csub>{{ first_sub | escape }}</p>
      </div>
      <button type="button" class="urs__arrow" data-next aria-label="Next style"{% if count < 2 %} hidden{% endif %}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  {%- endif -%}
</u-ring-slider>

{% stylesheet %}
  .urs {
    --urs-size: clamp(180px, 15vw + 140px, 440px);
    display: block;
    width: var(--urs-w, 100%);
    max-width: 100%;
    margin: 0 auto;
    padding: var(--urs-pad) 0;
    color: var(--urs-text);
    overflow: hidden;
  }
  .urs__head { text-align: center; padding: 0 20px; margin-bottom: clamp(4px, 1.5vw, 20px); }
  .urs__title {
    margin: 0 0 0.35em;
    font-size: min(var(--urs-title), calc(18px + 3vw));
    font-weight: 400;
    line-height: 1.15;
    color: inherit;
  }
  .urs__sub {
    max-width: 760px;
    margin: 0 auto;
    font-size: min(var(--urs-sub), calc(12px + 0.6vw));
    line-height: 1.7;
    opacity: 0.8;
  }

  .urs__stage {
    position: relative;
    height: calc(var(--urs-size) * 1.35);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }
  .urs__stage.is-dragging { cursor: grabbing; }
  .urs__item {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 1;
    width: var(--urs-size);
    height: var(--urs-size);
    margin-left: calc(var(--urs-size) / -2);
    display: block;
    visibility: hidden;
    opacity: 0;
    transform-origin: 50% 50%;
    will-change: transform, opacity;
    backface-visibility: hidden;
    -webkit-user-drag: none;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }
  .urs.is-ready .urs__item { visibility: visible; }
  .urs:not(.is-ready) .urs__item.is-active { top: auto; bottom: 24px; visibility: visible; opacity: 1; }
  .urs__media {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    overflow: hidden;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .urs__item.is-active:hover .urs__media { transform: scale(1.04); }
  .urs__item:focus-visible .urs__media { outline: 2px solid currentColor; outline-offset: 4px; }
  .urs__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }
  .urs__floor {
    position: absolute;
    left: 50%;
    bottom: calc(24px - var(--urs-shadow-y) * 0.6);
    z-index: 0;
    width: calc(var(--urs-size) * 0.62);
    height: calc(var(--urs-shadow-blur) * 0.9);
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--urs-shadow), transparent);
    pointer-events: none;
  }

  .urs__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 3vw, 36px);
    margin-top: clamp(8px, 1.5vw, 20px);
    padding: 0 16px;
  }
  .urs__arrow {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--urs-arrow);
    height: var(--urs-arrow);
    padding: 0;
    border: 1.5px solid var(--urs-arrow-bd);
    border-radius: 50%;
    background: var(--urs-arrow-bg);
    color: var(--urs-arrow-ic);
    cursor: pointer;
    transition: background-color 0.25s, transform 0.25s;
  }
  .urs__arrow:hover { background: var(--urs-arrow-hover); transform: scale(1.06); }
  .urs__arrow:active { transform: scale(0.94); }
  .urs__arrow:focus-visible { outline: 2px solid var(--urs-arrow-bd); outline-offset: 3px; }
  .urs__arrow svg { width: 38%; height: 38%; }
  .urs__caption { width: clamp(150px, 36vw, 320px); min-width: 0; text-align: center; }
  .urs__ptitle {
    margin: 0 0 4px;
    font-size: min(var(--urs-ptitle), calc(15px + 1vw));
    font-weight: 400;
    line-height: 1.25;
    color: inherit;
  }
  .urs__ptitle a { color: inherit; text-decoration: none; }
  .urs__ptitle a[href]:hover { text-decoration: underline; text-underline-offset: 4px; }
  .urs__psub { margin: 0; font-size: min(var(--urs-psub), calc(12px + 0.5vw)); opacity: 0.75; }

  @media (max-width: 699px) {
    .urs { --urs-size: min(60vw, 300px); }
  }
  @media (max-width: 749px) {
    .urs__arrow { width: min(var(--urs-arrow), 46px); height: min(var(--urs-arrow), 46px); }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    if (customElements.get('u-ring-slider')) return;

    var mod = function (i, n) { return ((i % n) + n) % n; };

    class URingSlider extends HTMLElement {
      connectedCallback() {
        if (this._init) return;
        this.stage = this.querySelector('[data-stage]');
        this.items = Array.prototype.slice.call(this.querySelectorAll('[data-item]'));
        this.n = this.items.length;
        if (!this.stage || !this.n) return;
        this._init = true;

        this.floor = this.querySelector('.urs__floor');
        this.cTitle = this.querySelector('[data-ctitle]');
        this.cSub = this.querySelector('[data-csub]');
        this.reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.depth = (parseFloat(this.dataset.depth) || 0) / 100;
        this.speed = parseInt(this.dataset.speed, 10) || 4000;
        this.autoplay = this.dataset.autoplay === 'true' && !this.reduce && this.n > 1;

        this.pos = 0;
        this.target = 0;
        this.vel = 0;
        this.active = 0;
        this.raf = 0;
        this.paused = { hover: false, focus: false, view: true, tab: false };
        this.frame = this.frame.bind(this);

        this.layout();
        this.render();
        this.setActive(0, true);
        this.classList.add('is-ready');

        this.bind();
      }

      disconnectedCallback() {
        if (!this._init) return;
        cancelAnimationFrame(this.raf);
        clearTimeout(this.timer);
        if (this.ro) this.ro.disconnect();
        if (this.io) this.io.disconnect();
        document.removeEventListener('visibilitychange', this.onVis);
        this._init = false;
        this.raf = 0;
      }

      /* ---------- geometry ---------- */
      layout() {
        var W = this.stage.clientWidth || window.innerWidth;
        var size = W < 700 ? Math.min(W * 0.6, 300) : Math.min(440, 0.15 * W + 140);
        var sp = size * 0.78;
        var vis = Math.max(1, Math.min(3, Math.round(W / 2 / sp)));
        this.vis = Math.max(0, Math.min(vis, Math.floor((this.n - 1) / 2)));
        this.size = size;
        this.sp = sp;
        this.lift = this.depth * size;
        this.liftNorm = Math.max(this.vis, 2);
        this.tilt = 4 + 6 * this.depth;

        /* Highest visual top among visible slots decides the baseline. */
        var minTop = 0;
        for (var a = 1; a <= this.vis; a++) {
          var top = -this.rise(a) + (size * (1 - this.scale(a))) / 2;
          if (top < minTop) minTop = top;
        }
        this.baseY = Math.ceil(-minTop) + 8;
        this.style.setProperty('--urs-size', size + 'px');
        this.stage.style.height = this.baseY + size + 24 + 'px';
      }

      rise(a) { return this.lift * Math.pow(a / this.liftNorm, 1.5); }
      scale(a) { return Math.max(0.35, 1 - 0.16 * a); }

      render() {
        var n = this.n, vis = this.vis;
        for (var i = 0; i < n; i++) {
          var el = this.items[i];
          var d = mod(i - this.pos, n);
          if (d > n / 2) d -= n;
          var a = Math.abs(d);
          if (a >= vis + 1) {
            if (!el._hid) { el.style.visibility = 'hidden'; el._hid = true; }
            continue;
          }
          if (el._hid) { el.style.visibility = ''; el._hid = false; }
          var x = d * this.sp * (1 - 0.06 * a);
          var y = this.baseY - this.rise(a);
          var op = a <= vis ? 1 - 0.1 * a : (1 - 0.1 * vis) * (vis + 1 - a);
          el.style.transform =
            'translate3d(' + x.toFixed(2) + 'px,' + y.toFixed(2) + 'px,0) rotate(' +
            (-d * this.tilt).toFixed(2) + 'deg) scale(' + this.scale(a).toFixed(4) + ')';
          el.style.opacity = op.toFixed(3);
          el.style.zIndex = 100 - Math.round(a * 10);
        }
      }

      /* ---------- motion (spring, runs only while moving) ---------- */
      kick() {
        if (!this.raf) { this.last = 0; this.raf = requestAnimationFrame(this.frame); }
      }

      frame(now) {
        var dt = this.last ? Math.min(32, now - this.last) / 1000 : 1 / 60;
        this.last = now;
        if (!this.dragging) {
          if (this.reduce) {
            this.pos = this.target; this.vel = 0;
          } else {
            this.vel += (170 * (this.target - this.pos) - 24 * this.vel) * dt;
            this.pos += this.vel * dt;
            if (Math.abs(this.target - this.pos) < 0.0008 && Math.abs(this.vel) < 0.002) {
              this.pos = this.target; this.vel = 0;
            }
          }
        }
        this.render();
        var idx = mod(Math.round(this.pos), this.n);
        if (idx !== this.active) this.setActive(idx);
        if (this.dragging || this.pos !== this.target) {
          this.raf = requestAnimationFrame(this.frame);
        } else {
          this.raf = 0;
          /* Keep numbers small after many laps. */
          var base = this.n * Math.floor(this.target / this.n);
          this.pos -= base; this.target -= base;
        }
      }

      go(t) {
        if (this.n < 2) return;
        this.target = t;
        this.kick();
        this.schedule();
      }

      setActive(idx, silent) {
        var prev = this.items[this.active];
        var cur = this.items[idx];
        this.active = idx;
        if (prev) { prev.classList.remove('is-active'); prev.tabIndex = -1; }
        cur.classList.add('is-active');
        cur.tabIndex = cur.hasAttribute('href') ? 0 : -1;
        for (var i = 0; i < this.n; i++) {
          var d = Math.abs(mod(i - idx + Math.floor(this.n / 2), this.n) - Math.floor(this.n / 2));
          this.items[i].setAttribute('aria-hidden', d > this.vis ? 'true' : 'false');
        }
        if (this.cTitle) {
          this.cTitle.textContent = cur.dataset.title || '';
          if (cur.hasAttribute('href')) this.cTitle.setAttribute('href', cur.getAttribute('href'));
          else this.cTitle.removeAttribute('href');
        }
        if (this.cSub) this.cSub.textContent = cur.dataset.sub || '';
        if (silent || this.reduce || !this.cTitle || !this.cTitle.animate) return;
        var ease = 'cubic-bezier(0.22, 1, 0.36, 1)';
        var dir = this._dir || 1;
        this.cTitle.parentNode.animate(
          [{ opacity: 0, transform: 'translateX(' + 18 * dir + 'px)' }, { opacity: 1, transform: 'none' }],
          { duration: 520, easing: ease }
        );
        if (this.cSub) {
          this.cSub.animate(
            [{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 0.75, transform: 'none' }],
            { duration: 620, delay: 60, easing: ease, fill: 'backwards' }
          );
        }
        if (this.floor) {
          this.floor.animate(
            [{ transform: 'translateX(-50%) scaleX(0.55)', opacity: 0.35 }, { transform: 'translateX(-50%) scaleX(1)', opacity: 1 }],
            { duration: 700, easing: ease }
          );
        }
      }

      step(dir) { this._dir = dir; this.go(this.target + dir); }

      /* ---------- input ---------- */
      bind() {
        var self = this;
        var prev = this.querySelector('[data-prev]');
        var next = this.querySelector('[data-next]');
        if (prev) prev.addEventListener('click', function () { self.step(-1); });
        if (next) next.addEventListener('click', function () { self.step(1); });

        this.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowLeft') { e.preventDefault(); self.step(-1); }
          else if (e.key === 'ArrowRight') { e.preventDefault(); self.step(1); }
        });

        /* Click a side slide to bring it to the center; follow the link only when it is centered. */
        this.stage.addEventListener('click', function (e) {
          var item = e.target.closest('[data-item]');
          if (self.moved) { e.preventDefault(); self.moved = false; return; }
          if (!item) return;
          var i = self.items.indexOf(item);
          if (i === self.active) return;
          e.preventDefault();
          var d = mod(i - self.target, self.n);
          if (d > self.n / 2) d -= self.n;
          self._dir = d > 0 ? 1 : -1;
          self.go(self.target + d);
        });
        this.stage.addEventListener('dragstart', function (e) { e.preventDefault(); });

        /* Pointer drag / swipe with momentum. */
        var x0 = 0, y0 = 0, pos0 = 0, lastX = 0, lastT = 0, vx = 0, pid = null, locked = false;
        this.stage.addEventListener('pointerdown', function (e) {
          if (e.button !== 0 || self.n < 2) return;
          pid = e.pointerId; x0 = lastX = e.clientX; y0 = e.clientY; lastT = e.timeStamp;
          pos0 = self.pos; vx = 0; locked = false; self.moved = false;
        });
        this.stage.addEventListener('pointermove', function (e) {
          if (e.pointerId !== pid) return;
          var dx = e.clientX - x0;
          if (!locked) {
            if (Math.abs(dx) < 6) return;
            if (Math.abs(e.clientY - y0) > Math.abs(dx)) { pid = null; return; }
            locked = true; self.dragging = true; self.moved = true;
            self.stage.classList.add('is-dragging');
            try { self.stage.setPointerCapture(pid); } catch (err) {}
            clearTimeout(self.timer);
            self.kick();
          }
          var dt = e.timeStamp - lastT;
          if (dt > 0) vx = 0.8 * ((e.clientX - lastX) / dt) + 0.2 * vx;
          lastX = e.clientX; lastT = e.timeStamp;
          self.pos = pos0 - dx / self.sp;
        });
        var end = function (e) {
          if (e.pointerId !== pid) return;
          pid = null;
          if (!locked) return;
          self.dragging = false;
          self.stage.classList.remove('is-dragging');
          var fling = Math.max(-3, Math.min(3, (-vx * 220) / self.sp));
          var t = Math.round(self.pos + fling);
          self._dir = t >= self.target ? 1 : -1;
          self.vel = Math.max(-12, Math.min(12, (-vx * 1000) / self.sp));
          self.go(t);
        };
        this.stage.addEventListener('pointerup', end);
        this.stage.addEventListener('pointercancel', end);

        /* Horizontal trackpad swipe. */
        var wheelLock = 0;
        this.stage.addEventListener('wheel', function (e) {
          if (Math.abs(e.deltaX) <= Math.abs(e.deltaY) || Math.abs(e.deltaX) < 12) return;
          e.preventDefault();
          if (e.timeStamp < wheelLock) return;
          wheelLock = e.timeStamp + 450;
          self.step(e.deltaX > 0 ? 1 : -1);
        }, { passive: false });

        /* Re-layout on resize (only when width actually changes). */
        var lastW = this.stage.clientWidth;
        this.ro = new ResizeObserver(function () {
          var w = self.stage.clientWidth;
          if (w === lastW) return;
          lastW = w;
          self.layout();
          self.render();
        });
        this.ro.observe(this.stage);

        if (!this.autoplay) return;
        this.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') { self.paused.hover = true; self.schedule(); } });
        this.addEventListener('pointerleave', function () { self.paused.hover = false; self.schedule(); });
        this.addEventListener('focusin', function () { self.paused.focus = true; self.schedule(); });
        this.addEventListener('focusout', function () { self.paused.focus = false; self.schedule(); });
        this.onVis = function () { self.paused.tab = document.hidden; self.schedule(); };
        document.addEventListener('visibilitychange', this.onVis);
        this.io = new IntersectionObserver(function (entries) {
          self.paused.view = !entries[0].isIntersecting;
          self.schedule();
        }, { threshold: 0.25 });
        this.io.observe(this);
      }

      schedule() {
        clearTimeout(this.timer);
        var p = this.paused;
        if (!this.autoplay || p.hover || p.focus || p.view || p.tab || this.dragging) return;
        var self = this;
        this.timer = setTimeout(function () { self.step(1); }, this.speed);
      }
    }

    customElements.define('u-ring-slider', URingSlider);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Ring style carousel",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Title",
      "default": "Discover Styles"
    },
    {
      "type": "textarea",
      "id": "main_subtitle",
      "label": "Subtitle",
      "default": "Discover diverse engagement ring styles, each embodying a distinct symbol of love and devotion"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Ring 1"
    },
    {
      "type": "image_picker",
      "id": "ring_image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "ring_title_1",
      "label": "Title",
      "default": "Classic Solitaire"
    },
    {
      "type": "text",
      "id": "ring_subtitle_1",
      "label": "Subtitle",
      "default": "Timeless elegance"
    },
    {
      "type": "url",
      "id": "ring_link_1",
      "label": "Collection link"
    },
    {
      "type": "header",
      "content": "Ring 2"
    },
    {
      "type": "image_picker",
      "id": "ring_image_2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "ring_title_2",
      "label": "Title",
      "default": "Halo Design"
    },
    {
      "type": "text",
      "id": "ring_subtitle_2",
      "label": "Subtitle",
      "default": "Radiant brilliance"
    },
    {
      "type": "url",
      "id": "ring_link_2",
      "label": "Collection link"
    },
    {
      "type": "header",
      "content": "Ring 3"
    },
    {
      "type": "image_picker",
      "id": "ring_image_3",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "ring_title_3",
      "label": "Title",
      "default": "Vintage Style"
    },
    {
      "type": "text",
      "id": "ring_subtitle_3",
      "label": "Subtitle",
      "default": "Classic romance"
