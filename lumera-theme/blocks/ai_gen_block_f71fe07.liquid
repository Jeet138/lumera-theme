{% doc %}
  @prompt
    Explore other categories ka ak section create kerna he jisme sare category show hogi with with product image, ak line me 6 collection product rkhan he kitne product he collection me oo show nhi kernna he , thodi sie badi rakho product image ki
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-explore-categories-{{ ai_gen_id }} {
    width: 100%;
    padding: 40px 0;
    background-color: {{ block.settings.background_color }};
  }
.ai-explore-categories-container-{{ ai_gen_id }} {
  width: 100%;
  max-width: 1800px;
  margin: 0 auto;
  padding: 0 20px;
}
  .ai-explore-categories-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-explore-categories-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 40px;
  }

  .ai-explore-categories-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
    font-weight: {{ block.settings.heading_weight }};
  }

  .ai-explore-categories-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-explore-categories-grid-{{ ai_gen_id }} {
    display: flex;
    overflow-x: auto;
    gap: {{ block.settings.grid_gap }}px;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .ai-explore-categories-grid-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-explore-category-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.item_border_radius }}px;
    transition: transform 0.3s ease;
    background-color: {{ block.settings.item_background }};

    flex: 0 0 calc(
      (100% - ({{ block.settings.grid_gap }}px * 5)) / 6
    );

    min-width: 180px;
  }

  .ai-explore-category-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-explore-category-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-explore-category-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-explore-category-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-explore-category-item-{{ ai_gen_id }}:hover
  .ai-explore-category-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-explore-category-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-explore-category-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-explore-category-overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 15px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.75),
      transparent
    );
    color: #ffffff;
  }

  .ai-explore-category-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_name_size }}px;
    font-weight: {{ block.settings.category_name_weight }};
    margin: 0;
    color: {{ block.settings.category_name_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-explore-category-item-{{ ai_gen_id }} {
      flex: 0 0 calc(
        (100% - ({{ block.settings.grid_gap }}px * 3)) / 4
      );
    }

    .ai-explore-categories-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-explore-categories-{{ ai_gen_id }} {
      padding: 30px 0;
    }

    .ai-explore-categories-container-{{ ai_gen_id }} {
      padding: 0 15px;
    }

    .ai-explore-categories-header-{{ ai_gen_id }} {
      margin-bottom: 25px;
    }

    .ai-explore-category-item-{{ ai_gen_id }} {
      flex: 0 0 calc(
        (100% - ({{ block.settings.grid_gap }}px * 1)) / 2
      );
      min-width: 150px;
    }

    .ai-explore-categories-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-explore-categories-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }

    .ai-explore-category-name-{{ ai_gen_id }} {
      font-size: calc(
        {{ block.settings.category_name_size }}px * 0.9
      );
    }

    .ai-explore-category-overlay-{{ ai_gen_id }} {
      padding: 12px;
    }
  }
{% endstyle %}


<div
  class="ai-explore-categories-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-explore-categories-container-{{ ai_gen_id }}">

    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-explore-categories-header-{{ ai_gen_id }}">

        {% if block.settings.heading != blank %}
          <h2 class="ai-explore-categories-title-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <p class="ai-explore-categories-subtitle-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </p>
        {% endif %}

      </div>
    {% endif %}


    <div class="ai-explore-categories-grid-{{ ai_gen_id }}">

      {% for i in (1..6) %}

        {% liquid
          assign collection_key = 'collection_' | append: i
          assign image_key = 'image_' | append: i

          assign collection = block.settings[collection_key]
          assign custom_image = block.settings[image_key]
        %}

        {% if collection != blank %}

          <div class="ai-explore-category-item-{{ ai_gen_id }}">

            <a
              href="{{ collection.url }}"
              class="ai-explore-category-link-{{ ai_gen_id }}"
            >

              <div class="ai-explore-category-image-wrapper-{{ ai_gen_id }}">

                {% if custom_image != blank %}

                  <img
                    src="{{ custom_image | image_url: width: 600 }}"
                    alt="{{ collection.title | escape }}"
                    class="ai-explore-category-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                  >

                {% else %}

                  <div class="ai-explore-category-image-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>

                {% endif %}


                {% if block.settings.show_overlay %}

                  <div class="ai-explore-category-overlay-{{ ai_gen_id }}">

                    <h3 class="ai-explore-category-name-{{ ai_gen_id }}">
                      {{ collection.title }}
                    </h3>

                  </div>

                {% endif %}

              </div>

            </a>

          </div>

        {% endif %}

      {% endfor %}

    </div>

  </div>
</div>


