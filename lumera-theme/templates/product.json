        "ai_gen_block_8d140ea_YQcHzw": {
          "type": "ai_gen_block_8d140ea",
          "settings": {
            "heading": "Have Any Questions?",
            "heading_size": 36,
            "heading_color": "#000000",
            "tab_general": "General",
            "tab_shipping": "Shipping",
            "tab_payment": "Payment",
            "tab_returns": "Returns and Exchanges",
            "tab_font_size": 14,
            "tab_border_radius": 4,
            "tab_bg_color": "#f4f4f4",
            "tab_text_color": "#666666",
            "tab_border_color": "#e0e0e0",
            "tab_hover_bg_color": "#e8e8e8",
            "tab_hover_text_color": "#132010",
            "tab_active_bg_color": "#132010",
            "tab_active_text_color": "#ffffff",
            "tab_active_border_color": "#132010",
            "general_q1": "Can You Provide Lab-Grown Diamonds?",
            "general_a1": "<p><strong>Of course!</strong> We offer high-quality lab-grown diamonds, crafted with meticulous attention to detail and exceptional quality standards.</p>",
            "general_q2": "Do You Offer Custom & Personalised Jewellery?",
            "general_a2": "<p><strong>Absolutely!</strong> We offer custom and personalised jewellery. Share your design ideas, preferences, and requirements with our team, and we’ll help create a piece tailored especially for you.</p>",
            "general_q3": "How Can I Track My Order?",
            "general_a3": "<p>Once your order has been dispatched, tracking details will be sent to your email so you can easily track your shipment.</p>",
            "general_q4": "Do You Offer International Shipping?",
            "general_a4": "<p><strong>Definitely!</strong> We offer international shipping to selected destinations. Delivery times and any applicable customs duties, import taxes, or local charges may vary by destination and are the customer’s responsibility.</p>",
            "general_q5": "What Payment Methods Do You Accept?",
            "general_a5": "<p>We accept PayPal as a secure and convenient payment method for your purchase.</p>",
            "general_q6": "Do You Offer Moissanite & Gemstone Jewellery?",
            "general_a6": "<p>Yes, we offer a selection of Moissanite and Gemstone Jewellery, crafted with attention to quality and detail.</p>",
            "general_q7": "Do You Offer Gift Wrapping?",
            "general_a7": "<p><strong>Of course!</strong> Gift wrapping is available for selected orders. Please check availability when placing your order.</p>",
            "general_q8": "Are Your Diamonds IGI or GIA Certified?",
            "general_a8": "<p><strong>Absolutely!</strong> Eligible diamond jewellery can be accompanied by IGI or GIA certification, providing important details about the diamond’s characteristics, quality, and authenticity.</p>",
            "general_q9": "",
            "general_a9": "",
            "general_q10": "",
            "general_a10": "",
            "shipping_q1": "How long does custom jewellery manufacturing take?",
            "shipping_a1": "<p>Custom jewellery typically requires 10–12 business days for manufacturing. We may request your confirmation before dispatch.</p>",
            "shipping_q2": "How long will my order take to arrive?",
            "shipping_a2": "<p>Yes, we offer an express shipping option. Express delivery typically takes 5–7 business days once your order is ready for dispatch. Availability may vary depending on your location and will be shown at checkout.</p>",
            "shipping_q3": "What can cause delivery delays?",
            "shipping_a3": "<p>Delays caused by severe weather, courier services, or unforeseen circumstances are beyond our control.<br/><br/>If the customer changes the delivery address directly with the courier while the parcel is in transit, any resulting delay is the customer’s responsibility.</p>",
            "shipping_q4": "Do you ship to PO Box addresses?",
            "shipping_a4": "<p>No. We do not ship to PO Box addresses.</p>",
            "shipping_q5": "Is delivery free?",
            "shipping_a5": "<p>Yes. We offer free delivery to your address.<br/>However, any applicable customs duties, import taxes, or local charges are the customer’s responsibility.</p>",
            "shipping_q6": "What happens if I request changes to my product before shipment?",
            "shipping_a6": "<p>Any product changes requested before shipment will restart the manufacturing timeline from day one.</p>",
            "shipping_q7": "Do you offer urgent processing?",
            "shipping_a7": "<p>We prioritize timely delivery and may offer urgent processing where possible. However, Lumera Fine Jewellery is not responsible for delays caused by shipping partners.</p>",
            "shipping_q8": "How will I track my order?",
            "shipping_a8": "<p>Once your order has been dispatched, tracking details will be sent to your email so you can easily track your shipment.</p>",
            "shipping_q9": "Who should I contact for tracking or delivery assistance?",
            "shipping_a9": "<p>For tracking or delivery assistance, please contact:<br/>info@lumerafinejewellery.com</p>",
            "shipping_q10": "",
            "shipping_a10": "",
            "payment_q1": "Is my payment information secure?",
            "payment_a1": "<p>Absolutely! Your security is our top priority. All transactions are protected with advanced encryption technology to ensure a safe and secure payment experience.</p>",
            "payment_q2": "Can I pay using cryptocurrency?",
            "payment_a2": "<p>Currently, we do not support cryptocurrency payments. However, we offer several secure and convenient payment methods for your ease.</p>",
            "payment_q3": "What should I do if my payment fails?",
            "payment_a3": "<p>If your payment is unsuccessful, please verify your payment details and try again. If the issue continues, kindly contact your bank or our customer support team for assistance.</p>",
            "payment_q4": "Do you store my payment information?",
            "payment_a4": "<p>Your privacy matters to us. We do not store sensitive payment information on our servers. All payment transactions are processed through secure payment systems to protect your personal and financial details.</p>",
            "payment_q5": "",
            "payment_a5": "",
            "payment_q6": "",
            "payment_a6": "",
            "payment_q7": "",
            "payment_a7": "",
            "payment_q8": "",
            "payment_a8": "",
            "payment_q9": "",
            "payment_a9": "",
            "payment_q10": "",
            "payment_a10": "",
            "returns_q1": "Can I cancel my order?",
            "returns_a1": "<p>Yes. Orders can be cancelled within 24 hours.<br/>After 24 hours, the following cancellation fees apply:<br/>Moissanite Jewellery: 20%<br/>Lab-Grown Diamond Jewellery: 30%<br/>For cancellation requests, contact info@lumerafinejewellery.com.</p>",
            "returns_q2": "What is your return policy?",
            "returns_a2": "<p>Returns are accepted within 14 days of delivery.<br/>Items must be:<br/>Unused and unworn<br/>In original condition<br/>With original packaging<br/>With proof of purchase<br/>Restocking fees apply:<br/>Moissanite Jewellery: 20%<br/>Lab-Grown Diamond Jewellery: 30%<br/>Please contact us before returning any item.</p>",
            "returns_q3": "Who pays for return shipping?",
            "returns_a3": "<p>Return shipping costs are the responsibility of the customer.</p>",
            "returns_q4": "How long does a refund take?",
            "returns_a4": "<p>Refunds are processed within 5-10 business days.</p>",
            "returns_q5": "Can I return custom items?",
            "returns_a5": "<p>Custom items are non-returnable unless defective.</p>",
            "returns_q6": "What condition should the item be in for return?",
            "returns_a6": "<p>The item must be unused, undamaged and returned with original packaging and certificates.</p>",
            "returns_q7": "Can I return or exchange a resized ring?",
            "returns_a7": "<p>Resized or engraved items cannot be returned, as they are customized for you.</p>",
            "returns_q8": "What if I receive a damaged or wrong item?",
            "returns_a8": "<p>Contact us within 48 hours of delivery with photos and we will arrange a replacement or refund.</p>",
            "returns_q9": "How will I receive my refund?",
            "returns_a9": "<p>Refunds are credited to your original payment method.</p>",
            "returns_q10": "Can I exchange for a different size or design?",
            "returns_a10": "<p>Yes, exchanges for a different size or design are possible within 30 days, subject to availability.</p>",
