{%- if section.settings.sizeguide_enable -%}
<!-- productSizeGuide.liquid -->
{%- assign pageSizeGudie = pages[section.settings.sizeguide_page] -%}

<a href="javascript:void(0)" data-toggle="modal" data-target="#jsSizeGuide" class="open-sizeguide link">
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M17.343 16.812H3.219v-4.415h14.124" stroke="currentColor" stroke-width=".987" stroke-miterlimit="10"></path>
    <path d="M11.903 16.705v-2.369M6.438 16.705v-2.369M9.17 16.705v-1.51M14.635 16.705v-1.51M17.368 16.705v-2.369" stroke="currentColor" stroke-width=".934" stroke-miterlimit="10"></path>
    <path d="M17.343 16.812a2.882 2.882 0 0 0 2.882-2.882V9.515" stroke="currentColor" stroke-width=".987" stroke-miterlimit="10"></path>
    <path d="M8.816 12.397a2.882 2.882 0 1 1 0-5.764h8.527a2.882 2.882 0 1 1 0 5.764" stroke="currentColor" stroke-width=".987" stroke-miterlimit="10"></path>
    <path d="M8.81 9.515h8.54" stroke="currentColor" stroke-width=".934" stroke-miterlimit="10"></path>
  </svg>
  {{ section.settings.sizeguide_title | default: 'Size Guide' }}
</a>

<div class="modal fade" id="jsSizeGuide" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog--sizeguide modal-dialog-centered" role="document">
    <div class="modal-content">
      
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          {%- render 'icon-close' -%}
        </button>
      </div>

      <div class="modal-body px-4 pb-4 pt-2">

        <h3 class="text-center mb-4">Bracelet Size Guide</h3>

        <div class="bracelet-size-guide">

          <table class="size-guide-table">
            <thead>
              <tr>
                <th>Wrist Size</th>
                <th>Bracelet Size</th>
                <th>Fit Type</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>5.5"</td>
                <td>6.5"</td>
                <td>Snug Fit</td>
              </tr>
              <tr>
                <td>6.0"</td>
                <td>7.0"</td>
                <td>Comfort Fit</td>
              </tr>
              <tr>
                <td>6.5"</td>
                <td>7.5"</td>
                <td>Comfort Fit</td>
              </tr>
              <tr>
                <td>7.0"</td>
                <td>8.0"</td>
                <td>Loose Fit</td>
              </tr>
              <tr>
                <td>7.5"</td>
                <td>8.5"</td>
                <td>Loose Fit</td>
              </tr>
              <tr>
                <td>8.0"</td>
                <td>9.0"</td>
                <td>Loose Fit</td>
              </tr>
            </tbody>
          </table>

          <div class="measure-guide">
            <h4>How to Measure Your Wrist</h4>

            <ol>
              <li>Wrap a flexible measuring tape around your wrist.</li>
              <li>Measure just below the wrist bone.</li>
              <li>Add 0.5" for a snug fit.</li>
              <li>Add 1" for a comfort fit.</li>
              <li>Add 1.5" for a loose fit.</li>
            </ol>

            <p>
              If you are between sizes, we recommend choosing the larger size
              for a more comfortable fit.
            </p>
          </div>

        </div>

      </div>
    </div>
  </div>
</div>

<style>
.modal-dialog--sizeguide img{
  width:100%;
}

.open-sizeguide{
  display:block;
  font-size:14px;
}

.open-sizeguide svg{
  width:18px;
  height:18px;
  vertical-align:middle;
  margin-right:5px;
}

.size-guide-table{
  width:100%;
  border-collapse:collapse;
  margin-bottom:25px;
}

.size-guide-table th,
.size-guide-table td{
  border:1px solid #e5e5e5;
  padding:12px;
  text-align:center;
}

.size-guide-table th{
  background:#f8f8f8;
  font-weight:600;
}

.measure-guide h4{
  margin-bottom:10px;
  font-size:18px;
}

.measure-guide ol{
  padding-left:20px;
  margin-bottom:15px;
}

.measure-guide li{
  margin-bottom:6px;
}

.measure-guide p{
  margin-bottom:0;
}

@media(max-width:767px){
  .size-guide-table th,
  .size-guide-table td{
    padding:8px;
    font-size:13px;
  }
}
</style>

{%- endif -%}