<!-- site-logo.liquid -->
{%- liquid
  assign logo_max_width = section.settings.logo_max_width | default: 180
  assign logodark = section.settings.logo
  assign logowhite = section.settings.logo_white
-%}

<style>
  .site-header__logo img {
    width: 80px;
    max-width: 100%;
    height: auto;
    display: inline-block;
  }

  .site-header__logo.has-logo {
    font-size: 0;
    line-height: 0;
  }

  .site-header__logo.has-logo a {
    font-size: 0;
    line-height: 0;
    display: inline-block;
    position: relative;
  }

  /* Dono logos same jagah stack honge, JS unke beech toggle karega */
  .site-header__logo-link .logo-dark,
  .site-header__logo-link .logo-white {
    transition: opacity 0.25s ease;
  }

  .site-header__logo-link .logo-white {
    position: absolute;
    top: 0;
    left: 0;
  }
  /* =========================================================
   MOBILE LOGO - EXACT CENTER
   ========================================================= */

@media screen and (max-width: 749px) {

  /* Header ko positioning reference banana */
  .site-header .site-header__row,
  .site-header .header__row,
  .site-header .container,
  .site-header .page-width {
    position: relative !important;
  }

  /* Logo exact center */
  .site-header__logo {
    position: absolute !important;
    left: 50% !important;
    top: 50% !important;

    transform: translate(-50%, -50%) !important;

    width: max-content !important;
    max-width: none !important;

    margin: 0 !important;
    padding: 0 !important;

    z-index: 10 !important;
  }

  .site-header__logo-link {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    margin: 0 !important;
    padding: 0 !important;
  }

  .site-header__logo img {
    display: block !important;

    width: 66px !important;
    max-width: 150px !important;

    height: auto !important;
    margin: 0 !important;
  }

  /* White logo bhi same position par */
  .site-header__logo-link .logo-white {
    position: absolute !important;
    left: 0 !important;
    top: 0 !important;
  }
}
</style>

{%- if template.name == 'index' -%}
  <h1 class="site-header__logo {% if logodark != blank %} has-logo {% endif %}" itemscope itemtype="http://schema.org/Organization">
{%- else -%}
  <div class="site-header__logo h1" itemscope itemtype="http://schema.org/Organization">
{%- endif -%}

  {%- if logodark != blank -%}
    {%- liquid
      assign maxlogo = logo_max_width | times: 2
    -%}
    <a href="{{ routes.root_url }}" itemprop="url" class="site-header__logo-link">
      {{ logodark | image_url: width: maxlogo | image_tag:
        class: 'logo-dark',
        widths: '50, 100, 150, 200, 250, 300, 400, 500',
        height: logodark.height,
        width: logodark.width,
        alt: shop.name,
        loading: 'eager'
      }}
      {%- if logowhite != blank -%}
        {{ logowhite | image_url: width: maxlogo | image_tag:
          class: 'logo-white d-none',
          widths: '50, 100, 150, 200, 250, 300, 400, 500',
          height: logowhite.height,
          width: logowhite.width,
          alt: shop.name,
          loading: 'eager'
        }}
      {%- endif -%}
    </a>
  {%- else -%}
    {%- assign shop_name_length = shop.name.size -%}
    <a href="/" itemprop="url" {% if shop_name_length > 10 %} class="site-header__shop-name--small"{% endif %}>{{ shop.name }}</a>
  {%- endif -%}

{%- if template.name != 'index' -%}
  </div>
{%- else -%}
  </h1>
{%- endif -%}