{%- liquid
  assign layout_header = section.settings.layout_header
  assign header_border_color = section.settings.background | color_mix: section.settings.textcolor, 86
  assign type_sticky = section.settings.type_sticky
  assign height_header = section.settings.height_header
  assign enable_menu_vertical = section.settings.enable_menu_vertical
  assign container = section.settings.setwidth
  assign sl_menu_vertical = section.settings.sl_menu_vertical
  assign main_linklist = section.settings.main_linklist
  assign blocks = section.blocks
-%}

{% render 'header-oncss',
  layout_header: layout_header,
  header_border_color: header_border_color,
  type_sticky: type_sticky
%}
<!-- header.liquid -->
<header
  class="{% if section.settings.menu_active == 'thick-line' %} thick-lineactive {% endif %} {{ layout_header }} size-header-{{ height_header }} section-{{ section.id }} site-header page-element is-moved-by-drawer header-{{ type_sticky }} {% if type_sticky == 'sticky' or type_sticky == 'sticky-top' %} site-header--sticky {% endif %} {% if section.settings.enable_transparent %} site-header--transparent {% if section.settings.enable_white %} site-header-white {% endif %} {% endif %} site-header--full {% if template contains 'index' %} index-header {% endif %} "
  role="banner"
  data-section-id="{{ section.id }}"
  data-section-type="header"
  data-sticky="{{ type_sticky }}"
>
  <div class="header-bottom py-2 py-lg-0 ">
    <div class="">
      <div class="d-flex row-header align-items-center">
        {%- liquid
          case layout_header
            when 'logo-center-navigation-center'
              render 'header-logo-center-nav-center', container: container, enable_menu_vertical: enable_menu_vertical, sl_menu_vertical: sl_menu_vertical, main_linklist: main_linklist, blocks: blocks
            when 'logo-left-navigation-underleft'
              render 'header-logo-left-nav-left', container: container, enable_menu_vertical: enable_menu_vertical, sl_menu_vertical: sl_menu_vertical, main_linklist: main_linklist, blocks: blocks
            when 'logo-center-navigation-split'
              render 'header-logo-center-split', container: container, enable_menu_vertical: enable_menu_vertical, sl_menu_vertical: sl_menu_vertical, main_linklist: main_linklist, blocks: blocks
            when 'logo-center-navigation-drawer'
              render 'header-logo-center-drawer', container: container
            else
              render 'header-logo-left', container: container, layout_header: layout_header, enable_menu_vertical: enable_menu_vertical, sl_menu_vertical: sl_menu_vertical, main_linklist: main_linklist, blocks: blocks
          endcase
        -%}
      </div>
    </div>
  </div>

  {%- if enable_menu_vertical -%}
    {% unless layout_header == 'logo-center-navigation-split' or layout_header == 'logo-center-navigation-drawer' %}
      {% render 'slide-menu' %}
    {% endunless %}
  {%- endif -%}
</header>

{%- render 'menu-mobile', menu: main_linklist -%}
<script>
  /* The drawer is fixed-position; keep it a direct child of <body> so it is not trapped in the sticky header's stacking context.
     On a theme-editor reload of this section, the freshly rendered drawer replaces the old one. */
  (function () {
    var drawers = document.querySelectorAll('#NavDrawer');
    var drawer = drawers[drawers.length - 1];
    for (var i = 0; i < drawers.length - 1; i++) drawers[i].remove();
    if (drawer && drawer.parentNode !== document.body) document.body.appendChild(drawer);
  })();
</script>

<style>
  /* ===== MEGA MENU HEADING ===== */
  .site-nav .meganav .mega-heading a {
    font-family: Georgia, serif;
    font-size: 14px !important;
    font-weight: 700 !important;
    color: #000;
    letter-spacing: 0.5px;
    border-bottom: 2px solid #c9a227;
    display: inline-block;
    padding-bottom: 4px;
  }

  /* ===== STICKY (sirf CSS, koi JS position nahi badalta) ===== */
  #shopify-section-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 99999;
  }
  /* Mobile menu drawer (#NavDrawer, z-index 9999) and its backdrop must cover the sticky header while open. */
  .js-drawer-open .drawer { z-index: 100001; }
  .js-drawer-open .page-container:after { z-index: 100000; }
  .site-header {
    position: relative !important;
    top: auto !important;
    transform: none !important;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* ===== HEADER SIZE + KAHIN SE BHI CUT NA HO ===== */
  .site-header .header-bottom {
    padding-top: 8px;
    padding-bottom: 8px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }
  .site-header .row-header {
    flex-wrap: nowrap;
    max-width: 100%;
  }
  /* flex children ko shrink hone do, warna content screen se bahar jaata hai */
  .site-header .row-header > *,
  .site-header .row-header .container-fluid,
  .site-header .row-header .container {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }
  /* sirf img: svg par max-width:100% lagane se header ke icons 0px tak shrink ho jaate the */
  .site-header img { max-width: 100%; }

  /* Layout, logo size aur menu font: snippets/header-logo-center-split.liquid me */
  @media (min-width: 992px) {
    .site-header .header-bottom {
      padding-top: 6px;
      padding-bottom: 6px;
    }
  }

  @media (max-width: 991px) {
    .meganav-preview { display: none !important; }
  }
</style>

<style>
  @media (min-width: 992px) and (hover: hover) {

    /* container ki side spacing: content isi se align rahega */
    .site-header {
      --mega-side: max(24px, calc((100vw - 1320px) / 2));
    }

    /* ===== FULL WIDTH MEGA MENU ===== */
    .site-header .menudesk-left .meganav,
    .site-header .menudesk-right .meganav {
      position: fixed !important;
      left: 0 !important;
      right: 0 !important;
      width: auto !important;
      min-width: 0 !important;
      max-width: none !important;
      margin: 0 !important;
      transform: none !important;
      box-sizing: border-box !important;
      padding: 22px var(--mega-side) 26px !important;
      min-height: 0 !important;
      /* screen se bada ho to andar scroll, bahar cut nahi */
      max-height: calc(100vh - var(--mega-top, 140px) - 16px);
      overflow-y: auto;
      overflow-x: hidden;
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.06);
    }

    .site-header .meganav li > a {
      padding-top: 4px !important;
      padding-bottom: 4px !important;
    }
    .site-header .meganav li {
      margin-bottom: 0 !important;
    }

    /* ===== Engagement Ring dropdown: preview image ===== */
    .site-header .menudesk-left .meganav.has-hover-preview,
    .site-header .menudesk-right .meganav.has-hover-preview {
      --mp-w: clamp(150px, 13vw, 200px);
      padding-right: calc(var(--mega-side) + var(--mp-w) + 40px) !important;
    }

    .meganav-preview {
      position: absolute;
      top: 22px;
      right: var(--mega-side);
      width: var(--mp-w);
      text-align: center;
      pointer-events: none;
    }
    .meganav-preview__frame {
      aspect-ratio: 1 / 1;
      overflow: hidden;
    }
    .meganav-preview__img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: opacity 0.25s ease;
    }
    .meganav-preview__img.is-fading { opacity: 0; }
    .meganav-preview__caption {
      margin-top: 10px;
      font-size: 14px;
      font-weight: 500;
      color: #222;
    }

    /* ===== Shop By Shape: 2 columns ===== */
    .meganav .mega-two-col {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(24px, 3vw, 50px);
    }
    .meganav .mega-two-col > .mega-title-li {
      grid-column: 1 / -1;
    }
  }

  /* chhote laptop pe preview image band: menu columns ko poori jagah mile */
  @media (min-width: 992px) and (max-width: 1199px) {
    .meganav-preview { display: none !important; }
    .site-header .menudesk-left .meganav.has-hover-preview,
    .site-header .menudesk-right .meganav.has-hover-preview {
      padding-right: var(--mega-side) !important;
    }
  }

  /* touch device pe preview nahi */
  @media (hover: none) {
    .meganav-preview { display: none !important; }
  }
</style>

<script>
  window.MENU_HOVER_IMAGES = {
    /* Shop By Shape */
    'round':    '{{ 'ring-round.jpg' | asset_url }}',
    'oval':     '{{ 'ring-oval.jpg' | asset_url }}',
    'radiant':  '{{ 'ring-radiant.jpg' | asset_url }}',
    'pear':     '{{ 'ring-pear.jpg' | asset_url }}',
    'marquise': '{{ 'ring-marquise.jpg' | asset_url }}',
    'cushion':  '{{ 'ring-cushion.jpg' | asset_url }}',
    'emerald':  '{{ 'ring-emerald.jpg' | asset_url }}',
    'princess': '{{ 'ring-princess.jpg' | asset_url }}',
    'heart':    '{{ 'ring-heart.jpg' | asset_url }}',
    /* Shop By Style */
    'solitaire rings': '{{ 'ring-solitaire.jpg' | asset_url }}',
    'halo rings':      '{{ 'ring-halo.jpg' | asset_url }}',
    'pave rings':      '{{ 'ring-pave.jpg' | asset_url }}',
    'three stone ring':'{{ 'ring-three-stone.jpg' | asset_url }}',
    'hidden halo':     '{{ 'ring-hidden-halo.jpg' | asset_url }}',
    'bezel ring':      '{{ 'ring-bezel.jpg' | asset_url }}',
    'toi et moi ring': '{{ 'ring-toi-et-moi.jpg' | asset_url }}',
    'cathedral':       '{{ 'ring-cathedral.jpg' | asset_url }}'
  };

  document.addEventListener('DOMContentLoaded', function () {
    var CONFIG = { parentMatch: /engagement/i, defaultKey: 'round' };
    var SHAPE_KEYS = ['round','oval','radiant','pear','marquise','cushion','emerald','princess','heart'];
    var images = window.MENU_HOVER_IMAGES || {};
    if (!window.matchMedia('(min-width: 992px) and (hover: hover)').matches) return;

    var header = document.querySelector('.site-header');

    function keyOf(a) {
      return a.textContent.replace(/\s+/g, ' ').trim().toLowerCase();
    }

    /* ---- Mega menu ko header ke bilkul neeche rakho (scroll/resize par bhi) ---- */
    var allMegas = document.querySelectorAll('.menudesk-left .meganav, .menudesk-right .meganav');

    function placeAll() {
      if (!header) return;
      var bottom = Math.max(0, header.getBoundingClientRect().bottom);
      document.documentElement.style.setProperty('--mega-top', bottom + 'px');
      allMegas.forEach(function (mega) {
        mega.style.setProperty('top', bottom + 'px', 'important');
      });
    }

    allMegas.forEach(function (mega) {
      var li = mega.closest('li');
      if (!li || !header) return;
      li.addEventListener('mouseenter', placeAll);
      li.addEventListener('focusin', placeAll);
    });
    window.addEventListener('scroll', placeAll, { passive: true });
    window.addEventListener('resize', placeAll);
    placeAll();

    /* ---- Engagement Ring dropdown: 2 columns + preview image ---- */
    allMegas.forEach(function (mega) {
      var li = mega.closest('li') || mega.parentElement;
      var topLink = li && li.querySelector('a');
      if (!topLink || !CONFIG.parentMatch.test(topLink.textContent)) return;

      var links = Array.prototype.filter.call(mega.querySelectorAll('a'), function (a) {
        return !a.closest('.mega-heading') && images[keyOf(a)];
      });
      if (!links.length) {
        console.warn('[menu-preview] koi link match nahi hua');
        return;
      }

      /* Shop By Shape ko 2 columns mein karo */
      links.forEach(function (a) {
        if (SHAPE_KEYS.indexOf(keyOf(a)) === -1) return;
        var ul = a.closest('ul');
        if (!ul || ul.classList.contains('mega-two-col')) return;
        ul.classList.add('mega-two-col');
        Array.prototype.forEach.call(ul.children, function (child) {
          if (child.classList.contains('mega-heading') || child.querySelector('.mega-heading')) {
            child.classList.add('mega-title-li');
          }
        });
      });

      /* Preview panel */
      var panel = document.createElement('div');
      panel.className = 'meganav-preview';
      panel.setAttribute('aria-hidden', 'true');
      panel.innerHTML =
        '<div class="meganav-preview__frame"><img class="meganav-preview__img" alt=""></div>' +
        '<div class="meganav-preview__caption"></div>';
      mega.appendChild(panel);
      mega.classList.add('has-hover-preview');

      var img = panel.querySelector('img');
      var caption = panel.querySelector('.meganav-preview__caption');
      var timer;

      function setNow(a) {
        img.src = images[keyOf(a)];
        caption.textContent = a.textContent.replace(/\s+/g, ' ').trim();
      }

      function show(a) {
        var url = images[keyOf(a)];
        if (img.getAttribute('src') === url) return;
        clearTimeout(timer);
        img.classList.add('is-fading');
        timer = setTimeout(function () {
          setNow(a);
          img.classList.remove('is-fading');
        }, 120);
      }

      var defaultLink = links.filter(function (a) { return keyOf(a) === CONFIG.defaultKey; })[0] || links[0];
      setNow(defaultLink);

      var preloaded = false;
      function preload() {
        if (preloaded) return;
        preloaded = true;
        links.forEach(function (a) { new Image().src = images[keyOf(a)]; });
      }
      li.addEventListener('mouseenter', preload);
      li.addEventListener('focusin', preload);

      links.forEach(function (a) {
        a.addEventListener('mouseenter', function () { show(a); });
        a.addEventListener('focus', function () { show(a); });
      });

      li.addEventListener('mouseleave', function () {
        clearTimeout(timer);
        img.classList.remove('is-fading');
        setNow(defaultLink);
      });
    });
  });
</script>

<script>
  /* In-page anchors (e.g. menu link "/#about-us"): land just below the sticky header. */
  (function () {
    var sticky = document.getElementById('shopify-section-{{ section.id }}');
    var root = document.documentElement;
    if (!sticky) return;

    function headerHeight() {
      return Math.ceil(sticky.getBoundingClientRect().height);
    }

    /* Native jumps (and anything else that scrolls to an id) use this offset too. */
    function syncOffset() {
      root.style.scrollPaddingTop = headerHeight() + 'px';
    }
    syncOffset();
    if (window.ResizeObserver) new ResizeObserver(syncOffset).observe(sticky);

    function targetOf(hash) {
      if (!hash || hash.length < 2) return null;
      try {
        return document.getElementById(decodeURIComponent(hash.slice(1)));
      } catch (e) {
        return null;
      }
    }

    function scrollToTarget(el, smooth) {
      var top = el.getBoundingClientRect().top + window.pageYOffset - headerHeight();
      window.scrollTo({ top: Math.max(0, top), behavior: smooth ? 'smooth' : 'auto' });
    }

    /* Link to a section on the current page: scroll smoothly instead of reloading, and close the mobile menu. */
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href*="#"]');
      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var url = new URL(a.href, location.href);
      if (url.origin !== location.origin || url.pathname !== location.pathname) return;
      var el = targetOf(url.hash);
      if (!el) return;
      e.preventDefault();
      if (window.theme && theme.NavDrawer && theme.NavDrawer.drawerIsOpen) theme.NavDrawer.close();
      history.pushState(null, '', url.hash);
      scrollToTarget(el, !window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    });

    /* Arriving from another page: sliders and images above the section change height while loading, so re-align once loaded. */
    if (targetOf(location.hash)) {
      window.addEventListener('load', function () {
        var el = targetOf(location.hash);
        if (el) scrollToTarget(el, false);
      });
    }
  })();
</script>

