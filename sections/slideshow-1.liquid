{%- if section.settings.enable_slideshow -%}
  {%- liquid
    assign rotate = section.settings.autorotate
    assign dot = section.settings.slide_dot
    assign mobile_height_class = section.settings.slideshow_height_mobile | default: '500'
    assign desktop_widths = '750,1100,1500,1920' | split: ','
    assign mobile_widths = '375,550,750,1100' | split: ','
  -%}
  <style>
    :root{
      --slidebg-arrow:{{ section.settings.bg_arrow.red }},{{ section.settings.bg_arrow.green }},{{ section.settings.bg_arrow.blue }};
      --slide-arrow-color:{{ section.settings.color_arrow }};
      --slide-alpha : {{ section.settings.opacity_arrow }};
      --slide-rotate: {{ section.settings.autorotate_speed }}s;
      --slide-color-dot: {{ section.settings.color_dot_nav.red }},{{ section.settings.color_dot_nav.green }},{{ section.settings.color_dot_nav.blue }};
      --slide-color-dotactive:{{ section.settings.color_dot_active.red }},{{ section.settings.color_dot_active.green }},{{ section.settings.color_dot_active.blue }};
    }
    .slideshow-wrapper{ position: relative; }
    .slideshow{
      position: unset;
      overflow: hidden;
      margin-bottom: 0;
      height: 100vh;
      transition: height .6s cubic-bezier(.44,.13,.48,.87);
    }
    @media only screen and (min-width:750px){
      .slideshow{ position: relative; }
    }
    .slideshow .slick-list,.slideshow .slick-track,.slideshow .slideshow__slide{ height: 100%; }
    .slideshow .slick-dots{ bottom: 30px; }

    @media only screen and (max-width:749px){
      .slideshow .slick-dots{ bottom: 10px; }
      .mobile--slideshow-250{ height: 250px !important; }
      .mobile--slideshow-300{ height: 300px !important; }
      .mobile--slideshow-400{ height: 400px !important; }
      .mobile--slideshow-500{ height: 500px !important; }
      .mobile--slideshow-full{ height: 100vh !important; }
      .img_mobile{ height: 100%; }
      .img_mobile img{ height: 100%; object-fit: cover; }
    }

    @media only screen and (min-width:750px){
      .slideshow--desktop-750{ height: 750px; }
      .slideshow--desktop-650{ height: 650px; }
      .slideshow--desktop-550{ height: 550px; }
      .slideshow--desktop-450{ height: 450px; }
      /* fallback values so height never collapses before JS sets the variables */
      .slideshow--desktop-full{
        height:calc(100vh - var(--height-announbar, 0px) - var(--height-header, 150px) - var(--height-announcementbar, 40px));
      }
      .slideshow--desktop-full-header{
        height:calc(100vh - var(--height-announbar, 0px) - var(--height-announcementbar, 40px));
      }
    }

    .slideshow__slide{ position: relative; overflow: hidden; }
    .slideshow__link{ display: block; position: absolute; top: 0; left: 0; right: 0; bottom: 0; }
    .slideshow__link:active,.slideshow__link:focus{ opacity: 1; }

    /* FULL BANNER CLICKABLE LINK */
    .slideshow__banner-link{
      position: absolute; top: 0; left: 0; right: 0; bottom: 0;
      z-index: 4; display: block; cursor: pointer;
    }
    .slideshow__text-wrap--desktop{ z-index: 5; pointer-events: none; }
    .slideshow__text-wrap--desktop .slideshow__btn-wrapper,
    .slideshow__text-wrap--desktop .slideshow__btn-wrapper a{ pointer-events: auto; }

    .slideshow__image{
      transition: opacity .8s cubic-bezier(.44,.13,.48,.87);
      position: absolute;
      top: 0;
      left: 0;
      opacity: 0;
      height: 100%;
      width: 100%;
      background-repeat: no-repeat;
      background-size: cover;
      background-position: center center;
      background-color: transparent;
      z-index: 1;
    }
    .slideshow__image picture{ display: block; }
    .slideshow .slideshow__image img{ opacity: 1 !important; }
    .slideshow__image img{
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
      object-fit: cover;
    }
    .video-slideshow{ position: absolute; top: 0; left: 0; height: 100%; width: 100%; z-index: 1; }
    .video-slideshow video{ height: 100%; width: 100%; object-fit: cover; }

    .no-js .slideshow__image,.slick-initialized .slideshow__image{ opacity: 1; }

    .slideshow__text-wrap{ height: 100%; position: relative; }
    .slideshow__link .slideshow__text-wrap{ cursor: inherit; }
    .slideshow__text-wrap--mobile{ display: none; }

    @media only screen and (min-width:750px){
      .slideshow__text-content{
        transition: .6s cubic-bezier(.44,.13,.48,.87);
        transition-delay: .3s;
      }
    }

    .slideshow__text-wrap--desktop .slideshow__text-content{
      position: absolute;
      width: 104%;
      top: 27%;
      opacity: 1;
      z-index: 2;
      padding: 0 50px;
      -ms-transform: translateY(-50%);
      -webkit-transform: translateY(-50%);
      transform: translateY(-50%);
    }
    .slideshow__text-wrap--desktop .slideshow__text-content li,
    .slideshow__text-wrap--desktop .slideshow__text-content .slideshow__btn-wrapper{ overflow: hidden; }

    .slideshow__text-wrap--desktop .slideshow__text-content li .slideshow__toptitle,
    .slideshow__text-wrap--desktop .slideshow__text-content li .slideshow__title,
    .slideshow__text-wrap--desktop .slideshow__text-content li .slideshow__subtitle,
    .slideshow__text-wrap--desktop .slideshow__text-content .slideshow__btn{ transform: translateY(110%); }

    @media only screen and (min-width:750px){
      .slideshow__text-content.slideshow__text-content--vertical-top{ top: 10%; transform: translateY(0); }
      .slideshow__text-content.slideshow__text-content--vertical-bottom{ top: auto; bottom: 10%; transform: translateY(0); }
    }

    .no-js .slideshow__text-content,
    .slick-initialized .slick-active .slideshow__text-content li .slideshow__toptitle,
    .slick-initialized .slick-active .slideshow__text-content li .slideshow__title,
    .slick-initialized .slick-active .slideshow__text-content li .slideshow__subtitle,
    .slick-initialized .slick-active .slideshow__text-content .slideshow__btn{
      transform: translateY(0);
      transition: transform 0.7s cubic-bezier(.29,.63,.44,1);
      transition-delay: .1s;
    }
    .slick-initialized .slick-active .slideshow__text-content li .slideshow__title{ transition-delay: .3s; }
    .slick-initialized .slick-active .slideshow__text-content li .slideshow__subtitle{ transition-delay: .4s; }
    .slick-initialized .slick-active .slideshow__text-content .slideshow__btn{
      transition-delay: .5s;
      transition: background-color 0.4s ease 0s, color 0.4s ease 0s, border 0.4s ease 0s, transform 0.5s cubic-bezier(.29,.63,.44,1) .5s;
    }

    @media only screen and (max-width:749px){
      .slideshow__text-wrap--desktop .slideshow__text-content{ padding: 0px; padding-top: 500px; }
    }

    /* first slide visible immediately (before slick JS loads), no fade delay for LCP */
    html:not(.no-js) .slideshow .slideshow__slide{ display:none; }
    html:not(.no-js) .slideshow .slideshow__slide:first-child{ display:block; visibility:visible; }
    html:not(.no-js) .slideshow:not(.slick-initialized) .slideshow__slide:first-child .slideshow__image{
      opacity:1;
      transform:none;
      transition:none;
    }
    html:not(.no-js) .slideshow.slick-initialized .slideshow__slide{ display:block; visibility:visible!important; }

    @media (min-width:750px){
      .slideshow__text-content--mobile{ display: none!important; }
    }
    .slideshow__text-content--mobile .container{ padding: 30px 20px; }
    .slideshow__arrows--mobile~.slideshow__text-content--mobile{ padding-top: 1.7rem; }
    @media only screen and (min-width:750px){
      .slideshow__arrows--mobile~.slideshow__text-content--mobile{ padding-top: 0; }
      .slideshow__text-content--mobile{ padding-top: 0; }
      .slideshow__text-content--mobile::after{ display: none; }
    }

    .slideshow__title{
      font-weight: var(--g-slide-font-weight);
      font-size: 39px !important;
      line-height: 1.15;
      letter-spacing:var(--g-slide-font-spacing);
      text-transform: var(--g-slide-font-transform);
    }
    .slideshow__subtitle{ font-size: 25px !important; line-height: 1.5; }
    @media (max-width:990px){
      .slideshow__title{ font-size: 25px !important; }
      .slideshow__subtitle{ font-size: 18px !important; }
    }

    {%- unless section.settings.slideshow_mobile -%}
    @media only screen and (max-width:749px){
      .slideshow__subtitle,.slideshow__title,.slideshow__toptitle{ display: none; }
      .slideshow__btn{ display: none; }
    }
    {%- endunless -%}

    .slideshow__title--mobile{
      margin-bottom: 0;
      font-size: calc(var(--g-font-size) + 30px);
      font-weight: 400;
    }
    .slideshow__title--mobile~.slideshow__subtitle--mobile{
      margin-top: 7px;
      font-size: var(--g-font-size);
    }
    .slideshow__subtitle--mobile,.slideshow__title--mobile{ display: none; color: #3d4246; }
    @media only screen and (max-width:749px){
      .slideshow__subtitle--mobile,.slideshow__title--mobile,.slideshow__toptitle--mobile{ display: block; }
    }

    .slideshow__btn-wrapper{
      border: none;
      background-color: transparent;
      display:flex;
      column-gap:24px;
    }
    .slideshow__btn--mobile{ display: none; margin: 1.3rem auto 0; }
    @media only screen and (max-width:749px){
      .slideshow__btn--mobile{ display: inline-block; }
      .slideshow__btn-wrapper--push{ margin-top: 5px; }
    }

    .slideshow .slick-prev{ left: 60px; }
    .slideshow .slick-next{ right: 60px; }
    .slideshow .slick-arrow{
      width: 50px;
      height: 50px;
      border-radius: 100%;
      color: #fff;
      box-shadow: none;
      background: rgba(var(--slidebg-arrow),var(--slide-alpha));
    }
    .slideshow .slick-arrow:before{ color: var(--slide-arrow-color); }

    {%- if dot == 'square' -%}
      @keyframes animright{
        0%   {width: 0%;}
        100% {width: 100%;}
      }
      .dot-square.slideshow .slick-dots li{ width: 48px; height: 32px; }
      @media (max-width:749px){
        .dot-square.slideshow .slick-dots li{ width: 32px; }
      }
      .dot-square.slideshow .slick-dots li button{
        width: 100%;
        height: 100%;
        border-radius: 0;
        border:none;
        background-color: transparent;
        position: relative;
      }
      .dot-square.slideshow .slick-dots li button:before{
        height: 2px;
        width: 100%;
        top: calc(50% - 1px);
        background-color: rgba(var(--slide-color-dot),0.5);
        content: "";
        position: absolute;
        left: 0;
      }
      .dot-square.slideshow .slick-dots li.slick-active button::after{
        height: 2px;
        top: calc(50% - 1px);
        background-color: rgba(var(--slide-color-dotactive), 1);
        content: "";
        position: absolute;
        left: 0;
        z-index: 1;
        {%- if rotate -%}
        animation:animright var(--slide-rotate) linear 1;
        {%- else -%}
        width:100%;
        {%- endif -%}
      }
    {%- elsif dot == 'circle' -%}
      .dot-circle.slideshow .slick-dots li{
        width: 20px;
        height: 20px;
        margin:0 3px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .dot-circle.slideshow .slick-dots li button{
        background-color: rgba(var(--slide-color-dot),0.5);
        border:none;
        transform: scale(0.7);
        transition: transform 0.3s cubic-bezier(0.23, 1, 0.320, 1);
      }
      .dot-circle.slideshow .slick-dots li.slick-active button{
        background-color: rgba(var(--slide-color-dotactive),1);
        transform: scale(1);
      }
    {%- endif -%}

    .slideshow__slide-split .slide_img_left{ left:0; }
    .slideshow__slide-split .slide_img_right{ right:0; left:auto; }

    @media (max-width:991px){
      .slideshow .slick-arrow{ display: none!important; }
    }

    .slideshow[data-transit="slide-fade"] .slide .slideshow__image{
      will-change: transform, opacity;
      transform: translateX(10vw);
      opacity: 0;
    }
    .slideshow[data-transit="slide-fade"] .slide.slick-active .slideshow__image{
      transition: transform 0.6s ease, opacity 0.6s;
      opacity: 1;
      transform: translateX(0);
    }
    .slideshow[data-transit="slide-fade"] .slide.slick-going .slideshow__image{
      transition: transform 0.6s ease 60ms;
      transform: translateX(-10vw);
      opacity: 1;
    }
    .slideshow[data-transit="zoom"] .slide .slideshow__image{
      transform: scale(1.2);
      will-change: transform;
      transition: transform 1.8s cubic-bezier(0.21, 0.6, 0.35, 1);
    }
    .slideshow[data-transit="zoom"] .slide.slick-active .slideshow__image{ transform: scale(1); }

    /* MOBILE SLIDESHOW IMAGE FIX */
    @media only screen and (max-width: 749px){
      .slideshow{ width: 100%; overflow: hidden; }
      .slideshow .slick-list,
      .slideshow .slick-track,
      .slideshow .slideshow__slide{ height: 100% !important; }
      .slideshow .img_mobile{
        display: block !important;
        position: absolute !important;
        inset: 0 !important;
        width: 100% !important;
        height: 100% !important;
        z-index: 3 !important;
        opacity: 1 !important;
        visibility: visible !important;
      }
      .slideshow .img_mobile img{
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        object-position: center center !important;
        opacity: 1 !important;
        visibility: visible !important;
      }
      .slideshow .slideshow__slide > .slideshow__image:not(.img_mobile){ display: none !important; }
      .slideshow .slick-slide .img_mobile{ opacity: 1 !important; visibility: visible !important; }
      .slideshow .slideshow__overlay{ z-index: 4 !important; }
      .slideshow .slideshow__banner-link{ z-index: 5 !important; }
      .slideshow .slideshow__text-wrap{ z-index: 6; }
    }

    /* iPhone / slow load fix: text AOS ya slick ke bharose na rahe */
    @media only screen and (max-width: 749px){
      .slideshow__text-wrap--desktop [data-aos]{
        opacity: 1 !important;
        transform: none !important;
        visibility: visible !important;
        transition: none !important;
      }
      .slideshow__text-wrap--desktop .slideshow__toptitle,
      .slideshow__text-wrap--desktop .slideshow__title,
      .slideshow__text-wrap--desktop .slideshow__subtitle,
      .slideshow__text-wrap--desktop .slideshow__btn{ transform: none !important; }
    }
    .slideshow:not(.slick-initialized) .slideshow__slide:first-child .slideshow__toptitle,
    .slideshow:not(.slick-initialized) .slideshow__slide:first-child .slideshow__title,
    .slideshow:not(.slick-initialized) .slideshow__slide:first-child .slideshow__subtitle,
    .slideshow:not(.slick-initialized) .slideshow__slide:first-child .slideshow__btn{ transform: none !important; }
  </style>
  <!-- slideshow-1.liquid -->
  {%- liquid
    if section.settings.slideshow_height_adapt == 'adapt'
      assign first_block = section.blocks[0]
      if first_block.settings.image.aspect_ratio == blank
        assign min_aspect_ratio = 2.0
      else
        assign min_aspect_ratio = first_block.settings.image.aspect_ratio
      endif
      assign wrapper_height = 100 | divided_by: min_aspect_ratio
    endif
  -%}
  <div
    class="{{ section.settings.setwidthout }}"
    data-section-id="{{ section.id }}"
    data-section-type="slideshow-section"
  >
    {%- if section.blocks.size > 0 -%}
      <div
        id="SlideshowWrapper-{{ section.id }}"
        class="slideshow-wrapper"
        role="region"
        aria-label="slideshow"
        aria-describedby="slideshow-info"
        tabindex="-1"
      >
        {%- comment -%} Button styles: slider ke bahar, ek hi baar (desktop + mobile dono ke liye) {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign show_btn_1 = false
            assign show_btn_2 = false
            if block.settings.button_label != blank and block.settings.button_link != blank
              assign show_btn_1 = true
            endif
            if block.settings.button_label_2 != blank and block.settings.button_link_2 != blank
              assign show_btn_2 = true
            endif
          -%}
          {%- if show_btn_1 or show_btn_2 -%}
<style>
                {%- if show_btn_1 -%}
                .btn-theme.slideshow__btn{{ block.id }}{
                  color:{{ block.settings.color_button }};
                  border: 1px solid {{ block.settings.bg_button }};
                  background-color:{{ block.settings.bg_button }};
                }
                .btn-theme.slideshow__btn{{ block.id }}:hover{
                  color:{{ block.settings.color_button_hover }};
                  border-color:{{ block.settings.bg_button_hover }};
                  {% unless settings.enable_button_hover %}background-color:{{ block.settings.bg_button_hover }};{% endunless %}
                }
                .btn-theme.slideshow__btn{{ block.id }}::before{ background-color:{{ block.settings.bg_button_hover }}; }
                .btn-outline.slideshow__btn{{ block.id }}{
                  color:{{ block.settings.color_button }};
                  border: 1px solid {{ block.settings.bg_button }};
                  background-color:transparent;
                }
                .btn-outline.slideshow__btn{{ block.id }}:hover{
                  border-color:{{ block.settings.bg_button_hover }};
                  color:{{ block.settings.color_button_hover }};
                  {% unless settings.enable_button_hover %}background-color:{{ block.settings.bg_button_hover }};{% endunless %}
                }
                .btn-outline.slideshow__btn{{ block.id }}::before{ background-color:{{ block.settings.bg_button_hover }}; }
                .btn-underline.slideshow__btn{{ block.id }}{ color:{{ block.settings.color_button }} !important; }
                .btn-underline.slideshow__btn{{ block.id }}:before{ background: {{ block.settings.bg_button }} !important; }
                .btn-underline.slideshow__btn{{ block.id }}:after{ background: {{ block.settings.bg_button_hover }} !important; }
                .btn-underline.slideshow__btn{{ block.id }}:hover{ color:{{ block.settings.color_button_hover }} !important; }
                @media only screen and (max-width:749px){
                  .btn-underline.slideshow__btn{{ block.id }}{ border-bottom-color: {{ block.settings.bg_button }} !important; }
                  .btn-underline.slideshow__btn{{ block.id }}:hover{ border-bottom-color: {{ block.settings.bg_button_hover }} !important; }
                }
                {%- endif -%}
                {%- if show_btn_2 -%}
                .btn-theme.slideshow__btn-2{{ block.id }}{
                  color:{{ block.settings.color_button_2 }};
                  border: 1px solid {{ block.settings.bg_button_2 }};
                  background-color:{{ block.settings.bg_button_2 }};
                }
                .btn-theme.slideshow__btn-2{{ block.id }}:hover{
                  color:{{ block.settings.color_button_hover_2 }};
                  border-color:{{ block.settings.bg_button_hover_2 }};
                  {% unless settings.enable_button_hover %}background-color:{{ block.settings.bg_button_hover_2 }};{% endunless %}
                }
                .btn-theme.slideshow__btn-2{{ block.id }}::before{ background-color:{{ block.settings.bg_button_hover_2 }}; }
                .btn-outline.slideshow__btn-2{{ block.id }}{
                  color:{{ block.settings.color_button_2 }};
                  border: 1px solid {{ block.settings.bg_button_2 }};
                  background-color:transparent;
                }
                .btn-outline.slideshow__btn-2{{ block.id }}:hover{
                  border-color:{{ block.settings.bg_button_hover_2 }};
                  color:{{ block.settings.color_button_hover_2 }};
                  {% unless settings.enable_button_hover %}background-color:{{ block.settings.bg_button_hover_2 }};{% endunless %}
                }
                .btn-outline.slideshow__btn-2{{ block.id }}::before{ background-color:{{ block.settings.bg_button_hover_2 }}; }
                .btn-underline.slideshow__btn-2{{ block.id }}{ color:{{ block.settings.color_button_2 }} !important; }
                .btn-underline.slideshow__btn-2{{ block.id }}:before{ background: {{ block.settings.bg_button_2 }} !important; }
                .btn-underline.slideshow__btn-2{{ block.id }}:after{ background: {{ block.settings.bg_button_hover_2 }} !important; }
                .btn-underline.slideshow__btn-2{{ block.id }}:hover{ color:{{ block.settings.color_button_hover_2 }} !important; }
                @media only screen and (max-width:749px){
                  .btn-underline.slideshow__btn-2{{ block.id }}{ border-bottom-color: {{ block.settings.bg_button_2 }} !important; }
                  .btn-underline.slideshow__btn-2{{ block.id }}:hover{ border-bottom-color: {{ block.settings.bg_button_hover_2 }} !important; }
                }
                {%- endif -%}
              </style>
          {%- endif -%}
        {%- endfor -%}
        <div
          class="transit-{{ section.settings.anim_slideshow }} dot-{{ section.settings.slide_dot }} slideshow {% unless section.settings.slideshow_height_adapt == 'adapt' %} slideshow--desktop-{{ section.settings.slideshow_height_adapt }} {% endunless %} mobile--slideshow-{{ mobile_height_class }}"
          id="Slideshow-{{ section.id }}"
          data-arrow="{{ section.settings.e_arrow }}"
          data-dot="{{ section.settings.e_dot }}"
          data-autorotate="{{ section.settings.autorotate }}"
          data-speed="{{ section.settings.autorotate_speed | times: 1000 }}"
          data-adapt-height="{%- if section.settings.slideshow_height_adapt == 'adapt' -%}true{%- else -%}false{%- endif -%}"
          data-slide-nav-a11y="{{ 'sections.slideshow.load_slide' | t: slide_number: '[slide_number]' }}"
          data-transit="{{ section.settings.anim_slideshow }}"
          {%- if section.settings.slideshow_height_adapt == 'adapt' -%}
            data-min-aspect-ratio="{{ min_aspect_ratio }}" style="height: {{ wrapper_height }}vw"
          {%- endif -%}
        >
          {%- for block in section.blocks -%}
            {%- assign text_alignments = block.settings.text_alignment | split: ' ' -%}
            {%- assign text_horizontal_alignment = text_alignments.first -%}
            {%- assign text_vertical_alignment = text_alignments.last | strip -%}

            {%- liquid
              assign show_btn_1 = false
              assign show_btn_2 = false
              if block.settings.button_label != blank and block.settings.button_link != blank
                assign show_btn_1 = true
              endif
              if block.settings.button_label_2 != blank and block.settings.button_link_2 != blank
                assign show_btn_2 = true
              endif
              assign img_d = block.settings.image
              assign img_d2 = block.settings.image2
              assign img_m = block.settings.image_mobile
              assign has_mobile = false
              assign has_split = false
              if img_m != blank
                assign has_mobile = true
              endif
              if img_d2 != blank
                assign has_split = true
              endif
              assign object_position = 'object-position:' | append: block.settings.alignment
            -%}

            <div
              class="slide {% if has_split %}slideshow__slide-split {% endif %} slideshow__slide slideshow__slide--{{ block.id }}"
              {{ block.shopify_attributes }}
              style="background-color: {{ block.settings.bgwrap }};"
            >
              {%- if block.settings.show_overlay -%}
                {%- capture bgoverlay -%}{{ block.settings.bg_overlay.red }}, {{ block.settings.bg_overlay.green }}, {{ block.settings.bg_overlay.blue }}{%- endcapture -%}
                {%- assign opoverlay = block.settings.opacity_overlay -%}
                {%- assign gradient = block.settings.gradient_overlay -%}
                <style>
                  .slideshow__overlay-{{ block.id }}::before{
                    content: '';
                    position: absolute;
                    top: 0;
                    right: 0;
                    bottom: 0;
                    left: 0;
                    background-color: rgba({{ bgoverlay }}, {{ opoverlay }});
                    z-index: 2;
                  }
                  {%- if gradient -%}
                  .gradient_overlay-{{ block.id }}:before{
                    background:linear-gradient(180deg, rgb({{ bgoverlay }}, 0) 0%, rgb({{ bgoverlay }},{{ opoverlay }}) 100%);
                    opacity: 1;
                  }
                  {%- endif -%}
                </style>
                <div class="slideshow__overlay slideshow__overlay-{{ block.id }} {% if gradient %}gradient_overlay-{{ block.id }}{% endif %}"></div>
              {%- endif -%}

              {%- if img_d == blank -%}
                <div class="slideshow__image js">
                  <div class="placeholder-background">
                    {%- capture current -%}{%- cycle 1, 2 -%}{%- endcapture -%}
                    {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                </div>
              {%- else -%}
                {%- comment -%} srcset strings (ek baar banao, har jagah reuse) {%- endcomment -%}
                {%- capture srcset_d -%}
                  {%- for w in desktop_widths -%}{%- assign wn = w | plus: 0 -%}{%- if wn <= img_d.width or forloop.first -%}{{ img_d | image_url: width: wn }} {{ wn }}w,{%- endif -%}{%- endfor -%}
                {%- endcapture -%}
                {%- assign srcset_d = srcset_d | strip | remove_last: ',' -%}

                {%- if has_split -%}
                  {%- capture srcset_d2 -%}
                    {%- for w in desktop_widths -%}{%- assign wn = w | plus: 0 -%}{%- if wn <= img_d2.width or forloop.first -%}{{ img_d2 | image_url: width: wn }} {{ wn }}w,{%- endif -%}{%- endfor -%}
                  {%- endcapture -%}
                  {%- assign srcset_d2 = srcset_d2 | strip | remove_last: ',' -%}
                {%- endif -%}

                {%- if has_mobile -%}
                  {%- capture srcset_m -%}
                    {%- for w in mobile_widths -%}{%- assign wn = w | plus: 0 -%}{%- if wn <= img_m.width or forloop.first -%}{{ img_m | image_url: width: wn }} {{ wn }}w,{%- endif -%}{%- endfor -%}
                  {%- endcapture -%}
                  {%- assign srcset_m = srcset_m | strip | remove_last: ',' -%}
                {%- endif -%}

                {%- comment -%} DESKTOP IMAGE (left / full) {%- endcomment -%}
                <div class="{% if has_mobile %}d-none d-lg-block {% endif %}{% if has_split %}w-50 slide_img_left {% endif %}slideshow__image box ratio-container">
                  <picture>
                    {%- if forloop.first and has_mobile -%}
                      <source media="(max-width: 991.98px)" srcset="{{ srcset_m }}" sizes="100vw">
                    {%- endif -%}
                    <img
                      src="{{ img_d | image_url: width: 1100 }}"
                      srcset="{{ srcset_d }}"
                      sizes="100vw"
                      width="{{ img_d.width }}"
                      height="{{ img_d.height }}"
                      alt="{{ img_d.alt | escape }}"
                      style="{{ object_position }}"
                      {% if forloop.first -%}
                        loading="eager" fetchpriority="high"
                      {%- else -%}
                        loading="lazy" decoding="async" class="lazyload scale-in"
                      {%- endif %}
                    >
                  </picture>
                </div>

                {%- if block.settings.enable_video -%}
                  {%- assign video = block.settings.video_hosted -%}
                  <div class="video-slideshow" data-provider="hosted" data-video-id="{{ video.id }}">
                    <video
                      playsinline
                      autoplay
                      loop
                      muted
                      preload="{% if forloop.first %}metadata{% else %}none{% endif %}"
                      poster="{{ img_d | image_url: width: 1100 }}"
                    >
                      <source src="{{ video }}" type="video/mp4">
                    </video>
                  </div>
                {%- endif -%}

                {%- comment -%} DESKTOP IMAGE 2 (right, split layout) {%- endcomment -%}
                {%- if has_split -%}
                  <div class="{% if has_mobile %}d-none d-lg-block {% endif %}w-50 slide_img_right slideshow__image box ratio-container">
                    <picture>
                      {%- if forloop.first and has_mobile -%}
                        <source media="(max-width: 991.98px)" srcset="{{ srcset_m }}" sizes="100vw">
                      {%- endif -%}
                      <img
                        src="{{ img_d2 | image_url: width: 1100 }}"
                        srcset="{{ srcset_d2 }}"
                        sizes="100vw"
                        width="{{ img_d2.width }}"
                        height="{{ img_d2.height }}"
                        alt="{{ img_d2.alt | escape }}"
                        style="{{ object_position }}"
                        {% if forloop.first -%}
                          loading="eager"
                        {%- else -%}
                          loading="lazy" decoding="async" class="lazyload scale-in"
                        {%- endif %}
                      >
                    </picture>
                  </div>
                {%- endif -%}

                {%- comment -%} MOBILE IMAGE {%- endcomment -%}
                {%- if has_mobile -%}
                  <div class="img_mobile d-lg-none slideshow__image box ratio-container">
                    <picture>
                      {%- if forloop.first -%}
                        <source media="(min-width: 992px)" srcset="{{ srcset_d }}" sizes="100vw">
                      {%- endif -%}
                      <img
                        src="{{ img_m | image_url: width: 750 }}"
                        srcset="{{ srcset_m }}"
                        sizes="100vw"
                        width="{{ img_m.width }}"
                        height="{{ img_m.height }}"
                        alt="{{ img_m.alt | escape }}"
                        class="mobile-slide-image"
                        {% if forloop.first -%}
                          loading="eager" fetchpriority="high"
                        {%- else -%}
                          loading="lazy" decoding="async"
                        {%- endif %}
                      >
                    </picture>
                  </div>
                {%- endif -%}
              {%- endif -%}

              {%- comment -%} FULL BANNER CLICKABLE LINK {%- endcomment -%}
              {%- if block.settings.banner_link != blank -%}
                <a
                  href="{{ block.settings.banner_link }}"
                  class="slideshow__banner-link"
                  aria-label="{{ block.settings.slide_title | default: 'Shop now' | escape }}"
                ></a>
              {%- endif -%}

              <div class="slideshow__text-wrap slideshow__text-wrap--desktop">
                <div class="slideshow__text-content slideshow__text-content--vertical-{{ text_vertical_alignment }} text-{{ text_horizontal_alignment }}">
                  <div class="{{ section.settings.setwidth }}">
                    <div class="d-inline-block text-{% if text_horizontal_alignment == 'right' %}left{% else %}{{ text_horizontal_alignment }}{% endif %}">
                      <ul class="list-unstyled">
                        {%- unless block.settings.slide_toptitle == blank -%}
                          <li class="mb-3">
                            <p class="slideshow__toptitle subtop" style="color:{{ block.settings.slide_toptitle_color }}">
                              {{ block.settings.slide_toptitle }}
                            </p>
                          </li>
                        {%- endunless -%}
                        {%- unless block.settings.slide_title == blank -%}
                          <li style="margin-bottom:{{ block.settings.margin_title | append:'rem' }};">
                            <h2 class="h1 mega-title slideshow__title font-family-1" style="color:{{ block.settings.slide_title_color }}">
                              {{ block.settings.slide_title }}
                            </h2>
                          </li>
                        {%- endunless -%}
                        {%- unless block.settings.subheading == blank -%}
                          <li class="mb-lg-5">
                            <div class="mega-subtitle slideshow__subtitle d-lg-block fz-2" style="color:{{ block.settings.subheading_color }}">
                              {{ block.settings.subheading }}
                            </div>
                          </li>
                        {%- endunless -%}
                      </ul>
                      {%- liquid
                        case block.settings.text_alignment
                          when 'center top'
                            assign align = 'justify-content-center'
                          when 'center center'
                            assign align = 'justify-content-center'
                          when 'center bottom'
                            assign align = 'justify-content-center'
                          else
                            assign align = 'justify-content-start'
                        endcase
                      -%}

                      <div class="slideshow__btn-wrapper align-items-center {{ align }} {% if block.settings.slide_title != blank or block.settings.subheading != blank %}slideshow__btn-wrapper--push{% endif %}">
                        {%- if show_btn_1 -%}
                          <div class="pb-1">
                            <a
                              href="{{ block.settings.button_link }}"
                              class="btn slideshow__btn slideshow__btn{{ block.id }} {{ block.settings.stylebtns }}"
                            >
                              <span>{{ block.settings.button_label }}</span>
                            </a>
                          </div>
                        {%- endif -%}
                        {%- if show_btn_2 -%}
                          <div class="pb-1">
                            <div class="slideshow__btn">
                              <a
                                href="{{ block.settings.button_link_2 }}"
                                class="btn slideshow__btn-2{{ block.id }} {{ block.settings.stylebtns_2 }}"
                              >
                                <span>{{ block.settings.button_label_2 }}</span>
                              </a>
                            </div>
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- unless section.settings.slideshow_mobile -%}
        <div class="slideshow__text-wrap slideshow__text-wrap--mobile bg-white text-center">
          {%- for block in section.blocks -%}
            {%- liquid
              assign show_text = false
              unless block.settings.slide_title == blank and block.settings.subheading == blank
                assign show_text = true
              endunless
              assign show_btn_1 = false
              assign show_btn_2 = false
              if block.settings.button_label != blank and block.settings.button_link != blank
                assign show_btn_1 = true
              endif
              if block.settings.button_label_2 != blank and block.settings.button_link_2 != blank
                assign show_btn_2 = true
              endif
            -%}
            {%- if show_text or show_btn_1 -%}
              <div
                class="slideshow__text-content slideshow__text-content--mobile slideshow__text-content--mobile-{{ forloop.index0 }}"
                {% unless forloop.first %}style="display:none"{% endunless %}
              >
                <div class="container" style="background-color: {{ block.settings.bgwrap }};">
                  {%- unless block.settings.slide_toptitle == blank -%}
                    <p class="slideshow__toptitle mb-2 slideshow__toptitle--mobile subtop" style="color:{{ block.settings.slide_toptitle_color }}">
                      {{ block.settings.slide_toptitle }}
                    </p>
                  {%- endunless -%}
                  {%- unless block.settings.slide_title == blank -%}
                    <h2 class="h1 mega-title slideshow__title slideshow__title--mobile mb-3" style="color:{{ block.settings.slide_title_color }}">
                      {{ block.settings.slide_title }}
                    </h2>
                  {%- endunless -%}
                  {%- unless block.settings.subheading == blank -%}
                    <div class="mega-subtitle slideshow__subtitle slideshow__subtitle--mobile mb-3" style="color:{{ block.settings.subheading_color }}">
                      {{ block.settings.subheading }}
                    </div>
                  {%- endunless -%}

                  <div class="slideshow__btn-wrapper align-items-center justify-content-center {% if block.settings.slide_title != blank or block.settings.subheading != blank %}slideshow__btn-wrapper--push{% endif %}">
                    {%- if show_btn_1 -%}
                      <div>
                        <a
                          href="{{ block.settings.button_link }}"
                          class="btn slideshow__btn{{ block.id }} {{ block.settings.stylebtns }}"
                        >
                          <span>{{ block.settings.button_label }}</span>
                        </a>
                      </div>
                    {%- endif -%}
                    {%- if show_btn_2 -%}
                      <div>
                        <a
                          href="{{ block.settings.button_link_2 }}"
                          class="btn slideshow__btn-2{{ block.id }} {{ block.settings.stylebtns_2 }}"
                        >
                          <span>{{ block.settings.button_label_2 }}</span>
                        </a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endunless -%}
    {%- endif -%}
    {%- if section.blocks.size == 0 -%}
      <div class="placeholder-noblocks">
        {{ 'homepage.onboarding.no_content' | t }}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}


