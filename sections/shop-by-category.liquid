{% doc %}
  @prompt
{% enddoc %}
{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}

  /* =========================================================
     MAIN SECTION
  ========================================================= */

  .shop-category-section-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ section.settings.section_background }};
    padding:
      {{ section.settings.section_padding_top }}px
      20px
      {{ section.settings.section_padding_bottom }}px;
    display: block;
    box-sizing: border-box;
  }


  /* =========================================================
     MAIN CONTAINER
     DESKTOP BASE
  ========================================================= */

  .shop-category-container-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    box-sizing: border-box;
  }


  /* =========================================================
     DESKTOP GRID
     24 COLUMNS
     
     LEFT   = 9
     CENTER = 6
     RIGHT  = 9
  ========================================================= */

  .shop-category-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    gap: 39px;
    width: 100%;
    align-items: stretch;
    box-sizing: border-box;
  }


  /* =========================================================
     ALL CARDS
  ========================================================= */

  .shop-category-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    background-color: {{ section.settings.card_background }};
    border-radius: {{ section.settings.border_radius }}px;
    min-width: 0;
    box-sizing: border-box;
  }


  /* =========================================================
     TOP LEFT IMAGE
     9 / 24 COLUMNS
  ========================================================= */

  .shop-category-card-{{ ai_gen_id }}.shop-category-card-top-{{ ai_gen_id }}:first-child {
    grid-column: span 9;
    height: {{ section.settings.image_height }}px;
    width: 100%;
  }


  /* =========================================================
     CENTER CONTENT CARD
     6 / 24 COLUMNS
  ========================================================= */

  .shop-category-center-card-{{ ai_gen_id }} {
    grid-column: span 6;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: {{ section.settings.image_height }}px;
    min-height: {{ section.settings.image_height }}px;

    padding: 40px 30px;

    text-align: center;

    background-color: {{ section.settings.center_card_background }};

    border-radius: {{ section.settings.border_radius }}px;

    box-sizing: border-box;
    overflow: hidden;
    min-width: 0;
  }


  /* =========================================================
     TOP RIGHT IMAGE
     9 / 24 COLUMNS
  ========================================================= */

  .shop-category-grid-{{ ai_gen_id }}
  > .shop-category-card-{{ ai_gen_id }}:nth-child(3) {
    grid-column: span 9;
    height: {{ section.settings.image_height }}px;
    width: 100%;
  }


  /* =========================================================
     BOTTOM 4 IMAGES
     6 / 24 COLUMNS EACH
  ========================================================= */

  .shop-category-card-{{ ai_gen_id }}.shop-category-card-bottom-{{ ai_gen_id }} {
    grid-column: span 6;
    width: 100%;
  }


  /* =========================================================
     CARD LINK
  ========================================================= */

  .shop-category-card-link-{{ ai_gen_id }} {
    display: block;
    position: relative;

    text-decoration: none;
    color: inherit;

    height: 100%;
    width: 100%;
  }


  /* =========================================================
     IMAGE WRAPPER
  ========================================================= */

  .shop-category-image-wrapper-{{ ai_gen_id }} {
    position: relative;

    width: 100%;
    height: {{ section.settings.image_height }}px;

    overflow: hidden;
    box-sizing: border-box;
  }


  /* =========================================================
     IMAGE
  ========================================================= */

  .shop-category-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;

    object-fit: cover;

    display: block;

    transition: transform 0.6s ease;
  }


  /* =========================================================
     IMAGE HOVER
  ========================================================= */

  .shop-category-card-link-{{ ai_gen_id }}:hover
  .shop-category-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }


  /* =========================================================
     PLACEHOLDER
  ========================================================= */

  .shop-category-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;

    background-color: #f5f5f5;

    display: flex;
    align-items: center;
    justify-content: center;
  }


  .shop-category-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  /* =========================================================
     IMAGE OVERLAY
  ========================================================= */

  .shop-category-overlay-{{ ai_gen_id }} {
    position: absolute;

    bottom: 0;
    left: 0;
    right: 0;

    padding: 30px 20px;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 12px;

    background:
      linear-gradient(
        to top,
        rgba(0, 0, 0, 0.4) 0%,
        rgba(0, 0, 0, 0) 100%
      );

    box-sizing: border-box;
  }


  /* =========================================================
     BUTTON
  ========================================================= */

  .shop-category-button-{{ ai_gen_id }} {
    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};

    padding:
      {{ section.settings.button_padding_vertical }}px
      {{ section.settings.button_padding_horizontal }}px;

    border: none;

    border-radius:
      {{ section.settings.button_border_radius }}px;

    font-size:
      {{ section.settings.button_font_size }}px;

    font-weight: 500;

    text-transform: uppercase;

    letter-spacing: 1px;

    cursor: pointer;

    transition: all 0.3s ease;

    font-family:
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      'Helvetica Neue',
      Arial,
      sans-serif;

    white-space: nowrap;
  }


  /* =========================================================
     BUTTON HOVER
  ========================================================= */

  .shop-category-card-link-{{ ai_gen_id }}:hover
  .shop-category-button-{{ ai_gen_id }} {
    background-color:
      {{ section.settings.button_hover_background }};

    color:
      {{ section.settings.button_hover_text_color }};
  }


  /* =========================================================
     CENTER EYEBROW
  ========================================================= */

  .shop-category-center-eyebrow-{{ ai_gen_id }} {
    font-size:
      {{ section.settings.eyebrow_font_size }}px;

    color:
      {{ section.settings.eyebrow_color }};

    text-transform: uppercase;

    letter-spacing: 2px;

    margin-bottom: 12px;

    font-weight: 400;

    font-family:
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      'Helvetica Neue',
      Arial,
      sans-serif;
  }


  /* =========================================================
     CENTER HEADING
  ========================================================= */

  .shop-category-center-heading-{{ ai_gen_id }} {
    font-size:
      {{ section.settings.center_heading_size }}px;

    color:
      {{ section.settings.center_heading_color }};

    margin: 0 0 16px;

    font-weight: 300;

    line-height: 1.2;

    font-family:
      Georgia,
      'Times New Roman',
      serif;
  }


  /* =========================================================
     CENTER DESCRIPTION
  ========================================================= */

  .shop-category-center-description-{{ ai_gen_id }} {
    font-size:
      {{ section.settings.description_font_size }}px;

    color:
      {{ section.settings.description_color }};

    line-height: 1.6;

    max-width: 280px;

    margin: 0 auto;

    font-family:
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      'Helvetica Neue',
      Arial,
      sans-serif;
  }


  /* =========================================================
     LAPTOP
     1200px - 1499px
     
     IMPORTANT:
     14"  = 1366px
     15"  = 1440px
     
     Container gets controlled side spacing.
  ========================================================= */

  @media screen and (min-width: 1200px) and (max-width: 1499px) {

    /* -------------------------------------------------------
       SECTION
    ------------------------------------------------------- */

    .shop-category-section-{{ ai_gen_id }} {
      width: 100%;
      padding-left: 0;
      padding-right: 0;
      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       CONTAINER

       1366px screen:
       1366 - 60 = 1306px

       1440px screen:
       1440 - 60 = 1380px

       So left and right spacing = 30px each.
    ------------------------------------------------------- */

    .shop-category-container-{{ ai_gen_id }} {
      width: calc(100% - 60px) !important;
      max-width: 1500px !important;

      margin-left: auto;
      margin-right: auto;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       GRID
    ------------------------------------------------------- */

    .shop-category-grid-{{ ai_gen_id }} {
      width: 100%;

      display: grid;

      grid-template-columns:
        repeat(24, minmax(0, 1fr));

      gap: {{ section.settings.grid_gap }}px;

      align-items: stretch;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       LEFT IMAGE
    ------------------------------------------------------- */

    .shop-category-card-{{ ai_gen_id }}.shop-category-card-top-{{ ai_gen_id }}:first-child {
      grid-column: span 9;

      width: 100%;
      min-width: 0;

      height: {{ section.settings.image_height }}px;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       CENTER
    ------------------------------------------------------- */

    .shop-category-center-card-{{ ai_gen_id }} {
      grid-column: span 6;

      width: 100%;
      min-width: 0;

      height: {{ section.settings.image_height }}px;
      min-height: {{ section.settings.image_height }}px;

      padding: 35px 25px;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       RIGHT IMAGE
    ------------------------------------------------------- */

    .shop-category-grid-{{ ai_gen_id }}
    > .shop-category-card-{{ ai_gen_id }}:nth-child(3) {
      grid-column: span 9;

      width: 100%;
      min-width: 0;

      height: {{ section.settings.image_height }}px;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       BOTTOM 4 IMAGES
    ------------------------------------------------------- */

    .shop-category-card-{{ ai_gen_id }}.shop-category-card-bottom-{{ ai_gen_id }} {
      grid-column: span 6;

      width: 100%;
      min-width: 0;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       IMAGE WRAPPER
    ------------------------------------------------------- */

    .shop-category-image-wrapper-{{ ai_gen_id }} {
      width: 100%;
      height: {{ section.settings.image_height }}px;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       IMAGE
    ------------------------------------------------------- */

    .shop-category-image-{{ ai_gen_id }} {
      width: 100%;
      height: 100%;

      object-fit: cover;

      display: block;
    }


    /* -------------------------------------------------------
       CENTER HEADING
    ------------------------------------------------------- */

    .shop-category-center-heading-{{ ai_gen_id }} {
      max-width: 100%;

      line-height: 1.15;
    }


    /* -------------------------------------------------------
       CENTER DESCRIPTION
    ------------------------------------------------------- */

    .shop-category-center-description-{{ ai_gen_id }} {
      max-width: 260px;
    }

  }


  /* =========================================================
     14" LAPTOP
     1366px
     
     EXACT CONTAINER:
     1366 - 60 = 1306px
     
     LEFT  = 30px
     RIGHT = 30px
  ========================================================= */

  @media screen and (min-width: 1200px) and (max-width: 1399px) {

    .shop-category-container-{{ ai_gen_id }} {
      width: calc(100% - 60px) !important;
      max-width: 1306px !important;

      margin-left: auto;
      margin-right: auto;
    }


    .shop-category-grid-{{ ai_gen_id }} {
      grid-template-columns:
        repeat(24, minmax(0, 1fr));

      gap: {{ section.settings.grid_gap }}px;
    }


    /* LEFT */

    .shop-category-card-{{ ai_gen_id }}.shop-category-card-top-{{ ai_gen_id }}:first-child {
      grid-column: span 9;
    }


    /* CENTER */

    .shop-category-center-card-{{ ai_gen_id }} {
      grid-column: span 6;

      padding-left: 22px;
      padding-right: 22px;
    }


    /* RIGHT */

    .shop-category-grid-{{ ai_gen_id }}
    > .shop-category-card-{{ ai_gen_id }}:nth-child(3) {
      grid-column: span 9;
    }


    /* BOTTOM */

    .shop-category-card-{{ ai_gen_id }}.shop-category-card-bottom-{{ ai_gen_id }} {
      grid-column: span 6;
    }


    /* CENTER TEXT */

    .shop-category-center-heading-{{ ai_gen_id }} {
      font-size:
        {{ section.settings.center_heading_size }}px;
    }

  }


  /* =========================================================
     15" LAPTOP
     1440px
     
     EXACT CONTAINER:
     1440 - 60 = 1380px
     
     LEFT  = 30px
     RIGHT = 30px
  ========================================================= */

  @media screen and (min-width: 1400px) and (max-width: 1499px) {

    .shop-category-container-{{ ai_gen_id }} {
      width: calc(100% - 60px) !important;
      max-width: 1380px !important;

      margin-left: auto;
      margin-right: auto;
    }


    .shop-category-grid-{{ ai_gen_id }} {
      grid-template-columns:
        repeat(24, minmax(0, 1fr));

      gap: {{ section.settings.grid_gap }}px;
    }


    /* LEFT */

    .shop-category-card-{{ ai_gen_id }}.shop-category-card-top-{{ ai_gen_id }}:first-child {
      grid-column: span 9;
    }


    /* CENTER */

    .shop-category-center-card-{{ ai_gen_id }} {
      grid-column: span 6;

      padding-left: 28px;
      padding-right: 28px;
    }


    /* RIGHT */

    .shop-category-grid-{{ ai_gen_id }}
    > .shop-category-card-{{ ai_gen_id }}:nth-child(3) {
      grid-column: span 9;
    }


    /* BOTTOM */

    .shop-category-card-{{ ai_gen_id }}.shop-category-card-bottom-{{ ai_gen_id }} {
      grid-column: span 6;
    }

  }


  /* =========================================================
     TABLET
     750px - 1100px

     4 / 4 / 4 LAYOUT
  ========================================================= */

  @media screen and (min-width: 750px) and (max-width: 1100px) {

    .shop-category-section-{{ ai_gen_id }} {
      width: 100%;
      box-sizing: border-box;
    }


    .shop-category-container-{{ ai_gen_id }} {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      box-sizing: border-box;
    }


    .shop-category-grid-{{ ai_gen_id }} {
      display: grid;

      grid-template-columns:
        repeat(12, minmax(0, 1fr));

      gap: {{ section.settings.grid_gap }}px;

      align-items: stretch;

      width: 100%;
    }


    /* -------------------------------------------------------
       TOP LEFT
    ------------------------------------------------------- */

    .shop-category-card-{{ ai_gen_id }}.shop-category-card-top-{{ ai_gen_id }}:first-child {
      grid-column: span 4;

      height: {{ section.settings.image_height }}px;

      min-width: 0;
    }


    /* -------------------------------------------------------
       CENTER
    ------------------------------------------------------- */

    .shop-category-center-card-{{ ai_gen_id }} {
      grid-column: span 4;

      height: {{ section.settings.image_height }}px;

      min-height: {{ section.settings.image_height }}px;

      padding: 30px 20px;

      display: flex;

      align-items: center;

      justify-content: center;
    }


    /* -------------------------------------------------------
       TOP RIGHT
    ------------------------------------------------------- */

    .shop-category-grid-{{ ai_gen_id }}
    > .shop-category-card-{{ ai_gen_id }}:nth-child(3) {
      grid-column: span 4;

      height: {{ section.settings.image_height }}px;

      min-width: 0;
    }


    /* -------------------------------------------------------
       BOTTOM
    ------------------------------------------------------- */

    .shop-category-card-{{ ai_gen_id }}.shop-category-card-bottom-{{ ai_gen_id }} {
      grid-column: span 3;

      min-width: 0;
    }

  }


  /* =========================================================
     MOBILE
     2 COLUMN
  ========================================================= */

  @media screen and (max-width: 749px) {

    /* -------------------------------------------------------
       MAIN SECTION
    ------------------------------------------------------- */

    .shop-category-section-{{ ai_gen_id }} {
      width: 100%;

      padding-left: 15px;
      padding-right: 15px;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       CONTAINER
    ------------------------------------------------------- */

    .shop-category-container-{{ ai_gen_id }} {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       MOBILE GRID
    ------------------------------------------------------- */

    .shop-category-grid-{{ ai_gen_id }} {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap:
        {{ section.settings.mobile_grid_gap }}px;

      align-items: stretch;

      width: 100%;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       CENTER CONTENT
       FULL WIDTH
       COMES FIRST
    ------------------------------------------------------- */

    .shop-category-center-card-{{ ai_gen_id }} {

      grid-column: 1 / -1;

      order: -1;

      width: 100%;

      height: auto;

      min-height: auto;

      padding: 30px 20px;

      box-sizing: border-box;

      display: flex;

      align-items: center;

      justify-content: center;

      text-align: center;
    }


    /* -------------------------------------------------------
       TOP IMAGE 1
    ------------------------------------------------------- */

    .shop-category-card-{{ ai_gen_id }}.shop-category-card-top-{{ ai_gen_id }}:first-child {

      grid-column: span 1;

      height: auto;

      min-width: 0;
    }


    /* -------------------------------------------------------
       TOP IMAGE 2
    ------------------------------------------------------- */

    .shop-category-grid-{{ ai_gen_id }}
    > .shop-category-card-{{ ai_gen_id }}:nth-child(3) {

      grid-column: span 1;

      height: auto;

      min-width: 0;
    }


    /* -------------------------------------------------------
       BOTTOM IMAGES
    ------------------------------------------------------- */

    .shop-category-card-{{ ai_gen_id }}.shop-category-card-bottom-{{ ai_gen_id }} {

      grid-column: span 1;

      height: auto;

      min-width: 0;
    }


    /* -------------------------------------------------------
       MOBILE IMAGE = SQUARE
    ------------------------------------------------------- */

    .shop-category-image-wrapper-{{ ai_gen_id }} {

      position: relative;

      width: 100%;

      height: 0;

      padding-bottom: 100%;

      overflow: hidden;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       MOBILE IMAGE
    ------------------------------------------------------- */

    .shop-category-image-{{ ai_gen_id }} {

      position: absolute;

      top: 0;
      left: 0;

      width: 100%;
      height: 100%;

      object-fit: cover;

      display: block;
    }


    /* -------------------------------------------------------
       MOBILE PLACEHOLDER
    ------------------------------------------------------- */

    .shop-category-placeholder-{{ ai_gen_id }} {

      position: absolute;

      top: 0;
      left: 0;

      width: 100%;
      height: 100%;
    }


    /* -------------------------------------------------------
       MOBILE OVERLAY
    ------------------------------------------------------- */

    .shop-category-overlay-{{ ai_gen_id }} {

      padding: 20px 10px;

      gap: 8px;
    }


    /* -------------------------------------------------------
       MOBILE BUTTON
    ------------------------------------------------------- */

    .shop-category-button-{{ ai_gen_id }} {

      padding:
        {{ section.settings.mobile_button_padding_vertical }}px
        {{ section.settings.mobile_button_padding_horizontal }}px;

      font-size:
        {{ section.settings.mobile_button_font_size }}px;

      letter-spacing: 0.8px;
    }


    /* -------------------------------------------------------
       MOBILE CENTER HEADING
    ------------------------------------------------------- */

    .shop-category-center-heading-{{ ai_gen_id }} {

      font-size:
        {{ section.settings.mobile_center_heading_size }}px;

      margin-bottom: 12px;
    }


    /* -------------------------------------------------------
       MOBILE EYEBROW
    ------------------------------------------------------- */

    .shop-category-center-eyebrow-{{ ai_gen_id }} {

      font-size:
        {{ section.settings.mobile_eyebrow_font_size }}px;

      margin-bottom: 8px;
    }


    /* -------------------------------------------------------
       MOBILE DESCRIPTION
    ------------------------------------------------------- */

    .shop-category-center-description-{{ ai_gen_id }} {

      font-size:
        {{ section.settings.mobile_description_font_size }}px;

      line-height: 1.5;

      max-width: 300px;
    }


    /* -------------------------------------------------------
       DISABLE HOVER ZOOM ON MOBILE
    ------------------------------------------------------- */

    .shop-category-card-link-{{ ai_gen_id }}:hover
    .shop-category-image-{{ ai_gen_id }} {

      transform: none;
    }

  }


  /* =========================================================
     VERY SMALL MOBILE
     BELOW 400px
  ========================================================= */

  @media screen and (max-width: 399px) {

    .shop-category-section-{{ ai_gen_id }} {

      padding-left: 10px;
      padding-right: 10px;
    }


    .shop-category-container-{{ ai_gen_id }} {
      width: 100%;
      max-width: 100%;
    }


    .shop-category-grid-{{ ai_gen_id }} {

      gap: {{ section.settings.mobile_grid_gap }}px;
    }


    .shop-category-center-card-{{ ai_gen_id }} {

      padding: 25px 15px;
    }


    .shop-category-overlay-{{ ai_gen_id }} {

      padding: 15px 8px;
    }


    .shop-category-button-{{ ai_gen_id }} {

      white-space: normal;

      text-align: center;
    }

  }

{% endstyle %}

<div class="shop-category-section-{{ ai_gen_id }}">
  <div class="shop-category-container-{{ ai_gen_id }}">
    <div class="shop-category-grid-{{ ai_gen_id }}">
      {% if section.settings.category_1_image != blank or section.settings.category_1_title != blank %}
        <div class="shop-category-card-{{ ai_gen_id }} shop-category-card-top-{{ ai_gen_id }}">
          <a
            href="{{ section.settings.category_1_link }}"
            class="shop-category-card-link-{{ ai_gen_id }}"
            {% if section.settings.category_1_title != blank %}
              aria-label="{{ section.settings.category_1_title }}"
            {% endif %}
          >
            <div class="shop-category-image-wrapper-{{ ai_gen_id }}">
              {% if section.settings.category_1_image %}
                <img
                  src="{{ section.settings.category_1_image | image_url: width: 900 }}"
                  alt="{{ section.settings.category_1_image.alt | escape }}"
                  loading="lazy"
                  width="900"
                  height="{{ section.settings.image_height }}"
                  class="shop-category-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="shop-category-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="shop-category-overlay-{{ ai_gen_id }}">
              <button type="button" class="shop-category-button-{{ ai_gen_id }}">
                {{ section.settings.category_1_button_text }}
              </button>
            </div>
          </a>
        </div>
      {% endif %}

      <div class="shop-category-center-card-{{ ai_gen_id }}">
        {% if section.settings.center_eyebrow != blank %}
          <div class="shop-category-center-eyebrow-{{ ai_gen_id }}">
            {{ section.settings.center_eyebrow }}
          </div>
        {% endif %}

        {% if section.settings.center_heading != blank %}
          <h2 class="shop-category-center-heading-{{ ai_gen_id }}">
            {{ section.settings.center_heading }}
          </h2>
        {% endif %}

        {% if section.settings.center_description != blank %}
          <div class="shop-category-center-description-{{ ai_gen_id }}">
            {{ section.settings.center_description }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.category_2_image != blank or section.settings.category_2_title != blank %}
        <div class="shop-category-card-{{ ai_gen_id }} shop-category-card-top-{{ ai_gen_id }}">
          <a
            href="{{ section.settings.category_2_link }}"
            class="shop-category-card-link-{{ ai_gen_id }}"
            {% if section.settings.category_2_title != blank %}
              aria-label="{{ section.settings.category_2_title }}"
            {% endif %}
          >
            <div class="shop-category-image-wrapper-{{ ai_gen_id }}">
              {% if section.settings.category_2_image %}
                <img
                  src="{{ section.settings.category_2_image | image_url: width: 900 }}"
                  alt="{{ section.settings.category_2_image.alt | escape }}"
                  loading="lazy"
                  width="900"
                  height="{{ section.settings.image_height }}"
                  class="shop-category-image-{{ ai_gen_id }}"
                >
