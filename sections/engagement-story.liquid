  /* ============================================
     HAND + RING (SCROLL SET)
  ============================================ */

  .lumera-engagement-right {
    min-height: 0;
  }

  .lumera-hand-stage {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
  }

  .lumera-hand-img {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 20px 25px rgba(40,25,15,.12));
  }

  .lumera-hand-placeholder {
    aspect-ratio: 3 / 4;
  }

  .lumera-hand-glow {
    position: absolute;
    width: 80%;
    height: 80%;
    left: 10%;
    top: 10%;
    border-radius: 50%;
    background: rgba(214,193,165,.22);
    filter: blur(40px);
    z-index: 0;
    opacity: calc(.3 + var(--p, 0) * .7);
  }

 /* Ring: --p 0 = hand ke upar se, --p 1 = ring finger par set */
.lumera-hand-ring {
    position: absolute;
    left: calc(var(--ring-x) + (1 - var(--p, 0)) * 6%);
    top: calc(var(--ring-y) - (1 - var(--p, 0)) * var(--ring-travel, 58%));
    width: var(--ring-size);
    z-index: 4;
    pointer-events: none;
    will-change: transform, opacity, top, left;
    opacity: min(1, calc(var(--p, 0) * 4));
    transform:
      translate(-50%, -50%)
      rotate(var(--ring-rotate))
      scale(calc(1.12 - var(--p, 0) * .12));
  }

  .lumera-hand-ring img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(
      0 calc(2px + (1 - var(--p, 0)) * 14px)
        calc(3px + (1 - var(--p, 0)) * 10px)
        rgba(40,25,15,.3)
    );
  }

  .hand-spark {
    z-index: 6;
    opacity: 0;
    transition: opacity .6s ease;
  }

  .lumera-hand-stage.is-set .hand-spark {
    opacity: .85;
    animation: sparkleAnimation 3s ease-in-out infinite;
  }

  .spark-a { left: calc(var(--ring-x) + 7%);  top: calc(var(--ring-y) - 7%); font-size: 16px; }
  .spark-b { left: calc(var(--ring-x) - 12%); top: calc(var(--ring-y) + 1%); font-size: 12px; animation-delay: .6s; }
  .spark-c { left: calc(var(--ring-x) + 9%);  top: calc(var(--ring-y) + 6%); font-size: 10px; animation-delay: 1.1s; }

  /* ============================================
     MOBILE : content upar, hand neeche
  ============================================ */

  @media screen and (max-width: 749px) {

    .lumera-engagement-inner {
      flex-direction: column;
      min-height: 0;
      padding: 40px 20px 30px;
      gap: 18px;
    }

    .lumera-engagement-content {
      width: 100%;
      max-width: 340px;
    }

    .lumera-eyebrow { font-size: 10px; letter-spacing: 2.5px; }
    .lumera-eyebrow span { width: 20px; }

    .lumera-engagement-heading {
      max-width: 100%;
      font-size: 32px;
    }

    .lumera-engagement-description {
      max-width: 100%;
      font-size: 13px;
      line-height: 1.7;
    }

    .lumera-engagement-button {
      min-width: 180px;
      padding: 14px 22px;
      font-size: 11px;
    }

    .lumera-bottom-text {
      max-width: 100%;
      font-size: 9px;
    }

    .lumera-engagement-right {
      position: relative;
      left: auto;
      top: auto;
      width: 100%;
      height: auto;
      display: flex;
      justify-content: center;
      pointer-events: auto;
      z-index: 2;
    }

    .lumera-hand-stage {
      max-width: 290px;
    }

    .spark-a { font-size: 16px; }
    .spark-b { font-size: 12px; }
    .spark-c { font-size: 10px; }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('.lumera-engagement-{{ section.id }}');
    if (!root) return;

    var stage = root.querySelector('[data-hand-stage]');
    if (!stage) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var current = 0, target = 0, ticking = false, running = false;

    function clamp(n) { return Math.min(1, Math.max(0, n)); }

    function calcTarget() {
      var rect = stage.getBoundingClientRect();
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var start = vh * 0.95;   // stage neeche se aata hua
      var end = vh * 0.30;     // is point par ring poori set
      target = clamp((start - rect.top) / (start - end));
      if (reduce) target = 1;
    }

    function render() {
      current += (target - current) * 0.14;      // smooth easing
      if (Math.abs(target - current) < 0.001) current = target;

      stage.style.setProperty('--p', current.toFixed(4));
      stage.classList.toggle('is-set', current > 0.97);

      if (current !== target) {
        requestAnimationFrame(render);
      } else {
        running = false;
      }
    }

    function start() {
      if (!running) {
        running = true;
        requestAnimationFrame(render);
      }
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        calcTarget();
        start();
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    window.addEventListener('load', onScroll);
    calcTarget();
    start();
  })();
</script>
