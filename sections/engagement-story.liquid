<section
  class="lumera-engagement-{{ section.id }}"
  style="
    --section-bg: {{ section.settings.background_color }};
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    --button-bg: {{ section.settings.button_background }};
    --button-text: {{ section.settings.button_text }};
    --accent-color: {{ section.settings.accent_color }};
    --section-height: {{ section.settings.section_height }}px;
  "
>

  <div class="lumera-engagement-inner">

    <!-- =========================
         LEFT : COUPLE IMAGE
    ========================== -->

    <div class="lumera-engagement-left">

      <div class="lumera-couple-wrap">

        {% if section.settings.couple_image != blank %}

          <div class="lumera-couple-image">

            <img
              src="{{ section.settings.couple_image | image_url: width: 1000 }}"
              alt="{{ section.settings.couple_image.alt | escape }}"
              loading="lazy"
              width="{{ section.settings.couple_image.width }}"
              height="{{ section.settings.couple_image.height }}"
            >

          </div>

        {% else %}

          <div class="lumera-placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>

        {% endif %}

        {% if section.settings.show_image_ring != blank %}

          <div class="lumera-mini-ring">

            <span></span>

          </div>

        {% endif %}

      </div>

    </div>


    <!-- =========================
         CENTER : CONTENT
    ========================== -->

    <div class="lumera-engagement-content">

      {% if section.settings.eyebrow != blank %}
        <div class="lumera-eyebrow">
          <span></span>
          {{ section.settings.eyebrow }}
          <span></span>
        </div>
      {% endif %}


      {% if section.settings.heading != blank %}

        <h2 class="lumera-engagement-heading">
          {{ section.settings.heading }}
        </h2>

      {% endif %}


      {% if section.settings.description != blank %}

        <div class="lumera-engagement-description">
          {{ section.settings.description }}
        </div>

      {% endif %}


      {% if section.settings.button_label != blank %}

        <a
          href="{{ section.settings.button_link }}"
          class="lumera-engagement-button"
        >

          <span>{{ section.settings.button_label }}</span>

          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M5 12H19"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
            <path
              d="M13 6L19 12L13 18"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>

        </a>

      {% endif %}


      {% if section.settings.bottom_text != blank %}

        <div class="lumera-bottom-text">
          {{ section.settings.bottom_text }}
        </div>

      {% endif %}

    </div>


    <!-- =========================
         RIGHT : HAND + RING
    ========================== -->

    <div class="lumera-engagement-right">

      <div
        class="lumera-hand-stage"
        data-hand-stage
        style="
          --ring-x: {{ section.settings.ring_x }}%;
          --ring-y: {{ section.settings.ring_y }}%;
          --ring-size: {{ section.settings.ring_size }}%;
          --ring-rotate: {{ section.settings.ring_rotate }}deg;
          --p: 0;
        "
      >

        <div class="lumera-hand-glow"></div>

        {% if section.settings.hand_image != blank %}
          <img
            class="lumera-hand-img"
            src="{{ section.settings.hand_image | image_url: width: 900 }}"
            alt="{{ section.settings.hand_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.hand_image.width }}"
            height="{{ section.settings.hand_image.height }}"
          >
        {% else %}
          <div class="lumera-placeholder lumera-hand-placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if section.settings.ring_image != blank %}
          <div class="lumera-hand-ring">
            <img
              src="{{ section.settings.ring_image | image_url: width: 400 }}"
              alt="{{ section.settings.ring_image.alt | escape }}"
              loading="lazy"
              width="{{ section.settings.ring_image.width }}"
              height="{{ section.settings.ring_image.height }}"
            >
          </div>
        {% endif %}

        <!-- Ring set hone ke baad: gold halo ripple + floating glow dots -->
        <span class="hand-halo" aria-hidden="true"></span>
        <span class="hand-dot dot-a" aria-hidden="true"></span>
        <span class="hand-dot dot-b" aria-hidden="true"></span>
        <span class="hand-dot dot-c" aria-hidden="true"></span>

      </div>

    </div>

  </div>

</section>


<style>

  /* ============================================
     MAIN SECTION
  ============================================ */

  .lumera-engagement-{{ section.id }} {
    width: 100%;
    background: var(--section-bg);
    overflow: hidden;
    position: relative;
  }


  .lumera-engagement-inner {
    width: min(1500px, 100%);
    min-height: var(--section-height);
    margin: 0 auto;
    padding: 55px 60px;
    display: grid;
    grid-template-columns: 30% 40% 30%;
    align-items: center;
    position: relative;
    box-sizing: border-box;
  }


  /* ============================================
     LEFT IMAGE
  ============================================ */

  .lumera-engagement-left {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
  }


  .lumera-couple-wrap {
    width: 100%;
    max-width: 390px;
    position: relative;
  }


  .lumera-couple-image {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 2px;
    animation: coupleReveal 1.2s ease both;
  }


  .lumera-couple-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 1s ease;
  }


  .lumera-couple-image:hover img {
    transform: scale(1.04);
  }


  /* Small decorative ring badge */

  .lumera-mini-ring {
    position: absolute;
    width: 54px;
    height: 54px;
    right: -18px;
    bottom: 30px;
    background: rgba(255,255,255,.8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 35px rgba(50,35,20,.12);
    backdrop-filter: blur(8px);
    animation: smallFloat 4s ease-in-out infinite;
  }


  .lumera-mini-ring span {
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--accent-color);
    border-radius: 50%;
    display: block;
    position: relative;
  }


  .lumera-mini-ring span:before {
    content: "";
    position: absolute;
    width: 7px;
    height: 7px;
    background: transparent;
    border: 1px solid var(--accent-color);
    transform: rotate(45deg);
    top: -5px;
    left: 5px;
  }


  /* ============================================
     CENTER CONTENT
  ============================================ */

  .lumera-engagement-content {
    text-align: center;
    padding: 20px 35px;
    position: relative;
    z-index: 5;
  }


  .lumera-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: 18px;
    font-weight: 500;
  }


  .lumera-eyebrow span {
    width: 28px;
    height: 1px;
    background: var(--accent-color);
    display: block;
    opacity: .65;
  }


  .lumera-engagement-heading {
    margin: 0;
    color: var(--heading-color);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(38px, 4vw, 65px);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: -1.5px;
  }


  .lumera-engagement-description {
    max-width: 570px;
    margin: 25px auto 0;
    color: var(--text-color);
    font-size: 15px;
    line-height: 1.85;
    font-weight: 400;
  }


  /* ============================================
     CTA
  ============================================ */

  .lumera-engagement-button {
    margin-top: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-width: 190px;
    padding: 15px 27px;
    background: var(--button-bg);
    color: var(--button-text);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    font-size: 12px;
    font-weight: 600;
    position: relative;
    overflow: hidden;
    transition:
      transform .35s ease,
      box-shadow .35s ease;
  }


  .lumera-engagement-button:before {
    content: "";
    position: absolute;
    width: 0;
    height: 100%;
    left: 0;
    top: 0;
    background: rgba(255,255,255,.12);
    transition: width .4s ease;
  }


  .lumera-engagement-button:hover:before {
    width: 100%;
  }


  .lumera-engagement-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(50,35,20,.15);
  }


  .lumera-engagement-button svg {
    transition: transform .35s ease;
  }


  .lumera-engagement-button:hover svg {
    transform: translateX(4px);
  }


  .lumera-bottom-text {
    margin-top: 20px;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-color);
    opacity: .55;
  }


  /* ============================================
     RIGHT : HAND + RING (SCROLL SET)
  ============================================ */

  .lumera-engagement-right {
    height: 100%;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .lumera-hand-stage {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
  }

  .lumera-hand-img {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 20px 25px rgba(40,25,15,.12));
  }

  .lumera-hand-placeholder {
    aspect-ratio: 3 / 4;
  }

  .lumera-hand-glow {
    position: absolute;
    width: 80%;
    height: 80%;
    left: 10%;
    top: 10%;
    border-radius: 50%;
    background: rgba(214,193,165,.22);
    filter: blur(40px);
    z-index: 0;
    opacity: calc(.3 + var(--p, 0) * .7);
  }

  /* Ring: --p 0 = hand ke upar se, --p 1 = ring finger par set */
  .lumera-hand-ring {
    position: absolute;
    left: calc(var(--ring-x) + (1 - var(--p, 0)) * 6%);
    top: calc(var(--ring-y) - (1 - var(--p, 0)) * var(--ring-travel, 58%));
    width: var(--ring-size);
    z-index: 4;
    pointer-events: none;
    will-change: transform, opacity, top, left;
    opacity: min(1, calc(var(--p, 0) * 4));
    transform:
      translate(-50%, -50%)
      rotate(var(--ring-rotate))
      scale(calc(1.12 - var(--p, 0) * .12));
  }

  .lumera-hand-ring img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(
      0 calc(2px + (1 - var(--p, 0)) * 14px)
        calc(3px + (1 - var(--p, 0)) * 10px)
        rgba(40,25,15,.3)
    );
  }


  /* ============================================
     RING SET ANIMATION : GOLD HALO + GLOW DOTS
     (sparkle star ki jagah)
  ============================================ */

  .hand-halo {
    position: absolute;
    left: var(--ring-x);
    top: var(--ring-y);
    width: calc(var(--ring-size) * 1.3);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: 1px solid rgba(217,180,108,.75);
    box-shadow: 0 0 14px rgba(217,180,108,.35);
    z-index: 3;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(.6);
  }

  .lumera-hand-stage.is-set .hand-halo {
    animation: ringHalo 3.2s ease-out infinite;
  }

  .hand-dot {
    position: absolute;
    z-index: 6;
    border-radius: 50%;
    background: radial-gradient(circle, #f8e8bb 0%, #d9b46c 50%, rgba(217,180,108,0) 72%);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(.4);
  }

  .lumera-hand-stage.is-set .hand-dot {
    animation: ringDotFloat 3.6s ease-in-out infinite;
  }

  .dot-a { left: calc(var(--ring-x) + 9%);  top: calc(var(--ring-y) - 4%); width: 12px; height: 12px; }
  .dot-b { left: calc(var(--ring-x) - 10%); top: calc(var(--ring-y) - 1%); width: 8px;  height: 8px;  animation-delay: 1.1s; }
  .dot-c { left: calc(var(--ring-x) + 12%); top: calc(var(--ring-y) + 5%); width: 9px;  height: 9px;  animation-delay: 2.1s; }

  @keyframes ringHalo {
    0%   { opacity: .85; transform: translate(-50%, -50%) scale(.6); }
    100% { opacity: 0;   transform: translate(-50%, -50%) scale(1.8); }
  }

  @keyframes ringDotFloat {
    0%   { opacity: 0;   transform: translate(-50%, -50%) scale(.4); }
    35%  { opacity: .95; }
    100% { opacity: 0;   transform: translate(-50%, calc(-50% - 28px)) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hand-halo,
    .hand-dot {
      animation: none !important;
    }
  }


  /* ============================================
     ANIMATIONS
  ============================================ */

  @keyframes smallFloat {

    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-9px);
    }

  }


  @keyframes coupleReveal {

    from {
      opacity: 0;
      transform: translateX(-35px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }

  }


  /* ============================================
     MOBILE : content upar, hand neeche
  ============================================ */

  @media screen and (max-width: 749px) {

    .lumera-engagement-inner {
      flex-direction: column;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 0;
      padding: 40px 20px 30px;
      gap: 18px;
    }

    /* couple image hide */
    .lumera-engagement-left {
      display: none !important;
    }

    .lumera-engagement-content {
      width: 100%;
      max-width: 340px;
      padding: 0;
      margin: 0;
    }

    .lumera-eyebrow {
      font-size: 10px;
      letter-spacing: 2.5px;
      gap: 8px;
      margin: 0 0 14px;
    }

    .lumera-eyebrow span {
      width: 20px;
      flex-shrink: 0;
    }

    .lumera-engagement-heading {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      font-size: 32px;
      line-height: 1.05;
      letter-spacing: -0.7px;
    }

    .lumera-engagement-description {
      width: 100%;
      max-width: 100%;
      margin: 18px auto 0;
      font-size: 13px;
      line-height: 1.7;
    }

    .lumera-engagement-button {
      margin: 23px auto 0;
      min-width: 180px;
      padding: 14px 22px;
      gap: 8px;
      font-size: 11px;
      line-height: 1.2;
      letter-spacing: 1px;
    }

    .lumera-engagement-button svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }

    .lumera-bottom-text {
      width: 100%;
      max-width: 100%;
      margin: 16px auto 0;
      font-size: 9px;
      line-height: 1.65;
      letter-spacing: 1.8px;
    }

    .lumera-engagement-right {
      position: relative;
      left: auto;
      top: auto;
      width: 100%;
      height: auto;
      display: flex;
      justify-content: center;
      pointer-events: auto;
      z-index: 2;
    }

    .lumera-hand-stage {
      max-width: 290px;
    }

    .hand-dot.dot-a { width: 10px; height: 10px; }
    .hand-dot.dot-b { width: 7px;  height: 7px; }
    .hand-dot.dot-c { width: 8px;  height: 8px; }

  }
</style>

<script>
  (function () {
    var root = document.querySelector('.lumera-engagement-{{ section.id }}');
    if (!root) return;

    var stage = root.querySelector('[data-hand-stage]');
    if (!stage) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var current = 0, target = 0, ticking = false, running = false;

    function clamp(n) { return Math.min(1, Math.max(0, n)); }

    function calcTarget() {
      var rect = stage.getBoundingClientRect();
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var start = vh * 0.95;   // stage neeche se aata hua
      var end = vh * 0.30;     // is point par ring poori set
      target = clamp((start - rect.top) / (start - end));
      if (reduce) target = 1;
    }

    function render() {
      current += (target - current) * 0.14;      // smooth easing
      if (Math.abs(target - current) < 0.001) current = target;

      stage.style.setProperty('--p', current.toFixed(4));
      stage.classList.toggle('is-set', current > 0.97);

      if (current !== target) {
        requestAnimationFrame(render);
      } else {
        running = false;
      }
    }

    function start() {
      if (!running) {
        running = true;
        requestAnimationFrame(render);
      }
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        calcTarget();
        start();
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    window.addEventListener('load', onScroll);
    calcTarget();
    start();
  })();
</script>

{% schema %}

{
  "name": "Lumera Engagement Story",
  "tag": "section",
  "class": "lumera-engagement-story",
  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Made for Your Forever"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The Ring That Begins Your Forever"
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Celebrate the moment you say forever with a timeless engagement ring, thoughtfully designed to capture your love story and shine through every chapter.</p>"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore Engagement Rings"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },

    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "Crafted with intention · Designed for forever"
    },


    {
      "type": "header",
      "content": "Left Image"
    },

    {
      "type": "image_picker",
      "id": "couple_image",
      "label": "Couple image"
    },

    {
      "type": "checkbox",
      "id": "show_image_ring",
      "label": "Show decorative mini ring",
      "default": true
    },


    {
      "type": "header",
      "content": "Hand + Ring Animation"
    },

    {
      "type": "image_picker",
      "id": "hand_image",
      "label": "Hand image (transparent PNG)"
    },

    {
      "type": "image_picker",
      "id": "ring_image",
      "label": "Ring image (transparent PNG)"
    },

    {
      "type": "range",
      "id": "ring_x",
      "label": "Ring position - Left/Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "ring_y",
      "label": "Ring position - Up/Down",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 45
    },

    {
      "type": "range",
      "id": "ring_size",
      "label": "Ring size",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 14
    },

    {
      "type": "range",
      "id": "ring_rotate",
      "label": "Ring rotation",
      "min": -45,
      "max": 45,
      "step": 1,
      "unit": "°",
      "default": 0
    },


    {
      "type": "header",
      "content": "Colors"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F5F1EB"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#17130F"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#403A34"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#806346"
    },

    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#6F5238"
    },

    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "section_height",
      "label": "Section minimum height",
      "min": 350,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 520
    }

  ],

  "presets": [
    {
      "name": "Lumera Engagement Story"
    }
  ]

}

{% endschema %}