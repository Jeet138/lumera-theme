<section
  class="lumera-engagement-{{ section.id }}"
  style="
    --section-bg: {{ section.settings.background_color }};
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    --button-bg: {{ section.settings.button_background }};
    --button-text: {{ section.settings.button_text }};
    --accent-color: {{ section.settings.accent_color }};
    --section-height: {{ section.settings.section_height }}px;
  "
>

  <div class="lumera-engagement-inner">

    <!-- =========================
         LEFT : COUPLE IMAGE
    ========================== -->

    <div class="lumera-engagement-left">

      <div class="lumera-couple-wrap">

        {% if section.settings.couple_image != blank %}

          <div class="lumera-couple-image">

            <img
              src="{{ section.settings.couple_image | image_url: width: 1000 }}"
              alt="{{ section.settings.couple_image.alt | escape }}"
              loading="lazy"
              width="{{ section.settings.couple_image.width }}"
              height="{{ section.settings.couple_image.height }}"
            >

          </div>

        {% else %}

          <div class="lumera-placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>

        {% endif %}

        {% if section.settings.show_image_ring != blank %}

          <div class="lumera-mini-ring">

            <span></span>

          </div>

        {% endif %}

      </div>

    </div>


    <!-- =========================
         CENTER : CONTENT
    ========================== -->

    <div class="lumera-engagement-content">

      {% if section.settings.eyebrow != blank %}
        <div class="lumera-eyebrow">
          <span></span>
          {{ section.settings.eyebrow }}
          <span></span>
        </div>
      {% endif %}


      {% if section.settings.heading != blank %}

        <h2 class="lumera-engagement-heading">
          {{ section.settings.heading }}
        </h2>

      {% endif %}


      {% if section.settings.description != blank %}

        <div class="lumera-engagement-description">
          {{ section.settings.description }}
        </div>

      {% endif %}


      {% if section.settings.button_label != blank %}

        <a
          href="{{ section.settings.button_link }}"
          class="lumera-engagement-button"
        >

          <span>{{ section.settings.button_label }}</span>

          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M5 12H19"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
            <path
              d="M13 6L19 12L13 18"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>

        </a>

      {% endif %}


      {% if section.settings.bottom_text != blank %}

        <div class="lumera-bottom-text">
          {{ section.settings.bottom_text }}
        </div>

      {% endif %}

    </div>


    <!-- =========================
         RIGHT : FLOATING IMAGES
    ========================== -->

    <div class="lumera-engagement-right">

      <div
        class="lumera-hand-stage"
        data-hand-stage
        style="
          --ring-x: {{ section.settings.ring_x }}%;
          --ring-y: {{ section.settings.ring_y }}%;
          --ring-size: {{ section.settings.ring_size }}%;
          --ring-rotate: {{ section.settings.ring_rotate }}deg;
          --p: 0;
        "
      >

        <div class="lumera-hand-glow"></div>

        {% if section.settings.hand_image != blank %}
          <img
            class="lumera-hand-img"
            src="{{ section.settings.hand_image | image_url: width: 900 }}"
            alt="{{ section.settings.hand_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.hand_image.width }}"
            height="{{ section.settings.hand_image.height }}"
          >
        {% else %}
          <div class="lumera-placeholder lumera-hand-placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if section.settings.ring_image != blank %}
          <div class="lumera-hand-ring">
            <img
              src="{{ section.settings.ring_image | image_url: width: 400 }}"
              alt="{{ section.settings.ring_image.alt | escape }}"
              loading="lazy"
              width="{{ section.settings.ring_image.width }}"
              height="{{ section.settings.ring_image.height }}"
            >
          </div>
        {% endif %}

        <div class="lumera-sparkle hand-spark spark-a">✦</div>
        <div class="lumera-sparkle hand-spark spark-b">✧</div>
        <div class="lumera-sparkle hand-spark spark-c">✦</div>

      </div>

    </div>

  </div>

</section>


<style>

  /* ============================================
     MAIN SECTION
  ============================================ */

  .lumera-engagement-{{ section.id }} {
    width: 100%;
    background: var(--section-bg);
    overflow: hidden;
    position: relative;
  }


  .lumera-engagement-inner {
    width: min(1500px, 100%);
    min-height: var(--section-height);
    margin: 0 auto;
    padding: 55px 60px;
    display: grid;
    grid-template-columns: 30% 40% 30%;
    align-items: center;
    position: relative;
    box-sizing: border-box;
  }


  /* ============================================
     LEFT IMAGE
  ============================================ */

  .lumera-engagement-left {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
  }


  .lumera-couple-wrap {
    width: 100%;
    max-width: 390px;
    position: relative;
  }


  .lumera-couple-image {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 2px;
    animation: coupleReveal 1.2s ease both;
  }


  .lumera-couple-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 1s ease;
  }


  .lumera-couple-image:hover img {
    transform: scale(1.04);
  }


  /* Small decorative diamond */

  .lumera-mini-ring {
    position: absolute;
    width: 54px;
    height: 54px;
    right: -18px;
    bottom: 30px;
    background: rgba(255,255,255,.8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 35px rgba(50,35,20,.12);
    backdrop-filter: blur(8px);
    animation: smallFloat 4s ease-in-out infinite;
  }


  .lumera-mini-ring span {
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--accent-color);
    border-radius: 50%;
    display: block;
    position: relative;
  }


  .lumera-mini-ring span:before {
    content: "";
    position: absolute;
    width: 7px;
    height: 7px;
    background: transparent;
    border: 1px solid var(--accent-color);
    transform: rotate(45deg);
    top: -5px;
    left: 5px;
  }


  /* ============================================
     CENTER CONTENT
  ============================================ */

  .lumera-engagement-content {
    text-align: center;
    padding: 20px 35px;
    position: relative;
    z-index: 5;
  }


  .lumera-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent-color);
    margin-bottom: 18px;
    font-weight: 500;
  }


  .lumera-eyebrow span {
    width: 28px;
    height: 1px;
    background: var(--accent-color);
    display: block;
    opacity: .65;
  }


  .lumera-engagement-heading {
    margin: 0;
    color: var(--heading-color);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(38px, 4vw, 65px);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: -1.5px;
  }


  .lumera-engagement-description {
    max-width: 570px;
    margin: 25px auto 0;
    color: var(--text-color);
    font-size: 15px;
    line-height: 1.85;
    font-weight: 400;
  }


  /* ============================================
     CTA
  ============================================ */

  .lumera-engagement-button {
    margin-top: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-width: 190px;
    padding: 15px 27px;
    background: var(--button-bg);
    color: var(--button-text);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    font-size: 12px;
    font-weight: 600;
    position: relative;
    overflow: hidden;
    transition:
      transform .35s ease,
      box-shadow .35s ease;
  }


  .lumera-engagement-button:before {
    content: "";
    position: absolute;
    width: 0;
    height: 100%;
    left: 0;
    top: 0;
    background: rgba(255,255,255,.12);
    transition: width .4s ease;
  }


  .lumera-engagement-button:hover:before {
    width: 100%;
  }


  .lumera-engagement-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(50,35,20,.15);
  }


  .lumera-engagement-button svg {
    transition: transform .35s ease;
  }


  .lumera-engagement-button:hover svg {
    transform: translateX(4px);
  }


  .lumera-bottom-text {
    margin-top: 20px;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-color);
    opacity: .55;
  }


  /* ============================================
     RIGHT JEWELLERY AREA
  ============================================ */

  .lumera-engagement-right {
    height: 100%;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }


  .lumera-jewellery-stage {
    width: 100%;
    max-width: 430px;
    height: 440px;
    position: relative;
  }


  /* ============================================
     JEWELLERY IMAGES
  ============================================ */

  .lumera-jewellery-image {
    position: absolute;
    z-index: 3;
  }


  .lumera-jewellery-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 18px 20px rgba(40,25,15,.12));
  }


  .jewellery-one {
    width: 235px;
    left: 0;
    top: 45px;
    animation:
      jewelleryFloatOne 5s ease-in-out infinite,
      jewelleryReveal 1.1s ease both;
  }


  .jewellery-two {
    width: 205px;
    right: 0;
    bottom: 30px;
    animation:
      jewelleryFloatTwo 6s ease-in-out infinite,
      jewelleryReveal 1.3s ease both;
  }


  /* ============================================
     IMAGE GLOW
  ============================================ */

  .lumera-image-glow {
    position: absolute;
    width: 75%;
    height: 75%;
    left: 12%;
    top: 12%;
    border-radius: 50%;
    background: rgba(214,193,165,.18);
    filter: blur(30px);
    animation: glowPulse 4s ease-in-out infinite;
    z-index: 0;
  }


  .jewellery-two .lumera-image-glow {
    animation-delay: 1.5s;
  }


  /* ============================================
     DECORATIVE ORBITS
  ============================================ */

  .lumera-orbit {
    position: absolute;
    border: 1px solid rgba(125,96,67,.12);
    border-radius: 50%;
    pointer-events: none;
  }


  .orbit-one {
    width: 280px;
    height: 280px;
    right: 15px;
    top: 80px;
    animation: orbitRotate 18s linear infinite;
  }


  .orbit-two {
    width: 370px;
    height: 180px;
    right: -15px;
    top: 135px;
    transform: rotate(-25deg);
    animation: orbitRotateReverse 24s linear infinite;
  }


  .orbit-one:before,
  .orbit-two:before {
    content: "";
    position: absolute;
    width: 5px;
    height: 5px;
    background: var(--accent-color);
    border-radius: 50%;
    top: 8%;
    left: 50%;
    box-shadow: 0 0 12px rgba(130,95,60,.4);
  }


  /* ============================================
     SPARKLES
  ============================================ */

  .lumera-sparkle {
    position: absolute;
    color: var(--accent-color);
    font-family: Georgia, serif;
    z-index: 6;
    opacity: .65;
    pointer-events: none;
  }


  .sparkle-one {
    top: 40px;
    right: 105px;
    font-size: 19px;
    animation: sparkleAnimation 3s ease-in-out infinite;
  }


  .sparkle-two {
    bottom: 90px;
    left: 70px;
    font-size: 15px;
    animation: sparkleAnimation 4s ease-in-out infinite .7s;
  }


  .sparkle-three {
    top: 190px;
    right: 30px;
    font-size: 24px;
    animation: sparkleAnimation 3.5s ease-in-out infinite 1s;
  }


  /* ============================================
     ANIMATIONS
  ============================================ */

  @keyframes jewelleryFloatOne {

    0%,
    100% {
      transform: translateY(0) rotate(-3deg);
    }

    50% {
      transform: translateY(-22px) rotate(2deg);
    }

  }


  @keyframes jewelleryFloatTwo {

    0%,
    100% {
      transform: translateY(0) rotate(4deg);
    }

    50% {
      transform: translateY(24px) rotate(-2deg);
    }

  }


  @keyframes smallFloat {

    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-9px);
    }

  }


  @keyframes glowPulse {

    0%,
    100% {
      opacity: .35;
      transform: scale(.9);
    }

    50% {
      opacity: .8;
      transform: scale(1.08);
    }

  }


  @keyframes sparkleAnimation {

    0%,
    100% {
      opacity: .15;
      transform: scale(.7) rotate(0deg);
    }

    50% {
      opacity: .85;
      transform: scale(1.25) rotate(25deg);
    }

  }


  @keyframes orbitRotate {

    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }

  }


  @keyframes orbitRotateReverse {

    from {
      transform: rotate(-25deg);
    }

    to {
      transform: rotate(-385deg);
    }

  }


  @keyframes coupleReveal {

    from {
      opacity: 0;
      transform: translateX(-35px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }

  }


  @keyframes jewelleryReveal {

    from {
      opacity: 0;
      transform: scale(.8);
    }

    to {
      opacity: 1;
    }

  }


  /* =========================================================
   LUMERA - PREMIUM MOBILE HERO
   LEFT JEWELLERY | CENTER CONTENT | RIGHT ORBIT
   ========================================================= */

@media screen and (max-width: 749px) {

  /* SECTION */

  .lumera-engagement-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
  }


  /* MAIN MOBILE AREA */

  .lumera-engagement-inner {
    width: 100%;
    min-height: 480px;

    padding: 34px 8px 28px;

    display: flex;
    align-items: center;
    justify-content: center;

    position: relative;
    box-sizing: border-box;
  }


  /* =====================================================
     COUPLE IMAGE HIDE
     ===================================================== */

  .lumera-engagement-left {
    display: none !important;
  }


  /* =====================================================
     CENTER CONTENT
     ===================================================== */

  .lumera-engagement-content {
    width: 58%;
    max-width: 220px;

    padding: 0;
    margin: 0;

    text-align: center;

    position: relative;
    z-index: 20;

    box-sizing: border-box;
  }


  /* =====================================================
     EYEBROW
     ===================================================== */

  .lumera-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 6px;

    margin: 0 0 14px;

    font-size: 8px;
    line-height: 1;

    letter-spacing: 2.5px;

    white-space: nowrap;
  }

  .lumera-eyebrow span {
    width: 13px;
    height: 1px;
    flex-shrink: 0;
  }


  /* =====================================================
     HEADING
     ===================================================== */

  .lumera-engagement-heading {
    width: 100%;
    max-width: 205px;

    margin: 0 auto;

    font-size: 27px;
    line-height: 1.05;

    font-weight: 400;

    letter-spacing: -0.7px;

    text-align: center;
  }


  /* =====================================================
     DESCRIPTION
     ===================================================== */

  .lumera-engagement-description {
    width: 100%;
    max-width: 205px;

    margin: 18px auto 0;

    font-size: 11px;

    line-height: 1.62;

    font-weight: 400;

    text-align: center;
  }


  /* =====================================================
     BUTTON
     ===================================================== */

  .lumera-engagement-button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    margin: 23px auto 0;

    min-width: 145px;

    padding: 12px 13px;

    gap: 8px;

    font-size: 7px;

    line-height: 1.2;

    letter-spacing: 1px;

    text-align: center;

    box-sizing: border-box;
  }

  .lumera-engagement-button svg {
    width: 14px;
    height: 14px;

    flex-shrink: 0;
  }


  /* =====================================================
     BOTTOM TEXT
     ===================================================== */

  .lumera-bottom-text {
    width: 100%;
    max-width: 190px;

    margin: 16px auto 0;

    font-size: 6.5px;

    line-height: 1.65;

    letter-spacing: 1.8px;

    text-align: center;
  }


  /* =====================================================
     RIGHT DECORATIVE AREA
     ===================================================== */

  .lumera-engagement-right {
    position: absolute;

    left: 0;
    top: 0;

    width: 100%;
    height: 100%;

    min-height: 0;

    display: block;

    pointer-events: none;

    z-index: 2;
  }


  .lumera-jewellery-stage {
    position: relative;

    width: 100%;
    height: 100%;

    max-width: none;
  }


  /* =====================================================
     JEWELLERY 1 - LEFT UPPER
     ===================================================== */

  .jewellery-one {
    position: absolute;

    width: 135px;

    left: -17px;
    top: 155px;

    z-index: 6;

    animation:
      jewelleryFloatOne 5s ease-in-out infinite,
      jewelleryReveal 1.1s ease both;
  }


  /* =====================================================
     JEWELLERY 2 - LEFT LOWER
     ===================================================== */

  .jewellery-two {
    position: absolute;

    width: 120px;

    left: -8px;
    right: auto;

    bottom: 70px;

    z-index: 6;

    animation:
      jewelleryFloatTwo 6s ease-in-out infinite,
      jewelleryReveal 1.3s ease both;
  }


  /* =====================================================
     ORBIT RIGHT SIDE
     ===================================================== */

  .orbit-one {
    position: absolute;

    width: 190px;
    height: 190px;

    right: -90px;
    left: auto;

    top: 190px;

    z-index: 1;

    border-width: 1px;

    animation: orbitRotate 18s linear infinite;
  }


  .orbit-two {
    position: absolute;

    width: 230px;
    height: 115px;

    right: -105px;
    left: auto;

    top: 235px;

    z-index: 1;

    border-width: 1px;

    transform: rotate(-25deg);

    animation: orbitRotateReverse 24s linear infinite;
  }


  /* =====================================================
     ORBIT DOTS
     ===================================================== */

  .orbit-one:before,
  .orbit-two:before {
    width: 4px;
    height: 4px;
  }


  /* =====================================================
     SPARKLES
     ===================================================== */

  .sparkle-one {
    top: 160px;
    right: 27px;

    font-size: 15px;

    z-index: 8;

    animation:
      sparkleAnimation 3s ease-in-out infinite;
  }


  .sparkle-two {
    bottom: 72px;
    left: auto;
    right: 34px;

    font-size: 11px;

    z-index: 8;

    animation:
      sparkleAnimation 4s ease-in-out infinite .7s;
  }


  .sparkle-three {
    top: 285px;
    right: 1px;

    font-size: 19px;

    z-index: 8;

    animation:
      sparkleAnimation 3.5s ease-in-out infinite 1s;
  }


  /* =====================================================
     IMAGE GLOW
     ===================================================== */

  .lumera-image-glow {
    width: 85%;
    height: 85%;

    left: 7.5%;
    top: 7.5%;

    filter: blur(20px);

    opacity: .45;
  }

}


/* =========================================================
   SMALL MOBILE — 480px
   ========================================================= */

@media screen and (max-width: 480px) {

  .lumera-engagement-inner {
    min-height: 455px;

    padding: 30px 5px 25px;
  }


  /* CENTER CONTENT */

  .lumera-engagement-content {
    width: 59%;
    max-width: 220px;
  }


  .lumera-eyebrow {
    font-size: 7px;
    letter-spacing: 2.2px;

    margin-bottom: 13px;
  }

  .lumera-eyebrow span {
    width: 11px;
  }


  .lumera-engagement-heading {
    max-width: 200px;

    font-size: 25px;
    line-height: 1.05;
  }


  .lumera-engagement-description {
    max-width: 200px;

    margin-top: 17px;

    font-size: 10.5px;
    line-height: 1.6;
  }


  .lumera-engagement-button {
    min-width: 140px;

    margin-top: 21px;

    padding: 11px 12px;

    font-size: 6.8px;
  }


  .lumera-bottom-text {
    max-width: 185px;

    margin-top: 14px;

    font-size: 6px;
  }


  /* LEFT JEWELLERY */

  .jewellery-one {
    width: 125px;

    left: -18px;
    top: 145px;
  }


  .jewellery-two {
    width: 110px;

    left: -9px;
    bottom: 67px;
  }


  /* RIGHT ORBIT */

  .orbit-one {
    width: 175px;
    height: 175px;

    right: -82px;

    top: 180px;
  }


  .orbit-two {
    width: 215px;
    height: 108px;

    right: -95px;

    top: 225px;
  }


  /* SPARKLES */

  .sparkle-one {
    top: 150px;
    right: 25px;

    font-size: 14px;
  }

  .sparkle-two {
    bottom: 65px;
    right: 31px;

    font-size: 10px;
  }

  .sparkle-three {
    top: 275px;
    right: 0;

    font-size: 17px;
  }

}


/* =========================================================
   VERY SMALL MOBILE — 360px
   ========================================================= */

@media screen and (max-width: 360px) {

  .lumera-engagement-inner {
    min-height: 445px;

    padding-left: 3px;
    padding-right: 3px;
  }


  /* CONTENT */

  .lumera-engagement-content {
    width: 61%;
    max-width: 215px;
  }


  .lumera-engagement-heading {
    max-width: 195px;

    font-size: 24px;
  }


  .lumera-engagement-description {
    max-width: 195px;

    font-size: 10px;

    line-height: 1.58;
  }


  .lumera-engagement-button {
    min-width: 138px;

    padding: 10px 11px;

    font-size: 6.5px;
  }


  .lumera-bottom-text {
