                        </style>

                        <script>
                          /* ===== Engraving modal ===== */
                          (function () {
                            if (window.__engravingInit) return;
                            window.__engravingInit = true;

                            var modal = document.getElementById('engraving-modal');
                            var openBtn = document.getElementById('engraving-open');
                            if (!modal || !openBtn) return;

                            // Modal ko body me shift karo (sticky/overflow ki problem se bachne ke liye)
                            document.body.appendChild(modal);

                            var closeBtn = document.getElementById('engraving-close');
                            var textInput = document.getElementById('engraving-text');
                            var countEl = document.getElementById('engraving-count');
                            var doneBtn = document.getElementById('engraving-done');
                            var clearBtn = document.getElementById('engraving-clear');
                            var btnText = document.getElementById('engraving-btn-text');
                            var fontBtns = modal.querySelectorAll('.engraving-font-btn');
                            var hidText = document.getElementById('engraving-text-input');
                            var hidFont = document.getElementById('engraving-font-input');

                            var currentFont = 'Script';

                            var fontFamily = {
                              Script: "'Brush Script MT','Segoe Script','Lucida Handwriting',cursive",
                              Serif: "Georgia,'Times New Roman',serif",
                              Block: 'Arial,Helvetica,sans-serif',
                            };
                            // image 2047px wide ke hisaab se base size / letter-spacing
                            var fontSize = { Script: 105, Serif: 78, Block: 70 };
                            var letterSp = { Script: 0, Serif: 36, Block: 38 };

                            function updatePreview() {
                              var v = textInput.value.trim();
                              var shown = v || 'Your message';
                              if (currentFont !== 'Script') shown = shown.toUpperCase();

                              var tpMain = document.getElementById('eng-tp-main');
                              var tpShadow = document.getElementById('eng-tp-shadow');
                              var tMain = document.getElementById('eng-text-main');
                              var tShadow = document.getElementById('eng-text-shadow');
                              var pathEl = document.getElementById('engPath');
                              if (!tpMain || !tMain) return;

                              tpMain.textContent = shown;
                              tpShadow.textContent = shown;

                              var size = fontSize[currentFont];
                              var spacing = letterSp[currentFont];
                              var weight = currentFont === 'Block' ? '600' : '400';

                              [tMain, tShadow].forEach(function (t) {
                                t.style.fontFamily = fontFamily[currentFont];
                                t.style.fontWeight = weight;
                                t.style.fontSize = size + 'px';
                                t.style.letterSpacing = spacing + 'px';
                              });

                              // Lamba text ho to apne aap chhota ho jaye (modal khula ho tabhi measure hota hai)
                              try {
                                var avail = pathEl.getTotalLength() * 0.88;
                                var len = tpMain.getComputedTextLength();
                                if (len > avail) {
                                  var k = avail / len;
                                  size = size * k;
                                  spacing = spacing * k;
                                  [tMain, tShadow].forEach(function (t) {
                                    t.style.fontSize = size + 'px';
                                    t.style.letterSpacing = spacing + 'px';
                                  });
                                }
                              } catch (err) {}

                              // text ko band ke beech me laane ke liye
                              tpMain.setAttribute('dy', (size * 0.35).toFixed(1));
                              tpShadow.setAttribute('dy', (size * 0.35 + 3).toFixed(1));

                              tMain.style.opacity = v ? '1' : '.45';
                              countEl.textContent = textInput.value.length + '/20';
                            }

                            function setFont(font) {
                              currentFont = font;
                              fontBtns.forEach(function (b) {
                                b.classList.toggle('active', b.getAttribute('data-font') === font);
                              });
                              updatePreview();
                            }

                            function openModal() {
                              // Pehle se saved value wapas dikhao
                              modal.classList.add('open');
                              modal.setAttribute('aria-hidden', 'false');
                              textInput.value = hidText.value || '';
                              setFont(hidFont.value || currentFont);
                              setTimeout(function () {
                                textInput.focus();
                              }, 50);
                            }

                            function closeModal() {
                              modal.classList.remove('open');
                              modal.setAttribute('aria-hidden', 'true');
                            }

                            function clearAll() {
                              hidText.value = '';
                              hidFont.value = '';
                              hidFont.disabled = true;
                              textInput.value = '';
                              btnText.textContent = 'Add Engraving';
                              openBtn.classList.remove('has-value');
                              updatePreview();
                            }

                            function save() {
                              var v = textInput.value.trim();
                              if (v) {
                                hidText.value = v;
                                hidFont.value = currentFont;
                                hidFont.disabled = false;
                                btnText.textContent = '"' + v + '"';
                                openBtn.classList.add('has-value');
                              } else {
                                clearAll();
                              }
                              closeModal();
                            }

                            openBtn.addEventListener('click', openModal);
                            closeBtn.addEventListener('click', closeModal);
                            doneBtn.addEventListener('click', save);
                            clearBtn.addEventListener('click', function () {
                              clearAll();
                              closeModal();
                            });

                            textInput.addEventListener('input', updatePreview);

                            // Enter dabane par product form submit na ho
                            textInput.addEventListener('keydown', function (e) {
                              if (e.key === 'Enter') {
                                e.preventDefault();
                                save();
                              }
                            });

                            fontBtns.forEach(function (b) {
                              b.addEventListener('click', function () {
                                setFont(b.getAttribute('data-font'));
                              });
                            });

                            // Bahar (dark area) click par band
                            modal.addEventListener('click', function (e) {
                              if (e.target === modal) closeModal();
                            });
                            document.addEventListener('keydown', function (e) {
                              if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
                            });

                            updatePreview();
                          })();
                        </script>

                        <script>
                          /* ===== Ring size dropdown ===== */
                          (function () {
                            if (window.__ringSizeInit) return;
                            window.__ringSizeInit = true;

                            function getEls() {
                              return {
                                dropdown: document.getElementById('ring-size-dropdown'),
                                list: document.getElementById('options-list'),
                                selected: document.getElementById('selected-option'),
                                label: document.getElementById('ring-size-label'),
                                hiddenInput: document.getElementById('ring-size-input'),
                                nativeSelect: document.getElementById('custom-size'),
                              };
                            }

                            function closeList() {
                              var e = getEls();
                              if (e.list) e.list.classList.remove('show');
                            }

                            function setSize(value) {
                              var e = getEls();
                              if (!e.dropdown) return;

                              var textEl = e.selected.querySelector('.selected-option-text');
                              if (textEl) textEl.textContent = value;

                              if (e.label) e.label.textContent = 'Ring Size: ' + value;
                              if (e.hiddenInput) e.hiddenInput.value = value;
                              if (e.nativeSelect) e.nativeSelect.value = value;

                              // error hatao
                              var err = document.getElementById('ring-size-error');
                              if (err) err.style.display = 'none';
                              if (e.dropdown) e.dropdown.classList.remove('has-error');
                            }

                            // Capture phase: purane theme JS se conflict (double toggle) nahi hoga
                            document.addEventListener(
                              'click',
                              function (event) {
                                var e = getEls();
                                if (!e.dropdown) return;

                                var item = event.target.closest('#options-list .option-item');
                                var box = event.target.closest('#ring-size-dropdown');

                                // Option select
                                if (item) {
                                  event.stopImmediatePropagation();
                                  setSize(item.getAttribute('data-value'));
                                  closeList();
                                  return;
                                }

                                // Dropdown open / close
                                if (box) {
                                  event.stopImmediatePropagation();
                                  e.list.classList.toggle('show');

                                  // open hone par selected option ko view me laao
                                  if (e.list.classList.contains('show')) {
                                    var current = e.hiddenInput ? e.hiddenInput.value : '';
                                    var active = e.list.querySelector('.option-item[data-value="' + current + '"]');
                                    if (active) e.list.scrollTop = active.offsetTop - 40;
                                  }
                                  return;
                                }

                                // Bahar click -> close
                                closeList();
                              },
                              true
                            );

                            // Esc se close
                            document.addEventListener('keydown', function (ev) {
                              if (ev.key === 'Escape') closeList();
                            });
                          })();
                        </script>
                      {%- endif -%}

                      <script>
                        document.addEventListener('DOMContentLoaded', function () {
                          function updateOptionDisplayValues() {
                            const wrappers = document.querySelectorAll('.selector-wrapper.js.product-form__item');

                            wrappers.forEach(function (wrapper) {
                              const display = wrapper.querySelector('.option-selected-value');
                              if (!display) return;

                              let selectedValue = '';

                              // CASE 1: select dropdown
                              const select = wrapper.querySelector('select:not([name="id"]):not(#custom-size)');
                              if (select) {
                                const selectedOption = select.options[select.selectedIndex];
                                if (selectedOption) selectedValue = selectedOption.textContent.trim();
                              }

                              // CASE 2: radio / swatch
                              if (!selectedValue) {
                                const checkedInput = wrapper.querySelector('input[type="radio"]:checked');
                                if (checkedInput) {
                                  selectedValue = checkedInput.value.trim();
                                  const checkedLabel = wrapper.querySelector('label[for="' + checkedInput.id + '"]');
                                  if (checkedLabel) {
                                    const labelText = checkedLabel.textContent.trim();
                                    if (labelText) selectedValue = labelText;
                                  }
                                }
                              }

                              // CASE 3: active button
                              if (!selectedValue) {
                                const activeElement = wrapper.querySelector(
                                  '.active, .selected, .is-selected, .checked'
                                );
                                if (activeElement) {
                                  selectedValue =
                                    activeElement.getAttribute('data-value') || activeElement.textContent.trim();
                                }
                              }

                              if (selectedValue) display.textContent = selectedValue;
                            });
                          }

                          updateOptionDisplayValues();

                          document.addEventListener('change', function (event) {
                            if (
                              event.target.matches('.selector-wrapper select, .selector-wrapper input[type="radio"]')
                            ) {
                              setTimeout(updateOptionDisplayValues, 50);
                            }
                          });

                          document.addEventListener('click', function (event) {
                            const wrapper = event.target.closest('.selector-wrapper.js.product-form__item');
                            if (!wrapper) return;
                            setTimeout(updateOptionDisplayValues, 100);
                          });

                          const observer = new MutationObserver(updateOptionDisplayValues);
                          observer.observe(document.body, {
                            subtree: true,
                            attributes: true,
                            attributeFilter: ['class', 'checked', 'selected'],
                          });
                        });
                      </script>

