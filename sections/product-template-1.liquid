    width:80px !important;
    height:80px !important;
    object-fit:contain !important;
  }

  .ring-dim-label{
    font-size:13px;
    color:#333;
    margin:0;
    white-space:nowrap;
  }

  /* DETAILS SECTION */
  .stone-details-grid{
    display:flex;
    gap:40px;
    margin-top:20px;
  }

  .stone-column{
    flex:1;
    background:transparent !important;
    border:none !important;
    padding:0 !important;
    box-shadow:none !important;
  }

  /* HEADING */
  .stone-heading{
    font-size:15px;
    font-weight:700;
    color:#0a1628;
    margin:0 0 12px 0;
  }

  /* ROW */
  .stone-row{
    display:flex;
    align-items:flex-start;
    gap:6px;
    margin-bottom:8px;
    font-size:13px;
    line-height:1.5;
    flex-wrap:nowrap;
  }

  /* LABEL */
  .stone-label{
    color:#333;
    white-space:nowrap;
    flex-shrink:0;
    font-weight:700;
  }

  /* VALUE */
  .stone-value{
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }

  /* MOBILE */
  @media (max-width:640px){

    .stone-details-grid{
      flex-direction:column;
      gap:25px;
    }

    .ring-diagrams{
      gap:32px;
    }

