  <script>
    /* ===== Ring size validation ===== */
    (function () {
      if (window.__ringValidateInit) return;
      window.__ringValidateInit = true;

      function ringMissing() {
        var input = document.getElementById('ring-size-input');
        return !!input && !input.value;
      }

      function showError() {
        var err = document.getElementById('ring-size-error');
        var box = document.getElementById('ring-size-dropdown');
        if (err) err.style.display = 'block';
        if (box) box.classList.add('has-error');
      }

      // 1) Click / submit: sirf default action roko, theme ko apna (metal) validation chalane do
      window.addEventListener(
        'click',
        function (e) {
          var btn = e.target.closest(
            '.product-form__cart-submit, button[name="add"], .product-form__buynow, .shopify-payment-button'
          );
          if (!btn || !ringMissing()) return;
          e.preventDefault();
          showError();
        },
        true
      );

      window.addEventListener(
        'submit',
        function (e) {
          if (!e.target.querySelector || !e.target.querySelector('#ring-size-input')) return;
          if (!ringMissing()) return;
          e.preventDefault();
          showError();
        },
        true
      );

      // 2) Ring size khali ho to cart add request bhi block (fetch + XHR)
      var origFetch = window.fetch;
      if (origFetch) {
        window.fetch = function (input) {
          var url = typeof input === 'string' ? input : (input && input.url) || '';
          if (/\/cart\/add/.test(url) && ringMissing()) {
            showError();
            return Promise.reject(new Error('Ring size required'));
          }
          return origFetch.apply(this, arguments);
        };
      }

      var origOpen = XMLHttpRequest.prototype.open;
      var origSend = XMLHttpRequest.prototype.send;
      XMLHttpRequest.prototype.open = function (method, url) {
        this.__url = url;
        return origOpen.apply(this, arguments);
      };
      XMLHttpRequest.prototype.send = function () {
        if (/\/cart\/add/.test(this.__url || '') && ringMissing()) {
          showError();
          try {
            this.abort();
          } catch (err) {}
          return;
        }
        return origSend.apply(this, arguments);
      };
    })();
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var overlay = document.querySelector('[data-premium-state="guest"]');
      if (!overlay) return;

      overlay.addEventListener('click', function () {
        var productUrl = overlay.dataset.productUrl;
        if (productUrl) {
          localStorage.setItem('premium_redirect_url', productUrl);
        }

        var loginPopup = document.getElementById('jsLogin');
        if (loginPopup) {
          if (typeof window.jQuery !== 'undefined' && typeof window.jQuery(loginPopup).modal === 'function') {
            window.jQuery(loginPopup).modal('show');
          } else {
            loginPopup.style.display = 'block';
            loginPopup.classList.add('show');
            loginPopup.setAttribute('aria-hidden', 'false');
          }
        }
      });
    });
