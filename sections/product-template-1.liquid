<div id="ProductModal" class="modal">
  <div class="modal__inner">
    <img
      width="auto"
      height="auto"
      src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
      loading="lazy"
      id="ProductZoomImg"
      class="product-modal__image"
    >
  </div>
  <button type="button" class="modal__close js-modal-close text-link">
    {%- render 'icon-close' -%}
  </button>
</div>
{% unless product == empty %}
  <script type="application/json" id="ProductJson-{{ section.id }}">
    {{ product | json }}
  </script>
  {% if section.settings.stock_enable %}
    <script type="application/json" id="VariantJson-{{ section.id }}">
      [
        {% for variant in product.variants %}
          {
             "incoming": {{ variant.incoming | default: false | json }},
             "next_incoming_date": {{ variant.next_incoming_date | date: format: 'month_day_year' | json }},
             "inventory_policy": {{ variant.inventory_policy | json }},
             "inventory_quantity": {{ variant.inventory_quantity | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>
  {% endif %}
{% endunless %}

<script>
  // Override default values of shop.strings for each template.
  // Alternate product templates can change values of
  // add to cart button, sold out, and unavailable states here.
  window.productStrings = {
    addToCart: {{ 'products.product.add_to_cart' | t | json }},
    soldOut: {{ 'products.product.sold_out' | t | json }},
    unavailable: {{ 'products.product.unavailable' | t | json }}
  }
</script>

<script>
  (function () {
    function filterMediaByShape(selectedShape) {
      if (!selectedShape) return;
      const shape = selectedShape.toLowerCase().trim();

      // Main gallery slides
      document.querySelectorAll('.product-single__photos .slick-slide').forEach(function (slide) {
        const img = slide.querySelector('img');
        if (!img) return;
        const alt = (img.alt || '').toLowerCase().trim();
        slide.style.setProperty('display', alt === shape ? '' : 'none', 'important');
      });

      // Thumbnail sidebar
      document.querySelectorAll('.product-single__thumbnail-item').forEach(function (item) {
        const img = item.querySelector('img');
        if (!img) return;
        // Remove filtering - show all thumbnails
        item.style.setProperty('display', '', 'important');
      });
    }

    function getSelectedShape() {
      const shapeInput = document.querySelector('input[name="option3"]:checked');
      if (shapeInput) return shapeInput.value;
      const shapeSelect = document.querySelector('select[name="option3"]');
      if (shapeSelect) return shapeSelect.value;
      return null;
    }

    function runFilter() {
      const shape = getSelectedShape();
      if (shape) filterMediaByShape(shape);
    }

    // MutationObserver — Slick ke DOM changes pe auto filter
    function startObserver() {
      const galleryEl = document.querySelector('.product-single__photos, .photos__item');
      if (!galleryEl) return;

      const observer = new MutationObserver(function () {
        runFilter();
      });

      observer.observe(galleryEl, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['class', 'style'],
      });
    }

    // Shape button click
    document.addEventListener('click', function (e) {
      const input = e.target.closest('input[name="option3"]');
      if (input) {
        setTimeout(runFilter, 50);
        setTimeout(runFilter, 300);
        setTimeout(runFilter, 700);
      }
    });

    // Page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        setTimeout(runFilter, 500);
        setTimeout(runFilter, 1000);
        setTimeout(runFilter, 2000);
        startObserver();
      });
    } else {
      setTimeout(runFilter, 500);
      setTimeout(runFilter, 1000);
      setTimeout(runFilter, 2000);
      startObserver();
    }
  })();
</script>
