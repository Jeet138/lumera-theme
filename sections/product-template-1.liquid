      }

      /* RIGHT column - sticky */
      .product-single .product-info-column {
        align-self: flex-start !important;
        position: sticky !important;
        position: -webkit-sticky !important;
        top: 90px !important; /* apne header height ke hisaab se adjust karein */
        height: fit-content !important;
        overflow: visible !important;
        z-index: 10;
      }

      /* Ensure inner wrapper doesn't block sticky */
      .product-single__info-wrapper {
        overflow: visible !important;
      }

      /* Ancestors ka overflow visible rakhna zaroori hai warna sticky kaam nahi karega */
      body,
      html,
      .page-width,
      .container,
      .product-single__wrapper {
        overflow: visible !important;
      }
    }

    /* Mobile pe sticky hata dein */
    @media (max-width: 767px) {
