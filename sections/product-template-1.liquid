<!-- product-template-1.liquid -->
{{ 'photoswipe.css' | asset_url | stylesheet_tag }}
{%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{{ 'component-product-model.css' | asset_url | stylesheet_tag }}
{%- if first_3d_model -%}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >
  <link
    id="ModelViewerOverride"
    rel="stylesheet"
    href="{{ 'component-model-viewer-ui.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
{%- endif -%}
{{ 'product-template.css' | asset_url | stylesheet_tag }}
<script>
  try {
    const items = JSON.parse(localStorage.getItem('recentlyviewed') || '[]');
    if (!items.includes({{ product.id }})) {
      items.unshift({{ product.id }});
    }
    localStorage.setItem('recentlyviewed', JSON.stringify(items.slice(0, 20)));
  } catch (e) {
    // have error
  }
</script>
<div
  class="{{ section.settings.setwidth }} js-recently-view"
  itemscope
  itemtype="http://schema.org/Product"
  id="ProductSection-{{ section.id }}"
  data-id="{{ section.settings.media_style }}"
  data-section-id="{{ section.id }}"
  data-section-type="product"
  data-enable-history-state="true"
  data-ajax="true"
  data-stock="{{ section.settings.stock_enable }}"
  data-handle="{{ product.handle }}"
  data-autoplay="{{ section.settings.e_autoplay }}"
  data-videoloop="{{ section.settings.e_loop }}"
>
  {%- liquid
    assign current_variant = product.selected_or_first_available_variant
    assign left_size = 'col-md-6 col-12'
    assign right_size = 'col-md-6 col-12'
    case section.settings.media_size
      when 'small'
        assign left_size = 'col-md-5 col-12'
        assign right_size = 'col-md-7 col-12'
      when 'normal'
        assign left_size = 'col-md-6 col-12'
        assign right_size = 'col-md-6 col-12'
      when 'large'
        assign left_size = 'col-md-7 col-12'
        assign right_size = 'col-md-5 col-12'
      when 'largest'
        assign left_size = 'col-md-8 col-12'
        assign right_size = 'col-md-4 col-12'
    endcase
    assign featured_img = current_variant.featured_image | default: product.featured_image

    assign media_style = section.settings.media_style
  -%}
  {%- assign is_premium_collection = false -%}
  {%- for c in product.collections -%}
    {%- if c.title == 'All Premium Collection' -%}
      {%- assign is_premium_collection = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign is_approved = false -%}
  {%- if customer and customer.tags contains 'premium-approved' -%}
    {%- assign is_approved = true -%}
  {%- endif -%}

  {%- assign is_locked = false -%}
  {%- if is_premium_collection and is_approved == false -%}
    {%- assign is_locked = true -%}
  {%- endif -%}
  <meta itemprop="name" content="{{ product.title }}">
  <meta itemprop="url" content="{{ shop.url }}{{ product.url }}">
  <meta itemprop="image" content="{{ product.featured_image.src | image_url: width: 600, height: 600 }}">
  <meta itemprop="brand" content="{{ product.vendor }}">

  <div class="row product-single">
    <div class="{{ left_size }} product-gallery-column">
      {% render 'product-media',
        product: product,
        featured_image: featured_img,
        image_size: section.settings.image_size,
        loop: section.settings.enable_video_looping,
        media_style: section.settings.media_style
      %}
    </div>
    <div
      class="{{ right_size }} order-1 product-info-column"
      itemprop="offers"
      itemscope
      itemtype="http://schema.org/Offer"
    >
      <div class="product-single__info-wrapper">
        <meta itemprop="priceCurrency" content="{{ shop.currency }}">
        <link
          itemprop="availability"
          href="http://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
        >
        <div class="product-single__meta small--text-center">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'text' -%}
                <p
                  class="product-block product__text{% if block.settings.text_style == 'uppercase' %} text-uppercase {% elsif block.settings.text_style == 'subtitle' %} subtop{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p>
              {%- when 'title' -%}
                <div class="product-block product-title">
                  {%- if block.settings.e_label -%}
                    {% render 'product-label', showlabel: false %}
                  {%- endif -%}
                  <h1 itemprop="name" class="product-single__title">
                    {{ product.title }}
                  </h1>
                </div>

              {%- when 'icon_with_text' -%}
                {%- liquid
                  assign block_style = block.settings.block_style
                -%}
                <div class="product-block product-block__iwt">
                  <div class="iwt-{{ block_style }}  {% if block_style == 'hoz' %} d-flex justify-content-start gap-4 flex-lg-row flex-column{% else %} iwt-blockhoz gap-3 {% endif %}">
                    {%- for i in (1..4) -%}
                      {%- liquid
                        assign icon = 'icon_' | append: i
                        assign text = 'icon_text_' | append: i
                        assign iconShow = block.settings[icon]
                        assign textShow = block.settings[text]
                      -%}
                      {%- if textShow != blank -%}
                        <div class="iwt-item text-center {% if block_style == 'hoz' %} d-flex flex-row gap-2 align-items-center {% endif %}">
                          {% render 'list-svg', icon: iconShow %}
                          {%- if textShow != blank -%}
                            <div class="iwt-item__text mt-1">
                              {{ textShow }}
                            </div>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- when 'block_banner' -%}
                {%- liquid
                  assign banner_text = block.settings.banner_text
                  assign banner_des = block.settings.banner_des
                  assign banner_icon = block.settings.banner_icon
                  assign banner_icon_svg = block.settings.banner_icon_svg
                  assign banner_txt_color = block.settings.banner_txt_color
                  assign banner_bg_color = block.settings.banner_bg_color
                  assign banner_radius = block.settings.banner_radius
                -%}
                <style>
                  .product-block__banner{{ block.id }} .media{
                    border-radius: {{ banner_radius }}px;
                    background:{{ banner_bg_color }};
                    color: {{ banner_txt_color }};
                    --g-color-heading: {{ banner_txt_color }};
                    --color-body-text: {{ banner_txt_color }};
                  }
                </style>
                <div class="product-block product-block__banner product-block__banner{{ block.id }}">
                  <div class="media px-4 py-3">
                    {%- if banner_icon != blank -%}
                      <img
                        class="mr-3"
                        src="{{ banner_icon | image_url: width: 300 }}"
                        loading="lazy"
                        width="{{ banner_icon.width }}"
                        height="{{ banner_icon.height }}"
                        alt="{{ banner_icon.alt }}"
                      >
                    {% else %}
                      {%- if banner_icon_svg != blank -%}
                        <div class="mr-3 img_svg">
                          {{ banner_icon_svg }}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                    <div class="media-body">
                      {%- if banner_text != blank -%}
                        <h5 class="mt-0 mb-0">{{ banner_text }}</h5>
                      {%- endif -%}
                      {%- if banner_des != blank -%}
                        <div>{{ banner_des }}</div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- when 'custom_liquid' -%}
                {% if block.settings.custom_liquid != blank %}
                  <div class="product-block product-customliquid">
                    {{ block.settings.custom_liquid }}
                  </div>
                {% endif %}
              {%- when 'shortdesc' -%}
                <div class="product-block rte product-short__description txt-body-70">
                  {% if product.metafields.info.shortdesc != blank %}
                    {{ product.metafields.info.shortdesc }}
                  {% else %}
                    {{ product.description | strip_html | truncatewords: 20 }}
                  {% endif %}
                </div>

              {%- when 'description' -%}
                {%- if block.settings.enable_tab -%}
                  {% assign details_title = 'Jewelry Details' %}
                  {% assign show_ring_diagram = false %}

                  {% for collection in product.collections %}
                    {% case collection.handle %}
                      {% when 'engagement-ring', 'rings' %}
                        {% assign details_title = 'Ring Details' %}
                        {% assign show_ring_diagram = true %}
                        {% break %}

                      {% when 'wedding-bands' %}
                        {% assign details_title = 'Wedding Band Details' %}
                        {% assign show_ring_diagram = true %}
                        {% break %}

                      {% when 'earrings' %}
                        {% assign details_title = 'Earrings Details' %}
                        {% break %}

                      {% when 'bracelets' %}
                        {% assign details_title = 'Bracelet Details' %}
                        {% break %}

                      {% when 'necklaces' %}
                        {% assign details_title = 'Necklace Details' %}
                        {% break %}

                      {% when 'pendants' %}
                        {% assign details_title = 'Pendant Details' %}
                        {% break %}
                    {% endcase %}
                  {% endfor %}

                  {% assign has_center_stone = false %}
                  {% assign has_side_stone = false %}

                  {% if product.metafields.ring_details.center_diamond_type != blank
                    or product.metafields.ring_details.center_shape != blank
                    or product.metafields.ring_details.center_color != blank
                    or product.metafields.ring_details.center_carat_weight != blank
                    or product.metafields.ring_details.center_clarity != blank
                  %}
                    {% assign has_center_stone = true %}
                  {% endif %}

                  {% if product.metafields.ring_details.side_diamond_type != blank
                    or product.metafields.ring_details.side_shape != blank
                    or product.metafields.ring_details.side_color != blank
                    or product.metafields.ring_details.side_carat_weight != blank
                    or product.metafields.ring_details.side_clarity != blank
                    or product.metafields.ring_details.side_measurement != blank
                  %}
                    {% assign has_side_stone = true %}
                  {% endif %}

                  {% if product.metafields.ring_details.height != blank
                    or product.metafields.ring_details.width != blank
                    or has_center_stone
                    or has_side_stone
                  %}
                    <div class="accordion">
                      <div
                        class="tabcustom collapsed h6"
                        data-toggle="collapse"
                        data-target="#jewelry-details-{{ block.id }}"
                      >
                        {{ details_title }}
                      </div>

                      <div id="jewelry-details-{{ block.id }}" class="collapse tab-content">
                        <div class="py-3">
                          {% if show_ring_diagram %}
                            <div class="ring-diagrams">
                              {% if product.metafields.ring_details.height != blank %}
                                <div class="ring-diagram-item">
                                  <img
                                    src="https://cdn.shopify.com/s/files/1/0790/0876/0059/files/Engagement-ring-height.svg"
                                    alt="Ring Height"
                                    width="65"
                                    height="70"
                                  >
                                  <p class="ring-dim-label">
                                    Height&nbsp;
                                    <strong>{{ product.metafields.ring_details.height.value }} MM</strong>
                                  </p>
                                </div>
                              {% endif %}

                              {% if product.metafields.ring_details.width != blank %}
                                <div class="ring-diagram-item">
                                  <img
                                    src="https://cdn.shopify.com/s/files/1/0790/0876/0059/files/Engagement-ring-width.svg"
                                    alt="Ring Width"
                                    width="65"
                                    height="70"
                                  >
                                  <p class="ring-dim-label">
                                    Width&nbsp;
                                    <strong>{{ product.metafields.ring_details.width.value }} MM</strong>
                                  </p>
                                </div>
                              {% endif %}
                            </div>
                          {% endif %}

                          <div class="stone-details-grid">
                            {% if has_center_stone %}
                              <div class="stone-column">
                                <h3 class="stone-heading">Center Stone Details</h3>

                                {% if product.metafields.ring_details.center_diamond_type != blank %}
                                  <div class="stone-row">
                                    <span class="stone-label">Diamond Type :</span>
                                    <span class="stone-value">
                                      {{- product.metafields.ring_details.center_diamond_type.value -}}
                                    </span>
                                  </div>
                                {% endif %}

                                {% if product.metafields.ring_details.center_shape != blank %}
                                  <div class="stone-row">
                                    <span class="stone-label">Shape :</span>
                                    <span class="stone-value">
                                      {{- product.metafields.ring_details.center_shape.value -}}
                                    </span>
                                  </div>
                                {% endif %}

                                {% if product.metafields.ring_details.center_color != blank %}
                                  <div class="stone-row">
                                    <span class="stone-label">Color :</span>
                                    <span class="stone-value">
                                      {{- product.metafields.ring_details.center_color.value -}}
                                    </span>
                                  </div>
                                {% endif %}

                                {% if product.metafields.ring_details.center_carat_weight != blank %}
                                  <div class="stone-row">
                                    <span class="stone-label">Carat Weight :</span>
                                    <span class="stone-value">
                                      {{- product.metafields.ring_details.center_carat_weight.value -}}
                                    </span>
                                  </div>
                                {% endif %}

                                {% if product.metafields.ring_details.center_clarity != blank %}
                                  <div class="stone-row">
                                    <span class="stone-label">Clarity :</span>
                                    <span class="stone-value">
                                      {{- product.metafields.ring_details.center_clarity.value -}}
                                    </span>
                                  </div>
                                {% endif %}
                                {% if product.metafields.custom.center_mesurement != blank %}
                                  <div class="stone-row">
                                    <span class="stone-label">Center Measurement :</span>
                                    <span class="stone-value">
                                      {{ product.metafields.custom.center_mesurement.value }}
                                    </span>
                                  </div>
                                {% endif %}
                              </div>
                            {% endif %}

                            {% if has_side_stone %}
                              <div class="stone-column">
                                <h3 class="stone-heading">Side Stone Details</h3>

                                {% if product.metafields.ring_details.side_diamond_type != blank %}
                                  <div class="stone-row">
                                    <span class="stone-label">Diamond Type :</span>
                                    <span class="stone-value">
                                      {{- product.metafields.ring_details.side_diamond_type.value -}}
                                    </span>
                                  </div>
                                {% endif %}

                                {% if product.metafields.ring_details.side_shape != blank %}
                                  <div class="stone-row">
                                    <span class="stone-label">Shape :</span>
                                    <span class="stone-value">
                                      {{- product.metafields.ring_details.side_shape.value -}}
                                    </span>
                                  </div>
                                {% endif %}

                                {% if product.metafields.ring_details.side_color != blank %}
                                  <div class="stone-row">
                                    <span class="stone-label">Color :</span>
                                    <span class="stone-value">
                                      {{- product.metafields.ring_details.side_color.value -}}
                                    </span>
                                  </div>
                                {% endif %}

                                {% if product.metafields.ring_details.side_carat_weight != blank %}
                                  <div class="stone-row">
                                    <span class="stone-label">Carat Weight :</span>
                                    <span class="stone-value">
                                      {{- product.metafields.ring_details.side_carat_weight.value -}}
                                    </span>
                                  </div>
                                {% endif %}

                                {% if product.metafields.ring_details.side_clarity != blank %}
                                  <div class="stone-row">
                                    <span class="stone-label">Clarity :</span>
                                    <span class="stone-value">
                                      {{- product.metafields.ring_details.side_clarity.value -}}
                                    </span>
                                  </div>
                                {% endif %}

                                {% if product.metafields.ring_details.side_measurement != blank %}
                                  <div class="stone-row">
                                    <span class="stone-label">Measurement :</span>
                                    <span class="stone-value">
                                      {{- product.metafields.ring_details.side_measurement.value -}}
                                    </span>
                                  </div>
                                {% endif %}
                              </div>
                            {% endif %}
                          </div>
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {%- else -%}
                  <div class="product-block product-single__description" itemprop="description">
                    {{ product.description }}
                  </div>
                {%- endif -%}
                <div class="accordion">
                  <div class="tabcustom collapsed h6" data-toggle="collapse" data-target="#tabp-{{ block.id }}">
                    {{ block.settings.title_tab | default: 'Description' }}
                  </div>

                  <div id="tabp-{{ block.id }}" class="collapse tab-content">
                    <div class="py-3">
                      {{ product.description }}
                    </div>
                  </div>
                </div>
              {%- when 'review' -%}
                {%- if product.metafields.reviews.rating_count.value > 0 -%}
                  <div class="review product-block">
                    <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
                  </div>
                {%- endif -%}
                <hr>
              {%- when 'price' -%}
                {% assign discount_percent = 30 %}

                {% for collection in product.collections %}
                  {% if collection.metafields.custom.discount.value %}
                    {% assign discount_percent = collection.metafields.custom.discount.value %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                {% assign base_price = current_variant.compare_at_price %}

                {% if base_price == blank or base_price == 0 %}
                  {% assign base_price = current_variant.price %}
                {% endif %}

                {% assign discount_amount = base_price | times: discount_percent | divided_by: 100 %}
                {% assign sale_price = base_price | minus: discount_amount %}

                <ul class="product-block product-single__meta-list product-single__meta-price list--inline{% if shop.taxes_included or shop.shipping_policy.body != blank %} product-single__price-container{% endif %}">
                  <li class="price-sku-row">
                    <div class="price-area">
                      <input
                        type="hidden"
                        id="CollectionDiscount"
                        value="{{ discount_percent }}"
                      >
                      <span
                        id="ProductPrice-{{ section.id }}"
                        class="product-single__price"
                        itemprop="price"
                        content="{{ sale_price | divided_by: 100.00 }}"
                      >
                        {{ sale_price | money }}
                      </span>

                      {% if discount_percent > 0 %}
                        <s
                          id="ComparePrice-{{ section.id }}"
                          class="product-single__price product-single__price--compare"
                        >
                          {{ base_price | money }}
                        </s>
                      {% endif %}

                      {% if settings.sale_label_enable and discount_percent > 0 %}
                        <span class="sale-badge-custom"> Save {{ discount_percent }}% </span>
                      {% endif %}
                    </div>

                    {% if current_variant.sku != blank %}
                      <div class="product-sku-right">SKU: {{ current_variant.sku }}</div>
                    {% endif %}
                  </li>

                  {%- if section.settings.stock_enable -%}
                    <li>{%- render 'productStock', current_variant: current_variant -%}</li>
                  {%- endif -%}
                </ul>
                <span class="lab-grown-tag"> LAB GROWN DIAMOND </span>
                <style>
                                                      .price-sku-row{
                                                        display:flex;
                                                        justify-content:space-between;
                                                        align-items:center;
                                                        width:100%;
                                                        list-style:none;
                                                      }

                                                      .price-area{
                                                        display:flex;
                                                        align-items:center;
                                                        gap:4px;
                                                        flex-wrap:wrap;
                                                      }

                                                      .product-single__price{
                                                        margin:0 !important;
                                                      }

                                                      .product-single__price--compare{
                                                        margin:0 2px !important;
                                                        text-decoration:line-through;
                                                        opacity:.7;
                                                      }

                                                      .sale-badge-custom{
                                                        display:inline-flex;
                                                        align-items:center;
                                                        justify-content:center;
                                                        padding:3px 8px;
                                                        border-radius:4px;
                                                        background:#006400;
                                                        color:#ffffff;
                                                        font-size:12px;
                                                        font-weight:600;
                                                        line-height:1;
                                                        margin-left:2px;
                                                      }

                                                      .product-sku-right{
                                                        font-size:14px;
                                                        font-weight:600;
                                                        color:#000;
                                                        background:#e8f5e9;
                                                        white-space:nowrap;
                                                      }

                                                    @media(max-width:767px){
                    .price-sku-row{
                      flex-wrap:wrap;
                      gap:8px;
                    }

                    .product-sku-right{
                      width:fit-content !important;
                      display:inline-block;
                      padding:2px 6px;
                    }
                  }
                                                      .lab-grown-tag{
                                        display:inline-block;
                                        padding:3px 8px;
                                        margin-left:-3px;
                                        background:#eef8ef;      /* Light Green */
                                        color:#000;
                                        font-size:14px;
                                        font-weight:700;
                                        line-height:1.4;
                                        white-space:nowrap;
                                    }
                </style>

                {% comment %}
                  {%- if section.settings.stock_enable -%}
                    {% comment %} <li>{%- render 'productStock', current_variant: current_variant -%}</li> {% endcomment %}
                  {%- endif -%}
                {% endcomment %}

                </ul>
              {%- when 'salepoint' -%}
                <div class="product-block salepoint d-flex align-items-center">
                  {% render 'list-svg', icon: block.settings.icon %}
                  {{ block.settings.free_word }}
                </div>
              {%- when 'buttons' -%}
                <div class="product-button-variant product-block">
                  {%- assign siblings_collection = product.metafields.theme.siblings_collection -%}
                  {%- assign enable_sibling = block.settings.enable_sibling -%}
                  {%- assign siblings_color = product.metafields.theme.siblings_color -%}
                  {% if siblings_collection != blank and enable_sibling %}
                    <div class="d-flex justify-content-between">
                      <label
                        >Color :
                        {%- if siblings_color != blank -%}
                          <span class="ml-1">{{ siblings_color }}</span>
                        {%- endif -%}
                      </label>
                    </div>
                    <div class="d-flex gap-3 siblings-product">
                      {% for sib_product in collections[siblings_collection].products limit: 50 %}
                        <a
                          href="{{ sib_product.url }}"
                          class="siblings-product__item {% if sib_product.id == product.id %} active {% endif %}"
                        >
                          {%- assign widths = '165, 360' -%}
                          {%- capture sizes -%}
                    (min-width: {{ settings.container }}px) {{ settings.container | minus: 100 | divided_by: 2 }}px,
                    (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                  {%- endcapture -%}
                          {%- assign image = sib_product.selected_or_first_available_variant.featured_image
                            | default: sib_product.featured_image
                          -%}
                          {{
                            image
                            | image_url: width: 200
                            | image_tag: sizes: sizes, widths: widths, fetchpriority: 'auto', class: 'lazyload'
                          }}
                        </a>
                      {% endfor %}
                    </div>
                  {% endif %}

                  {% if product.metafields.info.affiliate_link != blank %}
                    {% comment %}AFFILIATE PRODUCT{% endcomment %}
                    <a
                      href="{{ product.metafields.info.affiliate_link }}"
                      class="my-3 btn btn-theme btn--full product-form__cart-submit {% if block.settings.enable_payment_button %}product-form__cart-submit--outline{% endif %}"
                    >
                      {{ product.metafields.info.affiliate_button }}
                    </a>
                  {% else %}
                    {% comment %}NORMAL PRODUCT{% endcomment %}

                    {% capture form_class %}product-form {% if block.settings.product_selector == 'select' %} product-form-select{% endif %} {% if block.settings.enable_payment_button %} product-form--payment-button{% endif %}{%- endcapture %}
                    {% capture form_id %}AddToCartForm-{{ section.id }}{%- endcapture %}
                    {% form 'product', product, class: form_class, id: form_id %}
                      {%- comment -%} ===== VARIANT OPTIONS ===== {%- endcomment -%}
                      {%- comment -%}
                        ===== VARIANT OPTIONS (FIXED) =====
                        Replace: {% form 'product' ... %} ke andar wala poora
                        {% unless product.has_only_default_variant %} ... {% endunless %} block
                        (Ring Size + Engraving block se PEHLE wala part).

                        Fix: "Diamond Size" / "Ring Size" par Size Guide nahi aayega.
                        Size Guide sirf bracelet jaise "Size" option par aayega.
                      {%- endcomment -%}
                      {% unless product.has_only_default_variant %}
                        {% for option in product.options_with_values %}
                          {%- liquid
                            assign isColor = false
                            assign opt_lc = option.name | downcase
                            assign show_size_guide = false

                            if block.settings.product_selector == 'radio'
                              assign optionName = option.name
                              assign keywords_1 = settings.contain_color
                              assign keywords_2 = settings.contain_color_2
                              if optionName contains keywords_1 or optionName contains keywords_2
                                assign isColor = true
                              endif
                            endif

                            comment
                              Size guide: option naam me 'size' ho, lekin 'diamond' ya 'ring' na ho
                            endcomment
                            if opt_lc contains 'size'
                              unless opt_lc contains 'diamond' or opt_lc contains 'ring'
                                assign show_size_guide = true
                              endunless
                            endif
                          -%}

                          <div class="selector-wrapper js product-form__item {% if isColor %}{% if siblings_collection != blank and enable_sibling %} d-none {% endif %}{% endif %}">
                            <div class="d-flex justify-content-between">
                              <label
                                {% if option.name == 'default' %}
                                  class="label--hidden"
                                {% endif %}
                                for="SingleOptionSelector-{{ section.id }}-{{ forloop.index0 }}"
                              >
                                {% if option.name contains 'Ring size' %}
                                {% else %}
                                  {{ option.name }} :

                                  <span
                                    class="option-selected-value ml-1"
                                    data-option-name="{{ option.name | handleize }}"
                                  >
                                    {{ option.selected_value }}
                                  </span>
                                {% endif %}
                              </label>

                              {%- if show_size_guide -%}
                                <div>
                                  {%- render 'productSizeGuide' -%}
                                </div>
                              {%- endif -%}
                            </div>

                            {% render 'productOption',
                              product: product,
                              option: option,
                              firstloop: forloop.index0,
                              loop: forloop.index,
                              product_selector: block.settings.product_selector,
                              sw_color_product: block.settings.sw_color_product,
                              size_color: block.settings.size_color,
                              color_circle: block.settings.color_circle,
                              type_color: block.settings.type_color,
                              siblings_collection: siblings_collection,
                              enable_sibling: enable_sibling
                            %}
                          </div>
                        {% endfor %}
                      {% endunless %}

                      {%- comment -%}
                        ===== SHOW ONLY FOR ENGAGEMENT RING PRODUCTS =====
                        Block tab dikhega jab:
                        - product "engagement-ring" collection me ho, YA
                        - product par "Engagement Ring" tag ho
                      {%- endcomment -%}
                      {%- assign show_ring_block = false -%}
                      {%- for c in product.collections -%}
                        {%- if c.handle == 'engagement-ring' -%}
                          {%- assign show_ring_block = true -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if product.tags contains 'Engagement Ring' -%}
                        {%- assign show_ring_block = true -%}
                      {%- endif -%}

                      {%- if show_ring_block -%}
                        {%- comment -%}
