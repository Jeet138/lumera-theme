{% doc %}
  @prompt
    Create a countdown timer banner section with a dark black background. It should have: "Limited Time Offer" text on the left side, a live countdown timer in the center showing Days, Hours, Minutes, and Seconds with large bold numbers and labels below them, and a "Shop Collection" button/link on the right side. The text and numbers should be in white. The countdown timer should be configurable with an end date. Style should be minimal, elegant, and luxury jewelry brand appropriate.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-countdown-banner-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    width: 100%;
  }

  .ai-countdown-banner__container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-countdown-banner__text-{{ ai_gen_id }} {
    flex: 1;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: {{ block.settings.text_transform }};
    white-space: nowrap;
  }

  .ai-countdown-banner__timer-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.timer_gap }}px;
    flex: 2;
    justify-content: center;
  }

  .ai-countdown-banner__time-unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .ai-countdown-banner__number-{{ ai_gen_id }} {
    color: {{ block.settings.number_color }};
    font-size: {{ block.settings.number_size }}px;
    font-weight: {{ block.settings.number_weight }};
    line-height: 1;
    min-width: 60px;
    text-align: center;
  }

  .ai-countdown-banner__label-{{ ai_gen_id }} {
    color: {{ block.settings.label_color }};
    font-size: {{ block.settings.label_size }}px;
    font-weight: {{ block.settings.label_weight }};
    text-transform: {{ block.settings.label_transform }};
    letter-spacing: 1px;
  }

  .ai-countdown-banner__button-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .ai-countdown-banner__link-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: {{ block.settings.button_text_weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-transform: {{ block.settings.button_text_transform }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-countdown-banner__link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-countdown-banner__expired-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .ai-countdown-banner__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 24px;
      text-align: center;
    }

    .ai-countdown-banner__text-{{ ai_gen_id }} {
      white-space: normal;
    }

    .ai-countdown-banner__button-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-countdown-banner__timer-{{ ai_gen_id }} {
      gap: {{ block.settings.timer_gap | times: 0.7 }}px;
    }

    .ai-countdown-banner__number-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size | times: 0.8 }}px;
      min-width: 50px;
    }

    .ai-countdown-banner__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-countdown-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-countdown-banner__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.85 }}px;
    }

    .ai-countdown-banner__timer-{{ ai_gen_id }} {
      gap: {{ block.settings.timer_gap | times: 0.5 }}px;
    }

    .ai-countdown-banner__number-{{ ai_gen_id }} {
      font-size: {{ block.settings.number_size | times: 0.65 }}px;
      min-width: 40px;
    }

    .ai-countdown-banner__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size | times: 0.8 }}px;
    }

    .ai-countdown-banner__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_text_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<countdown-timer-{{ ai_gen_id }}
  class="ai-countdown-banner-{{ ai_gen_id }}"
  data-end-date="{{ block.settings.end_date }}"
  data-end-time="{{ block.settings.end_time }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-countdown-banner__container-{{ ai_gen_id }}">
    {% if block.settings.offer_text != blank %}
      <div class="ai-countdown-banner__text-{{ ai_gen_id }}">
        {{ block.settings.offer_text }}
      </div>
    {% endif %}

    <div class="ai-countdown-banner__timer-{{ ai_gen_id }}" data-timer>
      <div class="ai-countdown-banner__time-unit-{{ ai_gen_id }}">
        <div class="ai-countdown-banner__number-{{ ai_gen_id }}" data-days>00</div>
        <div class="ai-countdown-banner__label-{{ ai_gen_id }}">{{ block.settings.days_label }}</div>
      </div>
      <div class="ai-countdown-banner__time-unit-{{ ai_gen_id }}">
        <div class="ai-countdown-banner__number-{{ ai_gen_id }}" data-hours>00</div>
        <div class="ai-countdown-banner__label-{{ ai_gen_id }}">{{ block.settings.hours_label }}</div>
      </div>
      <div class="ai-countdown-banner__time-unit-{{ ai_gen_id }}">
        <div class="ai-countdown-banner__number-{{ ai_gen_id }}" data-minutes>00</div>
        <div class="ai-countdown-banner__label-{{ ai_gen_id }}">{{ block.settings.minutes_label }}</div>
      </div>
      <div class="ai-countdown-banner__time-unit-{{ ai_gen_id }}">
        <div class="ai-countdown-banner__number-{{ ai_gen_id }}" data-seconds>00</div>
        <div class="ai-countdown-banner__label-{{ ai_gen_id }}">{{ block.settings.seconds_label }}</div>
      </div>
    </div>

    {% if block.settings.button_text != blank %}
      <div class="ai-countdown-banner__button-{{ ai_gen_id }}">
        <a href="{{ block.settings.button_link }}" class="ai-countdown-banner__link-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>

  <div class="ai-countdown-banner__expired-{{ ai_gen_id }}" data-expired style="display: none;">
    {{ block.settings.expired_message }}
  </div>
</countdown-timer-{{ ai_gen_id }}>

<script>
  (function() {
    class CountdownTimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.endDate = this.dataset.endDate;
        this.endTime = this.dataset.endTime;
        this.timerElement = this.querySelector('[data-timer]');
        this.expiredElement = this.querySelector('[data-expired]');
        this.daysElement = this.querySelector('[data-days]');
        this.hoursElement = this.querySelector('[data-hours]');
        this.minutesElement = this.querySelector('[data-minutes]');
        this.secondsElement = this.querySelector('[data-seconds]');
        this.interval = null;
      }

      connectedCallback() {
        if (!this.endDate) {
          return;
        }

        this.updateCountdown();
        this.interval = setInterval(() => this.updateCountdown(), 1000);
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      updateCountdown() {
        const endDateTime = this.endTime 
          ? new Date(this.endDate + 'T' + this.endTime)
          : new Date(this.endDate + 'T23:59:59');
        
        const now = new Date();
        const distance = endDateTime - now;

        if (distance < 0) {
          this.showExpired();
          return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        this.daysElement.textContent = String(days).padStart(2, '0');
        this.hoursElement.textContent = String(hours).padStart(2, '0');
        this.minutesElement.textContent = String(minutes).padStart(2, '0');
        this.secondsElement.textContent = String(seconds).padStart(2, '0');
      }

      showExpired() {
        if (this.interval) {
          clearInterval(this.interval);
        }
        if (this.timerElement) {
          this.timerElement.style.display = 'none';
        }
        if (this.expiredElement) {
          this.expiredElement.style.display = 'block';
        }
      }
    }

    customElements.define('countdown-timer-{{ ai_gen_id }}', CountdownTimer{{ ai_gen_id }});
  })();
</script>

