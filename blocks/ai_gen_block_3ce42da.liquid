{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ring-size-chart-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-ring-size-chart__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-ring-size-chart__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.heading_color }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-ring-size-chart__description-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.text_color }};
    margin-bottom: 30px;
    font-size: {{ block.settings.text_size }}px;
  }

  .ai-ring-size-chart__table-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: {{ block.settings.table_border_radius }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-ring-size-chart__table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ block.settings.table_background }};
    font-size: {{ block.settings.table_text_size }}px;
  }

  .ai-ring-size-chart__table-{{ ai_gen_id }} thead {
    background-color: {{ block.settings.header_background }};
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .ai-ring-size-chart__table-{{ ai_gen_id }} th {
    padding: {{ block.settings.cell_padding }}px;
    text-align: center;
    font-weight: 600;
    color: {{ block.settings.header_text_color }};
    border: 1px solid {{ block.settings.border_color }};
    white-space: nowrap;
    font-size: {{ block.settings.header_text_size }}px;
  }

  .ai-ring-size-chart__table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    text-align: center;
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-ring-size-chart__table-{{ ai_gen_id }} tbody tr:nth-child(even) {
    background-color: {{ block.settings.row_alternate_background }};
  }

  .ai-ring-size-chart__table-{{ ai_gen_id }} tbody tr:hover {
    background-color: {{ block.settings.row_hover_background }};
  }

  .ai-ring-size-chart__country-group-{{ ai_gen_id }} {
    font-size: 11px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    display: block;
    margin-top: 4px;
  }

  @media screen and (max-width: 768px) {
    .ai-ring-size-chart__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-ring-size-chart__table-{{ ai_gen_id }} {
      font-size: {{ block.settings.table_text_size | times: 0.85 }}px;
    }

    .ai-ring-size-chart__table-{{ ai_gen_id }} th {
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
      font-size: {{ block.settings.header_text_size | times: 0.85 }}px;
    }

    .ai-ring-size-chart__table-{{ ai_gen_id }} td {
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<div class="ai-ring-size-chart-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
