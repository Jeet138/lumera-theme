{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-by-shape-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-shop-by-shape-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
  }

  .ai-shop-by-shape-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-shop-by-shape-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
    font-weight: {{ block.settings.heading_weight }};
  }

  .ai-shop-by-shape-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-shop-by-shape-scroll-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    padding: 0 60px;
  }

  .ai-shop-by-shape-grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 10px;
  }

  .ai-shop-by-shape-grid-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-shop-by-shape-item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.visible_items | minus: 1 }} * {{ block.settings.item_spacing }}px)) / {{ block.settings.visible_items }});
    min-width: calc((100% - ({{ block.settings.visible_items | minus: 1 }} * {{ block.settings.item_spacing }}px)) / {{ block.settings.visible_items }});
    text-align: center;
    transition: transform 0.3s ease;
  }

  .ai-shop-by-shape-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-shop-by-shape-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-shop-by-shape-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    background-color: transparent;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 12px;
    border: none;
  }

  .ai-shop-by-shape-image-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-shop-by-shape-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-shop-by-shape-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-shop-by-shape-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    font-weight: {{ block.settings.label_weight }};
    margin: 0;
  }

  .ai-shop-by-shape-nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.nav_button_color }};
    background-color: {{ block.settings.nav_button_bg }};
    color: {{ block.settings.nav_button_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .ai-shop-by-shape-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_bg }};
  }

  .ai-shop-by-shape-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-shop-by-shape-nav-button-{{ ai_gen_id }}[data-nav="prev"] {
    left: 0;
  }

  .ai-shop-by-shape-nav-button-{{ ai_gen_id }}[data-nav="next"] {
    right: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-shop-by-shape-scroll-wrapper-{{ ai_gen_id }} {
      padding: 0 50px;
    }

    .ai-shop-by-shape-item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.mobile_visible_items | minus: 1 }} * {{ block.settings.item_spacing }}px)) / {{ block.settings.mobile_visible_items }});
      min-width: calc((100% - ({{ block.settings.mobile_visible_items | minus: 1 }} * {{ block.settings.item_spacing }}px)) / {{ block.settings.mobile_visible_items }});
    }

    .ai-shop-by-shape-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-shop-by-shape-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-shop-by-shape-nav-button-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }
  }
{% endstyle %}

<shop-by-shape-{{ ai_gen_id }} class="ai-shop-by-shape-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shop-by-shape-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-shop-by-shape-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-shop-by-shape-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-shop-by-shape-subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-shop-by-shape-scroll-wrapper-{{ ai_gen_id }}">
      {% if block.settings.show_navigation %}
        <button
          class="ai-shop-by-shape-nav-button-{{ ai_gen_id }}"
          data-nav="prev"
          aria-label="Previous shapes"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      {% endif %}

      <div class="ai-shop-by-shape-grid-{{ ai_gen_id }}" data-scroll-container>
        {% for i in (1..15) %}
          {% liquid
            assign shape_name_key = 'shape_' | append: i | append: '_name'
            assign shape_image_key = 'shape_' | append: i | append: '_image'
            assign shape_link_key = 'shape_' | append: i | append: '_link'
            
            assign shape_name = block.settings[shape_name_key]
            assign shape_image = block.settings[shape_image_key]
            assign shape_link = block.settings[shape_link_key]
          %}

          {% if shape_name != blank %}
            <div class="ai-shop-by-shape-item-{{ ai_gen_id }}">
              <a href="{{ shape_link }}" class="ai-shop-by-shape-link-{{ ai_gen_id }}">
                <div class="ai-shop-by-shape-image-wrapper-{{ ai_gen_id }}">
                  {% if shape_image %}
                    <img
                      src="{{ shape_image | image_url: width: 400 }}"
                      alt="{{ shape_name | escape }}"
                      class="ai-shop-by-shape-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="400"
                      height="400"
                    >
                  {% else %}
                    <div class="ai-shop-by-shape-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <p class="ai-shop-by-shape-name-{{ ai_gen_id }}">{{ shape_name }}</p>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if block.settings.show_navigation %}
        <button
          class="ai-shop-by-shape-nav-button-{{ ai_gen_id }}"
          data-nav="next"
          aria-label="Next shapes"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {% endif %}
    </div>
  </div>
</shop-by-shape-{{ ai_gen_id }}>

<script>
  (function() {
    class ShopByShape{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scrollContainer = null;
        this.prevButton = null;
        this.nextButton = null;
      }

      connectedCallback() {
        this.scrollContainer = this.querySelector('[data-scroll-container]');
        this.prevButton = this.querySelector('[data-nav="prev"]');
        this.nextButton = this.querySelector('[data-nav="next"]');

        if (this.prevButton && this.nextButton) {
          this.prevButton.addEventListener('click', () => this.scroll('prev'));
          this.nextButton.addEventListener('click', () => this.scroll('next'));
          this.updateButtonStates();
          this.scrollContainer.addEventListener('scroll', () => this.updateButtonStates());
        }
      }

      scroll(direction) {
        if (!this.scrollContainer) return;

        const itemWidth = this.scrollContainer.querySelector('.ai-shop-by-shape-item-{{ ai_gen_id }}').offsetWidth;
        const gap = {{ block.settings.item_spacing }};
        const scrollAmount = itemWidth + gap;

        if (direction === 'prev') {
          this.scrollContainer.scrollLeft -= scrollAmount;
        } else {
          this.scrollContainer.scrollLeft += scrollAmount;
        }
      }

      updateButtonStates() {
        if (!this.scrollContainer || !this.prevButton || !this.nextButton) return;

        const isAtStart = this.scrollContainer.scrollLeft <= 0;
        const isAtEnd = this.scrollContainer.scrollLeft + this.scrollContainer.clientWidth >= this.scrollContainer.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('shop-by-shape-{{ ai_gen_id }}', ShopByShape{{ ai_gen_id }});
  })();
</script>

