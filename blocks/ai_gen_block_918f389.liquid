{% doc %}
  @prompt
    Fix the Previous/Next article navigation on blog article pages. Two-column flex layout space-between, Previous on left with thumbnail and title, Next on right with thumbnail and title. Font size 13-14px for titles, thumbnail 60x60px, luxury minimal style.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-article-nav-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_vertical }}px 0;
    border-top: 1px solid {{ block.settings.border_color }};
  }

  .ai-article-nav-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
  }

  .ai-article-nav-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: {{ block.settings.text_color }};
    transition: opacity 0.2s ease;
    flex: 1;
    max-width: 48%;
  }

  .ai-article-nav-item-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-article-nav-item-{{ ai_gen_id }}--prev {
    justify-content: flex-start;
  }

  .ai-article-nav-item-{{ ai_gen_id }}--next {
    justify-content: flex-end;
    flex-direction: row-reverse;
  }

  .ai-article-nav-thumbnail-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: {{ block.settings.thumbnail_radius }}px;
    background-color: {{ block.settings.placeholder_bg }};
  }

  .ai-article-nav-thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-article-nav-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .ai-article-nav-label-{{ ai_gen_id }} {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: {{ block.settings.label_color }};
    font-weight: 500;
  }

  .ai-article-nav-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.4;
    color: {{ block.settings.text_color }};
    font-weight: 400;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-article-nav-item-{{ ai_gen_id }}--prev .ai-article-nav-content-{{ ai_gen_id }} {
    align-items: flex-start;
    text-align: left;
  }

  .ai-article-nav-item-{{ ai_gen_id }}--next .ai-article-nav-content-{{ ai_gen_id }} {
    align-items: flex-end;
    text-align: right;
  }

  @media screen and (max-width: 749px) {
    .ai-article-nav-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 20px;
    }

    .ai-article-nav-item-{{ ai_gen_id }} {
      max-width: 100%;
      width: 100%;
    }

    .ai-article-nav-item-{{ ai_gen_id }}--prev,
    .ai-article-nav-item-{{ ai_gen_id }}--next {
      justify-content: flex-start;
      flex-direction: row;
    }

    .ai-article-nav-item-{{ ai_gen_id }}--next .ai-article-nav-content-{{ ai_gen_id }} {
      align-items: flex-start;
      text-align: left;
    }
  }
{% endstyle %}

<div class="ai-article-nav-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-article-nav-container-{{ ai_gen_id }}">
    {% if blog.previous_article %}
      <a
        href="{{ blog.previous_article.url }}"
        class="ai-article-nav-item-{{ ai_gen_id }} ai-article-nav-item-{{ ai_gen_id }}--prev"
        aria-label="Previous article: {{ blog.previous_article.title }}"
      >
        <div class="ai-article-nav-thumbnail-{{ ai_gen_id }}">
          {% if blog.previous_article.image %}
            <img
              src="{{ blog.previous_article.image | image_url: width: 120 }}"
              alt="{{ blog.previous_article.image.alt | escape }}"
              width="60"
              height="60"
              loading="lazy"
            >
          {% else %}
            <div style="width: 100%; height: 100%; background-color: {{ block.settings.placeholder_bg }};"></div>
          {% endif %}
        </div>
        <div class="ai-article-nav-content-{{ ai_gen_id }}">
          <span class="ai-article-nav-label-{{ ai_gen_id }}">{{ block.settings.previous_label }}</span>
          <span class="ai-article-nav-title-{{ ai_gen_id }}">{{ blog.previous_article.title }}</span>
        </div>
      </a>
    {% else %}
      <div style="flex: 1; max-width: 48%;"></div>
    {% endif %}

    {% if blog.next_article %}
      <a
        href="{{ blog.next_article.url }}"
        class="ai-article-nav-item-{{ ai_gen_id }} ai-article-nav-item-{{ ai_gen_id }}--next"
        aria-label="Next article: {{ blog.next_article.title }}"
      >
        <div class="ai-article-nav-thumbnail-{{ ai_gen_id }}">
          {% if blog.next_article.image %}
            <img
              src="{{ blog.next_article.image | image_url: width: 120 }}"
              alt="{{ blog.next_article.image.alt | escape }}"
              width="60"
              height="60"
              loading="lazy"
            >
          {% else %}
            <div style="width: 100%; height: 100%; background-color: {{ block.settings.placeholder_bg }};"></div>
          {% endif %}
        </div>
        <div class="ai-article-nav-content-{{ ai_gen_id }}">
          <span class="ai-article-nav-label-{{ ai_gen_id }}">{{ block.settings.next_label }}</span>
          <span class="ai-article-nav-title-{{ ai_gen_id }}">{{ blog.next_article.title }}</span>
        </div>
      </a>
    {% else %}
      <div style="flex: 1; max-width: 48%;"></div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Article navigation",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "previous_label",
      "label": "Previous label",
      "default": "Previous"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next label",
      "default": "Next"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Thumbnail"
    },
    {
      "type": "range",
      "id": "thumbnail_radius",
      "label": "Border radius",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "placeholder_bg",
      "label": "Placeholder background",
      "default": "#f4f4f4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Article navigation"
    }
  ]
}
{% endschema %}
