{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-video-content-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.gutter }}px;
  }

  .ai-video-content-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.content_spacing }}px;
  }

  .ai-video-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.2;
  }

  .ai-video-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: {{ block.settings.video_border_radius }}px;
  }

  .ai-video-wrapper-{{ ai_gen_id }} iframe,
  .ai-video-wrapper-{{ ai_gen_id }} video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-video-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    background-color: rgba(0, 0, 0, 0.7);
    color: #fff;
    font-size: 14px;
    border-radius: 4px;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-video-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-video-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-video-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px 0 {{ block.settings.padding_bottom | times: 0.6 }}px;
    }
  }
{% endstyle %}

<ai-video-section-{{ ai_gen_id }} class="ai-video-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.description != blank %}
    <div class="ai-video-content-wrapper-{{ ai_gen_id }}">
      <div class="ai-video-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-video-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-video-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <div class="ai-video-wrapper-{{ ai_gen_id }}">
    {% if block.settings.video_url != blank %}
      {% liquid
        assign video_url = block.settings.video_url
        assign youtube_id = ''
        assign vimeo_id = ''

        if video_url contains 'youtube.com/watch'
          assign youtube_id = video_url | split: 'v=' | last | split: '&' | first
        elsif video_url contains 'youtu.be/'
          assign youtube_id = video_url | split: 'youtu.be/' | last | split: '?' | first
        elsif video_url contains 'vimeo.com/'
          assign vimeo_id = video_url | split: 'vimeo.com/' | last | split: '?' | first
        endif
      %}

      {% if youtube_id != blank %}
        <iframe
          src="https://www.youtube.com/embed/{{ youtube_id }}?rel=0&modestbranding=1"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
          title="{{ block.settings.heading | default: 'Video' }}"
        ></iframe>
      {% elsif vimeo_id != blank %}
        <iframe
          src="https://player.vimeo.com/video/{{ vimeo_id }}?title=0&byline=0&portrait=0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          loading="lazy"
          title="{{ block.settings.heading | default: 'Video' }}"
        ></iframe>
      {% else %}
        <video controls>
          <source src="{{ block.settings.video_url }}" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      {% endif %}
    {% else %}
      <div class="ai-video-placeholder-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <div class="ai-video-empty-state-{{ ai_gen_id }}">
          Add a video URL to get started
        </div>
      </div>
    {% endif %}
  </div>
</ai-video-section-{{ ai_gen_id }}>

<script>
  (function() {
    class AiVideoSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const iframe = this.querySelector('iframe');
        if (iframe && !iframe.hasAttribute('title')) {
          iframe.setAttribute('title', 'Video player');
        }
      }
    }

    customElements.define('ai-video-section-{{ ai_gen_id }}', AiVideoSection{{ ai_gen_id }});
  })();
</script>

