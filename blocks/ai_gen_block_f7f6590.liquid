{% doc %}
  @prompt
    create a section Every Order Over $1000 Comes with a Complimentary Gift.
   
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gift-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-gift-banner__container-{{ ai_gen_id }} {
    display: flex;
    gap: 40px;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-gift-banner__content-{{ ai_gen_id }} {
    flex: 1;
    text-align: left;
  }

  .ai-gift-banner__product-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.product_width }}px;
    max-width: {{ block.settings.product_width }}px;
  }

  .ai-gift-banner__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .ai-gift-banner__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0 0 20px 0;
  }

  .ai-gift-banner__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: {{ block.settings.button_text_transform }};
  }

  .ai-gift-banner__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-gift-banner__product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.product_bg_color }};
    border-radius: {{ block.settings.product_border_radius }}px;
    padding: {{ block.settings.product_padding }}px;
    text-align: center;
    border: 1px solid {{ block.settings.product_border_color }};
  }

  .ai-gift-banner__product-image-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 16px;
    border-radius: {{ block.settings.product_image_radius }}px;
    overflow: hidden;
    position: relative;
    background-color: #f4f4f4;
  }

  .ai-gift-banner__product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-gift-banner__product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-gift-banner__product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-gift-banner__product-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .ai-gift-banner__product-title-{{ ai_gen_id }} {
    color: {{ block.settings.product_title_color }};
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: {{ block.settings.product_title_weight }};
    margin: 0 0 8px 0;
    line-height: 1.4;
  }

  .ai-gift-banner__product-price-{{ ai_gen_id }} {
    color: {{ block.settings.product_price_color }};
    font-size: {{ block.settings.product_price_size }}px;
    font-weight: 600;
    margin: 0;
  }

  .ai-gift-banner__product-price-{{ ai_gen_id }} .original-price {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 8px;
  }

  .ai-gift-banner__product-price-{{ ai_gen_id }} .free-price {
    color: {{ block.settings.free_price_color }};
    font-weight: 700;
  }

  @media screen and (max-width: 989px) {
    .ai-gift-banner__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 30px;
    }

    .ai-gift-banner__product-{{ ai_gen_id }} {
      flex: 1;
      max-width: 100%;
      width: 100%;
    }

    .ai-gift-banner__content-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-gift-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-gift-banner__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-gift-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }
  }
{% endstyle %}

<gift-banner-{{ ai_gen_id }}
  class="ai-gift-banner-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-cart-drawer="{{ settings.cartdraw }}"
>
  <div class="ai-gift-banner__container-{{ ai_gen_id }}">
    <div class="ai-gift-banner__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-gift-banner__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-gift-banner__text-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      <button
        type="button"
        class="ai-gift-banner__button-{{ ai_gen_id }}"
        aria-label="{{ block.settings.button_text }}"
      >
        {{ block.settings.button_text }}
      </button>
    </div>

    <div class="ai-gift-banner__product-{{ ai_gen_id }}">
      {% if block.settings.gift_product != blank %}
        {% assign gift_product = block.settings.gift_product %}
        <div class="ai-gift-banner__product-card-{{ ai_gen_id }}">
          <div class="ai-gift-banner__product-image-{{ ai_gen_id }}">
            {% if block.settings.show_badge %}
              <div class="ai-gift-banner__product-badge-{{ ai_gen_id }}">
                {{ block.settings.badge_text }}
              </div>
            {% endif %}
            {% if gift_product.featured_image %}
              <img
                src="{{ gift_product.featured_image | image_url: width: 600 }}"
                alt="{{ gift_product.featured_image.alt | escape }}"
                loading="lazy"
                width="600"
                height="{{ 600 | divided_by: gift_product.featured_image.aspect_ratio | round }}"
              >
            {% else %}
              <div class="ai-gift-banner__product-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <h3 class="ai-gift-banner__product-title-{{ ai_gen_id }}">
            {{ gift_product.title }}
          </h3>

          <div class="ai-gift-banner__product-price-{{ ai_gen_id }}">
            {% if gift_product.compare_at_price > gift_product.price %}
              <span class="original-price">{{ gift_product.compare_at_price | money }}</span>
            {% endif %}
            <span class="free-price">{{ block.settings.free_text }}</span>
          </div>
        </div>
      {% else %}
        <div class="ai-gift-banner__product-card-{{ ai_gen_id }}">
          <div class="ai-gift-banner__product-image-{{ ai_gen_id }}">
            <div class="ai-gift-banner__product-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          </div>
          <h3 class="ai-gift-banner__product-title-{{ ai_gen_id }}">
            Select a gift product
          </h3>
          <div class="ai-gift-banner__product-price-{{ ai_gen_id }}">
            <span class="free-price">{{ block.settings.free_text }}</span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</gift-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class GiftBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.button = this.querySelector('.ai-gift-banner__button-{{ ai_gen_id }}');
        this.isCartDrawer = this.dataset.cartDrawer === 'true';
      }

      connectedCallback() {
        if (this.button) {
          this.button.addEventListener('click', this.handleClick.bind(this));
        }
      }

      handleClick(event) {
        event.preventDefault();

        if (this.isCartDrawer) {
          this.openCartDrawer();
        } else {
          window.location.href = '/cart';
        }
      }

      openCartDrawer() {
        const cartDrawer = document.querySelector('cart-drawer');
        const cartIcon = document.querySelector('.header__icon--cart');
        const cartLink = document.querySelector('a[href="/cart"]');

        if (cartDrawer) {
          if (typeof cartDrawer.open === 'function') {
            cartDrawer.open();
          } else {
            const openEvent = new CustomEvent('cart:open');
            document.dispatchEvent(openEvent);
          }
        } else if (cartIcon) {
          cartIcon.click();
        } else if (cartLink) {
          cartLink.click();
        } else {
          window.location.href = '/cart';
        }
      }

      disconnectedCallback() {
        if (this.button) {
          this.button.removeEventListener('click', this.handleClick.bind(this));
        }
      }
    }

    customElements.define('gift-banner-{{ ai_gen_id }}', GiftBanner{{ ai_gen_id }});
  })();
</script>

