{% doc %}
  @prompt
    Create a new section for following content "Global Presence & Associations
    Our global partnerships ensure quality, consistency, and ethical sourcing.
    
    India
    Aaron Diamond & Glowstar (est. 1985)
    Belgium
    Chintan Gems
    Dubai
    Diamoon DMCC
    USA
    Diawork Inc.
    Hong Kong
    Liva HK Ltd. & Diamart"
    
    make modern, creative and mobile friendly also use theme colors, more modern and creative
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-global-presence-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background: {{ block.settings.background_color }};
    position: relative;
    overflow: hidden;
  }

  .ai-global-presence-container-{{ ai_gen_id }} {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }

  .ai-global-presence-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 70px;
    position: relative;
  }

  .ai-global-presence-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
    position: relative;
    display: inline-block;
  }

  .ai-global-presence-title-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: {{ block.settings.accent_color }};
    border-radius: 2px;
  }

  .ai-global-presence-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    max-width: 650px;
    margin: 24px auto 0;
    line-height: 1.7;
  }

  .ai-global-presence-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
  }

  .ai-global-presence-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 40px 28px;
    position: relative;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid {{ block.settings.card_border_color }};
    overflow: hidden;
  }

  .ai-global-presence-card-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, {{ block.settings.accent_color }}08 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .ai-global-presence-card-{{ ai_gen_id }}:hover::before {
    opacity: 1;
  }

  .ai-global-presence-card-{{ ai_gen_id }}:hover {
    transform: translateY(-12px);
    box-shadow: 0 20px 40px rgba(1, 48, 90, 0.12);
    border-color: {{ block.settings.accent_color }}40;
  }

  .ai-global-presence-card-top-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
    position: relative;
  }

  .ai-global-presence-icon-wrapper-{{ ai_gen_id }} {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, {{ block.settings.accent_color }}15 0%, {{ block.settings.accent_color }}05 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.4s ease;
    position: relative;
  }

  .ai-global-presence-card-{{ ai_gen_id }}:hover .ai-global-presence-icon-wrapper-{{ ai_gen_id }} {
    background: {{ block.settings.accent_color }};
    transform: rotate(360deg) scale(1.1);
  }

  .ai-global-presence-icon-{{ ai_gen_id }} {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-global-presence-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.accent_color }};
    transition: fill 0.4s ease;
  }

  .ai-global-presence-card-{{ ai_gen_id }}:hover .ai-global-presence-icon-{{ ai_gen_id }} svg {
    fill: #ffffff;
  }

  .ai-global-presence-country-{{ ai_gen_id }} {
    font-size: 26px;
    color: {{ block.settings.country_color }};
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .ai-global-presence-divider-{{ ai_gen_id }} {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, {{ block.settings.card_border_color }} 50%, transparent 100%);
    margin: 24px 0;
  }

  .ai-global-presence-companies-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-global-presence-company-{{ ai_gen_id }} {
    position: relative;
    padding-left: 20px;
  }

  .ai-global-presence-company-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    background: {{ block.settings.accent_color }};
    border-radius: 50%;
    transition: all 0.3s ease;
  }

  .ai-global-presence-card-{{ ai_gen_id }}:hover .ai-global-presence-company-{{ ai_gen_id }}::before {
    transform: scale(1.5);
  }

  .ai-global-presence-company-name-{{ ai_gen_id }} {
    font-size: 17px;
    font-weight: 600;
    color: {{ block.settings.company_name_color }};
    line-height: 1.5;
    margin-bottom: 4px;
  }

  .ai-global-presence-year-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.year_color }};
    font-style: italic;
    font-weight: 400;
  }

  .ai-global-presence-bg-decoration-{{ ai_gen_id }} {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, {{ block.settings.accent_color }}08 0%, transparent 70%);
    pointer-events: none;
  }

  .ai-global-presence-bg-decoration-{{ ai_gen_id }}:nth-child(1) {
    top: -200px;
    right: -200px;
  }

  .ai-global-presence-bg-decoration-{{ ai_gen_id }}:nth-child(2) {
    bottom: -200px;
    left: -200px;
  }

  @media screen and (max-width: 768px) {
    .ai-global-presence-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px 0 {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .ai-global-presence-header-{{ ai_gen_id }} {
      margin-bottom: 50px;
    }

    .ai-global-presence-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.65 }}px;
    }

    .ai-global-presence-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-global-presence-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-global-presence-card-{{ ai_gen_id }} {
      padding: 32px 24px;
    }

    .ai-global-presence-card-top-{{ ai_gen_id }} {
      margin-bottom: 24px;
    }

    .ai-global-presence-icon-wrapper-{{ ai_gen_id }} {
      width: 48px;
      height: 48px;
    }

    .ai-global-presence-icon-{{ ai_gen_id }} {
      width: 24px;
      height: 24px;
    }

    .ai-global-presence-country-{{ ai_gen_id }} {
      font-size: 22px;
    }

    .ai-global-presence-company-name-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-global-presence-bg-decoration-{{ ai_gen_id }} {
      width: 300px;
      height: 300px;
    }

    .ai-global-presence-bg-decoration-{{ ai_gen_id }}:nth-child(1) {
      top: -150px;
      right: -150px;
    }

    .ai-global-presence-bg-decoration-{{ ai_gen_id }}:nth-child(2) {
      bottom: -150px;
      left: -150px;
    }
  }

  @media screen and (min-width: 769px) and (max-width: 1024px) {
    .ai-global-presence-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstyle %}

