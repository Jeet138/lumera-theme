{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ring-tabs-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    margin: {{ block.settings.section_margin_top }}px {{ block.settings.section_margin_horizontal }}px {{ block.settings.section_margin_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-ring-tabs-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-ring-tabs-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    margin-bottom: {{ block.settings.title_margin_bottom }}px;
  }

  .ai-ring-tabs-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    font-weight: {{ block.settings.title_font_weight }};
    line-height: {{ block.settings.title_line_height }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
  }

  .ai-ring-tabs-nav-{{ ai_gen_id }} {
    display: flex;
    {% if block.settings.title_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.title_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
    gap: {{ block.settings.tab_gap }}px;
    margin-bottom: {{ block.settings.tab_margin_bottom }}px;
    flex-wrap: wrap;
    {% if block.settings.tab_style == 'style_1' %}
      border-bottom: {{ block.settings.tab_border_width }}px solid {{ block.settings.tab_border_color }};
      padding-bottom: {{ block.settings.tab_padding_bottom }}px;
    {% endif %}
  }

  .ai-ring-tab-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    transition: all 0.3s ease;
    font-weight: {{ block.settings.tab_font_weight }};
    font-size: {{ block.settings.tab_font_size }}px;
    letter-spacing: {{ block.settings.tab_letter_spacing }}px;
    {% if block.settings.tab_style == 'style_1' %}
      padding: {{ block.settings.tab_padding_vertical }}px {{ block.settings.tab_padding_horizontal }}px;
      color: {{ block.settings.tab_inactive_color }};
    {% elsif block.settings.tab_style == 'style_2' %}
      padding: {{ block.settings.tab_padding_vertical }}px {{ block.settings.tab_padding_horizontal }}px;
      color: {{ block.settings.tab_inactive_color }};
      border: {{ block.settings.tab_border_width }}px solid {{ block.settings.tab_border_color }};
      border-radius: {{ block.settings.tab_border_radius }}px;
    {% elsif block.settings.tab_style == 'style_3' %}
      padding: {{ block.settings.tab_padding_vertical }}px {{ block.settings.tab_padding_horizontal }}px;
      color: {{ block.settings.tab_inactive_color }};
      background-color: {{ block.settings.tab_inactive_bg }};
      border-radius: {{ block.settings.tab_border_radius }}px;
    {% endif %}
  }

  {% if block.settings.tab_style == 'style_1' %}
    .ai-ring-tab-button-{{ ai_gen_id }}:hover {
      color: {{ block.settings.tab_active_color }};
    }

    .ai-ring-tab-button-{{ ai_gen_id }}.active {
      color: {{ block.settings.tab_active_color }};
    }

    .ai-ring-tab-button-{{ ai_gen_id }}.active::after {
      content: '';
      position: absolute;
      bottom: calc(-{{ block.settings.tab_padding_bottom }}px - {{ block.settings.tab_border_width }}px);
      left: 0;
      right: 0;
      height: {{ block.settings.tab_active_underline_height }}px;
      background-color: {{ block.settings.tab_active_color }};
    }
  {% elsif block.settings.tab_style == 'style_2' %}
    .ai-ring-tab-button-{{ ai_gen_id }}:hover {
      border-color: {{ block.settings.tab_active_color }};
      color: {{ block.settings.tab_active_color }};
    }

    .ai-ring-tab-button-{{ ai_gen_id }}.active {
      background-color: {{ block.settings.tab_active_color }};
      color: {{ block.settings.tab_active_text_color }};
      border-color: {{ block.settings.tab_active_color }};
    }
  {% elsif block.settings.tab_style == 'style_3' %}
    .ai-ring-tab-button-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.tab_hover_bg }};
      color: {{ block.settings.text_color }};
    }

    .ai-ring-tab-button-{{ ai_gen_id }}.active {
      background-color: {{ block.settings.tab_active_color }};
      color: {{ block.settings.tab_active_text_color }};
    }
  {% endif %}

  .ai-ring-tab-content-{{ ai_gen_id }} {
    display: none;
  }

  .ai-ring-tab-content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-ring-collections-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.grid_columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    row-gap: {{ block.settings.grid_row_gap }}px;
  }

  .ai-ring-collection-item-{{ ai_gen_id }} {
    text-align: {{ block.settings.collection_text_align }};
    text-decoration: none;
    display: block;
    transition: transform {{ block.settings.hover_transition_speed }}s ease;
  }

  .ai-ring-collection-item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift_amount }}px);
  }

  .ai-ring-collection-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: {{ block.settings.image_margin_bottom }}px;
    aspect-ratio: 1;
    border: {{ block.settings.image_border_width }}px solid {{ block.settings.image_border_color }};
  }

  .ai-ring-collection-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform {{ block.settings.hover_transition_speed }}s ease;
  }

  .ai-ring-collection-item-{{ ai_gen_id }}:hover .ai-ring-collection-image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.image_hover_scale | divided_by: 10.0 }});
  }

  .ai-ring-collection-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ring-collection-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ring-collection-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.collection_title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.title_count_gap }}px;
    font-weight: {{ block.settings.collection_title_weight }};
    line-height: {{ block.settings.collection_title_line_height }};
    letter-spacing: {{ block.settings.collection_title_spacing }}px;
  }

  .ai-ring-collection-count-{{ ai_gen_id }} {
    font-size: {{ block.settings.collection_count_size }}px;
    color: {{ block.settings.collection_count_color }};
    margin: 0;
    font-weight: {{ block.settings.collection_count_weight }};
  }

  @media screen and (max-width: 1024px) {
    .ai-ring-collections-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.grid_columns_tablet }}, 1fr);
    }

    .ai-ring-tabs-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_tablet }}px;
    }

    .ai-ring-tab-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.tab_font_size_tablet }}px;
    }
  }

  @media screen and (max-width: 768px) {
    .ai-ring-tabs-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top_mobile }}px {{ block.settings.section_padding_horizontal_mobile }}px {{ block.settings.section_padding_bottom_mobile }}px;
      margin: {{ block.settings.section_margin_top_mobile }}px {{ block.settings.section_margin_horizontal_mobile }}px {{ block.settings.section_margin_bottom_mobile }}px;
    }

    .ai-ring-tabs-nav-{{ ai_gen_id }} {
      gap: {{ block.settings.tab_gap_mobile }}px;
    }

    .ai-ring-tab-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.tab_font_size_mobile }}px;
      {% if block.settings.tab_style == 'style_2' or block.settings.tab_style == 'style_3' %}
        padding: {{ block.settings.tab_padding_vertical_mobile }}px {{ block.settings.tab_padding_horizontal_mobile }}px;
      {% endif %}
    }

    .ai-ring-tabs-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-ring-collections-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.grid_columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap_mobile }}px;
      row-gap: {{ block.settings.grid_row_gap_mobile }}px;
    }

    .ai-ring-collection-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.collection_title_size_mobile }}px;
    }

    .ai-ring-collection-count-{{ ai_gen_id }} {
      font-size: {{ block.settings.collection_count_size_mobile }}px;
    }
  }
{% endstyle %}

<ring-tabs-{{ ai_gen_id }} class="ai-ring-tabs-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ring-tabs-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <div class="ai-ring-tabs-header-{{ ai_gen_id }}">
        <h2 class="ai-ring-tabs-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      </div>
    {% endif %}

    <div class="ai-ring-tabs-nav-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
          assign tab_title_key = 'tab_' | append: i | append: '_title'
          assign tab_enabled = block.settings[tab_enabled_key]
          assign tab_title = block.settings[tab_title_key]
        %}
        {% if tab_enabled and tab_title != blank %}
          <button
            class="ai-ring-tab-button-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-tab="tab-{{ i }}"
            aria-label="View {{ tab_title }} collections"
          >
            {{ tab_title }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    {% for i in (1..4) %}
      {% liquid
        assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
        assign tab_title_key = 'tab_' | append: i | append: '_title'
        assign tab_enabled = block.settings[tab_enabled_key]
        assign tab_title = block.settings[tab_title_key]
      %}
      {% if tab_enabled and tab_title != blank %}
        <div class="ai-ring-tab-content-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}" data-tab-content="tab-{{ i }}">
          <div class="ai-ring-collections-grid-{{ ai_gen_id }}">
            {% for j in (1..6) %}
              {% liquid
                assign collection_key = 'tab_' | append: i | append: '_collection_' | append: j
                assign collection_title_key = 'tab_' | append: i | append: '_collection_' | append: j | append: '_title'
                assign collection_count_key = 'tab_' | append: i | append: '_collection_' | append: j | append: '_count'
                assign collection_image_key = 'tab_' | append: i | append: '_collection_' | append: j | append: '_image'
                
                assign collection = block.settings[collection_key]
                assign custom_title = block.settings[collection_title_key]
                assign custom_count = block.settings[collection_count_key]
                assign custom_image = block.settings[collection_image_key]
              %}
              
              {% if collection != blank %}
                <a href="{{ collection.url }}" class="ai-ring-collection-item-{{ ai_gen_id }}">
                  <div class="ai-ring-collection-image-wrapper-{{ ai_gen_id }}">
                    {% if custom_image != blank %}
                      <img
                        src="{{ custom_image | image_url: width: 400 }}"
                        alt="{{ custom_title | default: collection.title | escape }}"
                        class="ai-ring-collection-image-{{ ai_gen_id }}"
                        loading="lazy"
                        width="400"
                        height="400"
                      >
                    {% elsif collection.image %}
                      <img
                        src="{{ collection.image | image_url: width: 400 }}"
                        alt="{{ custom_title | default: collection.title | escape }}"
                        class="ai-ring-collection-image-{{ ai_gen_id }}"
                        loading="lazy"
                        width="400"
                        height="400"
                      >
                    {% else %}
                      <div class="ai-ring-collection-placeholder-{{ ai_gen_id }}">
                        {{ 'collection-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                  <h3 class="ai-ring-collection-title-{{ ai_gen_id }}">
                    {{ custom_title | default: collection.title }}
                  </h3>
                  {% if custom_count != blank %}
                    <p class="ai-ring-collection-count-{{ ai_gen_id }}">{{ custom_count }}</p>
                  {% elsif block.settings.show_product_count %}
                    <p class="ai-ring-collection-count-{{ ai_gen_id }}">{{ collection.products_count }} items</p>
                  {% endif %}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</ring-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class RingTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabButtons = this.querySelectorAll('.ai-ring-tab-button-{{ ai_gen_id }}');
        this.tabContents = this.querySelectorAll('.ai-ring-tab-content-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const tabId = button.getAttribute('data-tab');
            this.switchTab(tabId);
          });
        });
      }

      switchTab(tabId) {
        this.tabButtons.forEach((btn) => {
          if (btn.getAttribute('data-tab') === tabId) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        this.tabContents.forEach((content) => {
          if (content.getAttribute('data-tab-content') === tabId) {
            content.classList.add('active');
          } else {
            content.classList.remove('active');
          }
        });
      }
    }

    customElements.define('ring-tabs-{{ ai_gen_id }}', RingTabs{{ ai_gen_id }});
  })();
</script>

