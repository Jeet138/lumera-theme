{% endstyle %}

<ring-carousel-{{ ai_gen_id }} class="ai-ring-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ring-carousel-container-{{ ai_gen_id }}">
    <div class="ai-ring-carousel-header-{{ ai_gen_id }}">
      {% if block.settings.main_title != blank %}
        <h2 class="ai-ring-carousel-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
      {% endif %}
      {% if block.settings.main_subtitle != blank %}
        <p class="ai-ring-carousel-subtitle-{{ ai_gen_id }}">{{ block.settings.main_subtitle }}</p>
      {% endif %}
    </div>

    <div class="ai-ring-carousel-stage-{{ ai_gen_id }}">
      <div class="ai-ring-carousel-track-{{ ai_gen_id }}" data-carousel-track>
        {% for i in (1..12) %}
          {% liquid
            assign image_key = 'ring_image_' | append: i
            assign title_key = 'ring_title_' | append: i
            assign subtitle_key = 'ring_subtitle_' | append: i
            assign link_key = 'ring_link_' | append: i

            assign ring_image = block.settings[image_key]
            assign ring_title = block.settings[title_key]
            assign ring_subtitle = block.settings[subtitle_key]
            assign ring_link = block.settings[link_key]
          %}

          {% if ring_image != blank %}
            <div class="ai-ring-carousel-item-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}">
              <div class="ai-ring-carousel-card-{{ ai_gen_id }}">
                {% if ring_link != blank %}
                  <a href="{{ ring_link }}" class="ai-ring-carousel-link-{{ ai_gen_id }}">
                {% else %}
                  <div class="ai-ring-carousel-link-{{ ai_gen_id }}">
                {% endif %}
                <div class="ai-ring-carousel-image-wrapper-{{ ai_gen_id }}">
                  <img
                    src="{{ ring_image | image_url: width: 800 }}"
                    alt=""
                    class="ai-ring-carousel-reflection-{{ ai_gen_id }}"
                    aria-hidden="true"
                    loading="lazy"
                  >
                </div>
                {% if ring_link != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              </div>

              <div class="ai-ring-carousel-info-wrapper-{{ ai_gen_id }}">
                <button
                  class="ai-ring-carousel-arrow-{{ ai_gen_id }} ai-ring-carousel-prev-{{ ai_gen_id }}"
                  aria-label="Previous ring style"
                  data-carousel-prev
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                  </svg>
                </button>

                {% if ring_title != blank or ring_subtitle != blank %}
                  <div class="ai-ring-carousel-info-{{ ai_gen_id }}">
                    {% if ring_title != blank %}
                      <h3 class="ai-ring-carousel-item-title-{{ ai_gen_id }}">{{ ring_title }}</h3>
                    {% endif %}
                    {% if ring_subtitle != blank %}
                      <p class="ai-ring-carousel-item-subtitle-{{ ai_gen_id }}">{{ ring_subtitle }}</p>
                    {% endif %}
                  </div>
                {% endif %}

                <button
                  class="ai-ring-carousel-arrow-{{ ai_gen_id }} ai-ring-carousel-next-{{ ai_gen_id }}"
                  aria-label="Next ring style"
                  data-carousel-next
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </button>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</ring-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class RingCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.items = [];
        this.isAnimating = false;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.items = Array.from(this.querySelectorAll('.ai-ring-carousel-item-{{ ai_gen_id }}'));

        if (this.items.length === 0) return;

        this.setupEventListeners();
        this.updatePositions();
      }

      setupEventListeners() {
        this.addEventListener('click', (e) => {
          const prevBtn = e.target.closest('[data-carousel-prev]');
          const nextBtn = e.target.closest('[data-carousel-next]');

          if (prevBtn) {
            e.preventDefault();
            e.stopPropagation();
            this.navigate(-1);
          } else if (nextBtn) {
            e.preventDefault();
            e.stopPropagation();
            this.navigate(1);
          }
        });

        let startX = 0;
        let endX = 0;

        this.track.addEventListener('touchstart', (e) => {
          startX = e.touches[0].clientX;
        });

        this.track.addEventListener('touchend', (e) => {
          endX = e.changedTouches[0].clientX;
          const diff = startX - endX;

          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              this.navigate(1);
            } else {
              this.navigate(-1);
            }
          }
        });
      }

      navigate(direction) {
        if (this.isAnimating || this.items.length === 0) return;

        this.isAnimating = true;
        this.currentIndex = (this.currentIndex + direction + this.items.length) % this.items.length;
        this.updatePositions();

        setTimeout(() => {
          this.isAnimating = false;
        }, 600);
      }

      updatePositions() {
        this.items.forEach((item, index) => {
          item.classList.remove('center', 'left-1', 'left-2', 'right-1', 'right-2', 'active');

          const position = (index - this.currentIndex + this.items.length) % this.items.length;

          if (position === 0) {
            item.classList.add('center', 'active');
          } else if (position === 1) {
            item.classList.add('right-1', 'active');
          } else if (position === this.items.length - 1) {
            item.classList.add('left-1', 'active');
          } else if (position === 2) {
            item.classList.add('right-2', 'active');
          } else if (position === this.items.length - 2) {
            item.classList.add('left-2', 'active');
          }
        });
      }
    }

    customElements.define('ring-carousel-{{ ai_gen_id }}', RingCarousel{{ ai_gen_id }});
  })();
</script>

