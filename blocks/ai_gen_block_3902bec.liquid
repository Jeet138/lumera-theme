{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-csr-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-csr-container-{{ ai_gen_id }} {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 30px;
  }

  .ai-csr-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-csr-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px;
    font-weight: 500;
  }

  .ai-csr-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 900px;
    margin: 0 auto;
    line-height: 1.8;
  }

  .ai-csr-initiatives-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-bottom: 60px;
  }

  .ai-csr-initiative-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    padding: 30px;
    border-radius: {{ block.settings.card_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-csr-initiative-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .ai-csr-initiative-icon-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    margin-bottom: 20px;
    color: {{ block.settings.icon_color }};
  }

  .ai-csr-initiative-title-{{ ai_gen_id }} {
    font-size: 20px;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px;
    font-weight: 600;
  }

  .ai-csr-initiative-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-csr-stats-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    margin-bottom: 60px;
    padding: 40px 0;
    border-top: 1px solid {{ block.settings.divider_color }};
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-csr-stat-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-csr-stat-number-{{ ai_gen_id }} {
    font-size: 48px;
    color: {{ block.settings.stat_color }};
    font-weight: 700;
    margin: 0 0 10px;
    line-height: 1;
  }

  .ai-csr-stat-label-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ai-csr-trust-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-csr-trust-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    font-style: italic;
  }

  .ai-csr-instagram-{{ ai_gen_id }} {
    margin-top: 60px;
  }

  .ai-csr-instagram-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-csr-instagram-title-{{ ai_gen_id }} {
    font-size: 32px;
    color: {{ block.settings.title_color }};
    margin: 0 0 15px;
    font-weight: 500;
  }

  .ai-csr-instagram-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: 16px;
    transition: color 0.3s ease;
  }

  .ai-csr-instagram-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-csr-instagram-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
  }

  .ai-csr-instagram-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .ai-csr-instagram-placeholder-{{ ai_gen_id }} {
    aspect-ratio: 1;
    background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    border-radius: {{ block.settings.card_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 14px;
    text-align: center;
    padding: 20px;
  }

  .ai-csr-cta-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 40px;
  }

  .ai-csr-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 18px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text }};
    text-decoration: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: 14px;
    font-weight: 600;
    text-transform: capitalize;
    transition: all 0.3s ease;
  }

  .ai-csr-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover }};
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }

  @media screen and (max-width: 768px) {
    .ai-csr-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 0;
    }

    .ai-csr-header-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }

    .ai-csr-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.6 }}px;
    }

    .ai-csr-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-csr-initiatives-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 40px;
    }

    .ai-csr-stats-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-bottom: 40px;
    }

    .ai-csr-stat-number-{{ ai_gen_id }} {
      font-size: 36px;
    }

    .ai-csr-instagram-{{ ai_gen_id }} {
      margin-top: 40px;
    }

    .ai-csr-instagram-title-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-csr-instagram-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }
{% endstyle %}

<div class="ai-csr-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-csr-container-{{ ai_gen_id }}">
    <div class="ai-csr-header-{{ ai_gen_id }}">
      <h2 class="ai-csr-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
      <div class="ai-csr-description-{{ ai_gen_id }}">
        {{ block.settings.main_description }}
      </div>
    </div>

    <div class="ai-csr-initiatives-{{ ai_gen_id }}">
      <div class="ai-csr-initiative-card-{{ ai_gen_id }}">
        <svg class="ai-csr-initiative-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <h3 class="ai-csr-initiative-title-{{ ai_gen_id }}">{{ block.settings.education_title }}</h3>
        <p class="ai-csr-initiative-text-{{ ai_gen_id }}">{{ block.settings.education_text }}</p>
      </div>

      <div class="ai-csr-initiative-card-{{ ai_gen_id }}">
        <svg class="ai-csr-initiative-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="ai-csr-initiative-title-{{ ai_gen_id }}">{{ block.settings.environment_title }}</h3>
        <p class="ai-csr-initiative-text-{{ ai_gen_id }}">{{ block.settings.environment_text }}</p>
      </div>

      <div class="ai-csr-initiative-card-{{ ai_gen_id }}">
        <svg class="ai-csr-initiative-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        <h3 class="ai-csr-initiative-title-{{ ai_gen_id }}">{{ block.settings.community_title }}</h3>
        <p class="ai-csr-initiative-text-{{ ai_gen_id }}">{{ block.settings.community_text }}</p>
      </div>
    </div>

    <div class="ai-csr-stats-{{ ai_gen_id }}">
      <div class="ai-csr-stat-{{ ai_gen_id }}">
        <div class="ai-csr-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_1_number }}</div>
        <div class="ai-csr-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_1_label }}</div>
      </div>

      <div class="ai-csr-stat-{{ ai_gen_id }}">
        <div class="ai-csr-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_2_number }}</div>
        <div class="ai-csr-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_2_label }}</div>
      </div>

      <div class="ai-csr-stat-{{ ai_gen_id }}">
        <div class="ai-csr-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_3_number }}</div>
        <div class="ai-csr-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_3_label }}</div>
      </div>

      <div class="ai-csr-stat-{{ ai_gen_id }}">
        <div class="ai-csr-stat-number-{{ ai_gen_id }}">{{ block.settings.stat_4_number }}</div>
        <div class="ai-csr-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_4_label }}</div>
      </div>
    </div>

    <div class="ai-csr-trust-{{ ai_gen_id }}">
      <p class="ai-csr-trust-text-{{ ai_gen_id }}">{{ block.settings.trust_text }}</p>
    </div>

    {% if block.settings.enable_instagram %}
      <div class="ai-csr-instagram-{{ ai_gen_id }}">
        <div class="ai-csr-instagram-header-{{ ai_gen_id }}">
          <h3 class="ai-csr-instagram-title-{{ ai_gen_id }}">{{ block.settings.instagram_title }}</h3>
          {% if block.settings.instagram_url != blank %}
            <a href="{{ block.settings.instagram_url }}" target="_blank" rel="noopener" class="ai-csr-instagram-link-{{ ai_gen_id }}">
              <svg class="ai-csr-instagram-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              {{ block.settings.instagram_handle }}
            </a>
          {% endif %}
        </div>

        <div class="ai-csr-instagram-grid-{{ ai_gen_id }}">
          {% for i in (1..4) %}
            <div class="ai-csr-instagram-placeholder-{{ ai_gen_id }}">
              Connect your Instagram to display recent CSR activities
            </div>
          {% endfor %}
        </div>

        {% if block.settings.instagram_cta_text != blank %}
          <div class="ai-csr-cta-{{ ai_gen_id }}">
            <a href="{{ block.settings.instagram_url }}" target="_blank" rel="noopener" class="ai-csr-button-{{ ai_gen_id }}">
              {{ block.settings.instagram_cta_text }}
            </a>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

