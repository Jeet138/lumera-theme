{% doc %}
  @prompt
   
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-gift-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 20px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-gift-banner-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.background_hover_color }};
  }

  .ai-gift-banner-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .ai-gift-banner-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-gift-banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 10px 0;
    line-height: 1.2;
  }

  .ai-gift-banner-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0 0 15px 0;
    line-height: 1.5;
  }

  .ai-gift-banner-cta-{{ ai_gen_id }} {
    display: inline-block;
    color: {{ block.settings.cta_color }};
    font-size: {{ block.settings.cta_size }}px;
    font-weight: {{ block.settings.cta_weight }};
    text-decoration: underline;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-gift-banner-images-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    align-items: center;
  }

  .ai-gift-banner-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.image_size }}px;
    flex-shrink: 0;
  }

  .ai-gift-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-gift-banner-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    padding-bottom: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-gift-banner-image-placeholder-{{ ai_gen_id }} svg {
    position: absolute;
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-gift-banner-price-badge-{{ ai_gen_id }} {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.price_badge_bg }};
    color: {{ block.settings.price_badge_text }};
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-gift-banner-original-price-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.7;
    font-size: 12px;
  }

  .ai-gift-banner-free-text-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 700;
    color: {{ block.settings.free_text_color }};
  }

  @media screen and (max-width: 768px) {
    .ai-gift-banner-container-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
      gap: 20px;
    }

    .ai-gift-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-gift-banner-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-gift-banner-images-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-gift-banner-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<gift-banner-{{ ai_gen_id }}
  class="ai-gift-banner-{{ ai_gen_id }}"
  data-cart-drawer-trigger
  {{ block.shopify_attributes }}
>
  <div class="ai-gift-banner-container-{{ ai_gen_id }}">
    <div class="ai-gift-banner-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h3 class="ai-gift-banner-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h3>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-gift-banner-text-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      {% if block.settings.cta_text != blank %}
        <span class="ai-gift-banner-cta-{{ ai_gen_id }}">
          {{ block.settings.cta_text }}
        </span>
      {% endif %}
    </div>

    <div class="ai-gift-banner-images-{{ ai_gen_id }}">
      {% if block.settings.show_product_image_1 %}
        <div class="ai-gift-banner-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.product_image_1 %}
            <img
              src="{{ block.settings.product_image_1 | image_url: width: 300 }}"
              alt="{{ block.settings.product_image_1.alt | escape }}"
              class="ai-gift-banner-image-{{ ai_gen_id }}"
              loading="lazy"
              width="300"
              height="300"
            >
          {% else %}
            <div class="ai-gift-banner-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
          {% comment %} <div class="ai-gift-banner-price-badge-{{ ai_gen_id }}">
            <span class="ai-gift-banner-original-price-{{ ai_gen_id }}">{{ block.settings.original_price }}</span>
            <span class="ai-gift-banner-free-text-{{ ai_gen_id }}">{{ block.settings.free_text }}</span>
          </div> {% endcomment %}
        </div>
      {% endif %}

      {% if block.settings.show_product_image_2 %}
        <div class="ai-gift-banner-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.model_image_1 %}
            <img
              src="{{ block.settings.model_image_1 | image_url: width: 300 }}"
              alt="{{ block.settings.model_image_1.alt | escape }}"
              class="ai-gift-banner-image-{{ ai_gen_id }}"
              loading="lazy"
              width="300"
              height="300"
            >
          {% else %}
            <div class="ai-gift-banner-image-placeholder-{{ ai_gen_id }}">
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
          {% comment %} <div class="ai-gift-banner-price-badge-{{ ai_gen_id }}">
            <span class="ai-gift-banner-original-price-{{ ai_gen_id }}">{{ block.settings.original_price }}</span>
            <span class="ai-gift-banner-free-text-{{ ai_gen_id }}">{{ block.settings.free_text }}</span>
          </div> {% endcomment %}
        </div>
      {% endif %}
    </div>
  </div>
</gift-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class GiftBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.addEventListener('click', this.handleClick.bind(this));
      }

      handleClick() {
        var cartToggleBtn = document.querySelector('.js-toggle-cart');
        var miniCart = document.querySelector('.js-mini-cart');

        if (cartToggleBtn) {
          cartToggleBtn.click();
        } else if (miniCart) {
          miniCart.classList.add('active');
        } else {
          window.location.href = '/cart';
        }
      }

      disconnectedCallback() {
        this.removeEventListener('click', this.handleClick);
      }
    }

    customElements.define('gift-banner-{{ ai_gen_id }}', GiftBanner{{ ai_gen_id }});
  })();
</script>

