{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ring-size-guide-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-ring-size-guide__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-ring-size-guide__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.spacing_between_sections }}px;
  }

  .ai-ring-size-guide__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-weight: {{ block.settings.title_weight }};
  }

  .ai-ring-size-guide__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-ring-size-guide__steps-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: {{ block.settings.step_gap }}px;
    margin-top: {{ block.settings.spacing_between_sections }}px;
  }

  .ai-ring-size-guide__step-{{ ai_gen_id }} {
    text-align: center;
    padding: {{ block.settings.step_padding }}px;
    background-color: {{ block.settings.step_background }};
    border-radius: {{ block.settings.step_border_radius }}px;
    transition: transform 0.3s ease;
  }

  .ai-ring-size-guide__step-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-ring-size-guide__step-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.image_spacing }}px;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-ring-size-guide__step-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-ring-size-guide__step-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-ring-size-guide__step-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ring-size-guide__step-number-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 40px;
    height: 40px;
    background-color: {{ block.settings.step_number_bg }};
    color: {{ block.settings.step_number_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 18px;
    z-index: 2;
  }

  .ai-ring-size-guide__step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    color: {{ block.settings.step_title_color }};
    margin: 0 0 {{ block.settings.step_title_spacing }}px;
    font-weight: {{ block.settings.step_title_weight }};
  }

  .ai-ring-size-guide__step-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_text_size }}px;
    color: {{ block.settings.step_text_color }};
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-ring-size-guide__steps-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-ring-size-guide__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-ring-size-guide__step-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.step_title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-ring-size-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ring-size-guide__container-{{ ai_gen_id }}">
    <div class="ai-ring-size-guide__header-{{ ai_gen_id }}">
      {% if block.settings.main_title != blank %}
        <h2 class="ai-ring-size-guide__title-{{ ai_gen_id }}">
          {{ block.settings.main_title }}
        </h2>
      {% endif %}

      {% if block.settings.main_description != blank %}
        <div class="ai-ring-size-guide__description-{{ ai_gen_id }}">
          {{ block.settings.main_description }}
        </div>
      {% endif %}
    </div>

    <div class="ai-ring-size-guide__steps-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign step_image_key = 'step_' | append: i | append: '_image'
          assign step_title_key = 'step_' | append: i | append: '_title'
          assign step_text_key = 'step_' | append: i | append: '_text'

          assign step_image = block.settings[step_image_key]
          assign step_title = block.settings[step_title_key]
          assign step_text = block.settings[step_text_key]
        %}

        <div class="ai-ring-size-guide__step-{{ ai_gen_id }}">
          <div class="ai-ring-size-guide__step-image-wrapper-{{ ai_gen_id }}">
            <div class="ai-ring-size-guide__step-number-{{ ai_gen_id }}">{{ i }}</div>
            {% if step_image %}
              <img
                src="{{ step_image | image_url: width: 600 }}"
                alt="{{ step_title | escape }}"
                class="ai-ring-size-guide__step-image-{{ ai_gen_id }}"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="ai-ring-size-guide__step-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if step_title != blank %}
            <h3 class="ai-ring-size-guide__step-title-{{ ai_gen_id }}">
              {{ step_title }}
            </h3>
          {% endif %}

          {% if step_text != blank %}
            <p class="ai-ring-size-guide__step-text-{{ ai_gen_id }}">
              {{ step_text }}
            </p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

