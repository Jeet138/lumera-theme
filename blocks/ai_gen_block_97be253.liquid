{% doc %}
  @prompt
    give me create a real review section with photo with scroller ke sath 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-section-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-reviews-container-{{ ai_gen_id }} {
    max-width: 1730px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 40px;
  }

  .ai-reviews-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
  }

  .ai-reviews-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-reviews-scroller-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-reviews-scroller-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 0;
  }

  .ai-reviews-scroller-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-review-card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .ai-review-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-review-avatar-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .ai-review-avatar-placeholder-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: {{ block.settings.heading_color }};
    color: {{ block.settings.card_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 600;
    flex-shrink: 0;
  }

  .ai-review-author-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-review-author-name-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px;
  }

  .ai-review-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
  }

  .ai-review-star-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    width: 16px;
    height: 16px;
  }

  .ai-review-photo-{{ ai_gen_id }} {
    width: 100%;
    height: 200px;
    border-radius: {{ block.settings.photo_border_radius }}px;
    object-fit: cover;
  }

  .ai-review-photo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 200px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.photo_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-review-photo-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-review-date-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-reviews-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 30px;
  }

  .ai-reviews-nav-btn-{{ ai_gen_id }} {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_icon_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-reviews-nav-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    transform: scale(1.1);
  }

  .ai-reviews-nav-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: scale(1);
  }

  @media screen and (max-width: 768px) {
    .ai-review-card-{{ ai_gen_id }} {
      flex: 0 0 280px;
    }

    .ai-reviews-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-reviews-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<reviews-scroller-{{ ai_gen_id }} class="ai-reviews-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-reviews-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-reviews-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-reviews-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-reviews-scroller-wrapper-{{ ai_gen_id }}">
      <div class="ai-reviews-scroller-{{ ai_gen_id }}" data-scroller>
        {% for i in (1..10) %}
          {% liquid
            assign review_name_key = 'review_' | append: i | append: '_name'
            assign review_rating_key = 'review_' | append: i | append: '_rating'
            assign review_text_key = 'review_' | append: i | append: '_text'
            assign review_date_key = 'review_' | append: i | append: '_date'
            assign review_photo_key = 'review_' | append: i | append: '_photo'
            assign review_avatar_key = 'review_' | append: i | append: '_avatar'

            assign review_name = block.settings[review_name_key]
            assign review_rating = block.settings[review_rating_key]
            assign review_text = block.settings[review_text_key]
            assign review_date = block.settings[review_date_key]
            assign review_photo = block.settings[review_photo_key]
            assign review_avatar = block.settings[review_avatar_key]
          %}

          {% if review_name != blank %}
            <div class="ai-review-card-{{ ai_gen_id }}">
              <div class="ai-review-header-{{ ai_gen_id }}">
                {% if review_avatar %}
                  <img
                    src="{{ review_avatar | image_url: width: 100 }}"
                    alt="{{ review_name }}"
                    class="ai-review-avatar-{{ ai_gen_id }}"
                    width="50"
                    height="50"
                    loading="lazy"
                  >
                {% else %}
                  <div class="ai-review-avatar-placeholder-{{ ai_gen_id }}">
                    {{ review_name | slice: 0 | upcase }}
                  </div>
                {% endif %}

                <div class="ai-review-author-info-{{ ai_gen_id }}">
                  <h3 class="ai-review-author-name-{{ ai_gen_id }}">{{ review_name }}</h3>
                  <div class="ai-review-stars-{{ ai_gen_id }}">
                    {% for star in (1..5) %}
                      <svg
                        class="ai-review-star-{{ ai_gen_id }}"
                        viewBox="0 0 24 24"
                        {% if star <= review_rating %}
                          fill="currentColor"
                        {% else %}
                          fill="none"
                        {% endif %}
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                      </svg>
                    {% endfor %}
                  </div>
                </div>
              </div>

              {% if review_photo %}
                <img
                  src="{{ review_photo | image_url: width: 400 }}"
                  alt="Review photo by {{ review_name }}"
                  class="ai-review-photo-{{ ai_gen_id }}"
                  width="400"
                  height="200"
                  loading="lazy"
                >
              {% else %}
                <div class="ai-review-photo-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if review_text != blank %}
                <p class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</p>
              {% endif %}

              {% if review_date != blank %}
                <p class="ai-review-date-{{ ai_gen_id }}">{{ review_date }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-reviews-nav-{{ ai_gen_id }}">
      <button
        class="ai-reviews-nav-btn-{{ ai_gen_id }}"
        data-nav="prev"
        aria-label="Previous reviews"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <button
        class="ai-reviews-nav-btn-{{ ai_gen_id }}"
        data-nav="next"
        aria-label="Next reviews"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
    </div>
  </div>
</reviews-scroller-{{ ai_gen_id }}>

<script>
  (function() {
    class ReviewsScroller{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.scroller = this.querySelector('[data-scroller]');
        this.prevBtn = this.querySelector('[data-nav="prev"]');
        this.nextBtn = this.querySelector('[data-nav="next"]');
        
        if (!this.scroller || !this.prevBtn || !this.nextBtn) return;

        this.setupEventListeners();
        this.updateButtonStates();
      }

      setupEventListeners() {
        this.prevBtn.addEventListener('click', () => this.scroll('prev'));
        this.nextBtn.addEventListener('click', () => this.scroll('next'));
        this.scroller.addEventListener('scroll', () => this.updateButtonStates());
      }

      scroll(direction) {
        const cardWidth = this.scroller.querySelector('.ai-review-card-{{ ai_gen_id }}').offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const scrollAmount = cardWidth + gap;

        if (direction === 'prev') {
          this.scroller.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        } else {
          this.scroller.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      }

      updateButtonStates() {
        const isAtStart = this.scroller.scrollLeft <= 0;
        const isAtEnd = this.scroller.scrollLeft + this.scroller.clientWidth >= this.scroller.scrollWidth - 1;

        this.prevBtn.disabled = isAtStart;
        this.nextBtn.disabled = isAtEnd;
      }
    }

    customElements.define('reviews-scroller-{{ ai_gen_id }}', ReviewsScroller{{ ai_gen_id }});
  })();
</script>

