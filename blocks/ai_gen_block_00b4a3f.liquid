{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  /* =========================================================
     SHOP BY STYLE
     MAIN SECTION
  ========================================================= */

  .ai-shop-by-style-{{ ai_gen_id }} {
    width: 100%;
    padding: 60px 0;
    background-color: {{ block.settings.background_color }};
    box-sizing: border-box;
    overflow: hidden;
  }


  /* =========================================================
     CONTAINER
  ========================================================= */

  .ai-shop-by-style-container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 1548px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }


  /* =========================================================
     HEADER
  ========================================================= */

  .ai-shop-by-style-header-{{ ai_gen_id }} {
    width: 100%;
    text-align: {{ block.settings.heading_alignment }};
    margin: -50px 0 17px;
    box-sizing: border-box;
  }


  /* =========================================================
     HEADING
  ========================================================= */

  .ai-shop-by-style-heading-{{ ai_gen_id }} {
    font-size: clamp(
      30px,
      2.5vw,
      {{ block.settings.heading_size }}px
    );

    line-height: 1.15;

    color: {{ block.settings.heading_color }};

    margin: 0 0 10px;

    font-weight: {{ block.settings.heading_weight }};

    box-sizing: border-box;
  }


  /* =========================================================
     SUBHEADING
  ========================================================= */

  .ai-shop-by-style-subheading-{{ ai_gen_id }} {
    font-size: clamp(
      13px,
      1vw,
      {{ block.settings.subheading_size }}px
    );

    line-height: 1.5;

    color: {{ block.settings.subheading_color }};

    margin: 0;

    box-sizing: border-box;
  }


  /* =========================================================
     DESKTOP GRID
     6 CARDS
  ========================================================= */

  .ai-shop-by-style-grid-{{ ai_gen_id }} {
    width: 100%;

    display: grid;

    grid-template-columns:
      repeat(6, minmax(0, 1fr));

    gap: {{ block.settings.grid_gap }}px;

    box-sizing: border-box;
  }


  /* =========================================================
     CARD
  ========================================================= */

  .ai-shop-by-style-item-{{ ai_gen_id }} {
    position: relative;

    width: 100%;
    min-width: 0;

    overflow: hidden;

    border-radius:
      {{ block.settings.item_border_radius }}px;

    background-color:
      {{ block.settings.item_background }};

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;

    box-sizing: border-box;
  }


  /* =========================================================
     CARD HOVER
  ========================================================= */

  .ai-shop-by-style-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);

    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.15);
  }


  /* =========================================================
     LINK
  ========================================================= */

  .ai-shop-by-style-link-{{ ai_gen_id }} {
    display: block;

    width: 100%;
    height: 100%;

    text-decoration: none;

    color: inherit;

    box-sizing: border-box;
  }


  /* =========================================================
     IMAGE WRAPPER
     120% RATIO
  ========================================================= */

  .ai-shop-by-style-image-wrapper-{{ ai_gen_id }} {
    position: relative;

    width: 100%;

    height: 0;

    padding-bottom: 120%;

    overflow: hidden;

    box-sizing: border-box;
  }


  /* =========================================================
     IMAGE
  ========================================================= */

  .ai-shop-by-style-image-{{ ai_gen_id }} {
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position: center;

    display: block;

    transition:
      transform 0.4s ease;
  }


  /* =========================================================
     IMAGE HOVER
  ========================================================= */

  .ai-shop-by-style-item-{{ ai_gen_id }}:hover
  .ai-shop-by-style-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }


  /* =========================================================
     PLACEHOLDER
  ========================================================= */

  .ai-shop-by-style-placeholder-{{ ai_gen_id }} {
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 100%;

    background-color: #f4f4f4;

    display: flex;

    align-items: center;
    justify-content: center;

    box-sizing: border-box;
  }


  .ai-shop-by-style-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;

    opacity: 0.3;
  }


  /* =========================================================
     OVERLAY
  ========================================================= */

  .ai-shop-by-style-overlay-{{ ai_gen_id }} {
    position: absolute;

    bottom: 0;
    left: 0;
    right: 0;

    padding: 50px 16px 18px;

    display: flex;

    align-items: flex-end;
    justify-content: center;

    background:
      linear-gradient(
        to top,
        rgba(0, 0, 0, 0.72) 0%,
        rgba(0, 0, 0, 0.35) 45%,
        transparent 100%
      );

    box-sizing: border-box;

    transition:
      background 0.3s ease;
  }


  /* =========================================================
     OVERLAY HOVER
  ========================================================= */

  .ai-shop-by-style-item-{{ ai_gen_id }}:hover
  .ai-shop-by-style-overlay-{{ ai_gen_id }} {
    background:
      linear-gradient(
        to top,
        rgba(0, 0, 0, 0.85) 0%,
        rgba(0, 0, 0, 0.4) 45%,
        transparent 100%
      );
  }


  /* =========================================================
     TITLE
  ========================================================= */

  .ai-shop-by-style-title-{{ ai_gen_id }} {
    width: 100%;

    font-size:
      {{ block.settings.collection_title_size }}px;

    line-height: 1.25;

    color:
      {{ block.settings.overlay_text_color }};

    margin: 0;

    font-weight: 600;

    text-align: center;

    overflow-wrap: break-word;

    box-sizing: border-box;
  }


  /* =========================================================
     LARGE DESKTOP
     1500px+
  ========================================================= */

  @media screen and (min-width: 1500px) {

    .ai-shop-by-style-container-{{ ai_gen_id }} {
      width: 100%;
      max-width: 1548px;

      padding-left: 24px;
      padding-right: 24px;

      margin-left: auto;
      margin-right: auto;
    }

    .ai-shop-by-style-grid-{{ ai_gen_id }} {
      width: 100%;

      grid-template-columns:
        repeat(6, minmax(0, 1fr));

      gap: {{ block.settings.grid_gap }}px;
    }

  }


  /* =========================================================
     15" LAPTOP
     1400px - 1499px

     SAME LEFT / RIGHT SPACING AS DESKTOP
  ========================================================= */

  @media screen and (min-width: 1400px) and (max-width: 1499px) {

    .ai-shop-by-style-section-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-shop-by-style-container-{{ ai_gen_id }} {
      width: 100%;

      max-width: 1548px;

      padding-left: 24px;
      padding-right: 24px;

      margin-left: auto;
      margin-right: auto;

      box-sizing: border-box;
    }

    .ai-shop-by-style-grid-{{ ai_gen_id }} {
      width: 100%;

      grid-template-columns:
        repeat(6, minmax(0, 1fr));

      gap: {{ block.settings.grid_gap }}px;
    }

    .ai-shop-by-style-image-wrapper-{{ ai_gen_id }} {
      padding-bottom: 120%;
    }

  }


  /* =========================================================
     14" LAPTOP
     1200px - 1399px

     SAME LEFT / RIGHT SPACING AS DESKTOP
  ========================================================= */

  @media screen and (min-width: 1200px) and (max-width: 1399px) {

    .ai-shop-by-style-container-{{ ai_gen_id }} {
      width: 100%;

      max-width: 1548px;

      padding-left: 24px;
      padding-right: 24px;

      margin-left: auto;
      margin-right: auto;

      box-sizing: border-box;
    }

    .ai-shop-by-style-grid-{{ ai_gen_id }} {
      width: 100%;

      grid-template-columns:
        repeat(6, minmax(0, 1fr));

      gap: {{ block.settings.grid_gap }}px;
    }


    .ai-shop-by-style-heading-{{ ai_gen_id }} {
      font-size: clamp(
        30px,
        2.7vw,
        {{ block.settings.heading_size }}px
      );
    }


    .ai-shop-by-style-title-{{ ai_gen_id }} {
      font-size:
        clamp(
          12px,
          1vw,
          {{ block.settings.collection_title_size }}px
        );
    }

  }


  /* =========================================================
     TABLET
     750px - 1199px

     3 CARDS PER ROW
  ========================================================= */

  @media screen and (min-width: 750px) and (max-width: 1199px) {

    .ai-shop-by-style-{{ ai_gen_id }} {
      padding: 50px 0;
    }


    .ai-shop-by-style-container-{{ ai_gen_id }} {
      width: 100%;

      max-width: 100%;

      padding-left: 20px;
      padding-right: 20px;

      box-sizing: border-box;
    }


    .ai-shop-by-style-grid-{{ ai_gen_id }} {

      display: grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap:
        {{ block.settings.grid_gap }}px;

      width: 100%;
    }


    .ai-shop-by-style-item-{{ ai_gen_id }} {
      width: 100%;

      min-width: 0;
    }


    .ai-shop-by-style-image-wrapper-{{ ai_gen_id }} {
      padding-bottom: 120%;
    }


    .ai-shop-by-style-overlay-{{ ai_gen_id }} {
      padding:
        45px 12px 14px;
    }


    .ai-shop-by-style-title-{{ ai_gen_id }} {
      font-size:
        {{ block.settings.collection_title_size | times: 0.85 }}px;
    }


    .ai-shop-by-style-heading-{{ ai_gen_id }} {
      font-size:
        {{ block.settings.heading_size | times: 0.8 }}px;

      margin-bottom: 8px;
    }


    .ai-shop-by-style-subheading-{{ ai_gen_id }} {
      font-size:
        {{ block.settings.subheading_size | times: 0.9 }}px;
    }

  }


  /* =========================================================
     MOBILE
     BELOW 749px

     HORIZONTAL SCROLL
  ========================================================= */

  @media screen and (max-width: 749px) {

    .ai-shop-by-style-{{ ai_gen_id }} {
      width: 100%;

      padding:
        40px 0;

      overflow: hidden;
    }


    /* -------------------------------------------------------
       CONTAINER
    ------------------------------------------------------- */

    .ai-shop-by-style-container-{{ ai_gen_id }} {
      width: 100%;

      max-width: 100%;

      padding:
        0 12px;

      margin: 0;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       HEADER
    ------------------------------------------------------- */

    .ai-shop-by-style-header-{{ ai_gen_id }} {
      margin-bottom: 24px;

      padding:
        15px 4px;
    }


    /* -------------------------------------------------------
       HEADING
    ------------------------------------------------------- */

    .ai-shop-by-style-heading-{{ ai_gen_id }} {
      font-size:
        {{ block.settings.heading_size | times: 0.72 }}px;

      line-height: 1.2;

      margin: 0 0 8px;
    }


    /* -------------------------------------------------------
       SUBHEADING
    ------------------------------------------------------- */

    .ai-shop-by-style-subheading-{{ ai_gen_id }} {
      font-size:
        {{ block.settings.subheading_size | times: 0.88 }}px;

      line-height: 1.45;

      margin: 0;
    }


    /* -------------------------------------------------------
       MOBILE SLIDER
    ------------------------------------------------------- */

    .ai-shop-by-style-grid-{{ ai_gen_id }} {

      display: flex;

      width: 100%;

      gap: 12px;

      overflow-x: auto;

      overflow-y: hidden;

      scroll-snap-type: x mandatory;

      -webkit-overflow-scrolling: touch;

      scrollbar-width: none;

      -ms-overflow-style: none;

      padding: 0 0 5px;

      box-sizing: border-box;
    }


    /* Hide scrollbar */

    .ai-shop-by-style-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }


    /* -------------------------------------------------------
       MOBILE CARD

       2 CARDS VISIBLE APPROX.
    ------------------------------------------------------- */

    .ai-shop-by-style-item-{{ ai_gen_id }} {

      flex:
        0 0 calc(
          50% - 6px
        );

      width:
        calc(
          50% - 6px
        );

      min-width:
        calc(
          50% - 6px
        );

      max-width:
        calc(
          50% - 6px
        );

      scroll-snap-align: start;

      border-radius: 8px;

      transform: none !important;

      box-shadow: none !important;

      box-sizing: border-box;
    }


    /* -------------------------------------------------------
       MOBILE IMAGE
    ------------------------------------------------------- */

    .ai-shop-by-style-image-wrapper-{{ ai_gen_id }} {

      width: 100%;

      height: 0;

      padding-bottom: 125%;

      overflow: hidden;

      box-sizing: border-box;
    }


    .ai-shop-by-style-image-{{ ai_gen_id }} {

      width: 100%;
      height: 100%;

      object-fit: cover;

      object-position: center;

      transition: none;
    }


    /* -------------------------------------------------------
       MOBILE OVERLAY
    ------------------------------------------------------- */

    .ai-shop-by-style-overlay-{{ ai_gen_id }} {

      padding:
        35px 8px 10px;

      background:
        linear-gradient(
          to top,
          rgba(0, 0, 0, 0.72),
          transparent
        );
    }


    /* -------------------------------------------------------
       MOBILE TITLE
    ------------------------------------------------------- */

    .ai-shop-by-style-title-{{ ai_gen_id }} {

      font-size: 13px;

      line-height: 1.25;

      text-align: center;

      white-space: nowrap;

      overflow: hidden;

      text-overflow: ellipsis;
    }


    /* -------------------------------------------------------
       REMOVE HOVER EFFECT ON TOUCH
    ------------------------------------------------------- */

    .ai-shop-by-style-item-{{ ai_gen_id }}:hover {

      transform: none;

      box-shadow: none;
    }


    .ai-shop-by-style-item-{{ ai_gen_id }}:hover
    .ai-shop-by-style-image-{{ ai_gen_id }} {

      transform: none;
    }


    .ai-shop-by-style-item-{{ ai_gen_id }}:hover
    .ai-shop-by-style-overlay-{{ ai_gen_id }} {

      background:
        linear-gradient(
          to top,
          rgba(0, 0, 0, 0.72),
          transparent
        );
    }

  }


  /* =========================================================
     SMALL MOBILE
     400px AND BELOW
  ========================================================= */

  @media screen and (max-width: 399px) {

    .ai-shop-by-style-{{ ai_gen_id }} {
      padding: 32px 0;
    }


    .ai-shop-by-style-container-{{ ai_gen_id }} {
      padding-left: 10px;
      padding-right: 10px;
    }


    .ai-shop-by-style-header-{{ ai_gen_id }} {
      margin-bottom: 20px;

      padding-left: 2px;
      padding-right: 2px;
    }


    .ai-shop-by-style-heading-{{ ai_gen_id }} {

      font-size:
        {{ block.settings.heading_size | times: 0.65 }}px;

      line-height: 1.2;
    }


    .ai-shop-by-style-subheading-{{ ai_gen_id }} {

      font-size:
        {{ block.settings.subheading_size | times: 0.82 }}px;

      line-height: 1.4;
    }


    .ai-shop-by-style-grid-{{ ai_gen_id }} {

      gap: 10px;
    }


    .ai-shop-by-style-item-{{ ai_gen_id }} {

      flex:
        0 0 calc(
          50% - 5px
        );

      width:
        calc(
          50% - 5px
        );

      min-width:
        calc(
          50% - 5px
        );

      max-width:
        calc(
          50% - 5px
        );
    }


    .ai-shop-by-style-image-wrapper-{{ ai_gen_id }} {

      padding-bottom: 128%;
    }


    .ai-shop-by-style-overlay-{{ ai_gen_id }} {

      padding:
        30px 6px 8px;
    }


    .ai-shop-by-style-title-{{ ai_gen_id }} {

      font-size: 12px;
    }

  }

{% endstyle %}


<div
  class="ai-shop-by-style-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>

  <div class="ai-shop-by-style-container-{{ ai_gen_id }}">

    {% if block.settings.heading != blank or block.settings.subheading != blank %}

      <div class="ai-shop-by-style-header-{{ ai_gen_id }}">

        {% if block.settings.heading != blank %}

          <h2 class="ai-shop-by-style-heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>

        {% endif %}


        {% if block.settings.subheading != blank %}

          <p class="ai-shop-by-style-subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </p>

        {% endif %}

      </div>

    {% endif %}


    <div class="ai-shop-by-style-grid-{{ ai_gen_id }}">

      {% for i in (1..6) %}

        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}


        {% if collection != blank %}

          <div class="ai-shop-by-style-item-{{ ai_gen_id }}">

            <a
              href="{{ collection.url }}"
              class="ai-shop-by-style-link-{{ ai_gen_id }}"
            >

              <div class="ai-shop-by-style-image-wrapper-{{ ai_gen_id }}">

                {% if collection.image %}

                  <img
                    src="{{ collection.image | image_url: width: 700 }}"
                    alt="{{ collection.title | escape }}"
                    class="ai-shop-by-style-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="700"
                    height="840"
                  >

                {% elsif collection.products.first and collection.products.first.featured_image %}

                  <img
                    src="{{ collection.products.first.featured_image | image_url: width: 700 }}"
                    alt="{{ collection.title | escape }}"
                    class="ai-shop-by-style-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="700"
                    height="840"
                  >

                {% else %}

                  <div
                    class="ai-shop-by-style-placeholder-{{ ai_gen_id }}"
                  >
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>

                {% endif %}


                <div
                  class="ai-shop-by-style-overlay-{{ ai_gen_id }}"
                >

                  <h3
                    class="ai-shop-by-style-title-{{ ai_gen_id }}"
                  >
                    {{ collection.title }}
                  </h3>

                </div>

              </div>

            </a>

          </div>

        {% endif %}

      {% endfor %}

    </div>

  </div>

</div>

{% schema %}
{
  "name": "Shop by style",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Style"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover your perfect jewelry style"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Collection 4"
    },
    {
      "type": "collection",
      "id": "collection_5",
      "label": "Collection 5"
    },
    {
      "type": "collection",
      "id": "collection_6",
      "label": "Collection 6"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_border_radius",
      "label": "Item border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "collection_title_size",
      "label": "Collection title size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "item_background",
      "label": "Item background",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "Overlay text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Shop by style"
    }
  ]
}
{% endschema %}
