<!doctype html>
<html class="no-js " lang="{{ shop.locale }}">
  <style>
      .product__description h2,
    .rte h2,
    .product-single__description h2 {
        font-size: 28px !important;
        line-height: 1.3 !important;
        font-weight: 600 !important;
    }
  </style>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="p:domain_verify" content="7080fbb2934f14c7ea77ef2eb765914a" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

    <meta name="viewport" content="width=device-width,initial-scale=1, maximum-scale=1">
    <meta name="theme-color" content="{{ settings.color_header_bg }}">
    <meta name="format-detection" content="telephone=no">
    <meta name="google-site-verification" content="dcCTVYQuZChxB5ujJs_7SikK6ZL4-MadMleMi3dhHu0">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="dns-prefetch" href="https://{{shop.domain }}" crossorigin>
    <link rel="dns-prefetch" href="https://{{shop.permanent_domain }}" crossorigin>

    <link rel="dns-prefetch" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="preconnect" href="https//fonts.shopifycdn.com/" crossorigin>
    <link rel="preconnect" href="https//cdn.shopify.com" crossorigin>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- unless settings.font_family.system? -%}
      <link rel="preload" as="font" href="{{ settings.font_family | font_url }}" type="font/woff2" crossorigin>
      <link rel="preload" as="font" href="{{ settings.font_family | font_url: 'woff' }}" type="font/woff" crossorigin>
    {%- endunless -%}
    {%- if settings.font_family2.system? == false and settings.font_family2 != settings.font_family -%}
      <link rel="preload" as="font" href="{{ settings.font_family2 | font_url }}" type="font/woff2" crossorigin>
      <link rel="preload" as="font" href="{{ settings.font_family2 | font_url: 'woff' }}" type="font/woff" crossorigin>
    {%- endif -%}
    {%- if settings.favicon != blank -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
    {%- endif -%}

    <title>
      {{ page_title }}
      | Lumera Fine Jewellery
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link
      rel="icon"
      type="image/png"
      href="https://cdn.shopify.com/s/files/1/0790/0876/0059/files/Lumea_Fine_jewellery_-_Copy.png?v=1779184355"
    >

    <!--
      =========================================
      LUMERA FINE JEWELLERY - SCHEMA MARKUP
      =========================================
    -->

    {%- comment -%}
      ORGANIZATION + WEBSITE SCHEMA
    {%- endcomment -%}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "{{ shop.url }}/#organization",
            "name": "Lumera Fine Jewellery",
            "url": "{{ shop.url }}",
            "logo": {
              "@type": "ImageObject",
              "url": "https://cdn.shopify.com/s/files/1/0790/0876/0059/files/Lumea_Fine_jewellery_-_Copy.png?v=1779184355"
            },
            "sameAs": ["https://www.instagram.com/lumerafinejewellery", "https://www.facebook.com/lumerafinejewellery"]
          },
          {
            "@type": "WebSite",
            "@id": "{{ shop.url }}/#website",
            "url": "{{ shop.url }}",
            "name": "Lumera Fine Jewellery",
            "publisher": {
              "@id": "{{ shop.url }}/#organization"
            }
          }
        ]
      }
    </script>

    {%- comment -%}
      PRODUCT SCHEMA
    {%- endcomment -%}

    {% if request.page_type == 'product' and product != blank %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Product",
          "@id": "{{ shop.url }}{{ product.url }}#product",
          "name": {{ product.title | json }},
          "url": "{{ shop.url }}{{ product.url }}",
          "description": {{ product.description | strip_html | strip_newlines | escape | json }},
          "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
          "brand": {
            "@type": "Brand",
            "name": "Lumera Fine Jewellery"
          },
          {% if product.featured_image %}
          "image": [
            "{{ product.featured_image | image_url: width: 1600 | prepend: 'https:' }}"
          ],
          {% endif %}
          "offers": {
            "@type": "Offer",
            "url": "{{ shop.url }}{{ product.url }}",
            "priceCurrency": "{{ cart.currency.iso_code }}",
            "price": "{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}",
            "availability": "https://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition",
            "seller": {
              "@type": "Organization",
              "name": "Lumera Fine Jewellery",
              "url": "{{ shop.url }}"
            }
          }
        }
      </script>
    {% endif %}

    {%- comment -%}
      COLLECTION PAGE SCHEMA
    {%- endcomment -%}

    {% if request.page_type == 'collection' and collection != blank %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "CollectionPage",
          "@id": "{{ shop.url }}{{ collection.url }}#collection",
          "name": {{ collection.title | json }},
          "url": "{{ shop.url }}{{ collection.url }}",
          "description": {{ collection.description | strip_html | strip_newlines | escape | json }},
          "isPartOf": {
            "@id": "{{ shop.url }}/#website"
          }
        }
      </script>
    {% endif %}

    {%- comment -%}
      BLOG ARTICLE SCHEMA
    {%- endcomment -%}

    {% if request.page_type == 'article' and article != blank %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Article",
          "@id": "{{ shop.url }}{{ article.url }}#article",
          "headline": {{ article.title | json }},
          "url": "{{ shop.url }}{{ article.url }}",
          "description": {{ article.excerpt_or_content | strip_html | strip_newlines | truncate: 300 | escape | json }},
          {% if article.image %}
          "image": [
            "{{ article.image | image_url: width: 1600 | prepend: 'https:' }}"
          ],
          {% endif %}
          "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
          "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
          "author": {
            "@type": "Person",
            "name": {{ article.author | json }}
          },
          "publisher": {
            "@id": "{{ shop.url }}/#organization"
          },
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "{{ shop.url }}{{ article.url }}"
          }
        }
      </script>
    {% endif %}

    {%- comment -%}
      GENERAL WEBPAGE SCHEMA
    {%- endcomment -%}

    {% if request.page_type == 'page' %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebPage",
          "@id": "{{ canonical_url }}#webpage",
          "url": "{{ canonical_url }}",
          "name": {{ page_title | json }},
          {% if page_description %}
          "description": {{ page_description | escape | json }},
          {% endif %}
          "isPartOf": {
            "@id": "{{ shop.url }}/#website"
          }
        }
      </script>
    {% endif %}

    {%- comment -%}
      BREADCRUMB SCHEMA
    {%- endcomment -%}

    {% unless request.page_type == 'index' %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "@id": "{{ canonical_url }}#breadcrumb",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "{{ shop.url }}"
            }
            {% if request.page_type == 'product' and product != blank %}
            ,
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | json }},
              "item": "{{ shop.url }}{{ product.url }}"
            }
            {% elsif request.page_type == 'collection' and collection != blank %}
            ,
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": "{{ shop.url }}{{ collection.url }}"
            }
            {% elsif request.page_type == 'article' and article != blank %}
            ,
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ article.title | json }},
              "item": "{{ shop.url }}{{ article.url }}"
            }
            {% elsif request.page_type == 'page' %}
            ,
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ page_title | json }},
              "item": "{{ canonical_url }}"
            }
            {% endif %}
          ]
        }
      </script>
    {% endunless %}

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="{{ settings.meta_description | escape }}">
    {%- endif -%}

    {%- render 'social-meta-tags' -%}
    {%- render 'header-css' -%}
    <link rel="preload" href="{{ 'lazysizes.min.js' | asset_url }}" as="script">
    <link rel="preload" href="{{ 'vendor.js' | asset_url }}" as="script">
    <link rel="preload" href="{{ 'swiper-bundle.min.js' | asset_url }}" as="script">
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
    <style>
      html, body { overflow-x: clip; }
      background-color: #fef8f1 !important;
    </style>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8QK6LMGVD5"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-8QK6LMGVD5');
    </script>
    <style>
            @media (max-width: 991px) {
        .slide_img_right {
          display: none !important;
        }

        .img_mobile {
          display: block !important;
        }
      }

      @media (min-width: 992px) {
        .img_mobile {
          display: none !important;
        }

        .slide_img_right {
          display: block !important;
        }
      }
    </style>
    <script>
      window.complimentaryGiftSettings = {
        enabled: {{ settings.enable_complimentary_gift | json }},

        variantId: {% if settings.complimentary_gift_product != blank %}
          {{ settings.complimentary_gift_product.selected_or_first_available_variant.id }}
        {% else %}
          null
        {% endif %},

        threshold: {{ settings.complimentary_gift_amount | times: 100 }},

        title: {% if settings.complimentary_gift_product != blank %}
          {{ settings.complimentary_gift_product.title | json }}
        {% else %}
          ""
        {% endif %},

        image: {% if settings.complimentary_gift_product != blank and settings.complimentary_gift_product.featured_image != blank %}
          {{ settings.complimentary_gift_product.featured_image | image_url: width: 300 | json }}
        {% else %}
          ""
        {% endif %},

        price: {% if settings.complimentary_gift_product != blank %}
          {{ settings.complimentary_gift_product.price | json }}
        {% else %}
          0
        {% endif %},

        progressText: {{ settings.gift_progress_text | json }},
        successText: {{ settings.gift_success_text | json }}
      };
    </script>
    <style>
      /* =========================================
         COMPLIMENTARY GIFT
      ========================================= */

      .complimentary-gift-mini {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #e5e5e5;
      }

