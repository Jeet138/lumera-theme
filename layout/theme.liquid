        background: #003b70;
        transition: width .3s ease;
      }

      .complimentary-gift-mini__text {
        text-align: center;
        font-size: 15px;
        line-height: 1.5;
        margin-bottom: 18px;
        color: #003b70;
      }

      .complimentary-gift-mini__product {
        display: none;
        align-items: center;
        gap: 12px;
        padding-top: 2px;
      }

      .complimentary-gift-mini__image {
        width: 105px;
        min-width: 105px;
      }

      .complimentary-gift-mini__image img {
        width: 100%;
        height: 100px;
        object-fit: cover;
        display: block;
      }

      .complimentary-gift-mini__details {
        flex: 1;
      }

      .complimentary-gift-mini__title {
        font-size: 14px;
        font-weight: 600;
        line-height: 1.35;
        margin-bottom: 8px;
      }

      .complimentary-gift-mini__price {
        margin-bottom: 12px;
        font-size: 14px;
      }

      .complimentary-gift-mini__free {
        font-weight: 600;
        margin-right: 7px;
      }

      .complimentary-gift-mini__button {
        background: #003b70;
        color: #fff;
