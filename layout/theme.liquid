      @media (max-width: 767px) {

        .complimentary-gift-mini__product {
          gap: 10px;
        }

        .complimentary-gift-mini__image {
          width: 90px;
          min-width: 90px;
        }

        .complimentary-gift-mini__image img {
          height: 90px;
        }

        .complimentary-gift-mini__title {
          font-size: 13px;
        }

        .complimentary-gift-mini__button {
          padding: 9px 14px;
        }

      }
    </style>
    {{ content_for_header }}
  </head>

  <body class="template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }} body-theme {% if settings.productpage == 'product-2' or settings.productpage == 'product-6' or settings.productpage == 'product-7' %} product-hide-breadcrumb {% endif %}">
    {%- render 'site-loader' -%}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    {%- render 'loading' -%}
    {%- sections 'header-group' -%}
    <div class="page-container page-element is-moved-by-drawer">
      {%- render 'breadcrumb' -%}
      <main class="main-content" id="MainContent" role="main">
        {%- if settings.enable_animationscroll -%}
          <div id="js-scroll">
        {% endif %}
        {%- if settings.enable_animationscroll -%}
          <div data-scroll-section>
        {% endif %}
        {%- render 'slideshow' -%}
        {%- if settings.enable_animationscroll -%}
          </div>
        {% endif %}
        {{ content_for_layout }}
        {%- if settings.enable_animationscroll -%}
          </div>
        {% endif %}
      </main>
      {%- sections 'footer-group' -%}
      {%- liquid
        section 'pnewsletter'
        section 'product-suggest'
        section 'cookie-policy'
        section 'custom-color'
      -%}
    </div>
    {%- liquid
      render 'back-to-top'
      render 'whatsapp'
      render 'bottom-contents'
      render 'quickview'
      render 'popup-compare'
      render 'header-js'
    -%}

  </body>

  <style>
    /* =========================================================
       PRODUCT GRID
       DESKTOP
       FILTER OPEN  = 3 COLUMNS
       FILTER CLOSED = 4 COLUMNS
       ========================================================= */

    @media screen and (min-width: 992px) {

      #ProductGridContainer,
      #ProductGridContainer .product-grid,
      #ProductGridContainer .product-grid > li,
      #ProductGridContainer .product-grid > .grid__item {
        transition: none !important;
        animation: none !important;
      }

      /* FILTER OPEN = 3 */
      #ProductGridContainer.filter-products-3 .product-grid > li,
      #ProductGridContainer.filter-products-3 .product-grid > .grid__item {
        width: 33.333333% !important;
        max-width: 33.333333% !important;
        flex: 0 0 33.333333% !important;
      }

      /* FILTER CLOSED = 4 */
      #ProductGridContainer.filter-products-4 .product-grid > li,
      #ProductGridContainer.filter-products-4 .product-grid > .grid__item {
        width: 25% !important;
        max-width: 25% !important;
        flex: 0 0 25% !important;
      }

      #ProductGridContainer .product-grid > li img,
      #ProductGridContainer .product-grid > .grid__item img {
        width: 100% !important;
        height: auto !important;
        aspect-ratio: 1 / 1 !important;
        object-fit: cover !important;
        display: block !important;
        max-width: 100% !important;
      }
    }

    @media screen and (max-width: 991px) {
      #ProductGridContainer .product-grid > li,
      #ProductGridContainer .product-grid > .grid__item {
        width: 50% !important;
        max-width: 50% !important;
        flex: 0 0 50% !important;
        box-sizing: border-box !important;
      }
    }

    /* =========================================================
       FILTER SIDEBAR TOGGLE BAR
       Lives OUTSIDE the sidebar/grid flex row entirely, so it can
       never overlap or fight for width with either of them.
       ========================================================= */

    @media screen and (min-width: 992px) {
      #filter-toggle-bar {
        display: flex !important;
        align-items: center;
        gap: 8px;
        width: fit-content;
        box-sizing: border-box;
        background: #fef8f1;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 8px 16px;
        margin: 0 0 18px 0;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: .5px;
        color: #062f57;
        cursor: pointer;
        position: static !important;
        z-index: 1;
      }

      #filter-toggle-bar #filter-toggle-icon {
        font-size: 16px;
        line-height: 1;
      }

      /* When the sidebar is closed it is fully removed from the
         row via display:none, so the grid can safely take 100%
         width with zero risk of overlap/overflow. */
      #main-collection-filters.is-closed {
        display: none !important;
      }
    }

    @media screen and (max-width: 991px) {
      #filter-toggle-bar {
        display: none !important;
      }
    }
    /* =========================================================
       FORCE CONSISTENT SQUARE PRODUCT IMAGES
       (theme's own component-card.css uses a fixed pixel height
       on the media wrapper, so the image looks portrait on
       narrower screens and landscape on wider screens. This
       forces a true 1:1 ratio at every breakpoint instead.)
       ========================================================= */

    #ProductGridContainer .product-grid > li .media,
    #ProductGridContainer .product-grid > li .card__media,
    #ProductGridContainer .product-grid > li .card__inner .media,
    #ProductGridContainer .product-grid > .grid__item .media,
    #ProductGridContainer .product-grid > .grid__item .card__media,
    #ProductGridContainer .product-grid > .grid__item .card__inner .media {
      position: relative !important;
      height: 0 !important;
      padding-top: 100% !important;
      overflow: hidden !important;
    }

    #ProductGridContainer .product-grid > li .media img,
    #ProductGridContainer .product-grid > li .card__media img,
    #ProductGridContainer .product-grid > .grid__item .media img,
    #ProductGridContainer .product-grid > .grid__item .card__media img {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: none !important;
      object-fit: cover !important;
      display: block !important;
    }
  </style>

  <script>
    (function () {
      'use strict';

      function initFilterToggle() {
        var aside = document.getElementById('main-collection-filters');
        var productGrid = document.getElementById('ProductGridContainer');

        if (!aside || !productGrid) {
          return;
        }

        if (document.getElementById('filter-toggle-bar')) {
          return;
        }

        var bar = document.createElement('div');
        bar.id = 'filter-toggle-bar';
        bar.setAttribute('role', 'button');
        bar.setAttribute('aria-label', 'Toggle filter');
        bar.innerHTML = '<span id="filter-toggle-icon">&#171;</span><span>Filter By</span>';

        /* Insert the bar as a full-width block right before the
           row that contains the sidebar + product grid, so it
           never becomes a flex child of that row. */
        var row = aside.closest('.facets-vertical') || aside.parentNode;
        row.parentNode.insertBefore(bar, row);

        var facetsContent = aside.querySelector('.facets-container');

        function isMobile() {
          return window.innerWidth <= 991;
        }

        function getProductItems() {
          var selectors = [
            '#ProductGridContainer .product-grid > li',
            '#ProductGridContainer .product-grid > .grid__item',
            '#ProductGridContainer .product-grid .grid__item',
            '#ProductGridContainer .collection-product-card',
          ];

          for (var i = 0; i < selectors.length; i++) {
            var items = productGrid.querySelectorAll(selectors[i]);
            if (items.length) {
              return Array.prototype.slice.call(items);
            }
          }
          return [];
        }

        function setProductColumns(columns) {
          if (!getProductItems().length) {
            return;
          }

          if (isMobile()) {
            columns = 2;
          }

          productGrid.classList.remove('filter-products-2', 'filter-products-3', 'filter-products-4');

          if (columns === 2) {
            productGrid.classList.add('filter-products-2');
          } else if (columns === 3) {
            productGrid.classList.add('filter-products-3');
          } else {
            productGrid.classList.add('filter-products-4');
          }
        }

        var isOpen = false;

        function setGrid(open) {
          if (isMobile()) {
            aside.classList.remove('is-closed');
            productGrid.classList.remove('col-md-9', 'col-md-12', 'pl-lg-5');
            productGrid.classList.add('col-12');
            if (facetsContent) {
              facetsContent.style.removeProperty('display');
            }
            setProductColumns(2);
            return;
          }

          if (open) {
            aside.classList.remove('is-closed');
            productGrid.classList.remove('col-md-12');
            productGrid.classList.add('col-md-9', 'pl-lg-5');

            if (facetsContent) {
              facetsContent.style.removeProperty('display');
            }

            document.getElementById('filter-toggle-icon').innerHTML = '&#171;';
            setProductColumns(3);
          } else {
            aside.classList.add('is-closed');
            productGrid.classList.remove('col-md-9', 'pl-lg-5');
            productGrid.classList.add('col-md-12');

            document.getElementById('filter-toggle-icon').innerHTML = '&#187;';
            setProductColumns(4);
          }
        }

        bar.addEventListener('click', function () {
          if (isMobile()) {
            return;
          }
          isOpen = !isOpen;
          setGrid(isOpen);
        });

        setGrid(isOpen);

        var resizeTimer;
        window.addEventListener('resize', function () {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(function () {
            setGrid(isOpen);
          }, 150);
        });

        var observer = new MutationObserver(function () {
          clearTimeout(window.__productGridResizeTimer);
          window.__productGridResizeTimer = setTimeout(function () {
            setProductColumns(isMobile() ? 2 : isOpen ? 3 : 4);
          }, 150);
        });

        observer.observe(productGrid, {
          childList: true,
          subtree: true,
        });
      }

      function boot() {
        initFilterToggle();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }

      document.addEventListener('shopify:section:load', function () {
        setTimeout(function () {
          initFilterToggle();
        }, 100);
      });
    })();
  </script>
</html>
