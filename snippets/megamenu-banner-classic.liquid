  {%- liquid
    assign link_column = ''
    assign menu_column = block.settings.menu_column
    assign menu_banner_width = block.settings.menu_banner_width
    assign menu_width = block.settings.menu_width
    assign enable_menu_banner = block.settings.enable_menu_banner

    case menu_column
      when 1
        assign link_column = 'col-sm-12'
      when 2
        assign link_column = 'col-sm-6'
      when 3
        assign link_column = 'col-sm-4'
      when 4
        assign link_column = 'col-sm-3'
      when 5
        assign link_column = 'col-1-5'
      when 6
        assign link_column = 'col-sm-2'
      else
        assign link_column = 'col-sm-2'
    endcase
  -%}
  <div class="{{ menu_width }}">
    <div class="row">
      {%- if link.links != blank -%}
        <div class="mega-col mega-link {% if enable_menu_banner == false %} col-12 {% else %} col {% endif %}">
          <div class="row">
            {%- if link.links != blank -%}
              {%- for childlink in link.links -%}
                <div class="{{ link_column }} d-col-link">
                  {% comment %}
                    <div class="mega-col-inner ">
                      <div class="menu-title">
                        <a href="{{ childlink.url }}" >
                          {%- render 'processMenuTitle' , itemName: childlink.title -%}
                          {%- render 'processMenuLabel' , itemName: childlink.title -%}
                        </a>
                      </div>
                      <div class="widget-inner">
                        <ul class="nav-links">
                          {%- if childlink.links != blank -%}
                          {%- for grandchildlink in childlink.links -%}
                          <li>
                            <a href="{{ grandchildlink.url }}" >
                              {%- render 'processMenuTitle' , itemName: grandchildlink.title -%}
                              {%- render 'processMenuLabel' , itemName: grandchildlink.title -%}
                            </a>
                          </li>
                          {%- endfor -%}
                          {%- endif -%}
                        </ul>
                      </div>
                    </div>
                  {% endcomment %}
                  <div class="mega-col-inner">
                    <div class="menu-title">
                      <a href="{{ childlink.url }}">
                        {%- assign link_object = childlink.object -%}
                        {%- assign link_type = childlink.type -%}
                        {%- assign link_title = childlink.title -%}
                        {% case link_type %}
                        {% when 'collection_link' %}
                          {% assign collection = link_object %}
                          <span
                            class="menu-icon-image"
                            {% if collection.metafields.custom.menu_icon != blank %}
                              style="background-image: url('{{ collection.metafields.custom.menu_icon | img_url: 'master' }}');"
                            {% elsif collection.products_count > 0 %}
                              {% assign first_product = collection.products.first %}
                              {% if first_product.featured_image %}
                                style="background-image: url('{{ first_product.featured_image | img_url: 'master' }}');"
                              {% endif %}
                            {% endif %}
                            role="img"
                            aria-label="{{ link_title }}"
                          ></span>

                        {% when 'page_link' %}
                          <span
                            class="menu-icon-image"
                            {% if link_object.image %}
                              style="background-image: url('{{ link_object.image | img_url: 'master' }}');"
                            {% endif %}
                            role="img"
                            aria-label="{{ link_title }}"
                          ></span>

                        {% when 'blog_link' %}
                          <span
                            class="menu-icon-image"
                            {% if link_object.image %}
                              style="background-image: url('{{ link_object.image | img_url: 'master' }}');"
                            {% endif %}
                            role="img"
                            aria-label="{{ link_title }}"
                          ></span>
                      {% endcase %}

                        {%- render 'processMenuTitle', itemName: childlink.title -%}
                        {%- render 'processMenuLabel', itemName: childlink.title -%}
                      </a>
                    </div>
                    <div class="widget-inner">
                      <ul class="nav-links">
                        {%- if childlink.links != blank -%}
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a href="{{ grandchildlink.url }}">
                                {%- assign link_object = grandchildlink.object -%}
                                {%- assign link_type = grandchildlink.type -%}
                                {%- assign link_title = grandchildlink.title -%}
                              {% case link_type %}
                                {% when 'collection_link' %}
                                  {% assign collection = link_object %}
                                  <span
                                    class="menu-icon-image"
                                    {% if collection.metafields.custom.menu_icon != blank %}
                                      style="background-image: url('{{ collection.metafields.custom.menu_icon | img_url: 'master' }}');"
                                    {% elsif collection.products_count > 0 %}
                                      {% assign first_product = collection.products.first %}
                                      {% if first_product.featured_image %}
                                        style="background-image: url('{{ first_product.featured_image | img_url: 'master' }}');"
                                      {% endif %}
                                    {% endif %}
                                    role="img"
                                    aria-label="{{ link_title }}"
                                  ></span>

                                {% when 'page_link' %}
                                  <span
                                    class="menu-icon-image"
                                    {% if link_object.image %}
                                      style="background-image: url('{{ link_object.image | img_url: 'master' }}');"
                                    {% endif %}
                                    role="img"
                                    aria-label="{{ link_title }}"
                                  ></span>

                                {% when 'blog_link' %}
                                  <span
                                    class="menu-icon-image"
                                    {% if link_object.image %}
                                      style="background-image: url('{{ link_object.image | img_url: 'master' }}');"
                                    {% endif %}
                                    role="img"
                                    aria-label="{{ link_title }}"
                                  ></span>
                              {% endcase %}

                                {%- render 'processMenuTitle', itemName: grandchildlink.title -%}
                                {%- render 'processMenuLabel', itemName: grandchildlink.title -%}
                              </a>
                            </li>
                          {%- endfor -%}
                        {%- endif -%}
                      </ul>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

      {%- endif -%}

      {% if block.settings.enable_menu_banner %}
        <div class="mega-col col" style="max-width:{{ menu_banner_width }}%;flex:0 0 {{ menu_banner_width }}%;">
          <div class="row">
            {% for i in (1..6) %}
              {%- liquid
                assign menu_banner_image_var = 'menu_banner_image_' | append: i
                assign menu_banner_html_var = 'menu_banner_html_' | append: i
                assign menu_banner_btn_var = 'menu_banner_btn_' | append: i
                assign menu_banner_link_var = 'menu_banner_link_' | append: i

                assign menu_banner_image = block.settings[menu_banner_image_var]
                assign menu_banner_html = block.settings[menu_banner_html_var]
                assign menu_banner_btn = block.settings[menu_banner_btn_var]
                assign menu_banner_link = block.settings[menu_banner_link_var]
              -%}
              {%- if menu_banner_image != blank -%}
                <div class="promotionclassic_menu col mb-2 mt-3 d-col-link">
                  <div class="image-content__image-container overflow-hidden">
                    <a
                      href="{{ menu_banner_link }}"
                      class="image-content__image-wrapper promotionclassic__image {{ block.settings.image_size }}"
                      style="padding-top:{{ 1 | divided_by: menu_banner_image.aspect_ratio | times: 100 }}%;"
                    >
                      {% assign img_url = menu_banner_image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                      <img
                        class="image-content__image lazyload "
                        src="{{ menu_banner_image | image_url: width: 1, height: 1 }}"
                        data-src="{{ img_url }}"
                        data-widths="[180, 360, 540, 720, 900, 1080]"
                        data-aspectratio="{{ menu_banner_image.aspect_ratio }}"
                        data-sizes="auto"
                        alt="{{ menu_banner_image.alt | escape }}"
                        loading="lazy"
                        width="{{ menu_banner_image.width }}"
                        height="{{ menu_banner_image.height }}"
                      >
                    </a>
                    <div class="promotionclassic_menu--content ">
                      <div class="promotionclassic_menu--txt">
                        {%- if menu_banner_html != blank -%}
                          <div class="my-3">{{ menu_banner_html }}</div>
                        {%- endif -%}
                        {%- if menu_banner_btn != blank -%}
                          <a class="btn btn-underline mb-1" href="{{ menu_banner_link }}"> {{ menu_banner_btn }}</a>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
    
  </div>
 {% style %}

.menu-title a,
.nav-links li a{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:10px 14px;
    border-radius:10px;
    transition:.25s;
    text-decoration:none;
    color:#222;
}

.menu-title a:hover,
.nav-links li a:hover{
    background:#f7f7f7;
}

.menu-icon-image{
    width:34px;
    height:34px;
    min-width:34px;
    border-radius:8px;
    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;
    display:inline-block;
}

.mega-arrow{
    margin-left:auto;
    opacity:.4;
    transition:.25s;
    font-size:18px;
}

.menu-title a:hover .mega-arrow,
.nav-links li a:hover .mega-arrow{
    transform:translateX(4px);
    opacity:1;
}

.widget-inner ul{
    padding:0;
    margin:8px 0 0;
}

.widget-inner li{
    list-style:none;
    margin-bottom:4px;
}

.mega-col-inner{
    background:#fff;
    border-radius:12px;
    padding:10px;
}

{% endstyle %}
