      class="product-card js-product-card product-card--style1 product-card--style6 product-card--style11 info-{{ enable_bg_info }}"
      data-price="{{ product.price }}"
    >
      <div class="product-card__image-wr overflow-hidden">
        <a
          class="product-card__image js image-content__image-wrapper {{ settings.size_image_grid }}{% if is_locked %} premium-product-locked{% endif %}"
          href="{{ locked_url }}"
          style="padding-top:{{ 1 | divided_by: image.aspect_ratio | times: 100 }}%;"
          data-image-id="{{ image.id }}"
          {% if is_locked %}
            data-premium-locked="true"
            data-product-url="{{ locked_url }}"
          {% endif %}
        >
          <img
            srcset="
              {%- if image.width >= 165 -%}{{ image | image_url: width: 165 }} 165w,{%- endif -%}
              {%- if image.width >= 360 -%}{{ image | image_url: width: 360 }} 360w,{%- endif -%}
              {%- if image.width >= 533 -%}{{ image | image_url: width: 533 }} 533w,{%- endif -%}
              {%- if image.width >= 720 -%}{{ image | image_url: width: 720 }} 720w,{%- endif -%}
              {%- if image.width >= 940 -%}{{ image | image_url: width: 940 }} 940w,{%- endif -%}
              {%- if image.width >= 1066 -%}{{ image | image_url: width: 1066 }} 1066w,{%- endif -%}
              {{ image | image_url }} {{ image.width }}w
            "
            src="{{ image | image_url: width: 720 }}"
            sizes="(min-width: {{ settings.container }}px) {{ settings.container | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
            alt="{{ image.alt | escape }}"
            class="lazyload scale-in first-image {% if product.images.size > 1 %} hover__hide-image {% endif %}"
            data-sizes="auto"
            data-aspectratio="{{ image.aspect_ratio }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
          {{ lock_overlay }}
        </a>

        {%- liquid
          if settings.enable_countdown_card
            render 'product-countdown', product: product
          endif
          render 'product-label', product: product, showlabel: true
        -%}
      </div>
      <div class="product-card__overlay d-flex justify-content-center flex-row">
        {%- if settings.enable_wishlsit -%}
          <span
            data-toggle="tooltip"
            data-placement="top"
            data-tooltipalltimes="true"
            class="btn btn-theme gradient-theme-vertical product-card__overlay-btn js-btn-wishlist"
            title="{{ 'products.product.wishlist_text' | t }}"
            data-handle="{{ product.handle }}"
          >
            {%- render 'icon-heart' -%}
          </span>
        {%- endif -%}

        {%- if settings.qv_box -%}
          <span
            data-tooltip="true"
            data-placement="top"
            class="btn btn-theme gradient-theme-vertical product-card__overlay-btn js-btn-quickview"
            title="{{ 'products.product.quickview_text' | t }}"
            data-toggle="modal"
            data-target="#jsQuickview"
            data-handle="{{ product.handle }}"
            data-pavailable="{% if product.available %}true{% else %}false{% endif %}"
            {% if settings.enable_review %}
              data-viewjdmg="<span class='jdgm-preview-badge' data-id='{{ product.id }}'>{{ product.metafields.judgeme.badge }}</span>"
            {% endif %}
          >
            {%- render 'icon-view' -%}
            <span>{{ 'products.product.quickview_text' | t }}</span>
            {%- if product.metafields.info.shortdesc != blank -%}
              <span class=" txt-short hide">
                {{ product.metafields.info.shortdesc | strip_html | truncatewords: 12 }}
              </span>
            {%- else -%}
              <span class=" txt-short hide">
                {{ product.description | strip_html | truncatewords: 12 }}
              </span>
            {%- endif -%}
          </span>
        {%- endif -%}
        {%- if settings.enable_compare -%}
          <span
            data-tooltip="true"
            data-placement="top"
            class="btn btn-theme gradient-theme-vertical product-card__overlay-btn js-btn-compare"
            title="{{ 'products.product.compare_text' | t }}"
            data-handle="{{ product.handle }}"
          >
            {%- render 'icon-exchange' -%}
            {%- render 'icon-close-solid' -%}
            <span>{{ 'products.product.compare_text' | t }}</span>
          </span>
        {%- endif -%}
        <span
          data-tooltip="true"
          data-placement="top"
          class="btn btn-theme gradient-theme-vertical product-card__overlay-btn js-grid-cart"
          title="{{ 'products.product.add_to_cart' | t }}"
          data-id="{{ product.selected_or_first_available_variant.id }}"
        >
          {%- render 'icon-cart' -%}
          <div class="product-card__loading spinner-{{ settings.loading }}" role="status"></div>
          <span>{{ 'products.product.add_to_cart' | t }}</span>
        </span>
      </div>
      <a
        href="{{ locked_url }}"
        class="link-second__image"
        {% if is_locked %}
          data-premium-locked="true"
          data-product-url="{{ locked_url }}"
        {% endif %}
      >
        {% render 'second-image', product: product %}
      </a>
      <div class="product-card__info">
        {{ vendor }}
        {{ product_title_link }}
        {{ review }}
        {{ price }}
        {%- render 'swatch-grid-1', product: product -%}
      </div>
    </div>
  {%- when 'product-12' -%}
