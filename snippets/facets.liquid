                <div class="modal-header">
                  <button type="button" class="close btn btn-facet-colose">{%- render 'icon-close' -%}</button>
                </div>
              </div>
              <div class="mobile-facets__main has-submenu gradient">
                {%- if enable_filtering -%}
                  {%- for filter in results.filters -%}
