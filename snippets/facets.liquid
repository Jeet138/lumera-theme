{% comment %}
  Renders facets (filtering and sorting)

  Accepts:
  - results: {Object} Collection or Search object
  - enable_filtering: {Boolean} Show filtering when true
  - enable_sorting: {Boolean} Show sorting when true
  - filter_type: {String} Type of filter

  Usage:
  {% render 'facets', results: collection, enable_filtering: true, enable_sorting: true, filter_type: 'vertical' %}
{% endcomment %}

{{ 'component-show-more.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign keywords_1 = settings.contain_color | handleize
  assign keywords_2 = settings.contain_color_2 | handleize
  assign hidden_center_shapes = 'PEAR & EMERALD|PEAR & HEART|PEAR & OVAL|PEAR & OVAL & EMERALD|PEAR & PRINCESS|PRINCESS & CUSHION' | split: '|'
  assign all_center_shapes = 'Round|Oval|Cushion|Pear|Princess|Emerald|Radiant|Marquise|Heart|Asscher|Baguette|Trillion|Half Moon' | split: '|'
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign total_active_values = 0
  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif

  case filter_type
    when 'drawer'
      assign filter_type = 'drawer'
    when 'drawer-slide-left'
      assign filter_type = 'drawer'
    when 'vertical'
      assign filter_type = 'vertical'
    when 'horizontal'
      assign filter_type = 'horizontal'
    when 'drawer-collapse-left'
      assign filter_type = 'vertical'
      assign filter_type_check = true
    when 'drawer-collapse-right'
      assign filter_type = 'vertical'
      assign filter_type_check = true
    else
      assign filter_type = 'vertical'
  endcase
-%}

<div
  class="
    facets-container
    {% if filter_type == 'drawer' %}facets-container-drawer{% endif %}
    {% if filter_type == 'vertical' %}pt-0 js-stick-parent{% endif %}
    {% if filter_type == 'drawer-collapse-right' %}facets-container-collapse-right{% endif %}
  "
  {% if filter_type == 'drawer-collapse-right' %}
    data-collapse-filter="true"
  {% endif %}
>
  {%- if filter_type == 'vertical' or filter_type == 'horizontal' -%}
    <facet-filters-form class="facets small-hide ">
      <form
        id="FacetFiltersForm"
        class="{% if filter_type == 'horizontal' %}facets__form{% else %}facets__form-vertical{% endif %}"
      >
        {%- if results.terms -%}
          <input type="hidden" name="q" value="{{ results.terms | escape }}">
          <input name="options[prefix]" type="hidden" value="last">
        {%- endif -%}

        {% if enable_filtering %}
          {% comment %} Heading is the first tabbable element on filter type horizontal {% endcomment %}
          <div
            id="FacetsWrapperDesktop"
            {% if filter_type == 'horizontal' %}
              class="facets__wrapper"
            {% endif %}
          >
            {%- if filter_type == 'horizontal' and results.filters != empty -%}
              <h2 class="facets__heading caption-large h5" id="verticalTitle" tabindex="-1">
                {{ 'products.facets.filter_by_label' | t }}
              </h2>
            {%- endif -%}
            {% comment %} Pills are right below the title for filter type vertical {% endcomment %}
            {%- if filter_type == 'vertical' -%}
              <div class="active-facets active-facets-desktop">
                <div class="active-facets-vertical-filter ">
                  {% if filter_type_check %}
                    <div class="d-flex align-items-center">
                      {%- unless results.filters == empty -%}
                        {% comment %}
                          <h2
                            class="facets__heading facets__heading--vertical caption-large text-body h5"
                            id="verticalTitle"
                            tabindex="-1"
                          >
                            {{ 'products.facets.filter_by_label' | t }}
                          </h2>
                        {% endcomment %}
                      {%- endunless -%}
                      <facet-remove class="active-facets__button-wrapper">
                        <a href="{{ results_url }}" class="active-facets__button-remove underlined-link">
                          <span>{{ 'products.facets.clear_all' | t }}</span>
                        </a>
                      </facet-remove>
                    </div>
                    <div class="modal-header p-0">
                      <button type="button" class="close btn-close-sidebar-collapse">
                        {%- render 'icon-close' -%}
                      </button>
                    </div>
                  {% else %}
                    {%- unless results.filters == empty -%}
                      {% comment %}
                        <h2
                          class="facets__heading facets__heading--vertical caption-large text-body h5"
                          id="verticalTitle"
                          tabindex="-1"
                        >
                          {{ 'products.facets.filter_by_label' | t }}
                        </h2>
                      {% endcomment %}
                    {%- endunless -%}
                    <facet-remove class="active-facets__button-wrapper">
                      <a href="{{ results_url }}" class="active-facets__button-remove underlined-link">
                        <span>{{ 'products.facets.clear_all' | t }}</span>
                      </a>
                    </facet-remove>
                  {% endif %}
                </div>
                {%- for filter in results.filters -%}
                  {%- for value in filter.active_values -%}
                    <facet-remove>
                      <a href="{{ value.url_to_remove }}" class="active-facets__button active-facets__button--light">
                        <span class="active-facets__button-inner button button--tertiary">
                          {%- comment -%}{{ filter.label }}: {%- endcomment -%}
                          {{ value.label | escape }}
                          {% render 'icon-close-small' %}
                          <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                        </span>
                      </a>
                    </facet-remove>
                  {%- endfor -%}
                  {% if filter.type == 'price_range' %}
                    {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                      <facet-remove>
                        <a href="{{ filter.url_to_remove }}" class="active-facets__button active-facets__button--light">
                          <span class="active-facets__button-inner button button--tertiary">
                            {%- if filter.min_value.value -%}
                              {{ filter.min_value.value | money }}
                            {%- else -%}
                              {{ 0 | money }}
                            {%- endif -%}
                            -
                            {%- if filter.max_value.value -%}
                              {{ filter.max_value.value | money }}
                            {%- else -%}
                              {{ filter.range_max | money }}
                            {%- endif -%}
                            {% render 'icon-close-small' %}
                            <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                          </span>
                        </a>
                      </facet-remove>
                    {%- endif -%}
                  {% endif %}
                {%- endfor -%}
              </div>
            {%- endif -%}

            <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
            {%- if filter_type == 'vertical' -%}
              {%- if linklists[section.settings.link_list_head].title != blank
                and section.settings.enable_list_collection
              -%}
                <details
                  id="Details-collection-{{ section.id }}"
                  class="{% if filter_type == 'horizontal' %}disclosure-has-popup facets__disclosure{% else %}facets__disclosure-vertical{% endif %} js-filter"
                  data-index="{{ collection }}"
                >
                  <summary class="facets__summary caption-large focus-offset">
                    <div>
                      <span>Collection</span>
                      {% render 'icon-caret' %}
                    </div>
                  </summary>
                  <div
                    id="Facet-collection-{{ section.id }}"
                    class="parent-display {% if filter_type == 'horizontal' %}facets__display{% else %}facets__display-vertical{% endif %}"
                  >
                    <div class="facets__collection">
                      <ul class="facets__collection__list list-unstyled">
                        {%- for link in linklists[section.settings.link_list_head].links -%}
                          {% assign collection_handle = link.url | split: 'collections/' | last %}
                          {%- assign current_collection = collections[collection_handle] -%}
                          <li class="site-head__list__list-item ">
                            <a
                              class="{% if link.current %} active {% endif %}"
                              href="{{ link.url }}"
                            >
                              {{ link.title }}
                              <span class="d-inline-block ml-1">({{ current_collection.all_products_count }})</span>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                </details>
              {%- endif -%}
            {%- endif -%}
            {% comment %} Filters for both horizontal and vertical filter {% endcomment %}
            {%- for filter in results.filters -%}
              {%- assign total_active_values = total_active_values | plus: filter.active_values.size -%}
              {% case filter.type %}
                {% when 'boolean', 'list' %}
                <details
                    id="Details-{{ forloop.index }}-{{ section.id }}"
                    class="{% if filter_type == 'horizontal' %}disclosure-has-popup facets__disclosure{% else %} facets__disclosure-vertical{% endif %} js-filter"
                    data-index="{{ forloop.index }}"
                  >
                    <summary
                      class="facets__summary caption-large focus-offset"
                      aria-label="{{ filter.label }} ({{ 'products.facets.filters_selected.one' | t: count: filter.active_values.size }})"
                    >
                      <div>
                        <span>
                          {{- filter.label | escape }}
                          {%- if filter_type != 'horizontal' -%}
                            <span class="facets__selected no-js-hidden{% if filter.active_values.size == 0 %} hidden {% endif %}">
                              {{ filter.active_values.size -}}
                            </span>
                          {%- endif -%}
                        </span>
                        {% render 'icon-caret' %}
                      </div>
                    </summary>
                    <div
                      id="Facet-{{ forloop.index }}-{{ section.id }}"
                      class="parent-display {% if filter_type == 'horizontal' %}facets__display{% else %}facets__display-vertical{% endif %}"
                    >
                      {%- if filter_type == 'horizontal' -%}
                        <div class="facets__header">
                          <span class="facets__selected no-js-hidden">
                            {{- 'products.facets.filters_selected' | t: count: filter.active_values.size -}}
                          </span>
                          <facet-remove>
                            <a href="{{ filter.url_to_remove }}" class="facets__reset link underlined-link">
                              {{ 'products.facets.reset' | t }}
                            </a>
                          </facet-remove>
                        </div>
                      {%- endif -%}
                      {%- liquid
                        assign typeColor = section.settings.type_color
                        assign styleColor = section.settings.style_color
                        assign is_color = false
                        if section.settings.enable_color
                          assign is_color = true
                        endif

                        assign styleSize = section.settings.style_size
                        assign style_color = false
                        assign style_size = false
                        for value in filter.values
                          if value.param_name contains keywords_1 or value.param_name contains keywords_2
                            assign style_color = true
                          endif
                          if value.param_name contains 'size'
                            assign style_size = true
                          endif
                        endfor
                      -%}
                      <fieldset
                        class="
                          facets-wrap parent-wrap
                          {% if filter_type == 'vertical' %}facets-wrap-vertical{% endif %}
                          {% if is_color %}
                            {% if style_color %}
                              {{ styleColor }}
                              {% if typeColor %}color_c{% else %}color_q{% endif %}
                            {% endif %}
                          {% endif %}
                          {% if style_size %}size-{{ styleSize }}{% endif %}
                        "
                      >
                        <legend class="visually-hidden">
                          {{ filter.label | escape }}
                        </legend>

                        <ul
                          class="
                            {% if filter_type != 'vertical' %}facets__list{% endif %}
                            list-unstyled
                            no-js-hidden

                            {% if filter.label == 'Category'
                              or filter.label == 'Stone'
                              or filter.label == 'Style'
                              or filter.label == 'Center Shape'
                              or filter.label == 'Diamond Type'
                                or filter.label == 'Diamond Shape'
                            %}
                              custom-image-filter-grid
                            {% endif %}
                          "
                          role="list"
                        >
                          {%- for value in filter.values -%}
                            {%- assign value_label_normalized = value.label | strip | downcase -%}

                            {%- assign show_center_shape = true -%}

                            {%- comment -%}
                              =====================================================
                              CENTER SHAPE FILTER
                              Only basic/original shapes will be displayed.
                              Combination shapes will be hidden.
                              =====================================================
                            {%- endcomment -%}

                            {% if filter.label == 'Center Shape' %}
                              {% assign show_center_shape = false %}

                              {% assign all_center_shapes = 'round|oval|cushion|pear|princess|emerald|radiant|marquise|heart|asscher|baguette|trillion|half moon'
                                | split: '|'
                              %}

                              {% for allowed_shape in all_center_shapes %}
                                {% assign allowed_shape_normalized = allowed_shape | strip | downcase %}

                                {% if value_label_normalized == allowed_shape_normalized %}
                                  {% assign show_center_shape = true %}
                                  {% break %}
                                {% endif %}
                              {% endfor %}
                            {% endif %}

                            {%- comment -%}
                              =====================================================
                              IMAGE FILTER CHECK
                              These filters will show image instead of checkbox.
                              =====================================================
                            {%- endcomment -%}

                            {% assign image_filter = false %}

                            {% if filter.label == 'Category'
                              or filter.label == 'Stone'
                              or filter.label == 'Style'
                              or filter.label == 'Center Shape'
                              or filter.label == 'Diamond Type'
                              or filter.label == 'Diamond Shape'
                            %}
                              {% assign image_filter = true %}
                            {% endif %}

                            {% if show_center_shape %}
                              <li
                                class="
                                  list-menu__item
                                  facets__item

                                  {% if image_filter %}
                                    custom-image-filter-li
                                  {% endif %}

                                  {% if forloop.index > 14 and filter_type == 'vertical' %}
                                    show-more-item hidden
                                  {% endif %}
                                "
                              >
                                <label
                                  for="Filter-{{ filter.param_name | escape }}-{{ forloop.index }}"
                                  class="
                                    facet-checkbox

                                    {% if value.count == 0 and value.active == false %}
                                      facet-checkbox--disabled
                                    {% endif %}

                                    {% if is_color %}
                                      st-tooltip-top
                                    {% endif %}

                                    {% if image_filter %}
                                      custom-image-filter-label
                                    {% endif %}
                                  "
                                >
                                  {%- comment -%}
                                    =================================================
                                    HIDDEN REAL CHECKBOX FOR IMAGE FILTERS
                                    Shopify JS still uses this checkbox.
                                    =================================================
                                  {%- endcomment -%}

                                  <input
                                    type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    id="Filter-{{ filter.param_name | escape }}-{{ forloop.index }}"

                                    {% if value.active %}
                                      checked
                                    {% endif %}

                                    {% if value.count == 0 and value.active == false %}
                                      disabled
                                    {% endif %}

                                    {% if image_filter %}
                                      class="custom-filter-hidden-input"
                                    {% endif %}
                                  >

                                  {%- comment -%}
                                    =================================================
                                    NORMAL CHECKBOX
                                    Only for normal filters.
                                    =================================================
                                  {%- endcomment -%}

                                  {% unless image_filter %}
                                    <svg
                                      class="svg-box"
                                      width="1.6rem"
                                      height="1.6rem"
                                      viewBox="0 0 16 16"
                                      aria-hidden="true"
                                      focusable="false"
                                    >
                                      <rect
                                        width="16"
                                        height="16"
                                        stroke="currentColor"
                                        fill="none"
                                        stroke-width="1"
                                      ></rect>
                                    </svg>

                                    <svg
                                      class="icon icon-checkmark"
                                      width="1.1rem"
                                      height="0.7rem"
                                      viewBox="0 0 11 7"
                                      fill="none"
                                      xmlns="http://www.w3.org/2000/svg"
                                    >
                                      <path
                                        d="M1.5 3.5L2.83333 4.75L4.16667 6L9.5 1"
                                        stroke="currentColor"
                                        stroke-width="1.75"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                      />
                                    </svg>
                                  {% endunless %}

                                  {%- comment -%}
                                    =================================================
                                    COLOR FILTER
                                    =================================================
                                  {%- endcomment -%}

                                  {%- if is_color -%}
                                    {%- if value.param_name contains keywords_1
                                      or value.param_name contains keywords_2
                                    -%}
                                      <span
                                        class="facets_bg st-color-{{ value.label | escape | downcase | handle }}"
                                        style="
                                          background-color:
                                          {{ value.label | escape | downcase | handle }};
                                        "
                                      ></span>

                                      {%- if styleColor == 'color_grid' -%}
                                        <span class="st-tooltip__content">
                                          {{ value.label }}
                                        </span>
                                      {%- endif -%}
                                    {%- endif -%}
                                  {%- endif -%}

                                  {%- comment -%}
                                    =================================================
                                    SIZE FILTER
                                    =================================================
                                  {%- endcomment -%}

                                  {%- if style_size -%}
                                    <span class="facets_size"></span>
                                  {%- endif -%}

                                  {%- comment -%}
                                    =================================================
                                    IMAGE FILTER
                                    Category
                                    Stone
                                    Style
                                    Center Shape
                                    Diamond Type
                                    =================================================
                                  {%- endcomment -%}

                                  {% if image_filter %}
                                    <div class="custom-filter-image-list">
                                      {% assign value_image_handle = value.label | handleize %}

                                      <div
                                        class="
                                          custom-filter-image-item
                                          {% if value.active %}active{% endif %}
                                          {% if value.count == 0 and value.active == false %}
                                            disabled
                                          {% endif %}
                                        "
                                      >
                                        <div class="custom-filter-image">
                                          <img
                                            src="{{ value_image_handle | append: '.png' | asset_url }}"
                                            alt="{{ value.label | escape }}"
                                            width="48"
                                            height="48"
                                            loading="lazy"
                                          >
                                        </div>

                                        <span class="custom-filter-image-label">
                                          {{ value.label | escape }}
                                        </span>
                                      </div>
                                    </div>

                                  {% else %}
                                    {%- comment -%}
                                      =================================================
                                      NORMAL FILTER TEXT
                                      =================================================
                                    {%- endcomment -%}

                                    <span class="facet-checkbox__text">
                                      {{ value.label | escape }}

                                      ({{ value.count }})
                                    </span>
                                  {% endif %}

                                  {%- comment -%}
                                    =================================================
                                    ACCESSIBILITY TEXT
                                    =================================================
                                  {%- endcomment -%}

                                  <span class="visually-hidden">
                                    {{- value.label | escape }} (

                                    {%- if value.count == 1 -%}
                                      {{ 'products.facets.product_count_simple.one' | t: count: value.count }}

                                    {%- else -%}
                                      {{ 'products.facets.product_count_simple.other' | t: count: value.count }}
                                    {%- endif -%}

                                    )
                                  </span>
                                </label>
                              </li>
                            {% endif %}
                          {%- endfor -%}
                        </ul>

                        {% comment %}
                          ==========================================================
                          NO JS FILTER LIST
                          ==========================================================
                        {% endcomment %}

                        <ul
                          class="
                            {% if filter_type != 'vertical' %}facets__list{% endif %}
                            no-js-list
                            list-unstyled
                            no-js
                          "
                          role="list"
                        >
                          {%- for value in filter.values -%}
                            {%- assign value_label_normalized = value.label | strip | downcase -%}

                            {%- assign show_center_shape = true -%}

                            {%- comment -%}
                              =====================================================
                              CENTER SHAPE FILTER
                              =====================================================
                            {%- endcomment -%}

                            {% if filter.label == 'Center Shape' %}
                              {% assign show_center_shape = false %}

                              {% assign all_center_shapes = 'round|oval|cushion|pear|princess|emerald|radiant|marquise|heart|asscher|baguette|trillion|half moon'
                                | split: '|'
                              %}

                              {% for allowed_shape in all_center_shapes %}
                                {% assign allowed_shape_normalized = allowed_shape | strip | downcase %}

                                {% if value_label_normalized == allowed_shape_normalized %}
                                  {% assign show_center_shape = true %}

                                  {% break %}
                                {% endif %}
                              {% endfor %}
                            {% endif %}

                            {% if show_center_shape %}
                              <li class="list-menu__item facets__item">
                                <label
                                  for="Filter-{{ filter.param_name | escape }}-{{ forloop.index }}-no-js"
                                  class="
                                    facet-checkbox

                                    {% if value.count == 0 and value.active == false %}
                                      facet-checkbox--disabled
                                    {% endif %}
                                  "
                                >
                                  <input
                                    type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    id="Filter-{{ filter.param_name | escape }}-{{ forloop.index }}-no-js"

                                    {% if value.active %}
                                      checked
                                    {% endif %}

                                    {% if value.count == 0 and value.active == false %}
                                      disabled
                                    {% endif %}
                                  >

                                  {%- comment -%}
                                    =================================================
                                    NO-JS NORMAL CHECKBOX
                                    =================================================
                                  {%- endcomment -%}

                                  <svg
                                    width="1.6rem"
                                    height="1.6rem"
                                    viewBox="0 0 16 16"
                                    aria-hidden="true"
                                    focusable="false"
                                  >
                                    <rect
                                      width="16"
                                      height="16"
                                      stroke="currentColor"
                                      fill="none"
                                      stroke-width="1"
                                    ></rect>
                                  </svg>

                                  <svg
                                    class="icon icon-checkmark"
                                    width="1.1rem"
                                    height="0.7rem"
                                    viewBox="0 0 11 7"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                  >
                                    <path
                                      d="M1.5 3.5L2.83333 4.75L4.16667 6L9.5 1"
                                      stroke="currentColor"
                                      stroke-width="1.75"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                    />
                                  </svg>

                                  <span aria-hidden="true">
                                    {{ value.label | escape }}

                                    ({{ value.count }})
                                  </span>

                                  <span class="visually-hidden">
                                    {{- value.label | escape }} (

                                    {%- if value.count == 1 -%}
                                      {{ 'products.facets.product_count_simple.one' | t: count: value.count }}

                                    {%- else -%}
                                      {{ 'products.facets.product_count_simple.other' | t: count: value.count }}
                                    {%- endif -%}

                                    )
                                  </span>
                                </label>
                              </li>
                            {% endif %}
                          {%- endfor -%}
                        </ul>
                      </fieldset>

                      <style>

                        .custom-image-filter-grid {
  max-height: 230px !important;      /* ~2 rows, adjust as needed */
  overflow-y: auto !important;
  padding-right: 8px !important;
}

/* Show-more se jo items 14 ke baad hidden ho jate hain,
   unhe force visible karo kyunki ab scroll se sab dikhenge */
.custom-image-filter-grid .show-more-item.hidden {
  display: flex !important;
}

/* Custom thin scrollbar - Chrome/Edge/Safari */
.custom-image-filter-grid::-webkit-scrollbar {
  width: 6px;
}
.custom-image-filter-grid::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 10px;
}
.custom-image-filter-grid::-webkit-scrollbar-thumb {
  background: #c2c2c2;
  border-radius: 10px;
}
.custom-image-filter-grid::-webkit-scrollbar-thumb:hover {
  background: #a0a0a0;
}

/* Firefox */
.custom-image-filter-grid {
  scrollbar-width: thin;
  scrollbar-color: #c2c2c2 #f1f1f1;
}



                                                                    /* =========================================================
                                                                       IMAGE FILTER ITEM
                                                                    ========================================================= */

                                                                    .custom-filter-image-item {
                                                                      width: 100%;
                                                                      min-width: 0;
                                                                      display: flex;
                                                                      flex-direction: column;
                                                                      align-items: center;
                                                                      justify-content: center;
                                                                      text-decoration: none !important;
                                                                      cursor: pointer;
                                                                      padding: 5px 2px;
                                                                      box-sizing: border-box;
                                                                    }


                                                                    /* =========================================================
                                                                       IMAGE
                                                                    ========================================================= */

                                                                    .custom-filter-image {
                                                                      width: 55px;
                                                                      height: 55px;
                                                                      display: flex;
                                                                      align-items: center;
                                                                      justify-content: center;
                                                                      margin-bottom: 5px;
                                                                    }

                                                                    .custom-filter-image img {
                                                                      display: block !important;
                                                                      width: 48px !important;
                                                                      height: 48px !important;
                                                                      max-width: 48px !important;
                                                                      max-height: 48px !important;
                                                                      object-fit: contain !important;
                                                                      margin: 0 !important;
                                                                      padding: 0 !important;
                                                                      border: 0 !important;
                                                                      box-shadow: none !important;
                                                                    }


                                                                    /* =========================================================
                                                                       LABEL
                                                                    ========================================================= */

                                                                    .custom-filter-image-label {
                                                                      display: block !important;
                                                                      width: 100% !important;
                                                                      font-size: 13px !important;
                                                                      line-height: 17px !important;
                                                                      text-align: center !important;
                                                                      color: #062f57 !important;
                                                                    }


                                                                    /* =========================================================
                                                                       ACTIVE
                                                                    ========================================================= */


                        .custom-image-filter-li > label:has(input[type="checkbox"]:checked)
                        .custom-filter-image-item .custom-filter-image {
                          outline: 2px solid #062f57 !important;
                          outline-offset: 3px;
                        }

                        /* Optional: selected image slightly highlighted */
                        .custom-image-filter-li > label:has(input[type="checkbox"]:checked)
                        .custom-filter-image-item {
                          color: #062f57;
                        }

                        /* Remove selected state automatically when unchecked */
                        .custom-image-filter-li > label:not(:has(input[type="checkbox"]:checked))
                        .custom-filter-image-item .custom-filter-image {
                          outline: none !important;
                        }


                                                                    /* =========================================================
                                                                       3 COLUMN GRID
                                                                    ========================================================= */

                                                                    .custom-image-filter-grid {
                                                                      display: grid !important;
                                                                      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
                                                                      gap: 18px 8px !important;
                                                                      width: 100% !important;
                                                                      padding: 0 !important;
                                                                      margin: 0 !important;
                                                                    }

                                                                    .custom-image-filter-grid .custom-image-filter-li {
                                                                      width: 100% !important;
                                                                      min-width: 0 !important;
                                                                      margin: 0 !important;
                                                                      padding: 0 !important;
                                                                    }


                                                                    /* =========================================================
                                                                       HIDE DEFAULT CHECKBOX FOR IMAGE FILTERS
                                                                    ========================================================= */

                                                                    .custom-image-filter-li > label > input,
                                                                    .custom-image-filter-li > label > svg {
                                                                      display: none !important;
                                                                    }


                                                                    /* =========================================================
                                                                       IMAGE WRAPPER
                                                                    ========================================================= */

                                                                    .custom-filter-image-list {
                                                                      display: block !important;
                                                                      width: 100% !important;
                                                                    }


                                                                    /* =========================================================
                                                                       MOBILE
                                                                    ========================================================= */

                                                                    @media screen and (max-width: 749px) {

                                                                      .custom-image-filter-grid {
                                                                        display: grid !important;
                                                grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
                                                                        gap: 18px 8px !important;
                                                                        width: 100% !important;
                                                                      }

                                                                      .custom-image-filter-li {
                                                                        width: 100% !important;
                                                                        margin: 0 !important;
                                                                        padding: 0 !important;
                                                                      }

                                                                      .custom-filter-image {
                                                                        width: 48px !important;
                                                                        height: 48px !important;
                                                                      }

                                                                      .custom-filter-image img {
                                                                        width: 42px !important;
                                                                        height: 42px !important;
                                                                      }

                                                                      .custom-filter-image-label {
                                                                        font-size: 12px !important;
                                                                        line-height: 16px !important;
                                                                      }

                                                                    }
                      </style>
                      {% comment %} {%- if filter.values.size > 14 and filter_type == 'vertical' -%}
