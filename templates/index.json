    "faq_accordion_3Qhy8q": {
      "type": "faq-accordion",
      "blocks": {
        "faq_JxQ7ki": {
          "type": "faq",
          "settings": {
            "faq_title": "How can I buy lab-grown diamonds from Lumera fine Jewellery?",
            "faq_des": "<p>Purchasing lab-grown diamonds from Lumera fine Jewellery is simple and secure. Browse our collection, select your preferred diamond or jewelry piece, customize it if needed, and proceed to checkout. If you need assistance choosing the right diamond, our experts are always here to guide you.<br/></p>"
          }
        },
        "faq_JidjbE": {
          "type": "faq",
          "settings": {
            "faq_title": "What are lab-grown or lab-created diamonds?",
            "faq_des": "<p>Lab-grown diamonds are real diamonds created in a controlled laboratory environment using advanced technology that replicates the natural diamond-forming process.<br/><br/>They have the <strong>same chemical, physical, and optical properties</strong> as mined diamonds.</p><p>Two primary creation methods are used:</p><ul><li><br/><strong>HPHT (High Pressure, High Temperature)</strong><br/></li><li><br/><strong>CVD (Chemical Vapor Deposition)</strong><br/></li></ul><p>Lab-grown diamonds are an ethical, eco-friendly alternative to mined diamonds—free from environmental damage and conflict concerns.</p>"
          }
        },
        "faq_G3MEDL": {
          "type": "faq",
          "settings": {
            "faq_title": "What is your return policy?",
            "faq_des": "<p>We offer a <strong>30-day return and exchange policy</strong>.<br/><br/>If you wish to return or exchange an item, simply contact us for instructions. Please ensure all items are returned in their <strong>original packaging</strong>.</p>"
          }
        },
        "faq_fF8YTL": {
          "type": "faq",
          "settings": {
            "faq_title": "Do your lab-grown diamonds come with certifications?",
            "faq_des": "<p>Yes.</p><ul><li><strong>Diamonds over 1 carat</strong> include an <strong>IGI certification</strong> at no additional cost.</li><li><strong>Diamonds below 1 carat</strong> can be certified for an additional fee of <strong>USD 94</strong>.</li></ul><p></p><p>Certification ensures authenticity and is useful for insurance or appraisal purposes.</p>"
          }
        },
        "faq_AHJGEj": {
          "type": "faq",
          "settings": {
            "faq_title": "What does “handpicked lab-grown diamonds” mean?",
            "faq_des": "<p>Our expert graders individually select each diamond based on superior <strong>cut, brilliance, and overall appearance</strong>.<br/><br/>Handpicked diamonds may cost slightly more, but they are chosen from a wider selection to ensure the highest possible quality.</p>"
          }
        },
        "faq_PXm7fq": {
          "type": "faq",
          "settings": {
            "faq_title": "Will the moissanite in your jewelry become dull or cloudy over time?",
            "faq_des": "<p>Moissanite does <strong>not</strong> become permanently dull or cloudy.<br/><br/>Any dullness is usually just from oil, dirt, or dust build-up. A quick cleaning restores its <strong>original sparkle and brilliance</strong>.</p>"
          }
        }
      },
